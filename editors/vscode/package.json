{
  "name": "bhash",
  "displayName": "Bhash (भाष)",
  "description": "Devanagari programming: compiler-backed diagnostics, completion, navigation, and project tasks.",
  "version": "0.9.3",
  "publisher": "bhashitva",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhashitva/bhash.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/bhashitva/bhash/tree/main/editors/vscode",
  "bugs": {
    "url": "https://github.com/bhashitva/bhash/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "bhash",
    "Devanagari",
    "Hindi",
    "Indic"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:bhash",
    "onLanguage:bhash-project",
    "workspaceContains:**/bhash.project",
    "onTaskType:bhash",
    "onDebugResolve:cppdbg",
    "onDebugResolve:bhash-native-windows"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Highlighting and snippets work in Restricted Mode. Trust is required for the Java language server and build/run commands.",
      "restrictedConfigurations": [
        "bhash.javaPath",
        "bhash.compilerPath",
        "bhash.native.toolchainMode",
        "bhash.native.toolchainHome",
        "bhash.native.toolchainMode",
        "bhash.native.toolchainHome",
        "bhash.native.gdbPath"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Highlighting and snippets are available. Analysis and tasks require files on disk in the local or remote extension host."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "bhash",
        "aliases": [
          "Bhash",
          "भाष"
        ],
        "extensions": [
          ".bhash"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "bhash-project",
        "aliases": [
          "Bhash Project"
        ],
        "filenames": [
          "bhash.project"
        ]
      }
    ],
    "grammars": [
      {
        "language": "bhash",
        "scopeName": "source.bhash",
        "path": "./syntaxes/bhash.tmLanguage.json"
      },
      {
        "language": "bhash-project",
        "scopeName": "source.bhash-project",
        "path": "./syntaxes/project.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "bhash",
        "path": "./snippets/bhash.json"
      }
    ],
    "commands": [
      {
        "command": "bhash.newProject",
        "title": "Bhash: New Project"
      },
      {
        "command": "bhash.build",
        "title": "Bhash: Build Project or File"
      },
      {
        "command": "bhash.run",
        "title": "Bhash: Run Project or File"
      },
      {
        "command": "bhash.restartServer",
        "title": "Bhash: Restart Language Server"
      },
      {
        "command": "bhash.openPlayground",
        "title": "Bhash: Open Browser Playground"
      },
      {
        "command": "bhash.openCommunity",
        "title": "Bhash: Community & Support (Discord)"
      },
      {
        "command": "bhash.lockDependencies",
        "title": "Bhash: Update Dependencies Lock"
      },
      {
        "command": "bhash.restoreDependencies",
        "title": "Bhash: Restore Dependencies"
      },
      {
        "command": "bhash.verifyDependencies",
        "title": "Bhash: Verify Dependencies"
      },
      {
        "command": "bhash.setupNativeTools",
        "title": "Bhash: Set Up Native Tools"
      },
      {
        "command": "bhash.checkNativeSetup",
        "title": "Bhash: Check Native Setup"
      },
      {
        "command": "bhash.repairNativeTools",
        "title": "Bhash: Repair Native Tools"
      },
      {
        "command": "bhash.setupNativeTools",
        "title": "Bhash: Set Up Native Tools"
      },
      {
        "command": "bhash.checkNativeSetup",
        "title": "Bhash: Check Native Setup"
      },
      {
        "command": "bhash.repairNativeTools",
        "title": "Bhash: Repair Native Tools"
      },
      {
        "command": "bhash.debugNative",
        "title": "Bhash: Debug Native"
      }
    ],
    "configuration": {
      "title": "Bhash",
      "properties": {
        "bhash.javaPath": {
          "type": "string",
          "default": "java",
          "scope": "machine",
          "description": "Java 17+ executable on the extension host. A full JDK is required to build/run JVM programs."
        },
        "bhash.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute compiler JAR path. Leave empty to use the compiler bundled with this extension."
        },
        "bhash.target": {
          "type": "string",
          "enum": [
            "jvm",
            "clr",
            "wasm-browser",
            "native",
            "native"
          ],
          "default": "jvm",
          "description": "Default target for build tasks. CLR and browser builds require .NET 10; browser builds also require wasm-tools."
        },
        "bhash.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Language server protocol trace in the Bhash output channel. Verbose tracing can include source text."
        },
        "bhash.native.toolchainMode": {
          "type": "string",
          "enum": [
            "managed",
            "system"
          ],
          "default": "managed",
          "scope": "machine",
          "description": "Managed downloads a pinned Windows x64, Linux x86-64 or macOS ARM64 LLVM SDK on first Native build/run (Windows 10+, glibc 2.35+, or macOS 14+ with Apple Command Line Tools; Java 17+). System uses an existing LLVM 18 toolchain."
        },
        "bhash.native.toolchainHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute SDK cache directory on the Windows/Linux/WSL/macOS extension host. Empty uses BHASH_TOOLCHAIN_HOME or the compiler default cache. Allow approximately 1 GB of free disk space for setup."
        },
        "bhash.native.gdbPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional debugger executable on this host. Empty automatically installs pinned GDB/Python on Windows x64 and uses gdb on Linux/WSL. Debugging requires Microsoft C/C++ on the same host."
        },
        "bhash.native.debuggerStartupTimeoutSeconds": {
          "type": "integer",
          "default": 300,
          "minimum": 15,
          "maximum": 600,
          "scope": "machine",
          "description": "Maximum seconds to wait for GDB startup, including first-run antivirus review. Setup remains cancellable. Increase up to 600 if a security scan takes longer."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "bhash",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "run"
            ]
          },
          "project": {
            "type": "string",
            "description": "Project directory, bhash.project, or .bhash file, relative to the workspace folder."
          },
          "target": {
            "type": "string",
            "enum": [
              "jvm",
              "clr",
              "wasm-browser",
              "native",
              "native"
            ]
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "bhash",
        "owner": "bhash-build",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    ],
    "configurationDefaults": {
      "[bhash]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?",
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        }
      }
    },
    "debuggers": [
      {
        "type": "cppdbg",
        "configurationAttributes": {
          "launch": {
            "properties": {
              "bhashNative": {
                "type": "boolean",
                "default": false,
                "description": "Build Bhash input with --target native --debug before launching GDB (Windows x64 or Linux/WSL)."
              },
              "bhashInput": {
                "type": "string",
                "description": "Bhash source file or project to compile. Relative paths resolve from cwd."
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Bhash: Native",
            "description": "Compile and debug a Bhash project with GDB. Requires Microsoft C/C++.",
            "body": {
              "type": "cppdbg",
              "request": "launch",
              "name": "Bhash: Native",
              "bhashNative": true,
              "bhashInput": "${workspaceFolder}/bhash.project",
              "program": "${workspaceFolder}/.bhash/debug/program",
              "cwd": "${workspaceFolder}",
              "stopAtEntry": false,
              "args": []
            }
          }
        ]
      },
      {
        "type": "bhash-native-windows",
        "label": "Bhash: Native (Windows)",
        "languages": [
          "bhash"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "bhashInput": {
                "type": "string",
                "description": "Bhash file or project to build and debug."
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "stopAtEntry": {
                "type": "boolean",
                "default": false
              },
              "environment": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              },
              "bhashNative": {
                "type": "boolean",
                "default": true
              }
            }
          }
        }
      }
    ],
    "breakpoints": [
      {
        "language": "bhash"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.cjs",
    "test:integration": "node test/run.cjs",
    "package": "npm run build && vsce package --no-dependencies --baseContentUrl https://github.com/bhashitva/bhash/blob/main/editors/vscode --baseImagesUrl https://github.com/bhashitva/bhash/raw/main/editors/vscode -o ../../target/bhash-vscode-0.9.3.vsix",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vscode-textmate": "9.2.0",
    "vscode-oniguruma": "2.0.1",
    "patch-package": "8.0.1"
  },
  "icon": "images/bhash-icon.png",
  "overrides": {
    "minimatch": "11.0.1"
  }
}
