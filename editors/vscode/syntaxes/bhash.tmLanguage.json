{
  "name": "Bhash",
  "scopeName": "source.bhash",
  "patterns": [
    {
      "name": "comment.line.double-slash.bhash",
      "begin": "//",
      "end": "$"
    },
    {
      "name": "comment.block.bhash",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.bhash",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.bhash",
          "match": "\\\\(?:[\"\\\\nrt]|u[0-9a-fA-F]{4})"
        }
      ]
    },
    {
      "match": "((?<![\\u0900-\\u094F\\u0951-\\u0963\\u0966-\\u097F0-9_])(?:वर्ग|अनुबंध|अभिलेख|परिगणना)(?![\\u0900-\\u094F\\u0951-\\u0963\\u0966-\\u097F0-9_]))\\s+([\\u0900-\\u094F\\u0951-\\u0963\\u0966-\\u097F0-9_]+)",
      "captures": {
        "1": {
          "name": "keyword.declaration.bhash"
        },
        "2": {
          "name": "entity.name.type.bhash"
        }
      }
    },
    {
      "match": "((?<![\\u0900-\\u094F\\u0951-\\u0963\\u0966-\\u097F0-9_])(?:कार्य)(?![\\u0900-\\u094F\\u0951-\\u0963\\u0966-\\u097F0-9_]))\\s+([\\u0900-\\u094F\\u0951-\\u0963\\u0966-\\u097F0-9_]+)",
      "captures": {
        "1": {
          "name": "keyword.declaration.function.bhash"
        },
        "2": {
          "name": "entity.name.function.bhash"
        }
      }
    },
    {
      "name": "storage.type.bhash",
      "match": "(?<![\\u0900-\\u094F\\u0951-\\u0963\\u0966-\\u097F0-9_])(?:सूची|मानचित्र|सरणी|अपवाद)(?![\\u0900-\\u094F\\u0951-\\u0963\\u0966-\\u097F0-9_])"
    },
    {
      "name": "constant.language.bhash",
      "match": "(?<![\\u0900-\\u094F\\u0951-\\u0963\\u0966-\\u097F0-9_])(?:सत्य|असत्य|रिक्त)(?![\\u0900-\\u094F\\u0951-\\u0963\\u0966-\\u097F0-9_])"
    },
    {
      "name": "keyword.control.bhash",
      "match": "(?<![\\u0900-\\u094F\\u0951-\\u0963\\u0966-\\u097F0-9_])(?:संकुल|आयात|उपनाम|कार्य|वर्ग|अभिलेख|परिगणना|परिवर्तित|प्रकारहै|सुरक्षितरूप|अनुबंध|पालन|साझा|विस्तार|निर्माता|नया|यह|आधार|सार्वजनिक|निजी|संरक्षित|अधिलेखन|रिक्त|मान|स्थिर|यदि|अन्यथा|जबतक|प्रत्येक|में|चयन|विकल्प|शेष|संसाधन|प्रयास|पकड़ो|अंततः|फेंको|लौटाओ|विराम|जारी|लिखो|पूर्णांक|बाइट|सर्ववस्तु|बाइटबफ़र|दशमलव|तार्किक|पाठ|शून्य|सत्य|असत्य)(?![\\u0900-\\u094F\\u0951-\\u0963\\u0966-\\u097F0-9_])"
    },
    {
      "name": "support.function.bhash",
      "match": "(?<![\\u0900-\\u094F\\u0951-\\u0963\\u0966-\\u097F0-9_])(?:पढ़ो|पाठपढ़ो|लंबाई|अंश|अंकपाठ|पूर्णांकपाठ|बड़ाअक्षर|त्रुटि|यूटीएफ८बफ़र|यूटीएफ८पाठ)(?![\\u0900-\\u094F\\u0951-\\u0963\\u0966-\\u097F0-9_])"
    },
    {
      "name": "constant.numeric.bhash",
      "match": "(?<![\\u0900-\\u097F0-9_])(?:[0-9]+(?:\\.[0-9]+)?|[०-९]+(?:\\.[०-९]+)?)(?![\\u0900-\\u097F0-9_])"
    },
    {
      "name": "keyword.operator.bhash",
      "match": "->|>>>|>>|<<|==|!=|<=|>=|&&|\\|\\||[+*/%=&|^~!<>-]"
    },
    {
      "name": "punctuation.section.bhash",
      "match": "[{}()\\[\\];,:.]"
    }
  ]
}
