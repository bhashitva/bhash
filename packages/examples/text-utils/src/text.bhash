संकुल उपयोगीपाठ;

सार्वजनिक फलन अभिवादन(नाम: पाठ) -> पाठ {
    लौटाओ "नमस्ते, " + नाम + "!";
}

सार्वजनिक फलन दोहराओ(संदेश: पाठ, बार: पूर्णांक) -> पाठ {
    यदि (बार < ० || बार > १०००) { फेंको नया अपवाद("दोहराव ० से १००० तक दें।"); }
    मान उत्तर = "";
    मान गिनती = ०;
    जबतक (गिनती < बार) { उत्तर = उत्तर + संदेश; गिनती = गिनती + १; }
    लौटाओ उत्तर;
}
