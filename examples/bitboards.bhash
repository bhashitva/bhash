// A 64-square board stored in one signed 64-bit integer.
कार्य गिनो(पट्ट: पूर्णांक) -> पूर्णांक {
    मान शेषबिट: पूर्णांक = पट्ट;
    मान गिनती: पूर्णांक = ०;
    जबतक (शेषबिट != ०) {
        शेषबिट = शेषबिट & (शेषबिट - १);
        गिनती = गिनती + १;
    }
    लौटाओ गिनती;
}

कार्य मुख्य() -> शून्य {
    स्थिर पहली: पूर्णांक = १ << ०;
    स्थिर अंतिम: पूर्णांक = १ << ६३;
    मान पट्ट: पूर्णांक = पहली | अंतिम;
    लिखो(पट्ट);
    लिखो((पट्ट & पहली) != ०, (पट्ट & अंतिम) != ०);
    लिखो(गिनो(पट्ट));
    पट्ट = पट्ट ^ पहली;
    लिखो(गिनो(पट्ट), पट्ट >>> ६३);
    लिखो(~०, -१ >> १, -१ >>> १);
    लिखो(१ << ६४, १ << ६५);
}
