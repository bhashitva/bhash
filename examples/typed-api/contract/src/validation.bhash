संकुल कार्यअनुबंध;
आयात मानक.पाठ्य;

फलन वस्तुजाँचो(मूल: सर्ववस्तु, अपेक्षित: पूर्णांक) -> मानचित्र<पाठ,सर्ववस्तु> {
    यदि (!प्रकारहै<मानचित्र<पाठ,सर्ववस्तु>>(मूल)) {
        फेंको नया अपवाद("JSON वस्तु अपेक्षित है।");
    }
    स्थिर वस्तु: मानचित्र<पाठ,सर्ववस्तु> = परिवर्तित<मानचित्र<पाठ,सर्ववस्तु>>(मूल);
    यदि (वस्तु.आकार != अपेक्षित) { फेंको नया अपवाद("JSON क्षेत्रों की सूची अमान्य है।"); }
    लौटाओ वस्तु;
}

फलन क्षेत्रलो(वस्तु: मानचित्र<पाठ,सर्ववस्तु>, नाम: पाठ) -> सर्ववस्तु {
    यदि (!वस्तु.है(नाम)) { फेंको नया अपवाद("आवश्यक JSON क्षेत्र अनुपस्थित है: " + नाम); }
    लौटाओ वस्तु[नाम];
}

फलन पाठजाँचो(मानक: सर्ववस्तु, नाम: पाठ, न्यून: पूर्णांक, अधिक: पूर्णांक) -> पाठ {
    यदि (!प्रकारहै<पाठ>(मानक)) { फेंको नया अपवाद("पाठ अपेक्षित है: " + नाम); }
    स्थिर फल: पाठ = परिवर्तित<पाठ>(मानक);
    स्थिर आकार: पूर्णांक = पाठ्य.लंबाई(फल);
    यदि (आकार < न्यून || आकार > अधिक || पाठ्य.है(फल,"\u0000")) {
        फेंको नया अपवाद("पाठ की लंबाई या सामग्री अमान्य है: " + नाम);
    }
    लौटाओ फल;
}

फलन पूर्णांकजाँचो(मानक: सर्ववस्तु, नाम: पाठ, न्यून: पूर्णांक, अधिक: पूर्णांक) -> पूर्णांक {
    यदि (!प्रकारहै<पूर्णांक>(मानक)) { फेंको नया अपवाद("पूर्णांक अपेक्षित है: " + नाम); }
    स्थिर फल: पूर्णांक = परिवर्तित<पूर्णांक>(मानक);
    यदि (फल < न्यून || फल > अधिक) { फेंको नया अपवाद("पूर्णांक सीमा से बाहर है: " + नाम); }
    लौटाओ फल;
}

फलन तार्किकजाँचो(मानक: सर्ववस्तु, नाम: पाठ) -> तार्किक {
    यदि (!प्रकारहै<तार्किक>(मानक)) { फेंको नया अपवाद("तार्किक मान अपेक्षित है: " + नाम); }
    लौटाओ परिवर्तित<तार्किक>(मानक);
}
