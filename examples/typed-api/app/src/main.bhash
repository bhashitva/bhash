आयात कार्यसेवा.संबंधखोलो;
आयात कार्यसेवा.बदलावयोजना;
आयात कार्यसेवा.अनुप्रयोगबनाओ;
आयात मानक.डेटासंबंध; आयात मानक.वेबचालक; आयात मानक.एचटीटीपीसर्वर;
आयात मानक.वेब; आयात मानक.विन्यास;

फलन मुख्य() -> शून्य {
    स्थिर तर्क: विन्यास = विन्यास.तर्क();
    स्थिर पोर्ट: पूर्णांक = वेब.संख्या(तर्क.पढ़ो("port","8080"),६५५३५);
    स्थिर सीमा: पूर्णांक = वेब.संख्या(तर्क.पढ़ो("requests","0"),१००००);
    संसाधन (डाटा: डेटासंबंध = संबंधखोलो(तर्क.पढ़ो("provider","sqlite"),तर्क.पढ़ो("db","typed-tasks.db"))) {
        बदलावयोजना().लागूकरो(डाटा);
        स्थिर चालक: वेबचालक = अनुप्रयोगबनाओ(डाटा);
        संसाधन (सर्वर: एचटीटीपीसर्वर = नया एचटीटीपीसर्वर("127.0.0.1",पोर्ट)) {
            लिखो("READY " + वेब.अंक(सर्वर.पोर्ट()));
            यदि (सीमा == ०) { सर्वर.चलाओ(चालक); }
            अन्यथा {
                मान गिनती: पूर्णांक = ०;
                जबतक (गिनती < सीमा && !सर्वर.रुकाहै()) {
                    यदि (सर्वर.अगला(चालक)) { गिनती = गिनती + १; }
                }
            }
        }
    }
}
