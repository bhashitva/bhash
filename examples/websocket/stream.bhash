आयात मानक.द्विदिशधारा;
आयात मानक.असमवेबउन्नतचालक;
आयात मानक.पाठ्य;
आयात मानक.सत्र;
आयात मानक.सत्रप्रबंधक;
आयात मानक.वेबअनुरोध;
आयात मानक.वेबत्रुटि;
आयात मानक.वेबसंबंध;
आयात मानक.वेबसॉकेटमार्ग;
आयात मानक.कार्य;
आयात मानक.कार्यफल;
आयात मानक.कार्यशून्य;
आयात मानक.निरस्तअपवाद;
आयात मानक.निरस्तीकरणस्रोत;
आयात मानक.निरस्तीकरणचिह्न;
आयात मानक.वेबसॉकेटकूट;
आयात मानक.वेबसॉकेटचालक;
आयात मानक.वेबसॉकेटसंदर्भ;
आयात मानक.वेबसॉकेटसंबंध;
आयात मानक.वेबसॉकेटसंदेश;

वर्ग स्मृतिधारा पालन द्विदिशधारा {
    निजी मान क्रम: पूर्णांक=०;
    निजी मान आनेवाले: सूची<पूर्णांक>;
    सार्वजनिक मान भेजे: सूची<पूर्णांक>;
    सार्वजनिक मान बंदगिनती: पूर्णांक=०;
    निर्माता() {
        आनेवाले=नया सूची<पूर्णांक>{१२९,१३०,१,२,३,४,१०५,१०७,१३६,१३०,१,२,३,४,२,२३४};
        भेजे=नया सूची<पूर्णांक>();
    }
    सार्वजनिक फलन पढ़ो() -> बाइटबफ़र {
        यदि (क्रम>=आनेवाले.आकार || (क्रम>=८ && भेजे.आकार<८)) { लौटाओ रिक्त; }
        स्थिर खंड: बाइटबफ़र=नया बाइटबफ़र(१);
        खंड[०]=परिवर्तित<बाइट>(आनेवाले[क्रम]); क्रम=क्रम+१; लौटाओ खंड;
    }
    सार्वजनिक फलन भेजो(खंड: बाइटबफ़र) -> पूर्णांक {
        भेजे.जोड़ो(परिवर्तित<पूर्णांक>(खंड[०])); लौटाओ १;
    }
    सार्वजनिक फलन बंदकरो() -> शून्य { बंदगिनती=बंदगिनती+१; }
}

वर्ग चालक पालन वेबसॉकेटचालक {
    सार्वजनिक मान समाप्त: तार्किक=असत्य;
    सार्वजनिक असमकालिक फलन संभालो(संदर्भ: वेबसॉकेटसंदर्भ, संबंध: वेबसॉकेटसंबंध, चिह्न: निरस्तीकरणचिह्न) -> शून्य {
        स्थिर संदेश: वेबसॉकेटसंदेश=प्रतीक्षा संबंध.पाओ(चिह्न);
        यदि (संदेश.प्रकार!="पाठ" || संदेश.पाठ्यांश!="hi") { फेंको नया अपवाद("अमान्य संदेश।"); }
        प्रतीक्षा संबंध.पाठभेजो(संदेश.पाठ्यांश,चिह्न);
        प्रतीक्षा संबंध.बंदकरो();
        समाप्त=सत्य;
    }
}


// Simulate a flow-controlled stream that can commit either zero or one byte.
वर्ग रुकीधारा पालन द्विदिशधारा {
    सार्वजनिक मान लिखे: पूर्णांक=०;
    सार्वजनिक मान प्रयासगिनती: पूर्णांक=०;
    सार्वजनिक मान बंदगिनती: पूर्णांक=०;
    निजी मान क्षमता: पूर्णांक;
    निर्माता(क्षमता: पूर्णांक) { यह.क्षमता=क्षमता; }
    सार्वजनिक फलन पढ़ो() -> बाइटबफ़र { लौटाओ रिक्त; }
    सार्वजनिक फलन भेजो(खंड: बाइटबफ़र) -> पूर्णांक {
        प्रयासगिनती=प्रयासगिनती+१;
        यदि (लिखे>=क्षमता) { लौटाओ ०; }
        लिखे=लिखे+१; लौटाओ १;
    }
    सार्वजनिक फलन बंदकरो() -> शून्य { बंदगिनती=बंदगिनती+१; }
}

वर्ग रद्दचालक पालन वेबसॉकेटचालक {
    निजी मान धारा: रुकीधारा;
    निजी मान रोक: निरस्तीकरणस्रोत;
    सार्वजनिक मान रद्दमिला: तार्किक=असत्य;
    निर्माता(धारा: रुकीधारा, रोक: निरस्तीकरणस्रोत) { यह.धारा=धारा; यह.रोक=रोक; }
    सार्वजनिक असमकालिक फलन संभालो(संदर्भ: वेबसॉकेटसंदर्भ, संबंध: वेबसॉकेटसंबंध, चिह्न: निरस्तीकरणचिह्न) -> शून्य {
        स्थिर भेजरोक: निरस्तीकरणस्रोत=नया निरस्तीकरणस्रोत();
        स्थिर भेजना: कार्यफल<कार्यशून्य> = संबंध.पाठभेजो("x",भेजरोक.चिह्नलो());
        जबतक (धारा.प्रयासगिनती==०) { प्रतीक्षा कार्य.विलंब(५,चिह्न); }
        भेजरोक.निरस्तकरो();
        प्रयास { प्रतीक्षा भेजना; }
        पकड़ो (दोष: निरस्तअपवाद) { रद्दमिला=सत्य; }
        रोक.निरस्तकरो();
    }
}

असमकालिक फलन रद्दजाँचो(क्षमता: पूर्णांक) -> शून्य {
    स्थिर धारा: रुकीधारा=नया रुकीधारा(क्षमता);
    स्थिर रोक: निरस्तीकरणस्रोत=नया निरस्तीकरणस्रोत();
    स्थिर सेवा: रद्दचालक=नया रद्दचालक(धारा,रोक);
    स्थिर संबंध: वेबसॉकेटसंबंध=नया वेबसॉकेटसंबंध(धारा);
    प्रतीक्षा संबंध.चलाओ(रिक्त,सेवा,रोक.चिह्नलो());
    यदि (!सेवा.रद्दमिला || धारा.लिखे!=क्षमता || धारा.बंदगिनती!=१) {
        फेंको नया अपवाद("रुकी धारा का प्रेषण रद्द नहीं हुआ।");
    }
}


फलन उन्नयनजाँचो() -> शून्य {
    संसाधन (प्रबंधक: सत्रप्रबंधक=सत्रप्रबंधक.स्थानीय("http://127.0.0.1:8080")) {
        स्थिर प्रवेश: सत्र=प्रबंधक.आरंभ("परीक्षक",नया सूची<पाठ>{"echo"});
        स्थिर मार्ग: वेबसॉकेटमार्ग=नया वेबसॉकेटमार्ग();
        मार्ग.जोड़ो("/echo/:नाम",प्रबंधक,"echo","bhash.echo",नया चालक());
        स्थिर तार: पाठ="GET /echo/test HTTP/1.1\r\nHost: 127.0.0.1:8080\r\nUpgrade: WebSocket\r\nConnection: keep-alive, Upgrade\r\nOrigin: http://127.0.0.1:8080\r\nCookie: bhash-local-session="+प्रवेश.पहचान()+"\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: other, bhash.echo\r\n\r\n";
        स्थिर जोड़: वेबसंबंध=नया वेबसंबंध();
        जोड़.आंतरिकखंडरखो(पाठ्य.यूटीएफ८(तार));
        स्थिर अनुरोध: वेबअनुरोध=जोड़.अनुरोधलो();
        यदि (अनुरोध.संस्करण!="HTTP/1.1") { फेंको नया अपवाद("HTTP संस्करण नहीं मिला।"); }
        संसाधन (चयनित: असमवेबउन्नतचालक=मार्ग.चुनो(अनुरोध)) {
            स्थिर उत्तर: पाठ=पाठ्य.यूटीएफ८पाठ(चयनित.उत्तरलो());
            यदि (!पाठ्य.आरंभ(उत्तर,"HTTP/1.1 101 ") ||
                !पाठ्य.है(उत्तर,"Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n") ||
                !पाठ्य.है(उत्तर,"Sec-WebSocket-Protocol: bhash.echo\r\n")) {
                फेंको नया अपवाद("WebSocket उत्तर असंगत।");
            }
        }
        प्रबंधक.हटाओ(प्रवेश);
        प्रयास {
            मार्ग.चुनो(अनुरोध);
            फेंको नया अपवाद("हटाए गए सत्र का उन्नयन हो गया।");
        } पकड़ो (दोष: वेबत्रुटि) {
            यदि (दोष.स्थिति!=४०१) { फेंको दोष; }
        }
    }
}

असमकालिक फलन मुख्य() -> शून्य {
    उन्नयनजाँचो();
    यदि (वेबसॉकेटकूट.स्वीकृतिलो("dGhlIHNhbXBsZSBub25jZQ==")!="s3pPLMBiTxaQ9kYGzzhZRbK+xOo=") {
        फेंको नया अपवाद("RFC कुंजी असंगत।");
    }
    स्थिर धारा: स्मृतिधारा=नया स्मृतिधारा();
    स्थिर सेवा: चालक=नया चालक();
    स्थिर संबंध: वेबसॉकेटसंबंध=नया वेबसॉकेटसंबंध(धारा);
    प्रतीक्षा संबंध.चलाओ(रिक्त,सेवा,नया निरस्तीकरणचिह्न());
    स्थिर अपेक्षित: सूची<पूर्णांक> = नया सूची<पूर्णांक>{१२९,२,१०४,१०५,१३६,२,३,२३२};
    यदि (!सेवा.समाप्त || धारा.बंदगिनती!=१ || धारा.भेजे.आकार!=अपेक्षित.आकार) { फेंको नया अपवाद("धारा पूरी नहीं हुई।"); }
    मान इ: पूर्णांक=०;
    जबतक (इ<अपेक्षित.आकार) {
        स्थिर पाया: पूर्णांक=धारा.भेजे[इ];
        स्थिर चाहिए: पूर्णांक=अपेक्षित[इ];
        यदि (पाया!=चाहिए) { फेंको नया अपवाद("धारा बाइट असंगत।"); }
        इ=इ+१;
    }
    प्रतीक्षा रद्दजाँचो(०);
    प्रतीक्षा रद्दजाँचो(१);
    लिखो("stream-ok");
}
