आयात मानक.असमएचटीटीपीसर्वर;
आयात मानक.असमवेबअनुप्रयोग;
आयात मानक.कार्य;
आयात मानक.निरस्तीकरणचिह्न;
आयात मानक.सत्र;
आयात मानक.सत्रप्रबंधक;
आयात मानक.वेब;
आयात मानक.वेबअनुरोध;
आयात मानक.वेबउत्तर;
आयात मानक.वेबचालक;
आयात मानक.वेबसॉकेटमार्ग;
आयात मानक.वेबसॉकेटचालक;
आयात मानक.वेबसॉकेटसंदर्भ;
आयात मानक.वेबसॉकेटसंबंध;
आयात मानक.वेबसॉकेटसंदेश;

वर्ग प्रतिध्वनि पालन वेबसॉकेटचालक {
    सार्वजनिक असमकालिक फलन संभालो(संदर्भ: वेबसॉकेटसंदर्भ, संबंध: वेबसॉकेटसंबंध, चिह्न: निरस्तीकरणचिह्न) -> शून्य {
        संदर्भ.अधिकृत();
        जबतक (सत्य) {
            स्थिर संदेश: वेबसॉकेटसंदेश = प्रतीक्षा संबंध.पाओ(चिह्न);
            यदि (संदेश.प्रकार=="बंद") { लौटाओ; }
            यदि (संदेश.प्रकार=="पाठ") { प्रतीक्षा संबंध.पाठभेजो(संदेश.पाठ्यांश,चिह्न); }
            अन्यथा { प्रतीक्षा संबंध.बाइटभेजो(संदेश.बाइटें,चिह्न); }
        }
    }
}

वर्ग परीक्षणचालक पालन वेबचालक {
    निजी मान सर्वर: असमएचटीटीपीसर्वर;
    निजी मान प्रबंधक: सत्रप्रबंधक;
    निजी मान प्रवेश: सत्र;
    निर्माता(सर्वर: असमएचटीटीपीसर्वर, प्रबंधक: सत्रप्रबंधक, प्रवेश: सत्र) {
        यह.सर्वर=सर्वर; यह.प्रबंधक=प्रबंधक; यह.प्रवेश=प्रवेश;
    }
    सार्वजनिक फलन संभालो(अनुरोध: वेबअनुरोध) -> वेबउत्तर {
        यदि (अनुरोध.पथ=="/revoke") { प्रबंधक.हटाओ(प्रवेश); }
        यदि (अनुरोध.पथ=="/stop") { सर्वर.रोको(); }
        लौटाओ वेब.पाठउत्तर(२००,"तैयार");
    }
}

असमकालिक फलन मुख्य() -> शून्य {
    संसाधन (सर्वर: असमएचटीटीपीसर्वर=नया असमएचटीटीपीसर्वर("127.0.0.1",०)) {
        संसाधन (प्रबंधक: सत्रप्रबंधक=सत्रप्रबंधक.स्थानीय("http://127.0.0.1:"+वेब.अंक(सर्वर.पोर्ट()))) {
            स्थिर प्रवेश: सत्र=प्रबंधक.आरंभ("परीक्षक",नया सूची<पाठ>{"echo"});
            स्थिर मार्ग: असमवेबअनुप्रयोग=नया असमवेबअनुप्रयोग();
            स्थिर सामान्य: परीक्षणचालक=नया परीक्षणचालक(सर्वर,प्रबंधक,प्रवेश);
            मार्ग.समजोड़ो("GET","/health",सामान्य);
            मार्ग.समजोड़ो("POST","/revoke",सामान्य);
            मार्ग.समजोड़ो("POST","/stop",सामान्य);
            स्थिर उन्नयन: वेबसॉकेटमार्ग=नया वेबसॉकेटमार्ग();
            उन्नयन.जोड़ो("/echo/:नाम",प्रबंधक,"echo","bhash.echo",नया प्रतिध्वनि());
            // This loopback fixture exposes its test session only to the harness.
            लिखो("PORT",सर्वर.पोर्ट()); लिखो("SESSION",प्रवेश.पहचान());
            प्रतीक्षा सर्वर.उन्नयनचलाओ(मार्ग,उन्नयन);
        }
    }
}
