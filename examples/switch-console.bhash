कार्य वर्णन(संख्या: पूर्णांक) -> पाठ {
    चयन (संख्या) {
        विकल्प ०: लौटाओ "शून्य";
        विकल्प १:
        विकल्प २: लौटाओ "एक या दो";
        शेष: लौटाओ "अन्य संख्या";
    }
}
कार्य मुख्य() -> शून्य {
    लिखो("एक पूर्णांक लिखें:");
    स्थिर संख्या: पूर्णांक = पढ़ो();
    लिखो(वर्णन(संख्या));
    चयन (वर्णन(संख्या)) {
        विकल्प "शून्य": लिखो("० मिला"); विराम;
        विकल्प "एक या दो": लिखो("१ या २ मिला");
        शेष: लिखो("दूसरा मान मिला");
    }
}
