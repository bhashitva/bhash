आयात मानक.एसक्यूलाइट; आयात मानक.डेटाबेस; आयात मानक.कथन; आयात मानक.परीक्षण;
कार्य मुख्य() -> शून्य {
    संसाधन (ड: डेटाबेस = एसक्यूलाइट.खोलो(":memory:")) {
        संसाधन (क: कथन = ड.तैयार("SELECT ?")) {
            क.पाठरखो(१,"' OR 1=1 --"); परीक्षण.सत्यहै(क.अगला(),"एक पंक्ति मिले।");
            परीक्षण.बराबर("' OR 1=1 --",क.पाठलो(०));
        }
    }
}
