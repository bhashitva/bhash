आयात मानक.असमडेटा;
आयात मानक.असमडेटासंबंध;
आयात मानक.असमडेटाकथन;
आयात मानक.असमडेटालेनदेन;
आयात मानक.डेटा;
आयात मानक.डेटासंबंध;
आयात मानक.माइग्रेशन;
आयात मानक.माइग्रेशनयोजना;
आयात मानक.पोस्टग्रेसविन्यास;
आयात मानक.निरस्तीकरणचिह्न;
आयात मानक.सत्रप्रबंधक;
आयात मानक.वेब;
आयात मानक.वेबअनुरोध;
आयात मानक.वेबत्रुटि;
आयात मानक.विन्यास;

वर्ग पटभंडार {
    निजी मान पथ: पाठ;
    निजी मान पोस्टग्रेस: पोस्टग्रेसविन्यास;
    निर्माता(प्रदाता: पाठ, पथ: पाठ) {
        यह.पथ=पथ;
        यदि (प्रदाता=="postgresql") {
            पोस्टग्रेस=नया पोस्टग्रेसविन्यास();
            पोस्टग्रेस.मेज़बान=विन्यास.परिवेश("BHASH_PG_HOST","localhost");
            पोस्टग्रेस.पोर्ट=वेब.संख्या(विन्यास.परिवेश("BHASH_PG_PORT","5432"),६५५३५);
            पोस्टग्रेस.डेटाबेस=विन्यास.परिवेश("BHASH_PG_DATABASE","bhash_tasks");
            पोस्टग्रेस.उपयोगकर्ता=विन्यास.परिवेश("BHASH_PG_USER","bhash");
            पोस्टग्रेस.गुप्तशब्द=विन्यास.परिवेश("BHASH_PG_PASSWORD","");
            पोस्टग्रेस.सुरक्षा=विन्यास.परिवेश("BHASH_PG_SSLMODE","verify-full");
            पोस्टग्रेस.प्रमाणपत्र=विन्यास.परिवेश("BHASH_PG_CA","");
        } अन्यथा यदि (प्रदाता!="sqlite") { फेंको नया अपवाद("प्रदाता sqlite या postgresql चुनें।"); }
    }
    सार्वजनिक फलन आरंभकरो() -> शून्य {
        मान डाटा: डेटासंबंध=रिक्त;
        यदि (पोस्टग्रेस==रिक्त) { डाटा=डेटा.एसक्यूलाइट(पथ); }
        अन्यथा { डाटा=डेटा.पोस्टग्रेस(पोस्टग्रेस); }
        संसाधन (संबंध: डेटासंबंध=डाटा) {
            स्थिर योजना: माइग्रेशनयोजना=नया माइग्रेशनयोजना(नया सूची<माइग्रेशन>{
                नया माइग्रेशन(१,"कार्यपट और कार्य",नया सूची<पाठ>{
                    "CREATE TABLE live_boards (board TEXT PRIMARY KEY NOT NULL, revision INTEGER NOT NULL)",
                    "CREATE TABLE live_tasks (board TEXT NOT NULL REFERENCES live_boards(board), id INTEGER NOT NULL, title TEXT NOT NULL, done BOOLEAN NOT NULL, PRIMARY KEY(board,id))",
                    "INSERT INTO live_boards(board,revision) VALUES ('team',0),('studio',0)"
                })
            });
            योजना.लागूकरो(संबंध);
        }
    }
    निजी असमकालिक फलन खोलो(चिह्न: निरस्तीकरणचिह्न) -> असमडेटासंबंध {
        यदि (पोस्टग्रेस==रिक्त) { लौटाओ प्रतीक्षा असमडेटा.एसक्यूलाइट(पथ,चिह्न); }
        लौटाओ प्रतीक्षा असमडेटा.पोस्टग्रेस(पोस्टग्रेस,चिह्न);
    }
    सार्वजनिक असमकालिक फलन प्रतिलो(पट: पाठ, चिह्न: निरस्तीकरणचिह्न) -> मानचित्र<पाठ,सर्ववस्तु> {
        स्थिर फल: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
        स्थिर कार्यसूची: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>();
        फल["board"]=पट; फल["tasks"]=कार्यसूची;
        असमकालिक संसाधन (डाटा: असमडेटासंबंध=प्रतीक्षा यह.खोलो(चिह्न)) {
            // One statement observes the revision and rows in the same database snapshot.
            असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार("SELECT b.revision,t.id,t.title,t.done FROM live_boards b LEFT JOIN live_tasks t ON b.board=t.board WHERE b.board=? ORDER BY t.id LIMIT 100",चिह्न)) {
                क.पाठरखो(१,पट);
                यदि (!(प्रतीक्षा क.अगला(चिह्न))) { फेंको नया वेबत्रुटि(४०४,"कार्यपट नहीं मिला।"); }
                फल["revision"]=क.पूर्णांकलो(०);
                यदि (!क.रिक्तहै(१)) {
                    जबतक (सत्य) {
                        स्थिर पंक्ति: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
                        पंक्ति["id"]=क.पूर्णांकलो(१); पंक्ति["title"]=क.पाठलो(२);
                        पंक्ति["done"]=क.तार्किकलो(३);
                        कार्यसूची.जोड़ो(पंक्ति);
                        यदि (!(प्रतीक्षा क.अगला(चिह्न))) { विराम; }
                    }
                }
            }
        }
        लौटाओ फल;
    }
    सार्वजनिक असमकालिक फलन बदलो(पट: पाठ, पहचान: पूर्णांक, शीर्षक: पाठ, पूरा: तार्किक, म: सत्रप्रबंधक, अ: वेबअनुरोध, घटनाएँ: पटघटनाएँ, चिह्न: निरस्तीकरणचिह्न) -> पूर्णांक {
        मान संस्करण: पूर्णांक=०;
        असमकालिक संसाधन (डाटा: असमडेटासंबंध=प्रतीक्षा यह.खोलो(चिह्न)) {
            असमकालिक संसाधन (लेन: असमडेटालेनदेन=प्रतीक्षा डाटा.लेनदेन(चिह्न)) {
                // Taking the board write lock first serializes revisions and mutations for this board.
                असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार("UPDATE live_boards SET revision=revision+1 WHERE board=? AND revision<2147483647",चिह्न)) {
                    क.पाठरखो(१,पट);
                    यदि ((प्रतीक्षा क.चलाओ(चिह्न))!=१) { फेंको नया वेबत्रुटि(४०९,"कार्यपट संस्करण सीमा।"); }
                }
                असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार("SELECT revision FROM live_boards WHERE board=?",चिह्न)) {
                    क.पाठरखो(१,पट);
                    यदि (!(प्रतीक्षा क.अगला(चिह्न))) { फेंको नया वेबत्रुटि(४०४,"कार्यपट नहीं मिला।"); }
                    संस्करण=क.पूर्णांकलो(०);
                }
                यदि (पहचान==०) {
                    असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार("INSERT INTO live_tasks(board,id,title,done) SELECT ?,?,?,FALSE WHERE (SELECT COUNT(*) FROM live_tasks WHERE board=?)<100",चिह्न)) {
                        क.पाठरखो(१,पट); क.पूर्णांकरखो(२,संस्करण); क.पाठरखो(३,शीर्षक); क.पाठरखो(४,पट);
                        यदि ((प्रतीक्षा क.चलाओ(चिह्न))!=१) { फेंको नया वेबत्रुटि(४०९,"कार्यपट में १०० कार्य हो चुके हैं।"); }
                    }
                } अन्यथा {
                    असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार("UPDATE live_tasks SET done=? WHERE board=? AND id=?",चिह्न)) {
                        क.तार्किकरखो(१,पूरा); क.पाठरखो(२,पट); क.पूर्णांकरखो(३,पहचान);
                        यदि ((प्रतीक्षा क.चलाओ(चिह्न))!=१) { फेंको नया वेबत्रुटि(४०४,"कार्य नहीं मिला।"); }
                    }
                }
                स्थिर उपयोगकर्ता: पाठ=म.अधिकृत(अ,"member").उपयोगकर्ता();
                यदि (पटमान(उपयोगकर्ता)!=पट) { फेंको नया वेबत्रुटि(४०३,"यह कार्यपट उपलब्ध नहीं है।"); }
                प्रतीक्षा लेन.सहेजो(चिह्न);
                घटनाएँ.सूचितकरो(पट,संस्करण);
            }
        }
        लौटाओ संस्करण;
    }
}
