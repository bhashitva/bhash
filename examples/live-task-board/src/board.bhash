आयात मानक.असमवेबचालक;
आयात मानक.वेब;
आयात मानक.वेबचालक;
आयात मानक.वेबअनुरोध;
आयात मानक.वेबउत्तर;
आयात मानक.वेबत्रुटि;
आयात मानक.सत्र;
आयात मानक.सत्रप्रबंधक;
आयात मानक.प्रवेशरक्षक;
आयात मानक.कूटशब्द;
आयात मानक.पाठ्य;
आयात मानक.कार्य;
आयात मानक.निरस्तीकरणचिह्न;
आयात मानक.वेबसॉकेटचालक;
आयात मानक.वेबसॉकेटसंदर्भ;
आयात मानक.वेबसॉकेटसंबंध;

फलन पटमान(उपयोगकर्ता: पाठ) -> पाठ {
    यदि (उपयोगकर्ता=="alice" || उपयोगकर्ता=="bob") { लौटाओ "team"; }
    यदि (उपयोगकर्ता=="charlie") { लौटाओ "studio"; }
    लौटाओ "";
}

फलन वस्तुलो(अनुरोध: वेबअनुरोध) -> मानचित्र<पाठ,सर्ववस्तु> {
    स्थिर मूल: सर्ववस्तु=अनुरोध.जेसनलो();
    यदि (!प्रकारहै<मानचित्र<पाठ,सर्ववस्तु>>(मूल)) { फेंको नया वेबत्रुटि(४२२,"JSON वस्तु चाहिए।"); }
    लौटाओ परिवर्तित<मानचित्र<पाठ,सर्ववस्तु>>(मूल);
}

फलन पाठलो(मूल: मानचित्र<पाठ,सर्ववस्तु>, नाम: पाठ, सीमा: पूर्णांक) -> पाठ {
    यदि (!मूल.है(नाम) || !प्रकारहै<पाठ>(मूल[नाम])) { फेंको नया वेबत्रुटि(४२२,"पाठ क्षेत्र चाहिए।"); }
    स्थिर मानक: पाठ=परिवर्तित<पाठ>(मूल[नाम]);
    यदि (मानक=="" || पाठ्य.यूटीएफ८(मानक).आकार>सीमा) { फेंको नया वेबत्रुटि(४२२,"पाठ सीमा से बाहर है।"); }
    लौटाओ मानक;
}

वर्ग पटप्रवेश पालन वेबचालक {
    निजी मान म: सत्रप्रबंधक;
    निजी मान खाते: मानचित्र<पाठ,पाठ>;
    निजी मान रक्षक: प्रवेशरक्षक;
    निर्माता(म: सत्रप्रबंधक, खाते: मानचित्र<पाठ,पाठ>, रक्षक: प्रवेशरक्षक) {
        यह.म=म; यह.खाते=खाते; यह.रक्षक=रक्षक;
    }
    निजी फलन उत्तर(स: सत्र) -> वेबउत्तर {
        स्थिर व: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
        व["user"]=स.उपयोगकर्ता(); व["csrf"]=स.सीएसआरएफ(); व["board"]=पटमान(स.उपयोगकर्ता());
        स्थिर उ: वेबउत्तर=वेब.जेसन(२००,व);
        म.कुकीरखो(उ,स); लौटाओ उ;
    }
    सार्वजनिक फलन संभालो(अ: वेबअनुरोध) -> वेबउत्तर {
        यदि (अ.पथ=="/session") {
            मान स: सत्र=म.पाओ(अ);
            यदि (स==रिक्त) { स=म.आरंभ("",नया सूची<पाठ>()); }
            लौटाओ यह.उत्तर(स);
        }
        यदि (अ.पथ=="/logout") {
            स्थिर उ: वेबउत्तर=वेब.पाठउत्तर(२०४,""); म.समाप्त(अ,उ); लौटाओ उ;
        }
        स्थिर मूल: मानचित्र<पाठ,सर्ववस्तु> = वस्तुलो(अ);
        स्थिर नाम: पाठ=पाठलो(मूल,"username",२५६);
        स्थिर पास: पाठ=पाठलो(मूल,"password",१०२४);
        रक्षक.प्रयासकरो(नाम);
        // Unknown accounts perform the same password verification work.
        मान हैश: पाठ="$bhash$pbkdf2-sha256$600000$000102030405060708090a0b0c0d0e0f$3bc37118e625093e9b79ed08930ea7af7389591233fdd92dddf369371e60dbc0";
        स्थिर मिला: तार्किक=खाते.है(नाम);
        यदि (मिला) { हैश=खाते[नाम]; }
        यदि (!कूटशब्द.जाँचो(पास,हैश) || !मिला) { लौटाओ वेब.त्रुटि(४०१); }
        स्थिर पुराना: सत्र=म.पाओ(अ);
        लौटाओ यह.उत्तर(म.बदलो(पुराना,नाम,नया सूची<पाठ>{"member"}));
    }
}

// Each board keeps a single high-water mark. A subscriber owns its own send.
वर्ग पटघटनाएँ {
    निजी मान नवीनतम: मानचित्र<पाठ,पूर्णांक>;
    निर्माता() { नवीनतम=नया मानचित्र<पाठ,पूर्णांक>(); }
    सार्वजनिक फलन पाओ(पट: पाठ) -> पूर्णांक {
        यदि (!नवीनतम.है(पट)) { लौटाओ ०; }
        लौटाओ नवीनतम[पट];
    }
    सार्वजनिक फलन सूचितकरो(पट: पाठ, संस्करण: पूर्णांक) -> शून्य {
        यदि (संस्करण>यह.पाओ(पट)) { नवीनतम[पट]=संस्करण; }
    }
}

वर्ग पटसॉकेट पालन वेबसॉकेटचालक {
    निजी मान घटनाएँ: पटघटनाएँ;
    निर्माता(घटनाएँ: पटघटनाएँ) { यह.घटनाएँ=घटनाएँ; }
    सार्वजनिक असमकालिक फलन संभालो(संदर्भ: वेबसॉकेटसंदर्भ, संबंध: वेबसॉकेटसंबंध, चिह्न: निरस्तीकरणचिह्न) -> शून्य {
        स्थिर पट: पाठ=संदर्भ.पथमान["board"];
        यदि (पटमान(संदर्भ.अधिकृत().उपयोगकर्ता())!=पट) {
            प्रतीक्षा संबंध.बंदकरो(१००८,""); लौटाओ;
        }
        मान भेजा: पूर्णांक=घटनाएँ.पाओ(पट);
        // The client refreshes after this ready message, closing the subscribe/snapshot race.
        प्रतीक्षा संबंध.पाठभेजो("{\"v\":1,\"type\":\"ready\"}",चिह्न);
        जबतक (सत्य) {
            स्थिर संस्करण: पूर्णांक=घटनाएँ.पाओ(पट);
            यदि (संस्करण>भेजा) {
                यदि (पटमान(संदर्भ.अधिकृत().उपयोगकर्ता())!=पट) {
                    प्रतीक्षा संबंध.बंदकरो(१००८,""); लौटाओ;
                }
                // Board IDs come from the fixed membership table above.
                प्रतीक्षा संबंध.पाठभेजो("{\"v\":1,\"type\":\"changed\",\"board\":\""+पट+"\",\"revision\":"+वेब.अंक(संस्करण)+"}",चिह्न);
                भेजा=संस्करण;
            }
            प्रतीक्षा कार्य.विलंब(५०,चिह्न);
        }
    }
}

वर्ग पटचालक पालन असमवेबचालक {
    निजी मान म: सत्रप्रबंधक;
    निजी मान भंडार: पटभंडार;
    निजी मान घटनाएँ: पटघटनाएँ;
    निर्माता(म: सत्रप्रबंधक, भंडार: पटभंडार, घटनाएँ: पटघटनाएँ) {
        यह.म=म; यह.भंडार=भंडार; यह.घटनाएँ=घटनाएँ;
    }
    सार्वजनिक असमकालिक फलन संभालो(अ: वेबअनुरोध, चिह्न: निरस्तीकरणचिह्न) -> वेबउत्तर {
        स्थिर प्रवेश: सत्र=म.अधिकृत(अ,"member");
        स्थिर पट: पाठ=अ.पथमान["board"];
        यदि (पटमान(प्रवेश.उपयोगकर्ता())!=पट) { फेंको नया वेबत्रुटि(४०३,"यह कार्यपट उपलब्ध नहीं है।"); }
        यदि (अ.विधि=="GET" || अ.विधि=="HEAD") {
            स्थिर प्रति: मानचित्र<पाठ,सर्ववस्तु> = प्रतीक्षा भंडार.प्रतिलो(पट,चिह्न);
            म.अधिकृत(अ,"member");
            लौटाओ वेब.जेसन(२००,प्रति);
        }
        स्थिर मूल: मानचित्र<पाठ,सर्ववस्तु> = वस्तुलो(अ);
        मान पहचान: पूर्णांक=०;
        मान शीर्षक: पाठ="";
        मान पूरा: तार्किक=असत्य;
        यदि (अ.विधि=="POST") {
            शीर्षक=पाठ्य.छाँटो(पाठलो(मूल,"title",४००));
            यदि (शीर्षक=="") { फेंको नया वेबत्रुटि(४२२,"शीर्षक चाहिए।"); }
        } अन्यथा {
            पहचान=वेब.संख्या(अ.पथमान["id"],२१४७४८३६४७);
            यदि (पहचान==० || !मूल.है("done") || !प्रकारहै<तार्किक>(मूल["done"])) {
                फेंको नया वेबत्रुटि(४२२,"कार्य पहचान और done चाहिए।");
            }
            पूरा=परिवर्तित<तार्किक>(मूल["done"]);
        }
        स्थिर संस्करण: पूर्णांक=प्रतीक्षा भंडार.बदलो(पट,पहचान,शीर्षक,पूरा,म,अ,घटनाएँ,चिह्न);
        स्थिर फल: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
        फल["revision"]=संस्करण;
        यदि (अ.विधि=="POST") { लौटाओ वेब.जेसन(२०१,फल); }
        लौटाओ वेब.जेसन(२००,फल);
    }
}
