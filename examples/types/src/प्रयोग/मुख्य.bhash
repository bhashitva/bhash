संकुल प्रयोग;
आयात आंकड़े.स्थिति उपनाम अवस्था;
आयात आंकड़े.संदेश;
आयात आंकड़े.निकालो;
कार्य मुख्य() -> शून्य {
    स्थिर ब: बाइटबफ़र = नया बाइटबफ़र(१६);
    ब.पूर्णांकलिखो(०,४२,सत्य);
    ब.दशमलवलिखो(८,१.५,असत्य);
    लिखो("बाइनरी:", ब.पूर्णांकपढ़ो(०,सत्य), ब.दशमलवपढ़ो(८,असत्य));
    स्थिर पाठ्य: पाठ = "नमस्ते 😀";
    लिखो("UTF-8:", यूटीएफ८पाठ(यूटीएफ८बफ़र(पाठ्य)));
    स्थिर ल: लघुपूर्णांक = परिवर्तित<लघुपूर्णांक>(२५५);
    स्थिर छोटा: बाइट = परिवर्तित<बाइट>(परिवर्तित<पूर्णांक>(ल));
    लिखो("परिवर्तन:", छोटा, परिवर्तित<पूर्णांक>(-३.९));
    स्थिर क: संदेश<पाठ> = नया संदेश<पाठ>(१,अवस्था.तैयार,"ठीक");
    लिखो("अभिलेख:", क.क्रम, क.अवस्था.नाम, क.सामग्री, क == नया संदेश<पाठ>(१,अवस्था.तैयार,"ठीक"));
    स्थिर मूल: सर्ववस्तु = क;
    लिखो("प्रकार:", प्रकारहै<संदेश<पाठ>>(मूल), प्रकारहै<संदेश<पूर्णांक>>(मूल));
    लिखो("निकाला:", निकालो<संदेश<पाठ>>(मूल).सामग्री);
    चयन (क.अवस्था) { विकल्प अवस्था.तैयार: लिखो("तैयार मिला"); शेष: लिखो("अन्य"); }
    प्रयास { लिखो(परिवर्तित<बाइट>(२५६)); } पकड़ो (गलती: अपवाद) { लिखो("सीमा सुरक्षित"); }
}
