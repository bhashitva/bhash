आयात मानक.पाठ्य;
आयात मानक.गणित;
आयात मानक.यादृच्छिक;
आयात मानक.जेसन;
आयात मानक.समय;
आयात मानक.फ़ाइल;

कार्य मुख्य() -> शून्य {
    स्थिर शब्द: सूची<पाठ> = पाठ्य.बाँटो("नमस्ते,भारत,", ",");
    लिखो(शब्द.आकार, पाठ्य.जोड़ो(शब्द, " | "));
    लिखो(पाठ्य.खोजो("a😀भारत", "भारत"), पाठ्य.बदलो("भाष अच्छी है", "अच्छी", "सरल"));
    लिखो(पाठ्य.संख्यापाठ(२.६२५, २));
    लिखो(गणित.वर्गमूल(८१.०) == ९.०, गणित.निरपेक्ष(-४२));
    यादृच्छिक.बीज(४२);
    लिखो(यादृच्छिक.पूर्णांकचुनो(१, ७));
    स्थिर मूल: सर्ववस्तु = जेसन.पढ़ो("{\"नाम\":\"भारत\",\"अंक\":[1,2,3]}");
    स्थिर मानक: मानचित्र<पाठ,सर्ववस्तु> = परिवर्तित<मानचित्र<पाठ,सर्ववस्तु>>(मूल);
    स्थिर अंक: सूची<सर्ववस्तु> = परिवर्तित<सूची<सर्ववस्तु>>(मानक["अंक"]);
    लिखो(परिवर्तित<पाठ>(मानक["नाम"]), अंक.आकार, जेसन.पाठबनाओ(मूल));
    लिखो(समय.पाठबनाओ(०), समय.पढ़ो("1970-01-01T00:00:00.000Z"));
    यदि (!फ़ाइल.समर्थित()) { लिखो("ब्राउज़र में फ़ाइल तंत्र उपलब्ध नहीं है।"); }
}
