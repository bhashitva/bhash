आयात मानक.फ़ाइल;
कार्य मुख्य() -> शून्य {
    यदि (!फ़ाइल.समर्थित()) {
        लिखो("यह उदाहरण JVM या CLR पर चलाएँ।");
        लौटाओ;
    }
    लिखो("पढ़ने के लिए UTF-8 फ़ाइल का पथ दें:");
    स्थिर पथ: पाठ = पाठपढ़ो();
    प्रयास {
        लिखो(फ़ाइल.पाठपढ़ो(पथ));
    } पकड़ो (गलती: अपवाद) {
        लिखो(गलती.संदेश);
    }
}
