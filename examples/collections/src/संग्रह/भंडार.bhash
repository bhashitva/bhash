संकुल संग्रह;

सार्वजनिक अनुबंध प्रदाता<त> {
    कार्य सभी() -> सूची<त>;
}

सार्वजनिक वर्ग भंडार<त> पालन प्रदाता<त> {
    निजी मान डाटा: सूची<त>;
    निर्माता() { डाटा = नया सूची<त>(); }
    कार्य जोड़ो(मानक: त) -> शून्य { डाटा.जोड़ो(मानक); }
    कार्य सभी() -> सूची<त> { लौटाओ डाटा; }
}
