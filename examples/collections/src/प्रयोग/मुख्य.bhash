संकुल प्रयोग;
आयात संग्रह.योग;
आयात संग्रह.भंडार;
आयात संग्रह.प्रदाता;

कार्य मुख्य() -> शून्य {
    स्थिर अंक: पूर्णांक[] = नया पूर्णांक[]{१,२,३};
    अंक[१] = ५;
    लिखो("सरणी:", अंक.लंबाई, योग(अंक));

    स्थिर जाल: पूर्णांक[][] = नया पूर्णांक[२][३];
    जाल[१][२] = ७;
    लिखो("जाल:", जाल[०][२], जाल[१][२]);

    स्थिर डिब्बा: भंडार<पूर्णांक> = नया भंडार<पूर्णांक>();
    प्रत्येक (अ: पूर्णांक में अंक) { डिब्बा.जोड़ो(अ); }
    डिब्बा.जोड़ो(९);
    स्थिर स्रोत: प्रदाता<पूर्णांक> = डिब्बा;
    स्थिर चालें: सूची<पूर्णांक> = स्रोत.सभी();
    चालें.डालो(१,४);
    लिखो("हटाया:", चालें.हटाओ(०));
    लिखो("सूची:", चालें[०], चालें[१], चालें[२], चालें[३]);

    स्थिर तालिका: मानचित्र<पाठ, सूची<पूर्णांक>> = नया मानचित्र<पाठ, सूची<पूर्णांक>>{"चालें":चालें};
    तालिका["दूसरा"] = नया सूची<पूर्णांक>{८};
    प्रत्येक (कुंजी: पाठ, मानक: सूची<पूर्णांक> में तालिका) { लिखो(कुंजी, लंबाई(मानक)); }
    लिखो("वैकल्पिक:", तालिका.लो("अनजान", नया सूची<पूर्णांक>()).आकार());
    लिखो("समान संदर्भ:", तालिका["चालें"] == चालें);
}
