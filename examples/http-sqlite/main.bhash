आयात मानक.एचटीटीपी;
आयात मानक.एचटीटीपीअनुरोध;
आयात मानक.जेसन;
आयात मानक.विन्यास;
आयात मानक.एसक्यूलाइट;
आयात मानक.डेटाबेस;
आयात मानक.कथन;
आयात मानक.लेनदेन;

कार्य लाओ(पता: पाठ) -> सूची<सर्ववस्तु> {
    स्थिर अनुरोध: एचटीटीपीअनुरोध = नया एचटीटीपीअनुरोध("GET", पता);
    अनुरोध.समयसीमा = ५०००;
    स्थिर उत्तर: मानक.एचटीटीपीउत्तर = एचटीटीपी.भेजो(अनुरोध);
    यदि (उत्तर.स्थिति() != २००) { फेंको नया अपवाद("HTTP स्थिति २०० नहीं मिली।"); }
    स्थिर मूल: सर्ववस्तु = जेसन.पढ़ो(उत्तर.पाठ्यांश());
    यदि (!प्रकारहै<सूची<सर्ववस्तु>>(मूल)) { फेंको नया अपवाद("JSON में लेखों की सूची आवश्यक है।"); }
    लौटाओ परिवर्तित<सूची<सर्ववस्तु>>(मूल);
}

कार्य सहेजो(ड: डेटाबेस, लेख: सूची<सर्ववस्तु>) -> शून्य {
    // पुराना संग्रह और पूरा नया संग्रह एक ही लेनदेन में बदलते हैं।
    संसाधन (ल: लेनदेन = ड.लेनदेन()) {
        संसाधन (मिटाओ: कथन = ड.तैयार("DELETE FROM cached_posts")) { मिटाओ.चलाओ(); }
        संसाधन (जोड़ो: कथन = ड.तैयार("INSERT INTO cached_posts(id, title) VALUES (?, ?)")) {
            प्रत्येक (मूल: सर्ववस्तु में लेख) {
                यदि (!प्रकारहै<मानचित्र<पाठ,सर्ववस्तु>>(मूल)) { फेंको नया अपवाद("हर लेख JSON वस्तु होना चाहिए।"); }
                स्थिर पंक्ति: मानचित्र<पाठ,सर्ववस्तु> = परिवर्तित<मानचित्र<पाठ,सर्ववस्तु>>(मूल);
                यदि (!पंक्ति.है("id") || !पंक्ति.है("title")) { फेंको नया अपवाद("हर लेख में id और title आवश्यक हैं।"); }
                यदि (!प्रकारहै<पाठ>(पंक्ति["id"]) || !प्रकारहै<पाठ>(पंक्ति["title"])) {
                    फेंको नया अपवाद("id और title दोनों पाठ होने चाहिए।");
                }
                जोड़ो.पाठरखो(१, परिवर्तित<पाठ>(पंक्ति["id"]));
                जोड़ो.पाठरखो(२, परिवर्तित<पाठ>(पंक्ति["title"]));
                जोड़ो.चलाओ();
                जोड़ो.रीसेट();
                जोड़ो.बंधनमिटाओ();
            }
        }
        ल.सहेजो();
    }
}

कार्य दिखाओ(ड: डेटाबेस) -> शून्य {
    मान गिनती: पूर्णांक = ०;
    संसाधन (क: कथन = ड.तैयार("SELECT id, title FROM cached_posts ORDER BY id")) {
        जबतक (क.अगला()) {
            लिखो(क.पाठलो(०), "|", क.पाठलो(१));
            गिनती = गिनती + १;
        }
    }
    लिखो("कुल पंक्तियाँ:", गिनती);
}

कार्य मुख्य() -> शून्य {
    स्थिर तर्क: मानक.विन्यास = विन्यास.तर्क();
    स्थिर पता: पाठ = तर्क.पढ़ो("url", "http://127.0.0.1:8080/posts.json");
    स्थिर फ़ाइल: पाठ = तर्क.पढ़ो("db", "article-cache.db");
    संसाधन (ड: डेटाबेस = एसक्यूलाइट.खोलो(फ़ाइल)) {
        संसाधन (क: कथन = ड.तैयार("CREATE TABLE IF NOT EXISTS cached_posts(id TEXT PRIMARY KEY NOT NULL, title TEXT NOT NULL)")) { क.चलाओ(); }
        यदि (तर्क.पढ़ो("offline", "false") != "true") {
            प्रयास {
                // नेटवर्क और JSON parsing लेनदेन शुरू करने से पहले पूरे होते हैं।
                स्थिर लेख: सूची<सर्ववस्तु> = लाओ(पता);
                सहेजो(ड, लेख);
                लिखो("सहेजी गई पंक्तियाँ:", लेख.आकार);
            } पकड़ो (ग: अपवाद) {
                // rollback के बाद, उसी खुले connection से पिछला संग्रह पढ़ें।
                लिखो("पिछला संग्रह:");
                दिखाओ(ड);
                फेंको ग;
            }
        }
        दिखाओ(ड);
    }
}
