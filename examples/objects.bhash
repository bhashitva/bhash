वर्ग खाता {
    निजी मान स्वामी: पाठ;
    संरक्षित मान बाकी: पूर्णांक;

    निर्माता(स्वामी: पाठ, प्रारंभ: पूर्णांक) {
        यह.स्वामी = स्वामी;
        यह.बाकी = प्रारंभ;
    }

    सार्वजनिक कार्य नाम() -> पाठ { लौटाओ यह.स्वामी; }
    सार्वजनिक कार्य शेषराशि() -> पूर्णांक { लौटाओ यह.बाकी; }
    सार्वजनिक कार्य जमा(राशि: पूर्णांक) -> शून्य {
        यह.बाकी = यह.बाकी + राशि;
    }
    सार्वजनिक कार्य बोनस() -> पूर्णांक { लौटाओ ०; }
}

वर्ग बचतखाता विस्तार खाता {
    निजी स्थिर दर: पूर्णांक = १०;

    निर्माता(स्वामी: पाठ) : आधार(स्वामी, १००) {}

    सार्वजनिक अधिलेखन कार्य बोनस() -> पूर्णांक {
        लौटाओ यह.बाकी / यह.दर;
    }

    सार्वजनिक कार्य कुल() -> पूर्णांक {
        लौटाओ आधार.शेषराशि() + यह.बोनस();
    }
}

कार्य मुख्य() -> शून्य {
    स्थिर बचत: बचतखाता = नया बचतखाता("मनोज");
    स्थिर सामान्य: खाता = बचत;
    सामान्य.जमा(५०);
    लिखो(सामान्य.नाम(), सामान्य.शेषराशि(), सामान्य.बोनस(), बचत.कुल());
}
