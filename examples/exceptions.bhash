वर्ग अमान्यअंक विस्तार अपवाद {
    सार्वजनिक निर्माता(संदेश: पाठ) : आधार(संदेश) {}
}
कार्य गुणनखंड(अंक: पूर्णांक) -> पूर्णांक {
    यदि (अंक < ० || अंक > २०) {
        फेंको नया अमान्यअंक("० से २० के बीच पूर्णांक लिखें।");
    }
    मान फल: पूर्णांक = १;
    मान शेषांक: पूर्णांक = अंक;
    जबतक (शेषांक > १) { फल = फल * शेषांक; शेषांक = शेषांक - १; }
    लौटाओ फल;
}
कार्य मुख्य() -> शून्य {
    प्रयास {
        लिखो(गुणनखंड(पढ़ो()));
    } पकड़ो (गलती: अमान्यअंक) {
        लिखो("अमान्य अंक:", गलती.संदेश);
    } पकड़ो (गलती: अपवाद) {
        लिखो("इनपुट त्रुटि:", गलती.संदेश);
    } अंततः {
        लिखो("कार्य समाप्त।");
    }
}
