आयात मानक.वेब; आयात मानक.वेबअनुरोध; आयात मानक.वेबउत्तर;
आयात मानक.वेबचालक; आयात मानक.वेबअनुप्रयोग; आयात मानक.परीक्षण; आयात मानक.पाठ्य;
वर्ग अभिवादन पालन वेबचालक {
    सार्वजनिक फलन संभालो(अ: वेबअनुरोध) -> वेबउत्तर { लौटाओ वेब.पाठउत्तर(२००,"नमस्ते "+अ.पथमान["name"]); }
}
फलन मुख्य() -> शून्य {
    स्थिर अ: वेबअनुप्रयोग = नया वेबअनुप्रयोग(); अ.जोड़ो("GET","/hello/:name",नया अभिवादन());
    स्थिर अनुरोध: वेबअनुरोध = नया वेबअनुरोध("GET","/hello/%E0%A4%AD%E0%A4%BE%E0%A4%B0%E0%A4%A4",नया सूची<पाठ>(),नया बाइटबफ़र(०));
    स्थिर उत्तर: वेबउत्तर = अ.संभालो(अनुरोध);
    परीक्षण.बराबर(२००,उत्तर.स्थिति); परीक्षण.बराबर("नमस्ते भारत",पाठ्य.यूटीएफ८पाठ(उत्तर.सामग्री));
    अनुरोध.विधि = "POST"; परीक्षण.बराबर(४०५,अ.संभालो(अनुरोध).स्थिति);
}
