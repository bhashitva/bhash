# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Bhash task board
After=network.target
[Service]
Type=simple
DynamicUser=yes
StateDirectory=bhash-tasks
WorkingDirectory=/opt/bhash-tasks
ExecStart=/opt/bhash-tasks/web-tasks --host=127.0.0.1 --port=8080 --db=/var/lib/bhash-tasks/tasks.db --page=/opt/bhash-tasks/index.html
Restart=on-failure
KillSignal=SIGTERM
TimeoutStopSec=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
[Install]
WantedBy=multi-user.target
