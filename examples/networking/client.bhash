आयात मानक.एचटीटीपी;
आयात मानक.विन्यास;
फलन मुख्य() -> शून्य {
    स्थिर पता: पाठ = विन्यास.तर्क().पढ़ो("url","https://example.com/");
    प्रयास {
        स्थिर उत्तर: मानक.एचटीटीपीउत्तर = एचटीटीपी.पाओ(पता);
        लिखो("स्थिति:",उत्तर.स्थिति()); लिखो("अंतिम पता:",उत्तर.अंतिमपता());
        लिखो("सामग्री बाइट:",उत्तर.सामग्री().आकार);
        प्रत्येक (उत्तर.शीर्षमान("Content-Type") में मानक: पाठ) { लिखो("Content-Type:",मानक); }
    } पकड़ो (ग: अपवाद) { लिखो("अनुरोध असफल:",ग.संदेश); }
}
