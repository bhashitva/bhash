अनुबंध नामित {
    फलन नाम() -> पाठ;
}

वर्ग व्यक्ति पालन नामित {
    निजी स्थिर नामपाठ: पाठ;
    निर्माता(नाम: पाठ) { यह.नामपाठ = नाम; }
    फलन नाम() -> पाठ { लौटाओ नामपाठ; }
    फलन पहचान<त>(मूल्य: त) -> त { लौटाओ मूल्य; }
}

फलन नामलो<त: नामित>(वस्तु: त) -> पाठ {
    लौटाओ वस्तु.नाम();
}

फलन मुख्य() -> शून्य {
    स्थिर छात्र = नया व्यक्ति("सीमा");
    स्थिर नाम = नामलो(छात्र);
    मान गिनती = छात्र.पहचान(१);
    गिनती = गिनती + १;
    लिखो(नाम, गिनती);
    लिखो(छात्र.पहचान<पाठ>("नमस्ते, भारत!"));
}
