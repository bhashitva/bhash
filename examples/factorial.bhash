कार्य गुणनफल(संख्या: पूर्णांक) -> पूर्णांक {
    यदि (संख्या <= १) {
        लौटाओ १;
    }
    लौटाओ संख्या * गुणनफल(संख्या - १);
}

कार्य मुख्य() -> शून्य {
    स्थिर सीमा: पूर्णांक = ५;
    मान गिनती: पूर्णांक = १;
    जबतक (गिनती <= सीमा) {
        लिखो(गिनती, गुणनफल(गिनती));
        गिनती = गिनती + १;
    }
}
