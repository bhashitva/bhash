आयात मानक.संग्रह;
आयात मानक.पूर्णांकक्रम;
आयात मानक.चयनक;
आयात मानक.रूपांतरक;
आयात मानक.रूपांतरण;
आयात मानक.समूहन;
आयात मानक.संचायक;
आयात मानक.परीक्षण;
वर्ग सम पालन चयनक<पूर्णांक> {
    सार्वजनिक कार्य चुनो(अ: पूर्णांक) -> तार्किक { लौटाओ अ % २ == ०; }
}
वर्ग दुगुना पालन रूपांतरक<पूर्णांक, पूर्णांक> {
    सार्वजनिक कार्य बदलो(अ: पूर्णांक) -> पूर्णांक { लौटाओ अ * २; }
}
वर्ग योग पालन संचायक<पूर्णांक, पूर्णांक> {
    सार्वजनिक कार्य जोड़ो(संचय: पूर्णांक, अ: पूर्णांक) -> पूर्णांक { लौटाओ संचय + अ; }
}
अभिलेख पंक्ति(कुंजी: पूर्णांक, क्रम: पूर्णांक, नाम: पाठ);
वर्ग पंक्तिक्रम पालन मानक.तुलनाकार<पंक्ति> {
    सार्वजनिक कार्य तुलना(क: पंक्ति, ख: पंक्ति) -> पूर्णांक {
        यदि (क.कुंजी < ख.कुंजी) { लौटाओ -१; } यदि (क.कुंजी > ख.कुंजी) { लौटाओ १; } लौटाओ ०;
    }
}
वर्ग पात्र {
    सार्वजनिक मान अंक: पूर्णांक;
    सार्वजनिक निर्माता(अ: पूर्णांक) { यह.अंक = अ; }
}
वर्ग पात्रबनाओ पालन रूपांतरक<पूर्णांक, पात्र> {
    सार्वजनिक कार्य बदलो(अ: पूर्णांक) -> पात्र { लौटाओ नया पात्र(अ); }
}
कार्य मुख्य() -> शून्य {
    स्थिर मूल: सूची<पूर्णांक> = नया सूची<पूर्णांक>{३,१,२,१};
    स्थिर क्रम: सूची<पूर्णांक> = संग्रह<पूर्णांक>.क्रमित(मूल, नया पूर्णांकक्रम());
    परीक्षण.बराबर(१, क्रम[०]); परीक्षण.बराबर(३, क्रम[३]); परीक्षण.बराबर(३, मूल[०]);
    परीक्षण.बराबर(१, संग्रह<पूर्णांक>.उलटो(मूल)[०]);
    परीक्षण.बराबर(४, संग्रह<पूर्णांक>.प्रतिलिपि(मूल).आकार);
    स्थिर नियम: सम = नया सम();
    परीक्षण.बराबर(२, संग्रह<पूर्णांक>.खोजो(मूल, नियम));
    परीक्षण.बराबर(२, संग्रह<पूर्णांक>.छाँटो(मूल, नियम)[०]);
    परीक्षण.सत्यहै(संग्रह<पूर्णांक>.कोई(मूल, नियम), "सम मान होना चाहिए।");
    परीक्षण.बराबर(असत्य, संग्रह<पूर्णांक>.सभी(मूल, नियम));
    परीक्षण.बराबर(६, रूपांतरण<पूर्णांक, पूर्णांक>.बदलो(मूल, नया दुगुना())[०]);
    परीक्षण.बराबर(१, संग्रह<पूर्णांक>.गिनो(मूल, नियम));
    परीक्षण.बराबर(०, संग्रह<पूर्णांक>.द्विआधारीखोज(क्रम,१,नया पूर्णांकक्रम()));
    परीक्षण.बराबर(-१, संग्रह<पूर्णांक>.द्विआधारीखोज(क्रम,९,नया पूर्णांकक्रम()));
    परीक्षण.बराबर(७, रूपांतरण<पूर्णांक, पूर्णांक>.संचित(मूल,०,नया योग()));
    परीक्षण.बराबर(२, समूहन<पूर्णांक, पूर्णांक>.समूहित(मूल,नया दुगुना())[२].आकार);
    स्थिर खाली: सूची<पूर्णांक> = नया सूची<पूर्णांक>();
    परीक्षण.बराबर(०, संग्रह<पूर्णांक>.क्रमित(खाली, नया पूर्णांकक्रम()).आकार);
    परीक्षण.बराबर(सत्य, संग्रह<पूर्णांक>.सभी(खाली,नियम));
    परीक्षण.बराबर(असत्य, संग्रह<पूर्णांक>.कोई(खाली,नियम));
    स्थिर पंक्तियाँ: सूची<पंक्ति> = नया सूची<पंक्ति>{नया पंक्ति(१,०,"अ"+"ब"), नया पंक्ति(०,१,"भारत😀"), नया पंक्ति(१,२,"ख"+"ग")};
    स्थिर स्थिरक्रम: सूची<पंक्ति> = संग्रह<पंक्ति>.क्रमित(पंक्तियाँ,नया पंक्तिक्रम());
    परीक्षण.बराबर(१,स्थिरक्रम[०].क्रम); परीक्षण.बराबर(०,स्थिरक्रम[१].क्रम); परीक्षण.बराबर(२,स्थिरक्रम[२].क्रम);
    परीक्षण.बराबर("अब",स्थिरक्रम[१].नाम);
    परीक्षण.बराबर(३,रूपांतरण<पूर्णांक,पात्र>.बदलो(मूल,नया पात्रबनाओ())[०].अंक);
}
