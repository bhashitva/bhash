आयात मानक.बंदनीय;
आयात मानक.परीक्षण;
वर्ग गिनती पालन बंदनीय {
    सार्वजनिक मान बंद: पूर्णांक = ०;
    सार्वजनिक मान विफल: तार्किक = असत्य;
    सार्वजनिक कार्य बंदकरो() -> शून्य { बंद = बंद + १; यदि (विफल) { फेंको नया अपवाद("सफाई त्रुटि"); } }
}
कार्य लौटना(ग: गिनती) -> पूर्णांक { संसाधन (स: गिनती = ग) { लौटाओ ७; } }
कार्य मुख्य() -> शून्य {
    स्थिर ग: गिनती = नया गिनती();
    परीक्षण.बराबर(७, लौटना(ग)); परीक्षण.बराबर(१, ग.बंद);
    प्रयास { संसाधन (स: गिनती = ग) { फेंको नया अपवाद("मूल त्रुटि"); } }
    पकड़ो (त: अपवाद) { परीक्षण.बराबर("मूल त्रुटि", त.संदेश); }
    परीक्षण.बराबर(२, ग.बंद);
    मान क: पूर्णांक = ०;
    जबतक (क < ३) { क = क + १; संसाधन (स: गिनती = ग) { यदि (क == १) { जारी; } विराम; } }
    परीक्षण.बराबर(४, ग.बंद);
    स्थिर अंदर: गिनती = नया गिनती(); अंदर.विफल = सत्य;
    प्रयास {
        संसाधन (बाहर: गिनती = ग) {
            संसाधन (स: गिनती = अंदर) { फेंको नया अपवाद("मुख्य त्रुटि"); }
        }
    } पकड़ो (त: अपवाद) { परीक्षण.बराबर("सफाई त्रुटि",त.संदेश); }
    परीक्षण.बराबर(५, ग.बंद); परीक्षण.बराबर(१, अंदर.बंद);
    मान शरीर: तार्किक = असत्य;
    प्रयास { संसाधन (स: गिनती = रिक्त) { शरीर = सत्य; } }
    पकड़ो (त: अपवाद) { परीक्षण.बराबर(असत्य,शरीर); }
    परीक्षण.बराबर(असत्य,शरीर);
}
