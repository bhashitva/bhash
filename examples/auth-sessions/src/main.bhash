आयात मानक.वेब; आयात मानक.वेबचालक; आयात मानक.वेबअनुरोध; आयात मानक.वेबउत्तर; आयात मानक.वेबत्रुटि;
आयात मानक.वेबअनुप्रयोग; आयात मानक.एचटीटीपीसर्वर; आयात मानक.सुरक्षितवेब; आयात मानक.अधिकृतचालक;
आयात मानक.सत्र; आयात मानक.सत्रप्रबंधक; आयात मानक.कूटशब्द; आयात मानक.प्रवेशरक्षक;
आयात मानक.एसक्यूलाइट; आयात मानक.डेटाबेस; आयात मानक.कथन; आयात मानक.लेनदेन;
आयात मानक.पाठ्य; आयात मानक.फ़ाइल; आयात मानक.विन्यास;

फलन एसक्यूएल(ड: डेटाबेस, पाठमान: पाठ) -> शून्य { संसाधन (क: कथन = ड.तैयार(पाठमान)) { क.चलाओ(); } }
फलन पाठक्षेत्र(अ: वेबअनुरोध, नाम: पाठ, सीमा: पूर्णांक) -> पाठ {
    स्थिर मूल: सर्ववस्तु = अ.जेसनलो();
    यदि (!प्रकारहै<मानचित्र<पाठ,सर्ववस्तु>>(मूल)) { फेंको नया वेबत्रुटि(४२२,"JSON वस्तु दें।"); }
    स्थिर म: मानचित्र<पाठ,सर्ववस्तु> = परिवर्तित<मानचित्र<पाठ,सर्ववस्तु>>(मूल);
    यदि (!म.है(नाम) || !प्रकारहै<पाठ>(म[नाम])) { फेंको नया वेबत्रुटि(४२२,"पाठ क्षेत्र आवश्यक है।"); }
    स्थिर व: पाठ = परिवर्तित<पाठ>(म[नाम]);
    यदि (व=="" || पाठ्य.यूटीएफ८(व).आकार>सीमा) { फेंको नया वेबत्रुटि(४२२,"पाठ की लंबाई अमान्य है।"); } लौटाओ व;
}
फलन सत्रउत्तर(म: सत्रप्रबंधक, स: सत्र) -> वेबउत्तर {
    स्थिर व: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
    व["authenticated"] = स.उपयोगकर्ता()!=""; व["user"] = स.उपयोगकर्ता(); व["csrf"] = स.सीएसआरएफ();
    स्थिर उ: वेबउत्तर = वेब.जेसन(२००,व); म.कुकीरखो(उ,स); लौटाओ उ;
}
वर्ग प्रवेशचालक पालन वेबचालक {
    निजी मान ड: डेटाबेस; निजी मान म: सत्रप्रबंधक; निजी मान रक्षक: प्रवेशरक्षक;
    सार्वजनिक निर्माता(ड: डेटाबेस, म: सत्रप्रबंधक, रक्षक: प्रवेशरक्षक) { यह.ड = ड; यह.म = म; यह.रक्षक = रक्षक; }
    सार्वजनिक फलन संभालो(अ: वेबअनुरोध) -> वेबउत्तर {
        यदि (अ.पथ=="/session") {
            मान स: सत्र = म.पाओ(अ); यदि (स==रिक्त) { स = म.आरंभ("",नया सूची<पाठ>()); } लौटाओ सत्रउत्तर(म,स);
        }
        यदि (अ.पथ=="/logout") { स्थिर उ: वेबउत्तर = वेब.पाठउत्तर(२०४,""); म.समाप्त(अ,उ); लौटाओ उ; }
        स्थिर उपयोगकर्ता: पाठ = पाठक्षेत्र(अ,"username",२५६); स्थिर कूट: पाठ = पाठक्षेत्र(अ,"password",१०२४);
        रक्षक.प्रयासकरो(उपयोगकर्ता);
        // A fixed valid dummy hash makes an unknown account perform the same KDF.
        मान हैश: पाठ = "$bhash$pbkdf2-sha256$600000$000102030405060708090a0b0c0d0e0f$3bc37118e625093e9b79ed08930ea7af7389591233fdd92dddf369371e60dbc0";
        मान मिला: तार्किक = असत्य; मान भूमिका: पाठ = "";
        संसाधन (क: कथन = ड.तैयार("SELECT password_hash,role FROM users WHERE username=?")) {
            क.पाठरखो(१,उपयोगकर्ता); यदि (क.अगला()) { मिला = सत्य; हैश = क.पाठलो(०); भूमिका = क.पाठलो(१); }
        }
        स्थिर सही: तार्किक = कूटशब्द.जाँचो(कूट,हैश);
        यदि (!मिला || !सही) { लौटाओ वेब.त्रुटि(४०१); }
        स्थिर पुराना: सत्र = म.पाओ(अ); यदि (पुराना==रिक्त) { फेंको नया वेबत्रुटि(४०३,"प्रवेश सत्र समाप्त है।"); }
        स्थिर नवीन: सत्र = म.बदलो(पुराना,उपयोगकर्ता,नया सूची<पाठ>{भूमिका}); लौटाओ सत्रउत्तर(म,नवीन);
    }
}
वर्ग टिप्पणीचालक पालन वेबचालक {
    निजी मान ड: डेटाबेस; निजी मान म: सत्रप्रबंधक;
    सार्वजनिक निर्माता(ड: डेटाबेस, म: सत्रप्रबंधक) { यह.ड = ड; यह.म = म; }
    सार्वजनिक फलन संभालो(अ: वेबअनुरोध) -> वेबउत्तर {
        स्थिर स: सत्र = म.अधिकृत(अ,"");
        यदि (अ.विधि=="POST") {
            स्थिर पाठमान: पाठ = पाठक्षेत्र(अ,"text",२०००);
            संसाधन (ल: लेनदेन = ड.लेनदेन()) {
                संसाधन (क: कथन = ड.तैयार("INSERT INTO notes(owner,text) VALUES (?,?)")) { क.पाठरखो(१,स.उपयोगकर्ता()); क.पाठरखो(२,पाठमान); क.चलाओ(); } ल.सहेजो();
            } लौटाओ वेब.पाठउत्तर(२०१,"सहेजा गया।");
        }
        स्थिर फल: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>();
        // Owner is taken from the validated session, never from JSON or a URL.
        संसाधन (क: कथन = ड.तैयार("SELECT text FROM notes WHERE owner=? ORDER BY id LIMIT 100")) { क.पाठरखो(१,स.उपयोगकर्ता()); जबतक (क.अगला()) { फल.जोड़ो(क.पाठलो(०)); } }
        लौटाओ वेब.जेसन(२००,फल);
    }
}
वर्ग व्यवस्थापकचालक पालन वेबचालक {
    निजी मान ड: डेटाबेस;
    सार्वजनिक निर्माता(ड: डेटाबेस) { यह.ड = ड; }
    सार्वजनिक फलन संभालो(अ: वेबअनुरोध) -> वेबउत्तर {
        स्थिर फल: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>();
        संसाधन (क: कथन = ड.तैयार("SELECT username FROM users ORDER BY username LIMIT 100")) { जबतक (क.अगला()) { फल.जोड़ो(क.पाठलो(०)); } } लौटाओ वेब.जेसन(२००,फल);
    }
}
वर्ग स्थिरपृष्ठ पालन वेबचालक {
    निजी मान सामग्री: पाठ; निजी मान प्रकार: पाठ;
    सार्वजनिक निर्माता(सामग्री: पाठ, प्रकार: पाठ) { यह.सामग्री = सामग्री; यह.प्रकार = प्रकार; }
    सार्वजनिक फलन संभालो(अ: वेबअनुरोध) -> वेबउत्तर { स्थिर उ: वेबउत्तर = वेब.पाठउत्तर(२००,सामग्री); उ.शीर्षरखो("Content-Type",प्रकार); लौटाओ उ; }
}
वर्ग पृष्ठसुरक्षा पालन वेबचालक {
    निजी मान चालक: वेबचालक;
    सार्वजनिक निर्माता(चालक: वेबचालक) { यह.चालक = चालक; }
    सार्वजनिक फलन संभालो(अ: वेबअनुरोध) -> वेबउत्तर {
        स्थिर उ: वेबउत्तर = चालक.संभालो(अ);
        उ.शीर्षरखो("Content-Security-Policy","default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'"); लौटाओ उ;
    }
}
फलन मुख्य() -> शून्य {
    स्थिर त: विन्यास = विन्यास.तर्क();
    संसाधन (ड: डेटाबेस = एसक्यूलाइट.खोलो(त.पढ़ो("db","accounts.db"))) {
        एसक्यूएल(ड,"CREATE TABLE IF NOT EXISTS users(username TEXT PRIMARY KEY NOT NULL,password_hash TEXT NOT NULL,role TEXT NOT NULL CHECK(role IN ('reader','admin')))");
        एसक्यूएल(ड,"CREATE TABLE IF NOT EXISTS notes(id INTEGER PRIMARY KEY,owner TEXT NOT NULL,text TEXT NOT NULL)");
        स्थिर नाम: पाठ = त.पढ़ो("init-user","");
        यदि (नाम!="") {
            स्थिर कूट: पाठ = विन्यास.परिवेश("BHASH_INITIAL_PASSWORD",""); स्थिर भूमिका: पाठ = त.पढ़ो("role","reader");
            यदि (पाठ्य.यूटीएफ८(नाम).आकार>२५६ || पाठ्य.लंबाई(कूट)<१२ || !(भूमिका=="reader" || भूमिका=="admin")) { फेंको नया अपवाद("खाता, भूमिका या कूटशब्द अमान्य है; BHASH_INITIAL_PASSWORD में कम से कम १२ अक्षर दें।"); }
            स्थिर हैश: पाठ = कूटशब्द.हैशबनाओ(कूट);
            संसाधन (ल: लेनदेन = ड.लेनदेन()) { संसाधन (क: कथन = ड.तैयार("INSERT INTO users(username,password_hash,role) VALUES (?,?,?)")) { क.पाठरखो(१,नाम); क.पाठरखो(२,हैश); क.पाठरखो(३,भूमिका); क.चलाओ(); } ल.सहेजो(); }
            लिखो("खाता बनाया गया।"); लौटाओ;
        }
        स्थिर स्थानीय: तार्किक = त.पढ़ो("local","false")=="true"; स्थिर होस्ट: पाठ = त.पढ़ो("host","127.0.0.1");
        यदि (स्थानीय && होस्ट!="127.0.0.1") { फेंको नया अपवाद("स्थानीय HTTP केवल 127.0.0.1 पर सुनें।"); }
        संसाधन (सर्वर: एचटीटीपीसर्वर = नया एचटीटीपीसर्वर(होस्ट,वेब.संख्या(त.पढ़ो("port","8080"),६५५३५))) {
            मान म: सत्रप्रबंधक = रिक्त;
            यदि (स्थानीय) { म = सत्रप्रबंधक.स्थानीय("http://127.0.0.1:"+वेब.अंक(सर्वर.पोर्ट())); }
            अन्यथा { म = नया सत्रप्रबंधक(त.पढ़ो("origin","https://localhost")); }
            संसाधन (सत्रमान: सत्रप्रबंधक = म) { संसाधन (रक्षक: प्रवेशरक्षक = नया प्रवेशरक्षक()) {
                स्थिर अ: वेबअनुप्रयोग = नया वेबअनुप्रयोग(); स्थिर प्रवेश: प्रवेशचालक = नया प्रवेशचालक(ड,म,रक्षक);
                अ.जोड़ो("GET","/",नया स्थिरपृष्ठ(फ़ाइल.पाठपढ़ो(त.पढ़ो("page","index.html")),"text/html; charset=utf-8"));
                अ.जोड़ो("GET","/app.js",नया स्थिरपृष्ठ(फ़ाइल.पाठपढ़ो(त.पढ़ो("script","app.js")),"text/javascript; charset=utf-8"));
                अ.जोड़ो("GET","/style.css",नया स्थिरपृष्ठ(फ़ाइल.पाठपढ़ो(त.पढ़ो("style","style.css")),"text/css; charset=utf-8"));
                अ.जोड़ो("GET","/session",प्रवेश); अ.जोड़ो("POST","/login",प्रवेश); अ.जोड़ो("POST","/logout",प्रवेश);
                स्थिर टिप्पणी: अधिकृतचालक = नया अधिकृतचालक(म,"",नया टिप्पणीचालक(ड,म));
                अ.जोड़ो("GET","/api/notes",टिप्पणी); अ.जोड़ो("POST","/api/notes",टिप्पणी);
                अ.जोड़ो("GET","/api/admin/users",नया अधिकृतचालक(म,"admin",नया व्यवस्थापकचालक(ड)));
                स्थिर चालक: पृष्ठसुरक्षा = नया पृष्ठसुरक्षा(नया सुरक्षितवेब(म,अ));
                लिखो("READY "+वेब.अंक(सर्वर.पोर्ट())); स्थिर सीमा: पूर्णांक = वेब.संख्या(त.पढ़ो("requests","0"),१००००);
                यदि (सीमा==०) { सर्वर.चलाओ(चालक); }
                अन्यथा { मान क: पूर्णांक = ०; जबतक (क<सीमा && !सर्वर.रुकाहै()) { यदि (सर्वर.अगला(चालक)) { क = क+१; } } }
            } }
        }
    }
}
