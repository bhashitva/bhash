आयात मानक.सत्रप्रबंधक; आयात मानक.सत्र; आयात मानक.सुरक्षितवेब; आयात मानक.अधिकृतचालक;
आयात मानक.वेब; आयात मानक.वेबअनुरोध; आयात मानक.वेबउत्तर; आयात मानक.वेबचालक; आयात मानक.परीक्षण;
वर्ग निजीचालक पालन वेबचालक {
    सार्वजनिक मान गिनती: पूर्णांक = ०;
    सार्वजनिक कार्य संभालो(अ: वेबअनुरोध) -> वेबउत्तर { गिनती = गिनती+१; लौटाओ वेब.पाठउत्तर(२००,"निजी"); }
}
कार्य मुख्य() -> शून्य {
    संसाधन (म: सत्रप्रबंधक = नया सत्रप्रबंधक("https://app.example")) {
        स्थिर स: सत्र = म.आरंभ("पाठक",नया सूची<पाठ>{"reader"}); स्थिर च: निजीचालक = नया निजीचालक();
        स्थिर चालक: सुरक्षितवेब = नया सुरक्षितवेब(म,नया अधिकृतचालक(म,"reader",च));
        स्थिर अ: वेबअनुरोध = नया वेबअनुरोध("POST","/",नया सूची<पाठ>{"host","app.example","origin","https://app.example","cookie","__Host-bhash-session="+स.पहचान()},नया बाइटबफ़र(०));
        परीक्षण.बराबर(४०३,चालक.संभालो(अ).स्थिति); परीक्षण.बराबर(०,च.गिनती);
        अ.शीर्ष.जोड़ो("x-csrf-token"); अ.शीर्ष.जोड़ो(स.सीएसआरएफ()); परीक्षण.बराबर(२००,चालक.संभालो(अ).स्थिति); परीक्षण.बराबर(१,च.गिनती);
        म.हटाओ(स); परीक्षण.बराबर(४०३,चालक.संभालो(अ).स्थिति); परीक्षण.बराबर(१,च.गिनती);
    }
}
