// दशमलव (Binary64), स्वरूपण (Formatting), सर्ववस्तु (Boxing), संग्रह (Collections).
आयात मानक.पाठ्य;
वर्ग माप {
    सार्वजनिक मान लंबाई: दशमलव;
    निर्माता(क: दशमलव) { यह.लंबाई = क; }
    सार्वजनिक कार्य क्षेत्र(चौड़ाई: दशमलव) -> दशमलव { लौटाओ यह.लंबाई * चौड़ाई; }
}
कार्य सुरक्षितवापसी(क: दशमलव) -> दशमलव {
    प्रयास { लौटाओ क; }
    अंततः { स्थिर स: पाठ = पाठ्य.दोहराओ("क्षणिक", १०); }
}
कार्य मुख्य() -> शून्य {
    स्थिर क: माप = नया माप(५.७);
    लिखो(पाठ्य.संख्यापाठ(क.क्षेत्र(४.२), २));
    स्थिर अंक: मानचित्र<दशमलव, पाठ> = नया मानचित्र<दशमलव, पाठ>{};
    अंक.रखो(-०.०, "शून्य"); अंक.रखो(०.०, "एक ही कुंजी");
    स्थिर मानक: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>();
    मान न: पूर्णांक = ०;
    जबतक (न < १०००) {
        स्थिर द: दशमलव = परिवर्तित<दशमलव>(न) / ८.०;
        मानक.जोड़ो(सुरक्षितवापसी(द));
        स्थिर पाठ्यअंक: पाठ = पाठ्य.संख्यापाठ(द, ३);
        यदि (परिवर्तित<दशमलव>(पाठ्यअंक) != द) { त्रुटि("परिवर्तन"); }
        न = न + १;
    }
    लिखो(मानक.आकार(), परिवर्तित<दशमलव>(मानक[९९९]), अंक.आकार(), अंक.लो(०.०));
    प्रयास { लिखो(परिवर्तित<पूर्णांक>(१.० / ०.०)); }
    पकड़ो (ग: अपवाद) { लिखो(ग.संदेश); }
    लिखो(सुरक्षितवापसी(-०.०), ०.० / ०.०, १.० / ०.०);
}
