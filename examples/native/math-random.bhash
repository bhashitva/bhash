// गणित (Math), बीज (Seed), पुनरुत्पादन (Reproducible sampling).
आयात मानक.गणित उपनाम ग;
आयात मानक.यादृच्छिक उपनाम य;
आयात मानक.पाठ्य उपनाम प;
कार्य मुख्य() -> शून्य {
    लिखो(ग.निरपेक्ष(-४२), ग.न्यूनतम(८, ३), ग.अधिकतम(८, ३));
    लिखो(ग.वर्गमूल(८१.०), ग.घात(२.०, १०.०), ग.फर्श(-२.२५), ग.छत(-२.२५));
    लिखो(ग.निकटतम(२.५), ग.निकटतम(३.५), ग.निरपेक्ष(-०.०));
    लिखो(प.संख्यापाठ(ग.ज्या(ग.पाई() / २.०), ६), प.संख्यापाठ(ग.कोज्या(ग.पाई()), ६));
    लिखो(प.संख्यापाठ(ग.लघुगणक(२.०), ६), प.संख्यापाठ(ग.घातांक(१.०), ६));
    य.बीज(४२);
    स्थिर स: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>();
    मान न: पूर्णांक = ०; मान योग: पूर्णांक = ०;
    जबतक (न < १०००) {
        स्थिर द: दशमलव = ग.निकटतम(य.अंश() * १००.०) / १०.०;
        स.जोड़ो(द); योग = योग + य.पूर्णांकचुनो(-१०००, १००१); न = न + १;
    }
    लिखो(स.आकार(), परिवर्तित<दशमलव>(स[०]), परिवर्तित<दशमलव>(स[९९९]), योग);
    प्रयास { लिखो(ग.वर्गमूल(-१.०)); }
    पकड़ो (क: अपवाद) { लिखो(क.संदेश); }
    अंततः { लिखो("साफ"); }
    य.बीज(४२); लिखो(य.पूर्णांकचुनो(०, १००));
}
