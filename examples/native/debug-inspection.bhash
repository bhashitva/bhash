वर्ग आधारकड़ी { सार्वजनिक मान विरासत: पूर्णांक=९; }
अभिलेख पात्र<त>(व: त, नाम: पाठ);
वर्ग कड़ी विस्तार आधारकड़ी {
    सार्वजनिक मान नाम: पाठ;
    सार्वजनिक मान अगली: कड़ी;
    सार्वजनिक मान अंक: पूर्णांक;
    निर्माता(नाम: पाठ) { यह.नाम=नाम; यह.अंक=४२; }
}
कार्य दुगुना(मूल: पूर्णांक) -> पूर्णांक {
    स्थिर उत्तर: पूर्णांक=मूल*२;
    लिखो(उत्तर); // DEBUG_INNER
    लौटाओ उत्तर;
}
कार्य मुख्य() -> शून्य {
    स्थिर पाठ्य: पाठ="भारत😀"+"\u0000"+"भाष";
    स्थिर वस्तु: कड़ी=नया कड़ी(पाठ्य);
    वस्तु.अगली=वस्तु;
    स्थिर अंक: सूची<पूर्णांक> =नया सूची<पूर्णांक>();
    अंक.जोड़ो(७); अंक.जोड़ो(४२);
    स्थिर शब्द: मानचित्र<पाठ, कड़ी> =नया मानचित्र<पाठ, कड़ी>();
    शब्द["साझा"]=वस्तु;
    स्थिर सरणी: पूर्णांक[]=नया पूर्णांक[२];
    सरणी[०]=९; सरणी[१]=११;
    स्थिर डिब्बा: सर्ववस्तु=४२;
    स्थिर बफ़र: बाइटबफ़र=मानक.पाठ्य.यूटीएफ८("AB");
    स्थिर रिक्तमान: कड़ी=रिक्त;
    स्थिर सच्चा: तार्किक=सत्य;
    स्थिर भिन्न: दशमलव=३.५;
    स्थिर अभिलेखमान: पात्र<पूर्णांक> =नया पात्र<पूर्णांक>(५५,"अभिलेख😀");
    स्थिर फल: पूर्णांक=दुगुना(२१); // DEBUG_BEFORE
    मान गिनती: पूर्णांक=०;
    जबतक (गिनती<३००) {
        स्थिर फेंका: पाठ=मानक.पाठ्य.दोहराओ("दबाव😀",२०);
        गिनती=गिनती+१;
    }
    प्रयास { फेंको नया अपवाद("अस्थायी😀"); }
    पकड़ो (गलती: अपवाद) { मानक.पाठ्य.दोहराओ(गलती.संदेश,२); }
    अंततः { मानक.पाठ्य.दोहराओ("साफ😀",५); }
    लिखो(वस्तु.नाम,अंक[१],शब्द["साझा"].अंक,फल); // DEBUG_AFTER
}
