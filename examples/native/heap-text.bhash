आयात मानक.पाठ्य;

कार्य लपेटो(शब्द: पाठ, गहराई: पूर्णांक) -> पाठ {
    यदि (गहराई == ०) { लौटाओ शब्द; }
    लौटाओ "[" + लपेटो(शब्द + अंकपाठ(गहराई), गहराई - १) + "]";
}
कार्य जोड़(क: पाठ, ख: पाठ) -> पाठ { लौटाओ क + ख; }
कार्य मुख्य() -> शून्य {
    स्थिर सुरक्षित: पाठ = लपेटो("मूल", ३);
    // हर चक्कर में नया पाठ बनता है; पुराने अस्थायी मान स्वतः मुक्त हो सकते हैं।
    मान न: पूर्णांक = ०;
    जबतक (न < २०००) {
        स्थिर क्षणिक: पाठ = जोड़(पाठ्य.बड़ाअक्षर("a" + अंकपाठ(न)), पाठ्य.अंश("😀क" + अंकपाठ(न), ०, २));
        यदि (लंबाई(क्षणिक) < ४) { त्रुटि("पाठ नष्ट हुआ"); }
        न = न + १;
    }
    लिखो(सुरक्षित);
    लिखो(पाठ्य.छाँटो("  नमस्ते, दुनिया!　"));
    लिखो(पाठ्य.बदलो("अ-ब-अ", "अ", "भाष"));
    लिखो(पाठ्य.खोजो("a😀क", "क"), पाठ्य.है("a😀क", "😀"));
    लिखो(पाठ्य.आरंभ("a😀क", "a"), पाठ्य.अंत("a😀क", "क"));
    लिखो(पाठ्य.छोटाअक्षर("ABCÉ"), पाठ्य.दोहराओ("क", ३));
    लिखो(पाठ्य.अंकदेवनागरी("v123"), पूर्णांकपाठ("-४२"));
    // जारी और विराम से बाहर निकलने पर भी स्थानीय पाठ की जड़ें हटती हैं।
    न = ०;
    जबतक (न < ३) {
        { स्थिर बड़ा: पाठ = पाठ्य.दोहराओ("क", ३००००);
          न = न + १;
          यदि (न == १) { जारी; }
          यदि (न == २) { विराम; }
          लिखो(लंबाई(बड़ा)); }
    }
    { स्थिर बड़ा: पाठ = पाठ्य.दोहराओ("ख", ३००००); लिखो(लंबाई(बड़ा)); }
}
