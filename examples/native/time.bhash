// UTC dates, exact millisecond round trips and allocating exception cleanup.
आयात मानक.समय उपनाम स;
कार्य वापस(क्षण: पूर्णांक) -> पाठ {
    प्रयास { लौटाओ स.पाठबनाओ(क्षण); }
    अंततः { स्थिर अन्य: पाठ = स.पाठबनाओ(क्षण+१); }
}
कार्य मुख्य() -> शून्य {
    लिखो(स.पाठबनाओ(-१));
    स्थिर क्षण: पूर्णांक = स.पढ़ो("2000-02-29T12:34:56.789Z");
    लिखो(स.वर्ष(क्षण),स.माह(क्षण),स.दिन(क्षण));
    स्थिर अभीमान: पूर्णांक = स.अभी();
    लिखो(स.पढ़ो(स.पाठबनाओ(अभीमान))==अभीमान);
    मान इ: पूर्णांक = ०;मान योग: पूर्णांक = ०;
    जबतक (इ<१०००) {
        स्थिर त: पूर्णांक = क्षण+इ;
        स्थिर पाठमान: पाठ = वापस(त);
        यदि (स.पढ़ो(पाठमान)!=त) { त्रुटि("समय बदला"); }
        प्रयास { स.पढ़ो("1900-02-29T00:00:00.000Z"); }
        पकड़ो (ग: अपवाद) { योग=योग+१; }
        अंततः { स्थिर अन्य: पाठ = स.पाठबनाओ(त); }
        इ=इ+१;
    }
    लिखो(इ,योग);
    प्रयास { स.पाठबनाओ(२५३४०२३००८०००००); } पकड़ो (ग: अपवाद) { लिखो(ग.संदेश); }
}
