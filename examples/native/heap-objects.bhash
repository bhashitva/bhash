वर्ग कड़ी {
    सार्वजनिक मान नाम: पाठ;
    सार्वजनिक मान अंक: पूर्णांक;
    सार्वजनिक मान अगला: कड़ी;
    सार्वजनिक मान सक्रिय: तार्किक = सत्य;
    निर्माता(नाम: पाठ, अंक: पूर्णांक) {
        यह.नाम = नाम;
        यह.अंक = अंक;
    }
    सार्वजनिक कार्य जोड़(अगला: कड़ी) -> शून्य { यह.अगला = अगला; }
    सार्वजनिक कार्य शीर्षक() -> पाठ { लौटाओ नाम + अंकपाठ(अंक); }
}
कार्य बनाओ(अंक: पूर्णांक) -> कड़ी {
    लौटाओ नया कड़ी("कड़ी" + अंकपाठ(अंक), अंक);
}
कार्य मुख्य() -> शून्य {
    स्थिर मूल: कड़ी = बनाओ(१);
    {
        स्थिर बच्चा: कड़ी = बनाओ(२);
        मूल.जोड़(बच्चा);
        बच्चा.जोड़(मूल);
    }
    लिखो(मूल.अगला.शीर्षक(), मूल.अगला.अगला == मूल, मूल.सक्रिय);
    मान न: पूर्णांक = ०;
    जबतक (न < २०००) {
        स्थिर क: कड़ी = बनाओ(न);
        स्थिर ख: कड़ी = बनाओ(न + १);
        क.जोड़(ख);
        ख.जोड़(क);
        न = न + १;
        यदि (न % २ == ०) { जारी; }
    }
    लिखो(मूल.अगला.नाम, मूल.अंक, मूल.अगला.अगला == मूल);
    मूल.अगला = रिक्त;
    लिखो(मूल.अगला == रिक्त);
}
