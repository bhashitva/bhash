कार्य वर्ग(संख्या: पूर्णांक) -> पूर्णांक {
    लौटाओ संख्या * संख्या;
}
कार्य मुख्य() -> शून्य {
    लिखो("नमस्ते, दुनिया!");
    मान गिनती: पूर्णांक = १;
    जबतक (गिनती <= ३) {
        यदि (गिनती == २) { लिखो("बीच", वर्ग(गिनती)); }
        अन्यथा { लिखो(वर्ग(गिनती)); }
        गिनती = गिनती + १;
    }
}
