वर्ग छोटीकड़ी {
    सार्वजनिक मान अंक: लघुपूर्णांक;
    सार्वजनिक मान अगली: सर्ववस्तु;
    सार्वजनिक मान नाम: पाठ;
}
कार्य सुरक्षित(अ: लघुपूर्णांक) -> सर्ववस्तु {
    प्रयास { लौटाओ अ; }
    अंततः { मानक.पाठ्य.दोहराओ("सफाई",२०); }
}
कार्य मुख्य() -> शून्य {
    स्थिर मानचित्रमान: मानचित्र<लघुपूर्णांक,छोटीकड़ी> = नया मानचित्र<लघुपूर्णांक,छोटीकड़ी>();
    मान न: पूर्णांक = ०;
    जबतक (न < ३००) {
        स्थिर क: छोटीकड़ी = नया छोटीकड़ी(); क.अंक=परिवर्तित<लघुपूर्णांक>(न); क.नाम="क"+अंकपाठ(न); क.अगली=मानचित्रमान;
        मानचित्रमान[परिवर्तित<लघुपूर्णांक>(न-१५०)]=क; न=न+१;
    }
    स्थिर चित्र: सूची<छोटीकड़ी> = मानचित्रमान.मूल्य(); स्थिर कुंजियाँ: सूची<लघुपूर्णांक> = मानचित्रमान.कुंजियाँ();
    लिखो(मानचित्रमान.आकार,चित्र[०].अंक,चित्र[२९९].अंक,कुंजियाँ[०],कुंजियाँ[२९९]);
    मानचित्रमान.साफ़(); न=०; मान योग: पूर्णांक = ०; मान गलत: पूर्णांक = ०;
    जबतक (न < १०००) {
        स्थिर छोटा: लघुपूर्णांक = परिवर्तित<लघुपूर्णांक>(न);
        स्थिर मूल: सर्ववस्तु = सुरक्षित(छोटा);
        स्थिर सरणी: सर्ववस्तु[] = नया सर्ववस्तु[१];
        स्थिर चक्र: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>{मूल,सरणी}; सरणी[०]=चक्र; चक्र.जोड़ो(चक्र);
        यदि (!प्रकारहै<लघुपूर्णांक>(मूल) || !चक्र.है(छोटा)) { त्रुटि("लघुपूर्णांक खो गया"); }
        प्रयास { परिवर्तित<पूर्णांक>(मूल); } पकड़ो (ग: अपवाद) { गलत=गलत+१; }
        अंततः { मानक.पाठ्य.दोहराओ("क",१००); }
        योग=योग+परिवर्तित<लघुपूर्णांक>(मूल); न=न+१;
    }
    लिखो(योग,गलत,चित्र[२९९].नाम);
}
