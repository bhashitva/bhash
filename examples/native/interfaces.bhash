अनुबंध नामी { कार्य नाम() -> पाठ; }
अनुबंध जुड़ा विस्तार नामी {
    कार्य अगला() -> नामी;
    कार्य जोड़ो(साथी: नामी) -> शून्य;
}
वर्ग मूल { सार्वजनिक मान पाठ्य: पाठ; निर्माता(पाठ्य: पाठ){ यह.पाठ्य = पाठ्य; } }
वर्ग कड़ी विस्तार मूल पालन जुड़ा {
    सार्वजनिक मान साथी: नामी;
    सार्वजनिक मान अतिरिक्त: पाठ;
    निर्माता(पाठ्य: पाठ, अतिरिक्त: पाठ) : आधार(पाठ्य){ यह.अतिरिक्त = अतिरिक्त; }
    सार्वजनिक कार्य नाम() -> पाठ { लौटाओ पाठ्य + ":" + अतिरिक्त; }
    सार्वजनिक कार्य अगला() -> नामी { लौटाओ साथी; }
    सार्वजनिक कार्य जोड़ो(साथी: नामी) -> शून्य { यह.साथी = साथी; }
}
वर्ग खास विस्तार कड़ी {
    निर्माता(पाठ्य: पाठ, अतिरिक्त: पाठ) : आधार(पाठ्य, अतिरिक्त) {}
    सार्वजनिक अधिलेखन कार्य नाम() -> पाठ { लौटाओ "[" + आधार.नाम() + "]"; }
}
वर्ग अन्य { सार्वजनिक कार्य नाम() -> पाठ { लौटाओ "संरचनात्मक समानता अनुबंध नहीं है"; } }
कार्य बनाओ(न: पूर्णांक) -> जुड़ा { लौटाओ नया कड़ी("कड़ी" + अंकपाठ(न), "e" + अंकपाठ(न)); }
कार्य मुख्य() -> शून्य {
    स्थिर मूलसंदर्भ: मूल = नया खास("मूल" + "😀", "विशेष" + "!");
    स्थिर क: जुड़ा = परिवर्तित<जुड़ा>(मूलसंदर्भ);
    {
        स्थिर बच्चा: जुड़ा = नया कड़ी("सा" + "थी", "ख" + "!");
        क.जोड़ो(बच्चा);
        बच्चा.जोड़ो(क);
    }
    लिखो(क.नाम(), क.अगला().नाम(), परिवर्तित<जुड़ा>(क.अगला()).अगला() == क);
    लिखो(प्रकारहै<मूल>(क), प्रकारहै<खास>(क), प्रकारहै<नामी>(क), सुरक्षितरूप<अन्य>(क) == रिक्त);
    मान न: पूर्णांक = ०;
    जबतक (न < १२००) {
        स्थिर अ: जुड़ा = बनाओ(न);
        स्थिर ब: जुड़ा = बनाओ(न + १);
        अ.जोड़ो(ब); ब.जोड़ो(अ);
        यदि (!प्रकारहै<कड़ी>(अ)){ त्रुटि("गलत प्रकार"); }
        स्थिर वास्तविक: कड़ी = परिवर्तित<कड़ी>(अ);
        न = न + १;
        यदि (न % २ == ०){ जारी; }
    }
    लिखो(क.नाम(), सुरक्षितरूप<जुड़ा>(क.अगला()).नाम());
}
