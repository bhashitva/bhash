// अपवाद (Exception): real programs keep roots precise through handlers and cleanup.
वर्ग विशेष विस्तार अपवाद {
    सार्वजनिक मान अंक: पूर्णांक;
    निर्माता(न: पूर्णांक) : आधार("दोष"+अंकपाठ(न)) { अंक = न; }
}
कार्य गहराई(न: पूर्णांक, स्तर: पूर्णांक) -> पाठ {
    स्थिर क्षण: सर्ववस्तु[] = नया सर्ववस्तु[]{"क्षण"+अंकपाठ(स्तर),न};
    यदि (स्तर == ०) { फेंको नया विशेष(न); }
    प्रयास { लौटाओ गहराई(न,स्तर-१); }
    अंततः { यदि (लंबाई(क्षण) != २) { त्रुटि("मूल नष्ट"); } }
}
कार्य बचाओ() -> पाठ {
    प्रयास { लौटाओ "बचा"+"😀"; }
    अंततः {
        प्रयास { त्रुटि("क्षणिक"); } पकड़ो (ग: अपवाद) { स्थिर क: पाठ = ग.संदेश+"!"; }
    }
}
कार्य मुख्य() -> शून्य {
    मान न: पूर्णांक = ०; मान योग: पूर्णांक = ०; मान साफ: पूर्णांक = ०;
    जबतक (न < ५००) {
        प्रयास { लिखो(गहराई(न,३)); }
        पकड़ो (ग: विशेष) { योग = योग + ग.अंक; }
        अंततः { साफ = साफ + १; }
        प्रयास {
            स्थिर अमान्य: मानचित्र<सर्ववस्तु,पाठ> = नया मानचित्र<सर्ववस्तु,पाठ>{रिक्त:"अ"+अंकपाठ(न)};
        } पकड़ो (ग: अपवाद) { यदि (लंबाई(ग.संदेश) == ०) { त्रुटि("संदेश"); } }
        न = न + १;
    }
    लिखो(योग,साफ); लिखो(बचाओ());
}
