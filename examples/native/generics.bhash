अभिलेख पात्र<त>(व: त);
वर्ग भंडार<त> {
    सार्वजनिक साझा मान आखिरी: त;
    सार्वजनिक साझा मान गिनती: पूर्णांक=०;
    साझा कार्य रखो(व: त) -> शून्य { आखिरी=व; गिनती=गिनती+१; }
}
कार्य पहचान<त>(व: त) -> त { प्रयास { लौटाओ व; } अंततः { मानक.पाठ्य.दोहराओ("साफ😀",१०); } }
कार्य मुख्य() -> शून्य {
    स्थिर म: मानचित्र<पात्र<पूर्णांक>,पात्र<पाठ>> = नया मानचित्र<पात्र<पूर्णांक>,पात्र<पाठ>>();
    मान न: पूर्णांक=०; मान योग: पूर्णांक=०; मान गलत: पूर्णांक=०;
    जबतक (न<५००) {
        स्थिर क: पात्र<पूर्णांक> =नया पात्र<पूर्णांक>(न);
        स्थिर प: पात्र<पाठ> =पहचान<पात्र<पाठ>>(नया पात्र<पाठ>("क"+परिवर्तित<पाठ>(न)));
        भंडार<पात्र<पाठ>>.रखो(प); भंडार<पात्र<पूर्णांक>>.रखो(क); म[क]=प;
        योग=योग+भंडार<पात्र<पूर्णांक>>.आखिरी.व;
        प्रयास { परिवर्तित<पात्र<पूर्णांक>>(परिवर्तित<सर्ववस्तु>(प)); } पकड़ो (ग: अपवाद) { गलत=गलत+१; }
        अंततः { मानक.पाठ्य.दोहराओ("अंत😀",१०); }
        म.हटाओ(नया पात्र<पूर्णांक>(न)); न=न+१;
    }
    लिखो(भंडार<पात्र<पाठ>>.गिनती,योग,गलत,भंडार<पात्र<पाठ>>.आखिरी==नया पात्र<पाठ>("क499"));
    भंडार<पात्र<पाठ>>.आखिरी=रिक्त; भंडार<पात्र<पूर्णांक>>.आखिरी=रिक्त;
}
