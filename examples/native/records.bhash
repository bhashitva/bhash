अभिलेख बिंदु(अंक: पूर्णांक, नाम: पाठ);
अभिलेख पैकेट(क: बिंदु, व: सर्ववस्तु);
वर्ग भंडार { सार्वजनिक साझा मान आखिरी: पैकेट; }
कार्य बनाओ(न: पूर्णांक) -> पैकेट {
    प्रयास { लौटाओ नया पैकेट(नया बिंदु(न,"क"+परिवर्तित<पाठ>(न)),न); }
    अंततः { मानक.पाठ्य.दोहराओ("साफ😀",१०); }
}
कार्य मुख्य() -> शून्य {
    स्थिर म: मानचित्र<बिंदु,सूची<सर्ववस्तु>> = नया मानचित्र<बिंदु,सूची<सर्ववस्तु>>();
    मान न: पूर्णांक=०; मान योग: पूर्णांक=०; मान गलत: पूर्णांक=०;
    जबतक (न<१०००) {
        स्थिर प: पैकेट=बनाओ(न); भंडार.आखिरी=प;
        स्थिर स: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>{प}; स.जोड़ो(स); म[प.क]=स;
        स्थिर दूसरी: बिंदु=नया बिंदु(न,"क"+परिवर्तित<पाठ>(न)); योग=योग+परिवर्तित<पूर्णांक>(परिवर्तित<पैकेट>(म[दूसरी][०]).व);
        प्रयास { परिवर्तित<बिंदु>(परिवर्तित<सर्ववस्तु>(प)); } पकड़ो (ग: अपवाद) { गलत=गलत+१; }
        अंततः { मानक.पाठ्य.दोहराओ("अंत😀",१०); }
        म.हटाओ(दूसरी); न=न+१;
    }
    लिखो(न,योग,गलत,भंडार.आखिरी==नया पैकेट(नया बिंदु(९९९,"क999"),९९९)); भंडार.आखिरी=रिक्त;
}
