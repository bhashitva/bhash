// Creates/replaces target/native-byte-example/data.bin; create the parent first.
आयात मानक.फ़ाइल उपनाम फ;
आयात मानक.पाठ्य उपनाम प;
कार्य मुख्य() -> शून्य {
    स्थिर पथ: पाठ = "target/native-byte-example/data.bin";
    मान इ: पूर्णांक = ०; मान योग: पूर्णांक = ०;
    जबतक (इ<३००) {
        स्थिर ब: बाइटबफ़र = प.यूटीएफ८("भारत😀");
        स्थिर क: बाइटबफ़र = ब.काटो(०,ब.आकार);
        स्थिर स: बाइट[] = क.सरणी();
        फ.बाइटलिखो(पथ,क);
        स्थिर लौटा: बाइटबफ़र = फ.बाइटपढ़ो(पथ);
        यदि (प.यूटीएफ८पाठ(लौटा)!="भारत😀") { त्रुटि("पाठ बदला"); }
        स्थिर वस्तु: सर्ववस्तु = परिवर्तित<बाइट>(इ%२५६);
        योग=योग+परिवर्तित<बाइट>(वस्तु);
        प्रयास { प.यूटीएफ८पाठ(नया बाइटबफ़र{परिवर्तित<बाइट>(२५५)}); }
        पकड़ो (ग: अपवाद) { यदि (इ==०) { लिखो(ग.संदेश); } }
        अंततः { स्थिर अंत: बाइटबफ़र = प.यूटीएफ८("साफ"); }
        इ=इ+१;
    }
    लिखो(इ,योग);
    स्थिर ब: बाइटबफ़र = नया बाइटबफ़र(८);ब.पूर्णांकलिखो(०,-१,सत्य);
    लिखो(ब[०],ब[७],ब.पूर्णांकपढ़ो(०,सत्य));
}
