परिगणना रंग { लाल, हरा=५, नीला }
वर्ग धारक { सार्वजनिक साझा स्थिर पसंद: रंग=रंग.हरा; }
कार्य लौटाओरंग() -> रंग {
    प्रयास { लौटाओ रंग.हरा; }
    अंततः { मानक.पाठ्य.दोहराओ("साफ😀",१०); }
}
कार्य मुख्य() -> शून्य {
    स्थिर म: मानचित्र<रंग,सूची<सर्ववस्तु>> =नया मानचित्र<रंग,सूची<सर्ववस्तु>>();
    मान न: पूर्णांक=०; मान त्रुटियाँ: पूर्णांक=०;
    जबतक (न<१०००) {
        स्थिर र: रंग=लौटाओरंग();
        स्थिर स: सूची<सर्ववस्तु> =नया सूची<सर्ववस्तु>{र,मानक.पाठ्य.दोहराओ("क😀",१०)};
        स.जोड़ो(स); म[र]=स;
        प्रयास { परिवर्तित<रंग>(३); } पकड़ो (ग: अपवाद) { त्रुटियाँ=त्रुटियाँ+१; }
        अंततः { मानक.पाठ्य.दोहराओ("अंत😀",१०); }
        चयन (र) { विकल्प रंग.लाल: त्रुटि("लाल"); विकल्प रंग.हरा: न=न+१; शेष: त्रुटि("रंग"); }
    }
    लिखो(न,त्रुटियाँ,परिवर्तित<रंग>(म[रंग.हरा][०]).नाम,धारक.पसंद==रंग.हरा);
    म.साफ़();
}
