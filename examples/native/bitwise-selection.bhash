कार्य चुनो(चयनपाठ: पाठ,अंक: पूर्णांक) -> पाठ {
    प्रयास {
        चयन (चयनपाठ) {
            विकल्प "क😀":
                स्थिर रखा: पाठ = चयनपाठ+"!";
                प्रयास {
                    यदि (अंक % ३ == ०) { लौटाओ रखा; }
                    यदि (अंक % ३ == १) { फेंको नया अपवाद(रखा); }
                    विराम;
                } पकड़ो (ग: अपवाद) { लौटाओ ग.संदेश; }
                अंततः { मानक.पाठ्य.दोहराओ("सफाई",२०); }
            शेष: लौटाओ "अन्य";
        }
    } अंततः { मानक.पाठ्य.दोहराओ("बाहरी",४०); }
    लौटाओ "बाद";
}
कार्य अंतिम() -> पाठ {
    प्रयास {
        चयन (मानक.पाठ्य.दोहराओ("मूल😀",१)) { विकल्प "मूल😀": लौटाओ "पहला"; शेष: लौटाओ "अन्य"; }
    } अंततः {
        चयन (सत्य) { विकल्प सत्य: फेंको नया अपवाद(मानक.पाठ्य.दोहराओ("अंतिम😀",१)); }
    }
}
कार्य मुख्य() -> शून्य {
    लिखो(१ << ६३ >>> ६३,-१ >> ६३,-१ >>> ६३,~०);
    मान क: पूर्णांक = ०;मान मिला: पूर्णांक = ०;मान बाद: पूर्णांक = ०;
    जबतक (क < १०००) {
        स्थिर फल: पाठ = चुनो(मानक.पाठ्य.दोहराओ("क😀",१),क);
        चयन (फल) {
            विकल्प "क😀!": मिला=मिला+१;
            विकल्प "बाद": बाद=बाद+१;
            शेष: त्रुटि("चयन परिणाम खो गया");
        }
        क=क+१;
    }
    लिखो(मिला,बाद);
    प्रयास { लिखो(अंतिम()); } पकड़ो (ग: अपवाद) { लिखो(ग.संदेश); }
}
