// सर्ववस्तु (Universal value): scalar boxing, exact unboxing and reference identity.
अनुबंध नामी { कार्य नाम() -> पाठ; }
वर्ग कड़ी पालन नामी {
    सार्वजनिक मान व: सर्ववस्तु;
    सार्वजनिक मान अगली: सर्ववस्तु;
    सार्वजनिक कार्य नाम() -> पाठ { लौटाओ परिवर्तित<पाठ>(व); }
}
कार्य पहचान(व: सर्ववस्तु) -> सर्ववस्तु { लौटाओ व; }
कार्य मुख्य() -> शून्य {
    स्थिर मूल: कड़ी = नया कड़ी(); मूल.व = "मू" + "ल😀";
    स्थिर अनु: नामी = मूल; स्थिर संदर्भ: सर्ववस्तु = अनु;
    मूल.अगली = मूल;
    स्थिर न: सर्ववस्तु = पहचान(४२); स्थिर हाँ: सर्ववस्तु = सत्य;
    लिखो(परिवर्तित<पूर्णांक>(न), परिवर्तित<तार्किक>(हाँ), परिवर्तित<नामी>(संदर्भ).नाम(), संदर्भ == मूल);
    मान गिनती: पूर्णांक = ०; मान आखिरी: सर्ववस्तु = रिक्त;
    जबतक (गिनती < ३०००) {
        स्थिर क्षणिक: कड़ी = नया कड़ी();
        क्षणिक.व = "क्षण" + अंकपाठ(गिनती); क्षणिक.अगली = क्षणिक;
        आखिरी = गिनती;
        स्थिर चिह्न: सर्ववस्तु = गिनती == २९९९;
        यदि (परिवर्तित<तार्किक>(चिह्न)) { मूल.अगली = मूल; }
        गिनती = गिनती + १;
    }
    लिखो(परिवर्तित<कड़ी>(संदर्भ).नाम(), मूल.अगली == संदर्भ, परिवर्तित<पूर्णांक>(आखिरी));
}
