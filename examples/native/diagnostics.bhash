कार्य भाग(न: पूर्णांक) -> पूर्णांक {
    लौटाओ १० / न;
}
अनुबंध गणना { कार्य लो() -> पूर्णांक; }
वर्ग गणक पालन गणना {
    सार्वजनिक कार्य लो() -> पूर्णांक { लौटाओ भाग(०); }
}
कार्य परत<त>(ग: त) -> पूर्णांक {
    प्रयास { लौटाओ ग.लो(); }
    अंततः { लिखो(मानक.पाठ्य.दोहराओ("साफ😀",१)); }
}
कार्य मुख्य() -> शून्य {
    स्थिर ग: गणना=नया गणक();
    लिखो(परत<गणना>(ग));
}
