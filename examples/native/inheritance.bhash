वर्ग मूल {
    सार्वजनिक मान नाम: पाठ;
    सार्वजनिक मान अगला: मूल;
    निर्माता(नाम: पाठ) { यह.नाम = नाम; }
    सार्वजनिक कार्य शीर्षक() -> पाठ { लौटाओ नाम + ":आधार"; }
}
वर्ग उप विस्तार मूल {
    सार्वजनिक मान अतिरिक्त: पाठ;
    निर्माता(नाम: पाठ, अतिरिक्त: पाठ) : आधार(नाम) { यह.अतिरिक्त = अतिरिक्त; }
    सार्वजनिक अधिलेखन कार्य शीर्षक() -> पाठ { लौटाओ आधार.शीर्षक() + ":" + अतिरिक्त; }
}
वर्ग अंतिम विस्तार उप {
    सार्वजनिक मान सहायक: मूल;
    निर्माता(नाम: पाठ, अतिरिक्त: पाठ) : आधार(नाम, अतिरिक्त) {}
    सार्वजनिक कार्य जोड़ो(सहायक: मूल) -> शून्य { यह.सहायक = सहायक; }
}
कार्य बनाओ(न: पूर्णांक) -> मूल { लौटाओ नया उप("कड़ी" + अंकपाठ(न), "e" + अंकपाठ(न)); }
कार्य मुख्य() -> शून्य {
    स्थिर खास: अंतिम = नया अंतिम("मूल" + "😀", "विशेष" + "!");
    स्थिर मूलसंदर्भ: मूल = खास;
    {
        स्थिर बच्चा: मूल = नया उप("सा" + "थी", "ख" + "!");
        खास.जोड़ो(बच्चा);
        मूलसंदर्भ.अगला = बच्चा;
        बच्चा.अगला = मूलसंदर्भ;
    }
    लिखो(मूलसंदर्भ.शीर्षक());
    लिखो(खास.सहायक.शीर्षक(), खास.सहायक == मूलसंदर्भ.अगला);
    मान न: पूर्णांक = ०;
    जबतक (न < १२००) {
        स्थिर क: मूल = बनाओ(न);
        स्थिर ख: मूल = बनाओ(न + १);
        क.अगला = ख;
        ख.अगला = क;
        न = न + १;
        यदि (न % २ == ०) { जारी; }
    }
    लिखो(मूलसंदर्भ.शीर्षक(), खास.सहायक.शीर्षक());
}
