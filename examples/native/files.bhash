// Creates/replaces target/native-file-example/state.json; create its parent first.
आयात मानक.फ़ाइल उपनाम फ;
आयात मानक.जेसन उपनाम ज;
कार्य मुख्य() -> शून्य {
    लिखो(फ.समर्थित());
    स्थिर पथ: पाठ = "target/native-file-example/state.json";
    मान गिनती: पूर्णांक = ०;
    मान योग: पूर्णांक = ०;
    जबतक (गिनती < १००) {
        स्थिर मूल: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>{};
        मूल.रखो("नाम","भारत😀"); मूल.रखो("अंक",गिनती);
        फ.पाठलिखो(पथ,ज.पाठबनाओ(मूल));
        स्थिर पढ़ा: मानचित्र<पाठ,सर्ववस्तु> = परिवर्तित<मानचित्र<पाठ,सर्ववस्तु>>(ज.पढ़ो(फ.पाठपढ़ो(पथ)));
        योग = योग + परिवर्तित<पूर्णांक>(पढ़ा.लो("अंक"));
        गिनती = गिनती + १;
    }
    लिखो(योग,फ.है(पथ));
    प्रयास { फ.पाठपढ़ो(पथ+".missing"); }
    पकड़ो (ग: अपवाद) { लिखो(ग.संदेश); }
    अंततः { फ.पाठलिखो(पथ,"बचा😀"); }
    लिखो(फ.पाठपढ़ो(पथ));
}
