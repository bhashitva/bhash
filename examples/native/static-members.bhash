// Shared references remain alive after their creating function returns or throws.
वर्ग पात्र {
    सार्वजनिक मान नाम: पाठ;
    निर्माता(न: पूर्णांक) { नाम="वस्तु"+परिवर्तित<पाठ>(न); }
}
वर्ग भंडार {
    सार्वजनिक साझा मान नाम: पाठ;
    सार्वजनिक साझा मान वस्तु: पात्र;
    सार्वजनिक साझा मान डब्बा: सर्ववस्तु;
    सार्वजनिक साझा मान सूचीमान: सूची<सर्ववस्तु>;
    सार्वजनिक साझा मान मानचित्रमान: मानचित्र<पाठ,सर्ववस्तु>;
    सार्वजनिक साझा मान सरणीमान: सर्ववस्तु[];
    सार्वजनिक साझा मान बफ़र: बाइटबफ़र;
    सार्वजनिक साझा मान कुल: पूर्णांक;
    सार्वजनिक साझा कार्य रखो(न: पूर्णांक) -> शून्य {
        वस्तु=नया पात्र(न); नाम=मानक.पाठ्य.दोहराओ("😀",१)+परिवर्तित<पाठ>(न); डब्बा=न;
        सूचीमान=नया सूची<सर्ववस्तु>(); सूचीमान.जोड़ो(सूचीमान); सूचीमान.जोड़ो(वस्तु);
        मानचित्रमान=नया मानचित्र<पाठ,सर्ववस्तु>{"वस्तु":वस्तु,"सूची":सूचीमान};
        सरणीमान=नया सर्ववस्तु[]{मानचित्रमान,नाम};
        बफ़र=मानक.पाठ्य.यूटीएफ८(नाम);
        कुल=कुल+१;
        फेंको नया अपवाद("परीक्षण");
    }
    सार्वजनिक साझा कार्य साफ़() -> शून्य {
        नाम=""; वस्तु=रिक्त; डब्बा=रिक्त; सूचीमान=रिक्त; मानचित्रमान=रिक्त; सरणीमान=रिक्त; बफ़र=रिक्त;
    }
}
कार्य मुख्य() -> शून्य {
    मान न: पूर्णांक=०;
    जबतक (न<१०००) {
        प्रयास { भंडार.रखो(न); } पकड़ो (ग: अपवाद) {} अंततः { मानक.पाठ्य.दोहराओ("संग्रह",१०); }
        न=न+१;
    }
    लिखो(भंडार.कुल,परिवर्तित<पूर्णांक>(भंडार.डब्बा),भंडार.वस्तु.नाम,भंडार.नाम);
    यदि (मानक.पाठ्य.यूटीएफ८पाठ(भंडार.बफ़र)!=भंडार.नाम) { त्रुटि("बफ़र बदला"); }
    भंडार.साफ़(); मानक.पाठ्य.दोहराओ("अंत",१); लिखो("रिक्त");
}
