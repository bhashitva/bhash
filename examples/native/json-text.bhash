// संरचित पाठ (Structured text), JSON, precise GC and failed-parse cleanup.
आयात मानक.पाठ्य उपनाम प;
आयात मानक.जेसन उपनाम ज;
कार्य मुख्य() -> शून्य {
    स्थिर भाग: सूची<पाठ> = प.बाँटो("अ,,भारत😀,", ",");
    लिखो(भाग.आकार(), प.जोड़ो(भाग,"|"));
    मान न: पूर्णांक = ०; मान योग: पूर्णांक = ०; मान त्रुटियाँ: पूर्णांक = ०;
    जबतक (न < ३००) {
        स्थिर म: मानचित्र<पाठ,सर्ववस्तु> = परिवर्तित<मानचित्र<पाठ,सर्ववस्तु>>(ज.पढ़ो("{\"नाम\":\"भारत😀\",\"अंक\":[1.25,true,null],\"भीतर\":{\"क\":[1,2]}}"));
        म.रखो("क्रम", न);
        स्थिर फिर: मानचित्र<पाठ,सर्ववस्तु> = परिवर्तित<मानचित्र<पाठ,सर्ववस्तु>>(ज.पढ़ो(ज.पाठबनाओ(म)));
        योग = योग + परिवर्तित<पूर्णांक>(फिर["क्रम"]);
        यदि (परिवर्तित<पाठ>(फिर["नाम"]) != "भारत😀") { त्रुटि("पाठ नष्ट हुआ"); }
        प्रयास {
            स्थिर अधूरा: पाठ = "{\"क\":[1,{\"स\":\"" + प.दोहराओ("क😀",६४) + "\"}],";
            ज.पढ़ो(अधूरा); त्रुटि("त्रुटि अपेक्षित थी");
        } पकड़ो (क: अपवाद) { त्रुटियाँ = त्रुटियाँ + १; }
        अंततः { स्थिर स: पाठ = "साफ" + "😀"; }
        न = न + १;
    }
    लिखो(योग, त्रुटियाँ);
    स्थिर साझासूची: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>{"साझा", १.०};
    लिखो(ज.पाठबनाओ(नया सूची<सर्ववस्तु>{साझासूची,साझासूची}));
    साझासूची.जोड़ो(साझासूची);
    प्रयास { ज.पाठबनाओ(साझासूची); } पकड़ो (क: अपवाद) { लिखो(क.संदेश); }
}
