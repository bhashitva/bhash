// सरणी (Array), सूची (List), मानचित्र (Map): precise managed storage and cycles.
वर्ग कड़ी { सार्वजनिक मान अगली: सर्ववस्तु; सार्वजनिक मान शब्द: पाठ; }
कार्य मुख्य() -> शून्य {
    स्थिर मानक: मानचित्र<पूर्णांक,कड़ी> = नया मानचित्र<पूर्णांक,कड़ी>();
    स्थिर सूचीमान: सूची<कड़ी> = नया सूची<कड़ी>();
    मान न: पूर्णांक = ०;
    जबतक (न < ३००) {
        स्थिर क: कड़ी = नया कड़ी(); क.शब्द = "श" + अंकपाठ(न);
        क.अगली = मानक; मानक[न] = क; सूचीमान.जोड़ो(क); न = न + १;
    }
    स्थिर चित्र: सूची<कड़ी> = मानक.मूल्य(); स्थिर कुंजी: सूची<पूर्णांक> = मानक.कुंजियाँ();
    लिखो(मानक.आकार, सूचीमान.आकार, मानक[२९९].शब्द, कुंजी[२९९]);
    मानक.हटाओ(१५०); मानक.साफ़(); सूचीमान.साफ़();
    लिखो(चित्र[०].शब्द, चित्र[२९९].शब्द, चित्र[०].अगली == मानक);
    न = ०;
    जबतक (न < २०००) {
        स्थिर अ: सर्ववस्तु[] = नया सर्ववस्तु[२];
        स्थिर ब: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>{अ, "क"+अंकपाठ(न)};
        अ[०] = ब; अ[१] = अ; ब.जोड़ो(ब); ब.हटाओ(१);
        न = न + १;
    }
    लिखो(मानक.खाली(), सूचीमान.खाली());
}
