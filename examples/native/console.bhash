कार्य मुख्य() -> शून्य {
    लिखो("अपना नाम लिखें:");
    स्थिर नाम: पाठ = पाठपढ़ो();
    लिखो("एक पूर्णांक लिखें:");
    प्रयास {
        स्थिर संख्या: पूर्णांक = पढ़ो();
        लिखो("नमस्ते",नाम,संख्या);
    } पकड़ो (गलती: अपवाद) {
        लिखो(गलती.संदेश);
    }
}
