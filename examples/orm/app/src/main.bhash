आयात विद्यालय.विद्यार्थी;
आयात विद्यालय.विद्यार्थीसंग्रह;
आयात विद्यालय.कक्षास्तर;
आयात विद्यालय.कक्षास्तरसंग्रह;
आयात विद्यालय.ओआरएमवैकल्पिक;
आयात विद्यालय.योजनालो;
आयात मानक.डेटा;
आयात मानक.डेटासंबंध;
आयात मानक.असमडेटा;
आयात मानक.असमडेटासंबंध;
आयात मानक.असमडेटालेनदेन;
आयात मानक.विन्यास;

असमकालिक फलन मुख्य() -> शून्य {
    स्थिर तर्क: विन्यास=विन्यास.तर्क();
    स्थिर पथ: पाठ=तर्क.पढ़ो("db","school.db");
    यदि (तर्क.पढ़ो("init","false")=="true") {
        संसाधन (डाटा: डेटासंबंध=डेटा.एसक्यूलाइट(पथ)) { योजनालो(असत्य).लागूकरो(डाटा); }
    }
    असमकालिक संसाधन (संबंध: असमडेटासंबंध=प्रतीक्षा असमडेटा.एसक्यूलाइट(पथ)) {
        स्थिर विद्यार्थीभंडार: विद्यार्थीसंग्रह=नया विद्यार्थीसंग्रह(संबंध);
        स्थिर कक्षाभंडार: कक्षास्तरसंग्रह=नया कक्षास्तरसंग्रह(संबंध);
        यदि (तर्क.पढ़ो("init","false")=="true") {
            असमकालिक संसाधन (लेन: असमडेटालेनदेन=प्रतीक्षा संबंध.लेनदेन()) {
                यदि ((प्रतीक्षा कक्षाभंडार.पहचानसेपाओ(५))==रिक्त) {
                    प्रतीक्षा कक्षाभंडार.जोड़ो(नया कक्षास्तर(५,"कक्षा पाँच"));
                }
                यदि ((प्रतीक्षा विद्यार्थीभंडार.पहचानसेपाओ(१०१))==रिक्त) {
                    प्रतीक्षा विद्यार्थीभंडार.जोड़ो(नया विद्यार्थी(१०१,"सीमा",नया ओआरएमवैकल्पिक<पूर्णांक>(५),सत्य,रिक्त,रिक्त,०));
                }
                प्रतीक्षा लेन.सहेजो();
            }
        }
        स्थिर छात्र: विद्यार्थी=प्रतीक्षा विद्यार्थीभंडार.पहचानसेपाओ(१०१);
        यदि (छात्र==रिक्त) { लिखो("विद्यार्थी नहीं मिला।"); लौटाओ; }
        लिखो("विद्यार्थी:",छात्र.नाम);
        स्थिर कक्षा: कक्षास्तर=प्रतीक्षा विद्यार्थीभंडार.कक्षास्तरलो(छात्र);
        यदि (कक्षा==रिक्त) { लिखो("कक्षास्तर तय नहीं है।"); लौटाओ; }
        लिखो("कक्षास्तर:",कक्षा.नाम);
    }
}
