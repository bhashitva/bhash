आयात विद्यालय.योजनालो;
आयात विद्यालय.कक्षास्तर;
आयात विद्यालय.कक्षास्तरसंग्रह;
आयात विद्यालय.विद्यार्थी;
आयात विद्यालय.विद्यार्थीसंग्रह;
आयात विद्यालय.दाखिला;
आयात विद्यालय.दाखिलासंग्रह;
आयात विद्यालय.ओआरएमवैकल्पिक;
आयात विद्यालय.ओआरएमसंघर्ष;
आयात मानक.डेटा;
आयात मानक.डेटासंबंध;
आयात मानक.असमडेटा;
आयात मानक.असमडेटासंबंध;
आयात मानक.असमडेटालेनदेन;
आयात मानक.असमडेटाकथन;
आयात मानक.पोस्टग्रेसविन्यास;
आयात मानक.माइग्रेशन;
आयात मानक.माइग्रेशनयोजना;
आयात मानक.विन्यास;
आयात मानक.वेब;
आयात मानक.पाठ्य;
आयात मानक.कार्य;
आयात मानक.निरस्तीकरणस्रोत;
आयात मानक.निरस्तअपवाद;
आयात मानक.परीक्षण;

फलन पोस्टग्रेसलो() -> पोस्टग्रेसविन्यास {
    स्थिर प: पोस्टग्रेसविन्यास=नया पोस्टग्रेसविन्यास();
    प.मेज़बान=विन्यास.परिवेश("BHASH_PG_HOST","127.0.0.1");
    प.पोर्ट=वेब.संख्या(विन्यास.परिवेश("BHASH_PG_PORT","5432"),६५५३५);
    प.डेटाबेस=विन्यास.परिवेश("BHASH_PG_DATABASE","bhash_orm");
    प.उपयोगकर्ता=विन्यास.परिवेश("BHASH_PG_USER","bhash");
    प.गुप्तशब्द=विन्यास.परिवेश("BHASH_PG_PASSWORD","");
    प.सुरक्षा=विन्यास.परिवेश("BHASH_PG_SSLMODE","verify-full");
    प.प्रमाणपत्र=विन्यास.परिवेश("BHASH_PG_CA","");
    लौटाओ प;
}

असमकालिक फलन मुख्य() -> शून्य {
    स्थिर पोस्ट: तार्किक=विन्यास.परिवेश("BHASH_ORM_PROVIDER","sqlite")=="postgresql";
    स्थिर पथ: पाठ=विन्यास.परिवेश("BHASH_ORM_DB","school.db");
    मान सम: डेटासंबंध=रिक्त;
    यदि (पोस्ट) { सम=डेटा.पोस्टग्रेस(पोस्टग्रेसलो()); }
    अन्यथा { सम=डेटा.एसक्यूलाइट(पथ); }
    संसाधन (डाटा: डेटासंबंध=सम) {
        परीक्षण.बराबर(१,योजनालो(पोस्ट).लागूकरो(डाटा));
        परीक्षण.बराबर(०,योजनालो(पोस्ट).लागूकरो(डाटा));
    }
    मान खोला: असमडेटासंबंध=रिक्त;
    यदि (पोस्ट) { खोला=प्रतीक्षा असमडेटा.पोस्टग्रेस(पोस्टग्रेसलो()); }
    अन्यथा { खोला=प्रतीक्षा असमडेटा.एसक्यूलाइट(पथ); }
    असमकालिक संसाधन (संबंध: असमडेटासंबंध=खोला) {
        प्रतीक्षा पढ़ाईजाँचो(संबंध);
        प्रतीक्षा बदलावजाँचो(संबंध);
        प्रतीक्षा लेनदेनजाँचो(संबंध);
        प्रतीक्षा दाखिलाजाँचो(संबंध);
        प्रतीक्षा बाधाजाँचो(संबंध);
    }
    लिखो("ORM विद्यालय ठीक");
}

असमकालिक फलन पढ़ाईजाँचो(संबंध: असमडेटासंबंध) -> शून्य {
    स्थिर कक्षाएँ: कक्षास्तरसंग्रह=नया कक्षास्तरसंग्रह(संबंध);
    स्थिर छात्र: विद्यार्थीसंग्रह=नया विद्यार्थीसंग्रह(संबंध);
    स्थिर दाखिले: दाखिलासंग्रह=नया दाखिलासंग्रह(संबंध);
    परीक्षण.बराबर(१,प्रतीक्षा कक्षाएँ.जोड़ो(नया कक्षास्तर(५,"कक्षा पाँच")));
    स्थिर नाम: पाठ="सीमा 😀 ' ; --";
    स्थिर मूल: विद्यार्थी=नया विद्यार्थी(१०१,नाम,नया ओआरएमवैकल्पिक<पूर्णांक>(५),सत्य,नया ओआरएमवैकल्पिक<दशमलव>(९.५),रिक्त,०);
    स्थिर रद्दस्रोत: निरस्तीकरणस्रोत=नया निरस्तीकरणस्रोत();
    रद्दस्रोत.निरस्तकरो();
    प्रयास {
        प्रतीक्षा छात्र.जोड़ो(मूल,रद्दस्रोत.चिह्नलो());
        फेंको नया अपवाद("निरस्त ORM लेखन चल गया।");
    } पकड़ो (दोष: निरस्तअपवाद) { }
    परीक्षण.बराबर(१,प्रतीक्षा छात्र.जोड़ो(मूल));

    स्थिर मिला: विद्यार्थी=प्रतीक्षा छात्र.पहचानसेपाओ(१०१);
    परीक्षण.बराबर(नाम,मिला.नाम);
    परीक्षण.सत्यहै(मिला.अंक.मूल्य==९.५,"दशमलव सही लौटे।");
    परीक्षण.बराबर(सत्य,मिला.सक्रिय);
    परीक्षण.सत्यहै(मिला.टिप्पणी==रिक्त,"SQL NULL को सुरक्षित लौटाएँ।");
    स्थिर कक्षा: कक्षास्तर=प्रतीक्षा छात्र.कक्षास्तरलो(मिला);
    परीक्षण.बराबर("कक्षा पाँच",कक्षा.नाम);
    परीक्षण.सत्यहै((प्रतीक्षा छात्र.पहचानसेपाओ(९९९))==रिक्त,"अज्ञात पहचान रिक्त हो।");
    परीक्षण.बराबर(१,(प्रतीक्षा छात्र.कक्षाकेविद्यार्थीलो(५)).आकार);
    परीक्षण.बराबर(नाम,(प्रतीक्षा छात्र.नामसेपाओ(नाम)).नाम);
    परीक्षण.बराबर(१,(प्रतीक्षा छात्र.सूचीलो(१,०)).आकार);
    परीक्षण.बराबर(०,(प्रतीक्षा छात्र.सूचीलो(१,१)).आकार);
    परीक्षण.बराबर(१,(प्रतीक्षा छात्र.सभीलो()).आकार);
    प्रयास { प्रतीक्षा छात्र.सूचीलो(०,०); फेंको नया ओआरएमसंघर्ष(); }
    पकड़ो (दोष: ओआरएमसंघर्ष) { फेंको दोष; }
    पकड़ो (दोष: अपवाद) { }


}

असमकालिक फलन बदलावजाँचो(संबंध: असमडेटासंबंध) -> शून्य {
    स्थिर कक्षाएँ: कक्षास्तरसंग्रह=नया कक्षास्तरसंग्रह(संबंध);
    स्थिर छात्र: विद्यार्थीसंग्रह=नया विद्यार्थीसंग्रह(संबंध);
    स्थिर दाखिले: दाखिलासंग्रह=नया दाखिलासंग्रह(संबंध);
    स्थिर मिला: विद्यार्थी=प्रतीक्षा छात्र.पहचानसेपाओ(१०१);
    स्थिर बदला: विद्यार्थी=प्रतीक्षा छात्र.बदलो(नया विद्यार्थी(१०१,"सीमा",मिला.कक्षास्तरपहचान,असत्य,रिक्त,नया ओआरएमवैकल्पिक<पाठ>("नई टिप्पणी"),०));
    परीक्षण.बराबर(१,बदला.संस्करण);
    प्रयास { प्रतीक्षा छात्र.बदलो(मिला); फेंको नया अपवाद("पुराना संस्करण सहेजा गया।"); }
    पकड़ो (दोष: ओआरएमसंघर्ष) { }
    स्थिर ताजा: विद्यार्थी=प्रतीक्षा छात्र.पहचानसेपाओ(१०१);
    परीक्षण.सत्यहै(ताजा.अंक==रिक्त,"nullable scalar साफ़ करें।");
    परीक्षण.बराबर("नई टिप्पणी",ताजा.टिप्पणी.मूल्य);
    परीक्षण.बराबर(असत्य,ताजा.सक्रिय);
    परीक्षण.बराबर(१,प्रतीक्षा छात्र.जोड़ो(नया विद्यार्थी(१०२,"दूसरा",रिक्त,सत्य,रिक्त,रिक्त,०)));
    परीक्षण.सत्यहै((प्रतीक्षा छात्र.कक्षास्तरलो(प्रतीक्षा छात्र.पहचानसेपाओ(१०२)))==रिक्त,"वैकल्पिक foreign key रिक्त हो।");

}

असमकालिक फलन लेनदेनजाँचो(संबंध: असमडेटासंबंध) -> शून्य {
    स्थिर कक्षाएँ: कक्षास्तरसंग्रह=नया कक्षास्तरसंग्रह(संबंध);
    स्थिर छात्र: विद्यार्थीसंग्रह=नया विद्यार्थीसंग्रह(संबंध);
    स्थिर दाखिले: दाखिलासंग्रह=नया दाखिलासंग्रह(संबंध);
    असमकालिक संसाधन (लेन: असमडेटालेनदेन=प्रतीक्षा संबंध.लेनदेन()) {
        प्रतीक्षा छात्र.जोड़ो(नया विद्यार्थी(१०३,"वापस होगा",रिक्त,सत्य,रिक्त,रिक्त,०));
    }
    परीक्षण.सत्यहै((प्रतीक्षा छात्र.पहचानसेपाओ(१०३))==रिक्त,"संसाधन बंद होने पर rollback हो।");
    असमकालिक संसाधन (लेन: असमडेटालेनदेन=प्रतीक्षा संबंध.लेनदेन()) {
        प्रतीक्षा छात्र.जोड़ो(नया विद्यार्थी(१०३,"सहेजा",रिक्त,सत्य,रिक्त,रिक्त,०));
        प्रतीक्षा लेन.सहेजो();
    }
    परीक्षण.बराबर("सहेजा",(प्रतीक्षा छात्र.पहचानसेपाओ(१०३)).नाम);

}

असमकालिक फलन दाखिलाजाँचो(संबंध: असमडेटासंबंध) -> शून्य {
    स्थिर कक्षाएँ: कक्षास्तरसंग्रह=नया कक्षास्तरसंग्रह(संबंध);
    स्थिर छात्र: विद्यार्थीसंग्रह=नया विद्यार्थीसंग्रह(संबंध);
    स्थिर दाखिले: दाखिलासंग्रह=नया दाखिलासंग्रह(संबंध);
    स्थिर दस्तावेज़: बाइटबफ़र=पाठ्य.यूटीएफ८("दस्तावेज़ 😀");
    परीक्षण.बराबर(१,प्रतीक्षा दाखिले.जोड़ो(नया दाखिला(१०१,२०२६,"12345678901234567890.123456789","2026-11-06T12:00:00Z",नया ओआरएमवैकल्पिक<बाइटबफ़र>(दस्तावेज़))));
    स्थिर दाखिलामान: दाखिला=प्रतीक्षा दाखिले.पहचानसेपाओ(१०१,२०२६);
    परीक्षण.बराबर("12345678901234567890.123456789",दाखिलामान.शुल्क);
    परीक्षण.बराबर("दस्तावेज़ 😀",पाठ्य.यूटीएफ८पाठ(दाखिलामान.दस्तावेज़.मूल्य));
    परीक्षण.बराबर("सीमा",(प्रतीक्षा दाखिले.विद्यार्थीलो(दाखिलामान)).नाम);
    परीक्षण.बराबर(१,प्रतीक्षा दाखिले.हटाओ(१०१,२०२६));
    परीक्षण.सत्यहै((प्रतीक्षा दाखिले.पहचानसेपाओ(१०१,२०२६))==रिक्त,"composite delete");

}

असमकालिक फलन बाधाजाँचो(संबंध: असमडेटासंबंध) -> शून्य {
    स्थिर कक्षाएँ: कक्षास्तरसंग्रह=नया कक्षास्तरसंग्रह(संबंध);
    स्थिर छात्र: विद्यार्थीसंग्रह=नया विद्यार्थीसंग्रह(संबंध);
    स्थिर दाखिले: दाखिलासंग्रह=नया दाखिलासंग्रह(संबंध);
    मान बाधा: तार्किक=असत्य;
    प्रयास { प्रतीक्षा छात्र.जोड़ो(नया विद्यार्थी(१०४,"अमान्य कक्षा",नया ओआरएमवैकल्पिक<पूर्णांक>(९९),सत्य,रिक्त,रिक्त,०)); }
    पकड़ो (दोष: अपवाद) { बाधा=सत्य; }
    परीक्षण.सत्यहै(बाधा,"डेटाबेस foreign key लागू करे।");
    प्रयास { प्रतीक्षा छात्र.हटाओ(१०१,०); फेंको नया अपवाद("पुराने संस्करण से हटाया।"); }
    पकड़ो (दोष: ओआरएमसंघर्ष) { }
    परीक्षण.बराबर(१,प्रतीक्षा छात्र.हटाओ(१०१,१));
    परीक्षण.बराबर(१,प्रतीक्षा कक्षाएँ.हटाओ(५));
}
