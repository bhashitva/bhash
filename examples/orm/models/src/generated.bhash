        यदि (मानक.अंक==रिक्त) { कथन.रिक्तरखो(5); }
        अन्यथा { कथन.दशमलवरखो(5,मानक.अंक.मूल्य); }
        यदि (मानक.टिप्पणी==रिक्त) { कथन.रिक्तरखो(6); }
        अन्यथा { कथन.पाठरखो(6,मानक.टिप्पणी.मूल्य); }
        कथन.पूर्णांकरखो(7,मानक.संस्करण);
            लौटाओ प्रतीक्षा कथन.चलाओ(चिह्न);
        }
    }
    सार्वजनिक फलन बदलो(मानक: विद्यार्थी) -> कार्यफल<विद्यार्थी> {
        लौटाओ यह.बदलो(मानक, कार्य.वर्तमानचिह्न());
    }
    सार्वजनिक असमकालिक फलन बदलो(मानक: विद्यार्थी, चिह्न: निरस्तीकरणचिह्न) -> विद्यार्थी {
        चिह्न.जाँचो();
        यदि (मानक==रिक्त) { फेंको नया अपवाद("ORM अभिलेख रिक्त है।"); }
        यदि (मानक.संस्करण<० || मानक.संस्करण==९२२३३७२०३६८५४७७५८०७) { फेंको नया अपवाद("ORM संस्करण सीमा अमान्य है।"); }
        असमकालिक संसाधन (कथन: असमडेटाकथन=प्रतीक्षा संबंध.तैयार("UPDATE \"student\" SET \"name\"=?, \"gradelevel_id\"=?, \"active\"=?, \"score\"=?, \"note\"=?, \"version\"=\"version\"+1 WHERE \"id\"=? AND \"version\"=?",चिह्न)) {
        कथन.पाठरखो(1,मानक.नाम);
        यदि (मानक.कक्षास्तरपहचान==रिक्त) { कथन.रिक्तरखो(2); }
        अन्यथा { कथन.पूर्णांकरखो(2,मानक.कक्षास्तरपहचान.मूल्य); }
        कथन.तार्किकरखो(3,मानक.सक्रिय);
        यदि (मानक.अंक==रिक्त) { कथन.रिक्तरखो(4); }
        अन्यथा { कथन.दशमलवरखो(4,मानक.अंक.मूल्य); }
        यदि (मानक.टिप्पणी==रिक्त) { कथन.रिक्तरखो(5); }
        अन्यथा { कथन.पाठरखो(5,मानक.टिप्पणी.मूल्य); }
        कथन.पूर्णांकरखो(6,मानक.पहचान);
        कथन.पूर्णांकरखो(7,मानक.संस्करण);
            यदि ((प्रतीक्षा कथन.चलाओ(चिह्न))!=१) { फेंको नया ओआरएमसंघर्ष(); }
        }
        लौटाओ नया विद्यार्थी(मानक.पहचान, मानक.नाम, मानक.कक्षास्तरपहचान, मानक.सक्रिय, मानक.अंक, मानक.टिप्पणी, मानक.संस्करण+१);
    }
    सार्वजनिक फलन हटाओ(कुंजी_0: पूर्णांक, अपेक्षितसंस्करण: पूर्णांक) -> कार्यफल<पूर्णांक> {
        लौटाओ यह.हटाओ(कुंजी_0, अपेक्षितसंस्करण, कार्य.वर्तमानचिह्न());
    }
    सार्वजनिक असमकालिक फलन हटाओ(कुंजी_0: पूर्णांक, अपेक्षितसंस्करण: पूर्णांक, चिह्न: निरस्तीकरणचिह्न) -> पूर्णांक {
        चिह्न.जाँचो();
        असमकालिक संसाधन (कथन: असमडेटाकथन=प्रतीक्षा संबंध.तैयार("DELETE FROM \"student\" WHERE \"id\"=? AND \"version\"=?",चिह्न)) {
        कथन.पूर्णांकरखो(1,कुंजी_0);
        कथन.पूर्णांकरखो(2,अपेक्षितसंस्करण);
            स्थिर संख्या: पूर्णांक=प्रतीक्षा कथन.चलाओ(चिह्न);
            यदि (संख्या!=१) { फेंको नया ओआरएमसंघर्ष(); }
            लौटाओ संख्या;
        }
    }
    सार्वजनिक फलन कक्षास्तरलो(मानक: विद्यार्थी) -> कार्यफल<कक्षास्तर> {
        लौटाओ यह.कक्षास्तरलो(मानक, कार्य.वर्तमानचिह्न());
    }
    सार्वजनिक असमकालिक फलन कक्षास्तरलो(मानक: विद्यार्थी, चिह्न: निरस्तीकरणचिह्न) -> कक्षास्तर {
        चिह्न.जाँचो();
        यदि (मानक==रिक्त) { फेंको नया अपवाद("ORM अभिलेख रिक्त है।"); }
        यदि (मानक.कक्षास्तरपहचान==रिक्त) { लौटाओ रिक्त; }
        स्थिर भंडार: कक्षास्तरसंग्रह=नया कक्षास्तरसंग्रह(संबंध);
        लौटाओ प्रतीक्षा भंडार.पहचानसेपाओ(मानक.कक्षास्तरपहचान.मूल्य,चिह्न);
    }
    सार्वजनिक फलन कक्षाकेविद्यार्थीलो(परिमाण_0: पूर्णांक) -> कार्यफल<सूची<विद्यार्थी>> {
        लौटाओ यह.कक्षाकेविद्यार्थीलो(परिमाण_0, कार्य.वर्तमानचिह्न());
    }
    सार्वजनिक असमकालिक फलन कक्षाकेविद्यार्थीलो(परिमाण_0: पूर्णांक, चिह्न: निरस्तीकरणचिह्न) -> सूची<विद्यार्थी> {
        चिह्न.जाँचो();
        स्थिर एसक्यूएल: पाठ="SELECT * FROM (SELECT id,name,gradelevel_id,active,score,note,version FROM student WHERE gradelevel_id=? ORDER BY id LIMIT 100\n) AS orm_result LIMIT 1001";
        असमकालिक संसाधन (कथन: असमडेटाकथन=प्रतीक्षा संबंध.तैयार(एसक्यूएल,चिह्न)) {
        कथन.पूर्णांकरखो(1,परिमाण_0);
            स्थिर फल: सूची<विद्यार्थी> = नया सूची<विद्यार्थी>();
            जबतक (प्रतीक्षा कथन.अगला(चिह्न)) {
                यदि (फल.आकार>=१०००) { फेंको नया अपवाद("ORM परिणाम सीमा १००० है।"); }
                फल.जोड़ो(यह.पंक्तिलो(कथन));
            }
            लौटाओ फल;
        }
    }
    सार्वजनिक फलन नामसेपाओ(परिमाण_0: पाठ) -> कार्यफल<विद्यार्थी> {
        लौटाओ यह.नामसेपाओ(परिमाण_0, कार्य.वर्तमानचिह्न());
    }
    सार्वजनिक असमकालिक फलन नामसेपाओ(परिमाण_0: पाठ, चिह्न: निरस्तीकरणचिह्न) -> विद्यार्थी {
        चिह्न.जाँचो();
        मान एसक्यूएल: पाठ="SELECT * FROM (SELECT id,name,gradelevel_id,active,score,note,version FROM student WHERE name=?\n) AS orm_result LIMIT 2";
        यदि (संबंध.आंतरिकपोस्टग्रेस) { एसक्यूएल="SELECT * FROM (SELECT id,name,gradelevel_id,active,score,note,version FROM student WHERE name=?::text\n) AS orm_result LIMIT 2"; }
        असमकालिक संसाधन (कथन: असमडेटाकथन=प्रतीक्षा संबंध.तैयार(एसक्यूएल,चिह्न)) {
        कथन.पाठरखो(1,परिमाण_0);
            यदि (!(प्रतीक्षा कथन.अगला(चिह्न))) { लौटाओ रिक्त; }
            स्थिर फल: विद्यार्थी=यह.पंक्तिलो(कथन);
            यदि (प्रतीक्षा कथन.अगला(चिह्न)) { फेंको नया अपवाद("ORM एक-पंक्ति query ने कई पंक्तियाँ लौटाईं।"); }
            लौटाओ फल;
        }
    }
    सार्वजनिक फलन सभीलो() -> कार्यफल<सूची<विद्यार्थी>> {
        लौटाओ यह.सभीलो(कार्य.वर्तमानचिह्न());
    }
    सार्वजनिक असमकालिक फलन सभीलो(चिह्न: निरस्तीकरणचिह्न) -> सूची<विद्यार्थी> {
        चिह्न.जाँचो();
        स्थिर एसक्यूएल: पाठ="SELECT * FROM (SELECT id,name,gradelevel_id,active,score,note,version FROM student ORDER BY id\n) AS orm_result LIMIT 1001";
        असमकालिक संसाधन (कथन: असमडेटाकथन=प्रतीक्षा संबंध.तैयार(एसक्यूएल,चिह्न)) {
            स्थिर फल: सूची<विद्यार्थी> = नया सूची<विद्यार्थी>();
            जबतक (प्रतीक्षा कथन.अगला(चिह्न)) {
                यदि (फल.आकार>=१०००) { फेंको नया अपवाद("ORM परिणाम सीमा १००० है।"); }
                फल.जोड़ो(यह.पंक्तिलो(कथन));
            }
            लौटाओ फल;
        }
    }
}

सार्वजनिक वर्ग दाखिलासंग्रह {
    निजी मान संबंध: असमडेटासंबंध;
    सार्वजनिक निर्माता(संबंध: असमडेटासंबंध) { यह.संबंध=संबंध; }
    निजी फलन पंक्तिलो(कथन: असमडेटाकथन) -> दाखिला {
        यदि (कथन.स्तंभसंख्या()!=5) { फेंको नया अपवाद("ORM परिणाम स्तंभ असंगत।"); }
        यदि (कथन.स्तंभनाम(0)!="student_id") { फेंको नया अपवाद("ORM स्तंभ नाम या क्रम असंगत।"); }
        यदि (कथन.रिक्तहै(0)) { फेंको नया अपवाद("ORM अनिवार्य स्तंभ रिक्त है।"); }
        स्थिर क्षेत्र_0: पूर्णांक=कथन.पूर्णांकलो(0);
        यदि (कथन.स्तंभनाम(1)!="year") { फेंको नया अपवाद("ORM स्तंभ नाम या क्रम असंगत।"); }
        यदि (कथन.रिक्तहै(1)) { फेंको नया अपवाद("ORM अनिवार्य स्तंभ रिक्त है।"); }
        स्थिर क्षेत्र_1: पूर्णांक=कथन.पूर्णांकलो(1);
        यदि (कथन.स्तंभनाम(2)!="fee") { फेंको नया अपवाद("ORM स्तंभ नाम या क्रम असंगत।"); }
        यदि (कथन.रिक्तहै(2)) { फेंको नया अपवाद("ORM अनिवार्य स्तंभ रिक्त है।"); }
        स्थिर क्षेत्र_2: पाठ=कथन.पाठलो(2);
        यदि (कथन.स्तंभनाम(3)!="saved_at") { फेंको नया अपवाद("ORM स्तंभ नाम या क्रम असंगत।"); }
        यदि (कथन.रिक्तहै(3)) { फेंको नया अपवाद("ORM अनिवार्य स्तंभ रिक्त है।"); }
        स्थिर क्षेत्र_3: पाठ=कथन.पाठलो(3);
        यदि (कथन.स्तंभनाम(4)!="document") { फेंको नया अपवाद("ORM स्तंभ नाम या क्रम असंगत।"); }
        मान क्षेत्र_4: ओआरएमवैकल्पिक<बाइटबफ़र> = रिक्त;
        यदि (!कथन.रिक्तहै(4)) { क्षेत्र_4=नया ओआरएमवैकल्पिक<बाइटबफ़र>(कथन.बाइटलो(4)); }
        लौटाओ नया दाखिला(क्षेत्र_0, क्षेत्र_1, क्षेत्र_2, क्षेत्र_3, क्षेत्र_4);
    }
    सार्वजनिक फलन पहचानसेपाओ(कुंजी_0: पूर्णांक, कुंजी_1: पूर्णांक) -> कार्यफल<दाखिला> {
        लौटाओ यह.पहचानसेपाओ(कुंजी_0, कुंजी_1, कार्य.वर्तमानचिह्न());
    }
    सार्वजनिक असमकालिक फलन पहचानसेपाओ(कुंजी_0: पूर्णांक, कुंजी_1: पूर्णांक, चिह्न: निरस्तीकरणचिह्न) -> दाखिला {
        चिह्न.जाँचो();
        स्थिर एसक्यूएल: पाठ="SELECT \"student_id\", \"year\", \"fee\", \"saved_at\", \"document\" FROM \"enrollment\" WHERE \"student_id\"=? AND \"year\"=?";
        असमकालिक संसाधन (कथन: असमडेटाकथन=प्रतीक्षा संबंध.तैयार(एसक्यूएल,चिह्न)) {
        कथन.पूर्णांकरखो(1,कुंजी_0);
        कथन.पूर्णांकरखो(2,कुंजी_1);
            यदि (!(प्रतीक्षा कथन.अगला(चिह्न))) { लौटाओ रिक्त; }
            स्थिर फल: दाखिला=यह.पंक्तिलो(कथन);
            यदि (प्रतीक्षा कथन.अगला(चिह्न)) { फेंको नया अपवाद("ORM एक-पंक्ति query ने कई पंक्तियाँ लौटाईं।"); }
            लौटाओ फल;
        }
    }
    सार्वजनिक फलन सूचीलो(सीमा: पूर्णांक, अंतर: पूर्णांक) -> कार्यफल<सूची<दाखिला>> {
        लौटाओ यह.सूचीलो(सीमा, अंतर, कार्य.वर्तमानचिह्न());
    }
    सार्वजनिक असमकालिक फलन सूचीलो(सीमा: पूर्णांक, अंतर: पूर्णांक, चिह्न: निरस्तीकरणचिह्न) -> सूची<दाखिला> {
        चिह्न.जाँचो();
        यदि (सीमा<१ || सीमा>१००० || अंतर<०) { फेंको नया अपवाद("ORM पृष्ठ सीमा अमान्य है।"); }
        स्थिर एसक्यूएल: पाठ="SELECT \"student_id\", \"year\", \"fee\", \"saved_at\", \"document\" FROM \"enrollment\" ORDER BY \"student_id\", \"year\" LIMIT ? OFFSET ?";
        असमकालिक संसाधन (कथन: असमडेटाकथन=प्रतीक्षा संबंध.तैयार(एसक्यूएल,चिह्न)) {
        कथन.पूर्णांकरखो(1,सीमा);
        कथन.पूर्णांकरखो(2,अंतर);
            स्थिर फल: सूची<दाखिला> = नया सूची<दाखिला>();
            जबतक (प्रतीक्षा कथन.अगला(चिह्न)) {
                यदि (फल.आकार>=१०००) { फेंको नया अपवाद("ORM परिणाम सीमा १००० है।"); }
                फल.जोड़ो(यह.पंक्तिलो(कथन));
            }
            लौटाओ फल;
        }
    }
    सार्वजनिक फलन जोड़ो(मानक: दाखिला) -> कार्यफल<पूर्णांक> {
        लौटाओ यह.जोड़ो(मानक, कार्य.वर्तमानचिह्न());
    }
    सार्वजनिक असमकालिक फलन जोड़ो(मानक: दाखिला, चिह्न: निरस्तीकरणचिह्न) -> पूर्णांक {
        चिह्न.जाँचो();
        यदि (मानक==रिक्त) { फेंको नया अपवाद("ORM अभिलेख रिक्त है।"); }
        असमकालिक संसाधन (कथन: असमडेटाकथन=प्रतीक्षा संबंध.तैयार("INSERT INTO \"enrollment\" (\"student_id\", \"year\", \"fee\", \"saved_at\", \"document\") VALUES (?, ?, ?, ?, ?)",चिह्न)) {
        कथन.पूर्णांकरखो(1,मानक.विद्यार्थीपहचान);
        कथन.पूर्णांकरखो(2,मानक.वर्ष);
        कथन.पाठरखो(3,मानक.शुल्क);
        कथन.पाठरखो(4,मानक.समय);
        यदि (मानक.दस्तावेज़==रिक्त) { कथन.रिक्तरखो(5); }
        अन्यथा { कथन.बाइटरखो(5,मानक.दस्तावेज़.मूल्य); }
            लौटाओ प्रतीक्षा कथन.चलाओ(चिह्न);
        }
    }
    सार्वजनिक फलन बदलो(मानक: दाखिला) -> कार्यफल<दाखिला> {
        लौटाओ यह.बदलो(मानक, कार्य.वर्तमानचिह्न());
    }
    सार्वजनिक असमकालिक फलन बदलो(मानक: दाखिला, चिह्न: निरस्तीकरणचिह्न) -> दाखिला {
        चिह्न.जाँचो();
        यदि (मानक==रिक्त) { फेंको नया अपवाद("ORM अभिलेख रिक्त है।"); }
        असमकालिक संसाधन (कथन: असमडेटाकथन=प्रतीक्षा संबंध.तैयार("UPDATE \"enrollment\" SET \"fee\"=?, \"saved_at\"=?, \"document\"=? WHERE \"student_id\"=? AND \"year\"=?",चिह्न)) {
        कथन.पाठरखो(1,मानक.शुल्क);
        कथन.पाठरखो(2,मानक.समय);
        यदि (मानक.दस्तावेज़==रिक्त) { कथन.रिक्तरखो(3); }
        अन्यथा { कथन.बाइटरखो(3,मानक.दस्तावेज़.मूल्य); }
        कथन.पूर्णांकरखो(4,मानक.विद्यार्थीपहचान);
        कथन.पूर्णांकरखो(5,मानक.वर्ष);
            यदि ((प्रतीक्षा कथन.चलाओ(चिह्न))!=१) { फेंको नया ओआरएमसंघर्ष(); }
        }
        लौटाओ नया दाखिला(मानक.विद्यार्थीपहचान, मानक.वर्ष, मानक.शुल्क, मानक.समय, मानक.दस्तावेज़);
    }
    सार्वजनिक फलन हटाओ(कुंजी_0: पूर्णांक, कुंजी_1: पूर्णांक) -> कार्यफल<पूर्णांक> {
        लौटाओ यह.हटाओ(कुंजी_0, कुंजी_1, कार्य.वर्तमानचिह्न());
    }
    सार्वजनिक असमकालिक फलन हटाओ(कुंजी_0: पूर्णांक, कुंजी_1: पूर्णांक, चिह्न: निरस्तीकरणचिह्न) -> पूर्णांक {
        चिह्न.जाँचो();
        असमकालिक संसाधन (कथन: असमडेटाकथन=प्रतीक्षा संबंध.तैयार("DELETE FROM \"enrollment\" WHERE \"student_id\"=? AND \"year\"=?",चिह्न)) {
        कथन.पूर्णांकरखो(1,कुंजी_0);
        कथन.पूर्णांकरखो(2,कुंजी_1);
            स्थिर संख्या: पूर्णांक=प्रतीक्षा कथन.चलाओ(चिह्न);
            लौटाओ संख्या;
        }
    }
    सार्वजनिक फलन विद्यार्थीलो(मानक: दाखिला) -> कार्यफल<विद्यार्थी> {
        लौटाओ यह.विद्यार्थीलो(मानक, कार्य.वर्तमानचिह्न());
    }
    सार्वजनिक असमकालिक फलन विद्यार्थीलो(मानक: दाखिला, चिह्न: निरस्तीकरणचिह्न) -> विद्यार्थी {
        चिह्न.जाँचो();
        यदि (मानक==रिक्त) { फेंको नया अपवाद("ORM अभिलेख रिक्त है।"); }
        स्थिर भंडार: विद्यार्थीसंग्रह=नया विद्यार्थीसंग्रह(संबंध);
        लौटाओ प्रतीक्षा भंडार.पहचानसेपाओ(मानक.विद्यार्थीपहचान,चिह्न);
    }
}
