// अनुबंध + generics + overloads + static members.
अनुबंध प्रदाता<त> {
    कार्य लो() -> त;
}
अनुबंध नामित {
    कार्य नाम() -> पाठ;
}
अनुबंध नामितप्रदाता<त> विस्तार प्रदाता<त>, नामित {}
वर्ग पात्र<त> पालन नामितप्रदाता<त> {
    निजी मान मूल्य: त;
    साझा मान गिनती: पूर्णांक = ०;
    साझा स्थिर सीमा: पूर्णांक = १००;
    निर्माता(मूल्य: त) { यह.मूल्य = मूल्य; पात्र<त>.गिनती = पात्र<त>.गिनती + १; }
    कार्य लो() -> त { लौटाओ यह.मूल्य; }
    कार्य नाम() -> पाठ { लौटाओ "पात्र"; }
    साझा कार्य संख्या() -> पूर्णांक { लौटाओ गिनती; }
    साझा कार्य दुगुना(संख्या: पूर्णांक) -> पूर्णांक { लौटाओ संख्या * २; }
    साझा कार्य दुगुना(संख्या: दशमलव) -> दशमलव { लौटाओ संख्या * २.०; }
}
कार्य पहचान<त>(मूल्य: त) -> त { लौटाओ मूल्य; }
कार्य दिखाओ(मूल्य: पूर्णांक) -> शून्य { लिखो("पूर्णांक:", मूल्य); }
कार्य दिखाओ(मूल्य: पाठ) -> शून्य { लिखो("पाठ:", मूल्य); }
कार्य मुख्य() -> शून्य {
    स्थिर संख्या: नामितप्रदाता<पूर्णांक> = नया पात्र<पूर्णांक>(२१);
    स्थिर शब्द: प्रदाता<पाठ> = नया पात्र<पाठ>("नमस्ते");
    दिखाओ(संख्या.लो());
    दिखाओ(पहचान<पाठ>(शब्द.लो()));
    लिखो(संख्या.नाम(), पात्र<पूर्णांक>.दुगुना(संख्या.लो()), पात्र<पूर्णांक>.दुगुना(१.५));
    लिखो(पात्र<पूर्णांक>.संख्या(), पात्र<पाठ>.संख्या(), पात्र<पूर्णांक>.सीमा);
}
