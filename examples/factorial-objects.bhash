वर्ग गणक {
    कार्य गणना(संख्या: पूर्णांक) -> पूर्णांक { लौटाओ संख्या; }
}

वर्ग गुणनफलगणक विस्तार गणक {
    अधिलेखन कार्य गणना(संख्या: पूर्णांक) -> पूर्णांक {
        यदि (संख्या <= १) { लौटाओ १; }
        लौटाओ संख्या * यह.गणना(संख्या - १);
    }
}

कार्य मुख्य() -> शून्य {
    लिखो("० से २० तक एक पूर्णांक लिखें:");
    स्थिर संख्या: पूर्णांक = पढ़ो();
    यदि (संख्या < ० || संख्या > २०) {
        लिखो("कृपया ० से २० तक की संख्या दें।");
        लौटाओ;
    }
    स्थिर गणना: गणक = नया गुणनफलगणक();
    लिखो("गुणनफल:", गणना.गणना(संख्या));
}
