आयात मानक.एसक्यूलाइट;
आयात मानक.डेटाबेस;
आयात मानक.कथन;
आयात मानक.लेनदेन;
आयात मानक.पाठ्य;
आयात मानक.जेसन;

वर्ग कार्यभंडार {
    सार्वजनिक मान डाटा: डेटाबेस;
    निर्माता(डाटा: डेटाबेस) { यह.डाटा = डाटा; }
}

फलन भंडारखोलो(भंडारपथ: पाठ) -> कार्यभंडार {
    यदि (भंडारपथ == "") { फेंको नया अपवाद("कार्य भंडार का पथ दें।"); }
    स्थिर ड: डेटाबेस = एसक्यूलाइट.खोलो(भंडारपथ + "/tasks.db");
    प्रयास {
        संसाधन (ल: लेनदेन = ड.लेनदेन()) {
            मान संस्करण: पूर्णांक = ०;
            संसाधन (क: कथन = ड.तैयार("PRAGMA user_version")) {
                यदि (क.अगला()) { संस्करण = क.पूर्णांकलो(०); }
            }
            यदि (संस्करण == ०) {
                संसाधन (क: कथन = ड.तैयार("CREATE TABLE tasks(id INTEGER PRIMARY KEY, title TEXT NOT NULL, done INTEGER NOT NULL DEFAULT 0 CHECK(done IN (0,1)))")) {
                    क.चलाओ();
                }
                संसाधन (क: कथन = ड.तैयार("PRAGMA user_version = 1")) { क.चलाओ(); }
            } अन्यथा यदि (संस्करण != १) {
                फेंको नया अपवाद("कार्य भंडार का संस्करण समर्थित नहीं है।");
            }
            ल.सहेजो();
        }
        लौटाओ नया कार्यभंडार(ड);
    } पकड़ो (ग: अपवाद) {
        प्रयास { ड.बंदकरो(); } पकड़ो (बंददोष: अपवाद) {}
        फेंको ग;
    }
}

फलन नियंत्रणहै(नाम: पाठ) -> तार्किक {
    स्थिर ब: बाइटबफ़र = पाठ्य.यूटीएफ८(नाम);
    मान इ: पूर्णांक = ०;
    जबतक (इ < ब.आकार) {
        स्थिर वर्तमान: पूर्णांक = परिवर्तित<पूर्णांक>(ब[इ]);
        यदि (वर्तमान < ३२ || वर्तमान == १२७) { लौटाओ सत्य; }
        // U+0080–U+009F are encoded as C2 80 through C2 9F.
        यदि (वर्तमान == १९४ && इ + १ < ब.आकार) {
            स्थिर अगला: पूर्णांक = परिवर्तित<पूर्णांक>(ब[इ + १]);
            यदि (अगला >= १२८ && अगला <= १५९) { लौटाओ सत्य; }
        }
        इ = इ + १;
    }
    लौटाओ असत्य;
}

फलन कार्यजोड़ो(भंडार: कार्यभंडार, शीर्षक: पाठ) -> पूर्णांक {
    यदि (नियंत्रणहै(शीर्षक)) { लौटाओ ०; }
    स्थिर नाम: पाठ = पाठ्य.छाँटो(शीर्षक);
    यदि (नाम == "" || पाठ्य.लंबाई(नाम) > १२०) {
        लौटाओ ०;
    }
    संसाधन (ल: लेनदेन = भंडार.डाटा.लेनदेन()) {
        संसाधन (क: कथन = भंडार.डाटा.तैयार("INSERT INTO tasks(title) VALUES (?)")) {
            क.पाठरखो(१, नाम);
            क.चलाओ();
        }
        मान पहचान: पूर्णांक = ०;
        संसाधन (क: कथन = भंडार.डाटा.तैयार("SELECT last_insert_rowid()")) {
            यदि (क.अगला()) { पहचान = क.पूर्णांकलो(०); }
        }
        यदि (पहचान <= ०) { फेंको नया अपवाद("नए कार्य की पहचान नहीं मिली।"); }
        ल.सहेजो();
        लौटाओ पहचान;
    }
}

फलन स्थितिरखो(भंडार: कार्यभंडार, पहचान: पूर्णांक, पूरा: तार्किक) -> तार्किक {
    संसाधन (क: कथन = भंडार.डाटा.तैयार("UPDATE tasks SET done=? WHERE id=?")) {
        क.तार्किकरखो(१, पूरा);
        क.पूर्णांकरखो(२, पहचान);
        लौटाओ क.चलाओ() == १;
    }
}

फलन कार्यसूची(भंडार: कार्यभंडार, छननी: पूर्णांक) -> पाठ {
    यदि (छननी < ० || छननी > २) { फेंको नया अपवाद("कार्य सूची की छननी अमान्य है।"); }
    स्थिर पंक्तियाँ: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>();
    संसाधन (क: कथन = भंडार.डाटा.तैयार("SELECT CAST(id AS TEXT),title,done FROM tasks WHERE ?=0 OR done=?-1 ORDER BY id")) {
        क.पूर्णांकरखो(१, छननी);
        क.पूर्णांकरखो(२, छननी);
        जबतक (क.अगला()) {
            स्थिर पंक्ति: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
            पंक्ति["id"] = क.पाठलो(०);
            पंक्ति["title"] = क.पाठलो(१);
            पंक्ति["done"] = क.तार्किकलो(२);
            पंक्तियाँ.जोड़ो(पंक्ति);
        }
    }
    लौटाओ जेसन.पाठबनाओ(पंक्तियाँ);
}

फलन भंडारबंदकरो(भंडार: कार्यभंडार) -> शून्य {
    भंडार.डाटा.बंदकरो();
}
