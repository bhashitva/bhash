आयात मानक.डेटा; आयात मानक.डेटासंबंध; आयात मानक.डेटाकथन;
आयात मानक.माइग्रेशन; आयात मानक.माइग्रेशनयोजना; आयात मानक.माइग्रेशनस्थिति;
फलन मुख्य() -> शून्य {
    स्थिर योजना: माइग्रेशनयोजना = नया माइग्रेशनयोजना(नया सूची<माइग्रेशन>{
        नया माइग्रेशन(१,"कार्यसूची",नया सूची<पाठ>{"CREATE TABLE tasks(id BIGINT PRIMARY KEY, title TEXT NOT NULL)"}),
        नया माइग्रेशन(२,"समयसीमा",नया सूची<पाठ>{"ALTER TABLE tasks ADD COLUMN due TEXT"})
    });
    संसाधन (ड: डेटासंबंध = डेटा.एसक्यूलाइट("tasks.db")) {
        लिखो("लागू बदलाव: ",योजना.लागूकरो(ड));
        योजना.जाँचो(ड);
        प्रत्येक (योजना.स्थिति(ड) में म: माइग्रेशनस्थिति) { लिखो(म.संस्करण," ",म.नाम," ",म.लागू); }
        संसाधन (क: डेटाकथन = ड.तैयार("INSERT INTO tasks(id,title) VALUES (?,?) ON CONFLICT(id) DO NOTHING")) {
            क.पूर्णांकरखो(१,१); क.पाठरखो(२,"भारत😀 का स्वागत"); क.चलाओ();
        }
        संसाधन (क: डेटाकथन = ड.तैयार("SELECT title FROM tasks ORDER BY id")) { जबतक (क.अगला()) { लिखो(क.पाठलो(०)); } }
    }
}
