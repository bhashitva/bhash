अभिलेख छात्र(नाम: पाठ, अंक: पूर्णांक);
विकल्पसमूह छात्रखोज {
    मिला(विद्यार्थी: छात्र);
    अनुपस्थित();
    असफल(संदेश: पाठ);
}
फलन खोजो(पहचान: पूर्णांक) -> छात्रखोज {
    यदि (पहचान == १) { लौटाओ छात्रखोज.मिला(नया छात्र("आशा", ९०)); }
    यदि (पहचान == ०) { लौटाओ छात्रखोज.अनुपस्थित(); }
    लौटाओ छात्रखोज.असफल("अमान्य पहचान");
}
फलन विवरण(उत्तर: छात्रखोज) -> पाठ {
    लौटाओ मिलान (उत्तर) {
        विकल्प छात्रखोज.मिला(छात्र(स्थिर नाम, स्थिर अंक)) यदि (अंक >= ८०) => नाम + ": उत्कृष्ट",
        विकल्प छात्रखोज.मिला(स्थिर विद्यार्थी) => विद्यार्थी.नाम,
        विकल्प छात्रखोज.अनुपस्थित() => "छात्र नहीं मिला",
        विकल्प छात्रखोज.असफल(स्थिर संदेश) => संदेश,
    };
}
फलन भागदो(अंश: पूर्णांक, भाजक: पूर्णांक) -> मानक.परिणाम<पूर्णांक, पाठ> {
    यदि (भाजक == ०) { लौटाओ मानक.परिणाम<पूर्णांक, पाठ>.असफल("शून्य से भाग नहीं कर सकते"); }
    लौटाओ मानक.परिणाम<पूर्णांक, पाठ>.सफल(अंश / भाजक);
}
फलन मुख्य() -> शून्य {
    लिखो(विवरण(खोजो(१)), विवरण(खोजो(०)), विवरण(खोजो(-१)));
    स्थिर उत्तर = भागदो(१२, ३);
    मिलान (उत्तर) {
        विकल्प मानक.परिणाम.सफल(स्थिर मूल्य): { लिखो("उत्तर:", मूल्य); }
        विकल्प मानक.परिणाम.असफल(स्थिर दोष): { लिखो("दोष:", दोष); }
    }
    स्थिर रिक्तउत्तर: छात्रखोज? = रिक्त;
    लिखो(मिलान (रिक्तउत्तर) {
        विकल्प रिक्त => "अभी खोज नहीं हुई",
        विकल्प स्थिर उपलब्ध: छात्रखोज => विवरण(उपलब्ध),
    });
    स्थिर क = छात्रखोज.मिला(नया छात्र("आशा", ९०));
    स्थिर ख = छात्रखोज.मिला(नया छात्र("आशा", ९०));
    स्थिर अनुक्रम = नया मानक.समुच्चय<छात्रखोज>();
    अनुक्रम.जोड़ो(क); अनुक्रम.जोड़ो(ख);
    लिखो(क == ख, अनुक्रम.आकार());
    स्थिर पूरा = मानक.परिणाम<मानक.इकाई, पाठ>.सफल(नया मानक.इकाई());
    मिलान (पूरा) {
        विकल्प मानक.परिणाम.सफल(मानक.इकाई()): { लिखो("पूरा"); }
        विकल्प मानक.परिणाम.असफल(स्थिर दोष): { लिखो(दोष); }
    }
}
