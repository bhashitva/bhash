असमकालिक फलन लाओ(पहचान: पूर्णांक) -> मानक.परिणाम<पाठ, पाठ> {
    प्रतीक्षा मानक.कार्य.विलंब(१);
    यदि (पहचान < ०) { लौटाओ मानक.परिणाम<पाठ, पाठ>.असफल("पहचान अमान्य"); }
    लौटाओ मानक.परिणाम<पाठ, पाठ>.सफल("भारत😀");
}
असमकालिक फलन स्वीकारो(पाठमान: पाठ) -> तार्किक {
    प्रतीक्षा मानक.कार्य.विलंब(१);
    लौटाओ पाठमान != "";
}
असमकालिक फलन मुख्य() -> शून्य {
    स्थिर उत्तर = प्रतीक्षा लाओ(१);
    स्थिर संदेश = मिलान (उत्तर) {
        विकल्प मानक.परिणाम.सफल(स्थिर मूल्य) यदि (प्रतीक्षा स्वीकारो(मूल्य)) => मूल्य,
        विकल्प मानक.परिणाम.सफल(_) => "खाली पाठ",
        विकल्प मानक.परिणाम.असफल(स्थिर दोष) => दोष,
    };
    लिखो(संदेश);
    स्थिर दूसरा = प्रतीक्षा लाओ(-१);
    मिलान (दूसरा) {
        विकल्प मानक.परिणाम.सफल(स्थिर मूल्य): { लिखो(मूल्य); }
        विकल्प मानक.परिणाम.असफल(स्थिर दोष): { लिखो(दोष); }
    }
}
