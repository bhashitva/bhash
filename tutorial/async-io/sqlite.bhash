आयात मानक.असमडेटा;आयात मानक.असमडेटासंबंध;आयात मानक.असमडेटाकथन;आयात मानक.असमडेटालेनदेन;
असमकालिक फलन सहेजो(ड:असमडेटासंबंध)->शून्य {
    असमकालिक संसाधन(ल:असमडेटालेनदेन=प्रतीक्षा ड.लेनदेन()){
        असमकालिक संसाधन(क:असमडेटाकथन=प्रतीक्षा ड.तैयार("INSERT INTO notes(id,title) VALUES (?,?)")){
            क.पूर्णांकरखो(१,१);क.पाठरखो(२,"नमस्ते, भारत😀");स्थिर बदले:पूर्णांक=प्रतीक्षा क.चलाओ();
        }
        प्रतीक्षा ल.सहेजो();
    }
}
असमकालिक फलन मुख्य()->शून्य {
    असमकालिक संसाधन(ड:असमडेटासंबंध=प्रतीक्षा असमडेटा.एसक्यूलाइट(":memory:")){
        असमकालिक संसाधन(क:असमडेटाकथन=प्रतीक्षा ड.तैयार("CREATE TABLE notes(id INTEGER PRIMARY KEY,title TEXT NOT NULL)")){
            स्थिर बदले:पूर्णांक=प्रतीक्षा क.चलाओ();
        }
        प्रतीक्षा सहेजो(ड);
        असमकालिक संसाधन(क:असमडेटाकथन=प्रतीक्षा ड.तैयार("SELECT title FROM notes ORDER BY id")){
            जबतक(प्रतीक्षा क.अगला()){लिखो(क.पाठलो(०));}
        }
    }
}
