आयात मानक.सत्र; आयात मानक.सत्रप्रबंधक; आयात मानक.कुकी; आयात मानक.प्रवेशरक्षक;
आयात मानक.वेब; आयात मानक.वेबअनुरोध; आयात मानक.वेबउत्तर; आयात मानक.वेबचालक;
आयात मानक.सुरक्षितवेब; आयात मानक.अधिकृतचालक; आयात मानक.पाठ्य;
वर्ग खाता पालन वेबचालक {
    सार्वजनिक फलन संभालो(अ: वेबअनुरोध) -> वेबउत्तर { लौटाओ वेब.पाठउत्तर(२००,"अनुमति मिली।"); }
}
फलन मुख्य() -> शून्य {
    संसाधन (म: सत्रप्रबंधक = नया सत्रप्रबंधक("https://app.example")) {
        स्थिर स: सत्र = म.आरंभ("मनोज",नया सूची<पाठ>{"reader"});
        स्थिर अ: वेबअनुरोध = नया वेबअनुरोध("POST","/account",नया सूची<पाठ>{"host","app.example","origin","https://app.example","cookie","__Host-bhash-session="+स.पहचान(),"x-csrf-token",स.सीएसआरएफ()},नया बाइटबफ़र(०));
        म.मूलजाँचो(अ); म.सीएसआरएफजाँचो(अ); लिखो("अनुमत खाता:",म.अधिकृत(अ,"reader").उपयोगकर्ता());
        स्थिर चालक: सुरक्षितवेब = नया सुरक्षितवेब(म,नया अधिकृतचालक(म,"reader",नया खाता()));
        स्थिर उत्तर: वेबउत्तर = चालक.संभालो(अ); लिखो("स्थिति:",उत्तर.स्थिति);
        म.कुकीरखो(उत्तर,स); कुकी.सुरक्षितजोड़ो(उत्तर,"theme","light",३६००);
        उत्तर.शीर्षजोड़ो("X-Example","ready");
        लिखो("अलग Set-Cookie शीर्ष:",वेब.मानलो(उत्तर.शीर्ष,"set-cookie").आकार);
        लिखो("कुकी पढ़ी गई:",कुकी.पढ़ो(अ,"__Host-bhash-session")==स.पहचान());
        लिखो("Host शीर्ष:",कुकी.शीर्षलो(अ,"host")[०]); कुकी.नामजाँचो("theme"); कुकी.मानजाँचो("light");
        म.समाप्त(अ,उत्तर); म.कुकीमिटाओ(वेब.पाठउत्तर(२०४,"")); लिखो("logout के बाद सत्र:",म.आकार());
        म.बंदकरो();
    }
    संसाधन (स्थानीय: सत्रप्रबंधक = सत्रप्रबंधक.स्थानीय("http://127.0.0.1:8080")) { लिखो("स्थानीय भंडार खाली:",स्थानीय.आकार()==०); }
    संसाधन (सीमा: प्रवेशरक्षक = नया प्रवेशरक्षक()) { सीमा.प्रयासकरो("मनोज"); सीमा.बंदकरो(); }
}
