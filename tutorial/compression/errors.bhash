// bhash:null-safety=strict
आयात मानक.संपीड़न;
आयात मानक.संपीड़नप्रारूप;
आयात मानक.संपीड़नदोष;
फलन दिखाओ(दोष: संपीड़नदोष) -> शून्य {
    लिखो(दोष.कोड.नाम, ": ", दोष.संदेश);
}
फलन मुख्य() -> शून्य {
    स्थिर मूल = यूटीएफ८बफ़र("यह compressed डेटा नहीं है।");
    मिलान (संपीड़न.विसंपीड़ितकरो(मूल, संपीड़नप्रारूप.जेडलिब, १०२४)) {
        विकल्प मानक.परिणाम.सफल(स्थिर बफ़र): { लिखो("अप्रत्याशित सफलता"); }
        विकल्प मानक.परिणाम.असफल(स्थिर दोष): { दिखाओ(दोष); }
    }
}
