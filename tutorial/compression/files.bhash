// bhash:null-safety=strict
// Creates/replaces compression-demo-input.txt and compression-demo-output.gz.
आयात मानक.प्रवाह;
आयात मानक.फ़ाइल;
आयात मानक.संपीड़न;
आयात मानक.संपीड़नप्रारूप;
फलन फ़ाइलपैककरो(आगत: पाठ, निर्गत: पाठ) -> शून्य {
    संसाधन (पाठक: प्रवाह = प्रवाह.पठन(आगत)) {
        स्थिर बफ़र = पाठक.पढ़ो(१०४८५७६);
        यदि (पाठक.पढ़ो(१).आकार > ०) { त्रुटि("इस उदाहरण में फ़ाइल की सीमा १ MiB है।"); }
        मिलान (संपीड़न.संपीड़ितकरो(बफ़र, संपीड़नप्रारूप.गज़िप, ६)) {
            विकल्प मानक.परिणाम.सफल(स्थिर पैक): { फ़ाइल.बाइटलिखो(निर्गत, पैक); }
            विकल्प मानक.परिणाम.असफल(स्थिर दोष): { त्रुटि(दोष.संदेश); }
        }
    }
}
फलन मुख्य() -> शून्य {
    फ़ाइल.पाठलिखो("compression-demo-input.txt", "नमस्ते भारत 😀");
    फ़ाइलपैककरो("compression-demo-input.txt", "compression-demo-output.gz");
    लिखो("गज़िप फ़ाइल तैयार है।");
}
