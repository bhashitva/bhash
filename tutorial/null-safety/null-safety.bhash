// bhash:null-safety=strict
वर्ग छात्र {
    सार्वजनिक स्थिर नाम: पाठ;
    निर्माता(नाम: पाठ) { यह.नाम = नाम; }
    सार्वजनिक फलन नामलो() -> पाठ { लौटाओ नाम; }
}

फलन खोजो(मिला: तार्किक) -> छात्र? {
    यदि (मिला) { लौटाओ नया छात्र("सीमा"); }
    लौटाओ रिक्त;
}

फलन अगला(अंक: पूर्णांक?) -> पूर्णांक {
    यदि (अंक == रिक्त) { लौटाओ ०; }
    लौटाओ अंक + १;
}

फलन पहचान<त>(मानक: त) -> त { लौटाओ मानक; }

फलन मुख्य() -> शून्य {
    स्थिर मिला: छात्र? = खोजो(सत्य);
    स्थिर अनुपस्थित: छात्र? = खोजो(असत्य);
    लिखो(मिला?.नामलो() ?? "अज्ञात", अनुपस्थित?.नाम ?? "अज्ञात");
    लिखो(अगला(४), अगला(रिक्त));
    स्थिर अंक: सूची<पूर्णांक?> = नया सूची<पूर्णांक?>{०, रिक्त, ७};
    प्रत्येक (अंक में मानक: पूर्णांक?) { लिखो(मानक ?? ९); }
    स्थिर मूल: सर्ववस्तु? = ५;
    स्थिर प्राप्त = सुरक्षितरूप<पूर्णांक>(मूल);
    लिखो(पहचान(प्राप्त) ?? ९);
    लिखो(मानक.जेसन.पाठबनाओ(मानक.जेसन.पढ़ो("null")));
}
