// फलन मान (Function values), प्रतिपुष्टि फलन (Callbacks) और संवृतियाँ (Closures).
फलन दुगुना(अंक: पूर्णांक) -> पूर्णांक { लौटाओ अंक * २; }

फलन लगाओ(क: फलन(पूर्णांक) -> पूर्णांक, अंक: पूर्णांक) -> पूर्णांक {
    लौटाओ क(अंक);
}

फलन गिनकबनाओ(आरंभ: पूर्णांक) -> फलन() -> पूर्णांक {
    मान गिनती: पूर्णांक = आरंभ;
    लौटाओ फलन() -> पूर्णांक {
        गिनती = गिनती + १;
        लौटाओ गिनती;
    };
}

फलन मुख्य() -> शून्य {
    स्थिर क: फलन(पूर्णांक) -> पूर्णांक = दुगुना;
    लिखो(लगाओ(क, ५));
    लिखो(लगाओ(फलन(अंक: पूर्णांक) -> पूर्णांक { लौटाओ अंक + ३; }, ५));

    स्थिर पहला: फलन() -> पूर्णांक = गिनकबनाओ(१०);
    स्थिर दूसरा: फलन() -> पूर्णांक = गिनकबनाओ(२०);
    लिखो(पहला(), पहला(), दूसरा());

    स्थिर काम: सूची<फलन() -> पूर्णांक> = नया सूची<फलन() -> पूर्णांक>();
    प्रत्येक (नया पूर्णांक[]{१, २, ३} में अंक: पूर्णांक) {
        काम.जोड़ो(फलन() -> पूर्णांक { लौटाओ अंक * अंक; });
    }
    लिखो(काम[०](), काम[१](), काम[२]());
}
