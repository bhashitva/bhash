आयात मानक.समय;

कार्य मुख्य() -> शून्य {
    // अभी (Current Time / Now)
    {
        लिखो("समय.अभी");
        स्थिर क्षण: पूर्णांक = समय.अभी();
        लिखो(क्षण > ०);
    }
    // पढ़ो (Parse UTC Timestamp)
    {
        लिखो("समय.पढ़ो");
        लिखो(समय.पढ़ो("1970-01-01T00:00:00.000Z"));
        स्थिर क्षण: पूर्णांक = समय.पढ़ो("2000-02-29T12:34:56.789Z");
        लिखो(समय.पाठबनाओ(क्षण));
    }
    // पाठबनाओ (Format UTC Timestamp)
    {
        लिखो("समय.पाठबनाओ");
        लिखो(समय.पाठबनाओ(०));
        लिखो(समय.पाठबनाओ(-१));
    }
    // वर्ष (Year)
    {
        लिखो("समय.वर्ष");
        स्थिर क्षण: पूर्णांक = समय.पढ़ो("2000-02-29T12:34:56.789Z");
        लिखो(समय.वर्ष(क्षण));
    }
    // माह (Month)
    {
        लिखो("समय.माह");
        स्थिर क्षण: पूर्णांक = समय.पढ़ो("2000-02-29T12:34:56.789Z");
        लिखो(समय.माह(क्षण));
    }
    // दिन (Day of Month)
    {
        लिखो("समय.दिन");
        स्थिर क्षण: पूर्णांक = समय.पढ़ो("2000-02-29T12:34:56.789Z");
        लिखो(समय.दिन(क्षण));
    }
}
