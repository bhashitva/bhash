आयात मानक.पाठ्य;
आयात मानक.गणित;
आयात मानक.यादृच्छिक;
आयात मानक.जेसन;
आयात मानक.समय;
कार्य मुख्य() -> शून्य {
    प्रयास { पाठ्य.अंश("abc", २, १); } पकड़ो (ग: अपवाद) { लिखो("अमान्य सीमा पकड़ी"); }
    प्रयास { पाठ्य.बाँटो("क,ख", ""); } पकड़ो (ग: अपवाद) { लिखो("खाली विभाजक पकड़ा"); }
    प्रयास { पाठ्य.दोहराओ("क", -१); } पकड़ो (ग: अपवाद) { लिखो("ऋणात्मक दोहराव पकड़ा"); }
    प्रयास { पाठ्य.संख्यापाठ(१.०, १६); } पकड़ो (ग: अपवाद) { लिखो("दशमलव स्थान की सीमा पकड़ी"); }
    प्रयास { गणित.निरपेक्ष(-९२२३३७२०३६८५४७७५८०८); } पकड़ो (ग: अपवाद) { लिखो("पूर्णांक सीमा पकड़ी"); }
    प्रयास { गणित.वर्गमूल(-१.०); } पकड़ो (ग: अपवाद) { लिखो("ऋणात्मक वर्गमूल पकड़ा"); }
    प्रयास { गणित.लघुगणक(०.०); } पकड़ो (ग: अपवाद) { लिखो("लघुगणक का डोमेन पकड़ा"); }
    प्रयास { यादृच्छिक.पूर्णांकचुनो(१, १); } पकड़ो (ग: अपवाद) { लिखो("यादृच्छिक सीमा पकड़ी"); }
    प्रयास { जेसन.पढ़ो("{\"क\":1,\"क\":2}"); } पकड़ो (ग: अपवाद) { लिखो("दोहरी JSON कुंजी पकड़ी"); }
    प्रयास { जेसन.पढ़ो("[१२]"); } पकड़ो (ग: अपवाद) { लिखो("JSON में गैर-ASCII अंक पकड़े"); }
    स्थिर चक्र: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>(); चक्र.जोड़ो(चक्र);
    प्रयास { जेसन.पाठबनाओ(चक्र); } पकड़ो (ग: अपवाद) { लिखो("चक्रीय संग्रह पकड़ा"); }
    प्रयास { समय.पढ़ो("1900-02-29T00:00:00.000Z"); } पकड़ो (ग: अपवाद) { लिखो("अमान्य दिनांक पकड़ा"); }
    प्रयास { समय.पढ़ो("2000-02-29T00:00:00Z"); } पकड़ो (ग: अपवाद) { लिखो("अपूर्ण समय प्रारूप पकड़ा"); }
    स्थिर खराब: बाइटबफ़र = नया बाइटबफ़र{परिवर्तित<बाइट>(२५५)};
    प्रयास { पाठ्य.यूटीएफ८पाठ(खराब); } पकड़ो (ग: अपवाद) { लिखो("अमान्य UTF-8 पकड़ा"); }
}
