आयात मानक.समवेबचालक;
आयात मानक.असमवेबचालक;
आयात मानक.असमसुरक्षितवेब;
आयात मानक.सत्रप्रबंधक;
आयात मानक.निरस्तीकरणचिह्न;
आयात मानक.वेब;
आयात मानक.वेबचालक;
आयात मानक.वेबअनुरोध;
आयात मानक.वेबउत्तर;

वर्ग हाल पालन वेबचालक {
    फलन संभालो(अनुरोध: वेबअनुरोध) -> वेबउत्तर {
        लौटाओ वेब.पाठउत्तर(२००, "सेवा तैयार");
    }
}

असमकालिक फलन मुख्य() -> शून्य {
    स्थिर जाँच: वेबअनुरोध = नया वेबअनुरोध("GET", "/health", नया सूची<पाठ>(), नया बाइटबफ़र(०));
    स्थिर रोक: निरस्तीकरणचिह्न = नया निरस्तीकरणचिह्न();
    स्थिर चालक: असमवेबचालक = नया समवेबचालक(नया हाल());
    स्थिर उत्तर: वेबउत्तर = प्रतीक्षा चालक.संभालो(जाँच, रोक);
    लिखो(उत्तर.स्थिति);
    संसाधन (सत्र: सत्रप्रबंधक = नया सत्रप्रबंधक("https://example.org")) {
        स्थिर आवरण: असमसुरक्षितवेब = नया असमसुरक्षितवेब(सत्र, चालक);
        स्थिर सुरक्षितउत्तर: वेबउत्तर = प्रतीक्षा आवरण.संभालो(जाँच, रोक);
        लिखो(वेब.मानलो(सुरक्षितउत्तर.शीर्ष, "cache-control")[०]);
    }
}
