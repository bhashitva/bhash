आयात मानक.समूहन;
आयात मानक.रूपांतरक;

वर्ग समविषम पालन रूपांतरक<पूर्णांक, पाठ> {
    फलन बदलो(अंक: पूर्णांक) -> पाठ {
        यदि (अंक % २ == ०) { लौटाओ "सम"; }
        लौटाओ "विषम";
    }
}

फलन मुख्य() -> शून्य {
    स्थिर अंक: सूची<पूर्णांक> = नया सूची<पूर्णांक>{३, २, ७, ४, ६};
    स्थिर समूह: मानचित्र<पाठ, सूची<पूर्णांक>> = समूहन<पूर्णांक, पाठ>.समूहित(अंक, नया समविषम());
    लिखो("पहला विषम:", समूह["विषम"][०]);
    लिखो("सम अंकों की संख्या:", समूह["सम"].आकार);
}
