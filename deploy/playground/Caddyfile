{
    email {$ACME_EMAIL}
}
{$PLAY_DOMAIN} {
    encode zstd gzip
    header {
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
    @artifacts path /artifacts/*
    respond @artifacts 404
    reverse_proxy service:8080 {
        header_up X-Playground-Client {remote_host}
    }
}
{$RUN_DOMAIN} {
    encode zstd gzip
    header {
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
    handle /artifacts/* {
        reverse_proxy service:8080
    }
    handle {
        respond 404
    }
}
