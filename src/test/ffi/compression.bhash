आयात मानक.संपीड़न;
आयात मानक.संपीड़नप्रारूप;
आयात मानक.संपीड़नदोष;
फलन खोलो(फल: मानक.परिणाम<बाइटबफ़र, संपीड़नदोष>) -> बाइटबफ़र {
    लौटाओ मिलान (फल) {
        विकल्प मानक.परिणाम.सफल(स्थिर मूल्य) => मूल्य,
        विकल्प मानक.परिणाम.असफल(स्थिर दोष) => नया बाइटबफ़र(०),
    };
}
फलन मुख्य() -> शून्य {
    स्थिर मूल = यूटीएफ८बफ़र("भारत😀 नमस्ते");
    स्थिर पैक = खोलो(संपीड़न.संपीड़ितकरो(मूल, संपीड़नप्रारूप.गज़िप, ६));
    स्थिर खुला = खोलो(संपीड़न.विसंपीड़ितकरो(पैक, संपीड़नप्रारूप.गज़िप, १०२४));
    लिखो(यूटीएफ८पाठ(खुला));
    मिलान (संपीड़न.विसंपीड़ितकरो(पैक, संपीड़नप्रारूप.गज़िप, १)) {
        विकल्प मानक.परिणाम.सफल(स्थिर मूल्य): { लिखो("अप्रत्याशित"); }
        विकल्प मानक.परिणाम.असफल(स्थिर दोष): { लिखो(दोष.कोड.नाम); }
    }
    मिलान (संपीड़न.विसंपीड़ितकरो(मूल, संपीड़नप्रारूप.जेडलिब, १०२४)) {
        विकल्प मानक.परिणाम.सफल(स्थिर मूल्य): { लिखो("अप्रत्याशित"); }
        विकल्प मानक.परिणाम.असफल(स्थिर दोष): { लिखो(दोष.कोड.नाम); }
    }
}
