आयात परीक्षण.जोड़;
आयात परीक्षण.गणक;
फलन छोड़ो() -> शून्य { स्थिर अस्थायी = गणक.बनाओ(७); }
फलन अपवादपथ() -> शून्य {
    संसाधन (ग: गणक = गणक.बनाओ(५)) {
        स्थिर दबाव = नया बाइटबफ़र(१२८);
        फेंको नया अपवाद("संसाधन के भीतर परीक्षण अपवाद");
    }
}
फलन मुख्य() -> शून्य {
    यदि (जोड़.वास्तविकदुगुना(३.५) != ७.० || जोड़.बाइटलो(परिवर्तित<बाइट>(२५५)) != २५५
            || जोड़.नकारो(सत्य) || !जोड़.नकारो(असत्य)) {
        त्रुटि("primitive wire conversion बदला।");
    }
    लिखो(जोड़.जोड़ो(२, ३), जोड़.प्रतिध्वनि("भारत😀"));
    संसाधन (ग: गणक = गणक.बनाओ(४२)) { लिखो(गणक.मूल्य(ग)); }
    लिखो(गणक.जीवित());
    स्थिर ग = गणक.बनाओ(९);
    स्थिर उर्फ = ग;
    स्थिर बक्सा: सर्ववस्तु = ग;
    स्थिर समूह: सूची<गणक> = नया सूची<गणक>();
    समूह.जोड़ो(ग);
    स्थिर दाब = नया बाइटबफ़र(१२८);
    यदि (गणक.मूल्य(परिवर्तित<गणक>(बक्सा)) != ९ || गणक.मूल्य(समूह[०]) != ९) {
        त्रुटि("boxed या संग्रह में रखा संसाधन खो गया।");
    }
    मान विधि = ०;
    जबतक (विधि < २) {
        मान अस्वीकृत = असत्य;
        प्रयास { स्थिर जाली = गणक.दुबारा(विधि); }
        पकड़ो (दोष: अपवाद) { अस्वीकृत = सत्य; }
        यदि (!अस्वीकृत || गणक.मूल्य(ग) != ९ || गणक.जीवित() != १) {
            त्रुटि("दोबारा स्वामित्व देने से मूल संसाधन बदल गया।");
        }
        विधि = विधि + १;
    }
    ग.बंदकरो();
    उर्फ.बंदकरो();
    प्रयास { लिखो(गणक.मूल्य(उर्फ)); }
    पकड़ो (दोष: अपवाद) { लिखो("बन्द"); }
    लिखो(गणक.जीवित());
    प्रयास { अपवादपथ(); }
    पकड़ो (दोष: अपवाद) { यदि (गणक.जीवित() != ०) { त्रुटि("unwinding में संसाधन बंद नहीं हुआ।"); } }
    मान गिनती = ०;
    जबतक (गिनती < ३००) { छोड़ो(); गिनती = गिनती + १; }
    // Forced native GC runs at allocation seams, so collect the last discarded wrapper too.
    स्थिर दबाव = नया बाइटबफ़र(१);
    गणक.जीवित();
    लिखो(गणक.जीवित());
}
