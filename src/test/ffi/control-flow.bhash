आयात मानक.संपीड़न;
आयात मानक.संपीड़नप्रारूप;
फलन मुख्य() -> शून्य {
    प्रयास { फेंको नया अपवाद("दोष"); }
    पकड़ो (द: अपवाद) {
        स्थिर पैक = संपीड़न.संपीड़ितकरो(यूटीएफ८बफ़र("भारत😀"), संपीड़नप्रारूप.गज़िप, ६);
        लिखो("catch");
    }
    चयन (१) {
        विकल्प १:
            स्थिर पैक = संपीड़न.संपीड़ितकरो(यूटीएफ८बफ़र("भारत😀"), संपीड़नप्रारूप.जेडलिब, ६);
            लिखो("case");
            विराम;
        शेष: त्रुटि("गलत विकल्प");
    }
}
