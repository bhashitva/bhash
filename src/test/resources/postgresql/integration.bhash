// SPDX-License-Identifier: Apache-2.0
आयात मानक.डेटा; आयात मानक.डेटासंबंध; आयात मानक.डेटाकथन; आयात मानक.डेटालेनदेन;
आयात मानक.पोस्टग्रेसविन्यास; आयात मानक.परीक्षण; आयात मानक.विन्यास;
आयात मानक.माइग्रेशन; आयात मानक.माइग्रेशनयोजना;
फलन मुख्य() -> शून्य {
    स्थिर व: पोस्टग्रेसविन्यास = नया पोस्टग्रेसविन्यास();
    व.मेज़बान=विन्यास.परिवेश("BHASH_PG_HOST","localhost");
    व.पोर्ट=परिवर्तित<पूर्णांक>(विन्यास.परिवेश("BHASH_PG_PORT","5432"));
    व.डेटाबेस=विन्यास.परिवेश("BHASH_PG_DATABASE","bhash_test");
    व.उपयोगकर्ता=विन्यास.परिवेश("BHASH_PG_USER","bhash");
    व.गुप्तशब्द=विन्यास.परिवेश("BHASH_PG_PASSWORD","");
    व.सुरक्षा=विन्यास.परिवेश("BHASH_PG_SSLMODE","verify-full");
    व.प्रमाणपत्र=विन्यास.परिवेश("BHASH_PG_CA","");
    व.कथनसमय=१०००;
    संसाधन (ड: डेटासंबंध = डेटा.पोस्टग्रेस(व)) {
        // Each test connection uses only session-local tables.
        संसाधन (क: डेटाकथन = ड.तैयार("CREATE TEMP TABLE values_test(id BIGINT PRIMARY KEY, title TEXT)")) { क.चलाओ(); }
        संसाधन (क: डेटाकथन = ड.तैयार("SELECT ?::bigint AS संख्या, ?::float8, ?::boolean, ?::text, ?::bytea, ?::text, ?::numeric, ?::date")) {
            परीक्षण.बराबर(८,क.बंधनसंख्या()); परीक्षण.बराबर(८,क.स्तंभसंख्या()); परीक्षण.बराबर("संख्या",क.स्तंभनाम(०));
            क.पूर्णांकरखो(१,९२२३३७२०३६८५४७७५८०७); क.दशमलवरखो(२,१.२५); क.तार्किकरखो(३,सत्य);
            क.पाठरखो(४,"भारत😀 '; DROP TABLE values_test; --");
            स्थिर ब: बाइटबफ़र = नया बाइटबफ़र(३); ब[०]=परिवर्तित<बाइट>(०); ब[१]=परिवर्तित<बाइट>(१२८); ब[२]=परिवर्तित<बाइट>(२५५);
            क.बाइटरखो(५,ब); ब[२]=परिवर्तित<बाइट>(१); क.रिक्तरखो(६);
            क.पाठरखो(७,"12345678901234567890.123456789"); क.पाठरखो(८,"2026-11-02");
            परीक्षण.सत्यहै(क.अगला(),"पहली पंक्ति");
            परीक्षण.बराबर(९२२३३७२०३६८५४७७५८०७,क.पूर्णांकलो(०)); परीक्षण.सत्यहै(क.दशमलवलो(१)==१.२५,"दशमलव"); परीक्षण.सत्यहै(क.तार्किकलो(२),"तार्किक");
            परीक्षण.बराबर("भारत😀 '; DROP TABLE values_test; --",क.पाठलो(३));
            स्थिर मिला: बाइटबफ़र = क.बाइटलो(४); परीक्षण.बराबर(२५५,परिवर्तित<पूर्णांक>(मिला[२]));
            परीक्षण.सत्यहै(क.रिक्तहै(५),"रिक्त"); परीक्षण.बराबर("रिक्त",क.प्रकार(५));
            परीक्षण.बराबर("12345678901234567890.123456789",क.पाठलो(६)); परीक्षण.बराबर("सटीकदशमलव",क.प्रकार(६));
            परीक्षण.बराबर("2026-11-02",क.पाठलो(७));
            परीक्षण.सत्यहै(!क.अगला(),"समाप्त"); परीक्षण.बराबर(२५५,परिवर्तित<पूर्णांक>(मिला[२]));
            क.रीसेट(); परीक्षण.सत्यहै(क.अगला(),"पुनः बंधन"); क.रीसेट(); क.बंधनमिटाओ();
            मान रोका: तार्किक = असत्य; प्रयास { क.अगला(); } पकड़ो (ग: अपवाद) { रोका=सत्य; }
            परीक्षण.सत्यहै(रोका,"सभी बंधन आवश्यक");
        }
        संसाधन (ल: डेटालेनदेन = ड.लेनदेन()) {
            संसाधन (क: डेटाकथन = ड.तैयार("INSERT INTO values_test VALUES (1,'सहेजा')")) { परीक्षण.बराबर(१,क.चलाओ()); }
            ल.सहेजो();
        }
        संसाधन (ल: डेटालेनदेन = ड.लेनदेन()) {
            संसाधन (क: डेटाकथन = ड.तैयार("INSERT INTO values_test VALUES (2,'वापस')")) { क.चलाओ(); }
        }
        संसाधन (ल: डेटालेनदेन = ड.लेनदेन()) {
            मान रोका: तार्किक = असत्य;
            प्रयास { संसाधन (क: डेटाकथन = ड.तैयार("INSERT INTO values_test VALUES (1,'duplicate')")) { क.चलाओ(); } } पकड़ो (ग: अपवाद) { रोका=सत्य; }
            परीक्षण.सत्यहै(रोका,"duplicate रोका"); रोका=असत्य;
            प्रयास { ल.सहेजो(); } पकड़ो (ग: अपवाद) { रोका=सत्य; }
            परीक्षण.सत्यहै(रोका,"असफल लेनदेन commit नहीं हो");
        }
        संसाधन (क: डेटाकथन = ड.तैयार("SELECT count(*) FROM values_test")) { क.अगला(); परीक्षण.बराबर(१,क.पूर्णांकलो(०)); }
        // Temporary history allows independent JVM/CLR/native runs against one CI database.
        संसाधन (क: डेटाकथन = ड.तैयार("CREATE TEMP TABLE bhash_schema_history(version BIGINT PRIMARY KEY,name TEXT NOT NULL,checksum TEXT NOT NULL)")) { क.चलाओ(); }
        स्थिर म१: माइग्रेशन = नया माइग्रेशन(१,"आरंभ",नया सूची<पाठ>{"CREATE TEMP TABLE migration_test(id BIGINT PRIMARY KEY,title TEXT)","INSERT INTO migration_test VALUES (1,'भारत😀')"});
        स्थिर म२: माइग्रेशन = नया माइग्रेशन(२,"विस्तार",नया सूची<पाठ>{"ALTER TABLE migration_test ADD COLUMN due TEXT"});
        स्थिर योजना: माइग्रेशनयोजना = नया माइग्रेशनयोजना(नया सूची<माइग्रेशन>{म१,म२});
        परीक्षण.बराबर(२,योजना.लागूकरो(ड)); परीक्षण.बराबर(०,योजना.लागूकरो(ड)); योजना.जाँचो(ड);
        स्थिर खराब: माइग्रेशनयोजना = नया माइग्रेशनयोजना(नया सूची<माइग्रेशन>{म१,म२,नया माइग्रेशन(३,"असफल",नया सूची<पाठ>{"INSERT INTO migration_test VALUES (2,'rollback',NULL)","INSERT INTO migration_test VALUES (1,'duplicate',NULL)"})});
        मान असफल: तार्किक = असत्य; प्रयास { खराब.लागूकरो(ड); } पकड़ो (ग: अपवाद) { असफल=सत्य; }
        परीक्षण.सत्यहै(असफल,"माइग्रेशन असफल हो"); योजना.जाँचो(ड);
        संसाधन (क: डेटाकथन = ड.तैयार("SELECT count(*) FROM migration_test")) { क.अगला(); परीक्षण.बराबर(१,क.पूर्णांकलो(०)); }
        मान च: पूर्णांक=०;
        जबतक (च < २००) {
            संसाधन (क: डेटाकथन = ड.तैयार("SELECT ?::text, ?::bytea")) {
                क.पाठरखो(१,"भारत😀"+परिवर्तित<पाठ>(च)); क.बाइटरखो(२,नया बाइटबफ़र(०));
                क.अगला(); परीक्षण.बराबर("भारत😀"+परिवर्तित<पाठ>(च),क.पाठलो(०)); परीक्षण.बराबर(०,क.बाइटलो(१).आकार);
            } च=च+१;
        }
    }
    लिखो("PostgreSQL ठीक");
}
