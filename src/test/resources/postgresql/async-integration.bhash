आयात मानक.असमडेटा; आयात मानक.असमडेटासंबंध; आयात मानक.असमडेटाकथन; आयात मानक.असमडेटालेनदेन;
आयात मानक.कार्य; आयात मानक.कार्यफल; आयात मानक.निरस्तीकरणस्रोत; आयात मानक.निरस्तअपवाद;
असमकालिक फलन निरस्तबाद(स:निरस्तीकरणस्रोत)->शून्य {प्रतीक्षा कार्य.विलंब(२५);स.निरस्तकरो();}
असमकालिक फलन मुख्य()->शून्य {
    तुल्यकालिकजाँच();
    स्थिर व: पोस्टग्रेसविन्यास = नया पोस्टग्रेसविन्यास();
    व.मेज़बान=विन्यास.परिवेश("BHASH_PG_HOST","localhost");
    व.पोर्ट=परिवर्तित<पूर्णांक>(विन्यास.परिवेश("BHASH_PG_PORT","5432"));
    व.डेटाबेस=विन्यास.परिवेश("BHASH_PG_DATABASE","bhash_test");
    व.उपयोगकर्ता=विन्यास.परिवेश("BHASH_PG_USER","bhash");
    व.गुप्तशब्द=विन्यास.परिवेश("BHASH_PG_PASSWORD","");
    व.सुरक्षा=विन्यास.परिवेश("BHASH_PG_SSLMODE","verify-full");
    व.प्रमाणपत्र=विन्यास.परिवेश("BHASH_PG_CA","");
    व.कथनसमय=३००००;

    प्रतीक्षा पोस्टमूल(व);प्रतीक्षा पोस्टमान(व);प्रतीक्षा पोस्टनिरस्त(व);
    प्रतीक्षा प्रतिबद्धजाँच(व,असत्य);प्रतीक्षा प्रतिबद्धजाँच(व,सत्य);
    परीक्षण.बराबर(०,मानक.असमडाटातंत्र.जीवित());
}
असमकालिक फलन पोस्टमूल(व:पोस्टग्रेसविन्यास)->शून्य {
    असमकालिक संसाधन(ड:असमडेटासंबंध=प्रतीक्षा असमडेटा.पोस्टग्रेस(व)){
        असमकालिक संसाधन(क:असमडेटाकथन=प्रतीक्षा ड.तैयार("CREATE TEMP TABLE async_entries(id BIGINT PRIMARY KEY,title TEXT)")){स्थिर ग:पूर्णांक=प्रतीक्षा क.चलाओ();}
        असमकालिक संसाधन(ल:असमडेटालेनदेन=प्रतीक्षा ड.लेनदेन()){
            असमकालिक संसाधन(क:असमडेटाकथन=प्रतीक्षा ड.तैयार("INSERT INTO async_entries VALUES (?,?)")){
                क.पूर्णांकरखो(१,४२);क.पाठरखो(२,"भारत😀 '; DROP TABLE async_entries; --");परीक्षण.बराबर(१,प्रतीक्षा क.चलाओ());
            }
            प्रतीक्षा ल.सहेजो();
        }
        असमकालिक संसाधन(ल:असमडेटालेनदेन=प्रतीक्षा ड.लेनदेन()){
            असमकालिक संसाधन(क:असमडेटाकथन=प्रतीक्षा ड.तैयार("INSERT INTO async_entries VALUES (43,'rollback')")){स्थिर ग:पूर्णांक=प्रतीक्षा क.चलाओ();}
        }
        असमकालिक संसाधन(क:असमडेटाकथन=प्रतीक्षा ड.तैयार("SELECT id,title FROM async_entries")){
            परीक्षण.बराबर(सत्य,प्रतीक्षा क.अगला());परीक्षण.बराबर(४२,क.पूर्णांकलो(०));
            परीक्षण.बराबर("भारत😀 '; DROP TABLE async_entries; --",क.पाठलो(१));परीक्षण.बराबर(असत्य,प्रतीक्षा क.अगला());
            प्रतीक्षा क.रीसेट();परीक्षण.बराबर(सत्य,प्रतीक्षा क.अगला());
        }
    }
}
असमकालिक फलन पोस्टमान(व:पोस्टग्रेसविन्यास)->शून्य {
    असमकालिक संसाधन(ड:असमडेटासंबंध=प्रतीक्षा असमडेटा.पोस्टग्रेस(व)){
        असमकालिक संसाधन(क:असमडेटाकथन=प्रतीक्षा ड.तैयार("SELECT ?::bigint,?::float8,?::boolean,?::text,?::bytea,?::text,?::numeric,?::date")){
            क.पूर्णांकरखो(१,९२२३३७२०३६८५४७७५८०७);क.दशमलवरखो(२,१.२५);क.तार्किकरखो(३,सत्य);क.पाठरखो(४,"भारत😀");
            स्थिर ब:बाइटबफ़र=नया बाइटबफ़र(१);ब[०]=परिवर्तित<बाइट>(२५५);क.बाइटरखो(५,ब);ब[०]=परिवर्तित<बाइट>(०);
            क.रिक्तरखो(६);क.पाठरखो(७,"12345678901234567890.123456789");क.पाठरखो(८,"2026-11-03");
            परीक्षण.बराबर(सत्य,प्रतीक्षा क.अगला());परीक्षण.बराबर(९२२३३७२०३६८५४७७५८०७,क.पूर्णांकलो(०));
            परीक्षण.सत्यहै(क.दशमलवलो(१)==१.२५,"दशमलव");परीक्षण.बराबर(सत्य,क.तार्किकलो(२));परीक्षण.बराबर("भारत😀",क.पाठलो(३));
            स्थिर मिला:बाइटबफ़र=क.बाइटलो(४);परीक्षण.बराबर(२५५,परिवर्तित<पूर्णांक>(मिला[०]));परीक्षण.बराबर(सत्य,क.रिक्तहै(५));
            परीक्षण.बराबर("12345678901234567890.123456789",क.पाठलो(६));परीक्षण.बराबर("2026-11-03",क.पाठलो(७));
        }
    }
}
असमकालिक फलन पोस्टनिरस्त(व:पोस्टग्रेसविन्यास)->शून्य {
    // Cancellation drains the query and discards this connection before close completes.
    असमकालिक संसाधन(ड:असमडेटासंबंध=प्रतीक्षा असमडेटा.पोस्टग्रेस(व)){
        असमकालिक संसाधन(क:असमडेटाकथन=प्रतीक्षा ड.तैयार("SELECT count(*) FROM pg_sleep(10)")){
            संसाधन(स:निरस्तीकरणस्रोत=नया निरस्तीकरणस्रोत()){
                स्थिर रोक:कार्यफल<शून्य> = निरस्तबाद(स);मान रोका:तार्किक=असत्य;
                प्रयास{स्थिर मिला:तार्किक=प्रतीक्षा क.अगला(स.चिह्नलो());}पकड़ो(द:निरस्तअपवाद){रोका=सत्य;}
                प्रतीक्षा रोक;परीक्षण.बराबर(सत्य,रोका);
            }
        }
    }
    परीक्षण.बराबर(०,मानक.असमडाटातंत्र.जीवित());
}

// The deferred trigger gates COMMIT on an advisory lock held by a second
// connection. The observer cancels/terminates only after pg_stat_activity
// proves COMMIT is in flight: no timing-based assumption about dispatch.
असमकालिक फलन बदलाव(ड:असमडेटासंबंध,एस:पाठ)->शून्य {
    असमकालिक संसाधन(क:असमडेटाकथन=प्रतीक्षा ड.तैयार(एस)){स्थिर ग:पूर्णांक=प्रतीक्षा क.चलाओ();}
}
असमकालिक फलन संख्यालो(ड:असमडेटासंबंध,एस:पाठ)->पूर्णांक {
    असमकालिक संसाधन(क:असमडेटाकथन=प्रतीक्षा ड.तैयार(एस)){स्थिर मिला:तार्किक=प्रतीक्षा क.अगला();लौटाओ क.पूर्णांकलो(०);}
}
असमकालिक फलन नियंत्रण(ड:असमडेटासंबंध,एस:पाठ,प:पूर्णांक)->शून्य {
    असमकालिक संसाधन(क:असमडेटाकथन=प्रतीक्षा ड.तैयार(एस)){क.पूर्णांकरखो(१,प);स्थिर मिला:तार्किक=प्रतीक्षा क.अगला();}
}
असमकालिक फलन प्रतिबद्धरोको(ड:असमडेटासंबंध,स:निरस्तीकरणस्रोत,प:पूर्णांक,घात:तार्किक)->शून्य {
    मान तैयार:तार्किक=असत्य;मान बार:पूर्णांक=०;
    असमकालिक संसाधन(क:असमडेटाकथन=प्रतीक्षा ड.तैयार("SELECT count(*) FROM pg_stat_activity WHERE pid=? AND upper(query)='COMMIT' AND lower(wait_event)='advisory'")){
        क.पूर्णांकरखो(१,प);
        जबतक(!तैयार && बार<२०००){
            स्थिर मिला:तार्किक=प्रतीक्षा क.अगला();तैयार=क.पूर्णांकलो(०)==१;प्रतीक्षा क.रीसेट();
            यदि(!तैयार){प्रतीक्षा कार्य.विलंब(५);}बार=बार+१;
        }
    }
    यदि(तैयार){यदि(घात){प्रतीक्षा नियंत्रण(ड,"SELECT pg_terminate_backend(?::integer)",प);}अन्यथा{स.निरस्तकरो();}}
    प्रतीक्षा नियंत्रण(ड,"SELECT pg_advisory_unlock(?)",प);
    परीक्षण.सत्यहै(तैयार,"COMMIT reached the provider before cancellation");
}
असमकालिक फलन प्रतिबद्धचलाओ(ड:असमडेटासंबंध,नि:असमडेटासंबंध,प:पूर्णांक,घात:तार्किक)->शून्य {
    संसाधन(स:निरस्तीकरणस्रोत=नया निरस्तीकरणस्रोत()){
        असमकालिक संसाधन(ल:असमडेटालेनदेन=प्रतीक्षा ड.लेनदेन()){
            प्रतीक्षा बदलाव(ड,"INSERT INTO async_commit_gate VALUES (1)");
            स्थिर रोक:कार्यफल<शून्य> = प्रतिबद्धरोको(नि,स,प,घात);मान अज्ञात:तार्किक=असत्य;
            प्रयास{प्रतीक्षा ल.सहेजो(स.चिह्नलो());}पकड़ो(द:मानक.लेनदेनपरिणामअज्ञातअपवाद){अज्ञात=सत्य;}
            प्रतीक्षा रोक;परीक्षण.बराबर(घात,अज्ञात);
        }
    }
    यदि(!घात){परीक्षण.बराबर(१,प्रतीक्षा संख्यालो(ड,"SELECT count(*) FROM async_commit_gate"));}
}
असमकालिक फलन प्रतिबद्धजाँच(व:पोस्टग्रेसविन्यास,घात:तार्किक)->शून्य {
    असमकालिक संसाधन(ड:असमडेटासंबंध=प्रतीक्षा असमडेटा.पोस्टग्रेस(व)){
        प्रतीक्षा बदलाव(ड,"CREATE TEMP TABLE async_commit_gate(id BIGINT)");
        प्रतीक्षा बदलाव(ड,"CREATE FUNCTION pg_temp.bhash_async_gate() RETURNS trigger LANGUAGE plpgsql AS 'BEGIN PERFORM pg_advisory_xact_lock(pg_backend_pid()::bigint); RETURN NEW; END;'");
        प्रतीक्षा बदलाव(ड,"CREATE CONSTRAINT TRIGGER bhash_async_gate AFTER INSERT ON async_commit_gate DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION pg_temp.bhash_async_gate()");
        स्थिर प:पूर्णांक=प्रतीक्षा संख्यालो(ड,"SELECT pg_backend_pid()");
        असमकालिक संसाधन(नि:असमडेटासंबंध=प्रतीक्षा असमडेटा.पोस्टग्रेस(व)){
            प्रतीक्षा नियंत्रण(नि,"SELECT count(*) FROM pg_advisory_lock(?)",प);
            प्रतीक्षा प्रतिबद्धचलाओ(ड,नि,प,घात);
        }
    }
}
