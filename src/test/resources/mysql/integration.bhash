आयात मानक.डेटा;
आयात मानक.माईएसक्यूएलविन्यास;
आयात मानक.डेटासंबंध;
आयात मानक.डेटालेनदेन;
आयात मानक.डेटाकथन;
आयात मानक.परीक्षण;
आयात मानक.विन्यास;

फलन मुख्य() -> शून्य {
    स्थिर व: माईएसक्यूएलविन्यास = नया माईएसक्यूएलविन्यास();
    व.मेज़बान=विन्यास.परिवेश("BHASH_MYSQL_HOST","127.0.0.1");
    व.पोर्ट=परिवर्तित<पूर्णांक>(विन्यास.परिवेश("BHASH_MYSQL_PORT","3306"));
    व.डेटाबेस=विन्यास.परिवेश("BHASH_MYSQL_DATABASE","bhash");
    व.उपयोगकर्ता=विन्यास.परिवेश("BHASH_MYSQL_USER","bhash");
    व.गुप्तशब्द=विन्यास.परिवेश("BHASH_MYSQL_PASSWORD","");
    व.सुरक्षा=विन्यास.परिवेश("BHASH_MYSQL_TLS","verify-full");
    संसाधन (ड: डेटासंबंध = डेटा.माईएसक्यूएल(व)) {
        परीक्षण.बराबर("mysql",ड.प्रदाता());
        स्थिर पाठ्यांश: पाठ="भारत😀 ' ?";
        संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {
            संसाधन (क: डेटाकथन=ड.तैयार("INSERT INTO items VALUES (?,?,?,?)")) {
                परीक्षण.बराबर(४,क.बंधनसंख्या());
                क.पूर्णांकरखो(१,९२२३३७२०३६८५४७७५८०७);
                क.पाठरखो(२,पाठ्यांश);
                स्थिर ब: बाइटबफ़र=नया बाइटबफ़र(१);
                ब[०]=परिवर्तित<बाइट>(२५५);
                क.बाइटरखो(३,ब);
                क.रिक्तरखो(४);
                परीक्षण.बराबर(१,क.चलाओ());
            }
            ल.सहेजो();
        }
        संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {
            संसाधन (क: डेटाकथन=ड.तैयार("DELETE FROM items WHERE body=?")) {
                क.पाठरखो(१,पाठ्यांश);
                परीक्षण.बराबर(१,क.चलाओ());
            }
        }
        संसाधन (क: डेटाकथन=ड.तैयार("SELECT id,body,payload,extra FROM items WHERE body=?")) {
            क.पाठरखो(१,पाठ्यांश);
            परीक्षण.सत्यहै(क.अगला(),"पंक्ति मिली");
            परीक्षण.बराबर(९२२३३७२०३६८५४७७५८०७,क.पूर्णांकलो(०));
            परीक्षण.बराबर(पाठ्यांश,क.पाठलो(१));
            परीक्षण.बराबर(२५५,परिवर्तित<पूर्णांक>(क.बाइटलो(२)[०]));
            परीक्षण.सत्यहै(क.रिक्तहै(३),"SQL NULL");
            परीक्षण.सत्यहै(!क.अगला(),"एक ही पंक्ति");
            क.रीसेट();
            परीक्षण.सत्यहै(क.अगला(),"रीसेट ने बंधन रखा");
        }
    }
    लिखो("MYSQL_OK");
}
