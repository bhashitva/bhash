आयात मानक.डेटा;
आयात मानक.डेटासंबंध;
आयात मानक.डेटालेनदेन;
आयात मानक.डेटाकथन;
आयात मानक.असमडेटा;
आयात मानक.असमडेटासंबंध;
आयात मानक.असमडेटालेनदेन;
आयात मानक.परीक्षण;
आयात मानक.विन्यास;
आयात विद्यालय.कक्षास्तर;
आयात विद्यालय.कक्षास्तरसंग्रह;
आयात विद्यालय.विद्यार्थी;
आयात विद्यालय.विद्यार्थीसंग्रह;
आयात विद्यालय.ओआरएमवैकल्पिक;
आयात विद्यालय.ओआरएमसंघर्ष;

फलन सीधीपढ़ाई(पता: पाठ) -> शून्य {
    संसाधन (ड: डेटासंबंध = डेटा.एसक्यूएलसर्वर(पता)) {
        परीक्षण.बराबर("sqlserver", ड.प्रदाता());
        संसाधन (ल: डेटालेनदेन = ड.लेनदेन()) {
            संसाधन (क: डेटाकथन = ड.तैयार("INSERT INTO gradelevel (id,name) VALUES (?,?)")) {
                परीक्षण.बराबर(२, क.बंधनसंख्या());
                क.पूर्णांकरखो(१, ९९);
                क.पाठरखो(२, "इसे वापस लो");
                परीक्षण.बराबर(१, क.चलाओ());
            }
        }
        संसाधन (क: डेटाकथन = ड.तैयार("SELECT id FROM gradelevel WHERE id=?")) {
            क.पूर्णांकरखो(१, ९९);
            परीक्षण.सत्यहै(!क.अगला(), "संबंध ने परिवर्तन वापस लिया।");
        }
        संसाधन (क: डेटाकथन = ड.तैयार("SELECT CAST(? AS NVARCHAR(120)) AS [text?], 'literal?' AS [quoted]")) {
            परीक्षण.बराबर(१, क.बंधनसंख्या());
            क.पाठरखो(१, "भारत😀 ' ? ;");
            परीक्षण.सत्यहै(क.अगला(), "पंक्ति मिली।");
            परीक्षण.बराबर("text?", क.स्तंभनाम(०));
            परीक्षण.बराबर("भारत😀 ' ? ;", क.पाठलो(०));
            क.रीसेट();
            परीक्षण.सत्यहै(क.अगला(), "रीसेट के बाद पंक्ति मिली।");
        }
    }
}

असमकालिक फलन मुख्य() -> शून्य {
    स्थिर पता: पाठ = विन्यास.परिवेश("BHASH_SQLSERVER_URL", "");
    सीधीपढ़ाई(पता);
    असमकालिक संसाधन (ड: असमडेटासंबंध = प्रतीक्षा असमडेटा.एसक्यूएलसर्वर(पता)) {
        स्थिर कक्षाएँ: कक्षास्तरसंग्रह = नया कक्षास्तरसंग्रह(ड);
        स्थिर छात्र: विद्यार्थीसंग्रह = नया विद्यार्थीसंग्रह(ड);
        असमकालिक संसाधन (ल: असमडेटालेनदेन = प्रतीक्षा ड.लेनदेन()) {
            परीक्षण.बराबर(१, प्रतीक्षा कक्षाएँ.जोड़ो(नया कक्षास्तर(५, "कक्षा पाँच")));
            परीक्षण.बराबर(१, प्रतीक्षा छात्र.जोड़ो(नया विद्यार्थी(१०, "सीमा 😀 ' ? ;", नया ओआरएमवैकल्पिक<पूर्णांक>(५), सत्य, नया ओआरएमवैकल्पिक<दशमलव>(९.५), रिक्त, ०)));
            परीक्षण.बराबर(१, प्रतीक्षा छात्र.जोड़ो(नया विद्यार्थी(२०, "आरव", रिक्त, असत्य, रिक्त, रिक्त, ०)));
            प्रतीक्षा ल.सहेजो();
        }
        स्थिर मिला: विद्यार्थी = प्रतीक्षा छात्र.नामसेपाओ("सीमा 😀 ' ? ;");
        परीक्षण.बराबर(१०, मिला.पहचान);
        परीक्षण.बराबर(सत्य, मिला.सक्रिय);
        परीक्षण.सत्यहै(मिला.अंक.मूल्य == ९.५ && मिला.टिप्पणी == रिक्त, "दशमलव और रिक्त मान।");
        स्थिर कक्षा: कक्षास्तर = प्रतीक्षा छात्र.कक्षास्तरलो(मिला);
        परीक्षण.बराबर("कक्षा पाँच", कक्षा.नाम);
        स्थिर पृष्ठ: सूची<विद्यार्थी> = प्रतीक्षा छात्र.सूचीलो(१, १);
        परीक्षण.बराबर(१, पृष्ठ.आकार);
        परीक्षण.बराबर(२०, पृष्ठ[०].पहचान);
        असमकालिक संसाधन (ल: असमडेटालेनदेन = प्रतीक्षा ड.लेनदेन()) {
            परीक्षण.बराबर(१, प्रतीक्षा छात्र.हटाओ(१०, ०));
        }
        परीक्षण.सत्यहै((प्रतीक्षा छात्र.पहचानसेपाओ(१०)) != रिक्त, "ORM ने लेनदेन वापस लिया।");
        स्थिर बदला: विद्यार्थी = प्रतीक्षा छात्र.बदलो(मिला);
        परीक्षण.बराबर(१, बदला.संस्करण);
        प्रयास {
            प्रतीक्षा छात्र.बदलो(मिला);
            फेंको नया अपवाद("पुराना संस्करण सहेजा गया।");
        } पकड़ो (दोष: ओआरएमसंघर्ष) {}
    }
    लिखो("SQLSERVER_ORM_OK");
}
