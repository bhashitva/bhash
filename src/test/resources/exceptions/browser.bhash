वर्ग संदेश {}
वर्ग विशेष विस्तार अपवाद {
    सार्वजनिक निर्माता(क: पाठ) : आधार(क) {}
    सार्वजनिक कार्य लो() -> पाठ { लौटाओ संदेश; }
}
वर्ग गलत { साझा मान संख्या: पूर्णांक = १ / ०; }
कार्य फल<त>(मानक: त) -> त {
    प्रयास { लौटाओ मानक; } अंततः { लिखो("वापसी"); }
}
कार्य मुख्य() -> शून्य {
    स्थिर संकेत: पूर्णांक = पढ़ो();
    यदि (संकेत == १) {
        प्रयास { फेंको नया अपवाद("असफल"); } अंततः { लिखो("सफाई"); }
    } अन्यथा यदि (संकेत == २) {
        प्रयास {
            प्रयास { फेंको नया अपवाद("पहला"); } अंततः { फेंको नया अपवाद("अंतिम"); }
        } पकड़ो (गलती: अपवाद) { लिखो(गलती.संदेश); }
    } अन्यथा {
        स्थिर मूल: विशेष = नया विशेष("मूल");
        प्रयास {
            प्रयास { फेंको मूल; }
            पकड़ो (गलती: विशेष) { लिखो(गलती == मूल, गलती.लो()); फेंको; }
            अंततः { लिखो("भीतर"); }
        } पकड़ो (गलती: अपवाद) { लिखो(गलती == मूल, गलती.संदेश); }
        अंततः { लिखो("बाहर"); }
        प्रयास { लिखो(१ / ०); } पकड़ो (गलती: अपवाद) { लिखो("भाग"); }
        प्रयास { लिखो(नया पूर्णांक[०].लो(०)); } पकड़ो (गलती: अपवाद) { लिखो("सीमा"); }
        प्रयास { लिखो(गलत.संख्या); } पकड़ो (गलती: अपवाद) { लिखो("प्रारंभ"); }
        लिखो(फल<पूर्णांक>(७));
        मान क: पूर्णांक = ०;
        जबतक (क < ३) {
            क = क + १;
            प्रयास { यदि (क == १) { जारी; } विराम; }
            अंततः { लिखो("चक्र", क); }
        }
    }
}
