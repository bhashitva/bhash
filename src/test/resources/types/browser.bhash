परिगणना रंग { लाल, हरा = ५, नीला }
अभिलेख जोड़ा<त>(क: त, ख: त);
अनुबंध नामी { कार्य नाम() -> पाठ; }
वर्ग जीव {}
वर्ग बिल्ली विस्तार जीव पालन नामी { सार्वजनिक कार्य नाम() -> पाठ { लौटाओ "बिल्ली"; } }
वर्ग अन्य {}
कार्य मुख्य() -> शून्य {
    स्थिर संकेत: पूर्णांक = पढ़ो();
    चयन (संकेत) {
        विकल्प १: लिखो(परिवर्तित<बाइट>(२५६));
        विकल्प २: लिखो(परिवर्तित<लघुपूर्णांक>(२१४७४८३६४८));
        विकल्प ३: लिखो(परिवर्तित<पूर्णांक>(१.० / ०.०));
        विकल्प ४: लिखो(परिवर्तित<पूर्णांक>(०.० / ०.०));
        विकल्प ५: लिखो(परिवर्तित<पूर्णांक>(९२२३३७२०३६८५४७७५८०८.०));
        विकल्प ६: स्थिर क: सर्ववस्तु = १; लिखो(परिवर्तित<बाइट>(क));
        विकल्प ७: स्थिर क: सर्ववस्तु = रिक्त; लिखो(परिवर्तित<पूर्णांक>(क));
        विकल्प ८: स्थिर क: सर्ववस्तु = नया सूची<पाठ>(); स्थिर ख: सूची<पूर्णांक> = परिवर्तित<सूची<पूर्णांक>>(क);
        विकल्प ९: स्थिर क: रंग = परिवर्तित<रंग>(९);
        विकल्प १०: लिखो(नया बाइटबफ़र(१)[-१]);
        विकल्प ११: लिखो(नया बाइटबफ़र(७).पूर्णांकपढ़ो(०,सत्य));
        विकल्प १२: नया बाइटबफ़र(८).पूर्णांकलिखो(१,१,सत्य);
        विकल्प १३: लिखो(यूटीएफ८पाठ(नया बाइटबफ़र{परिवर्तित<बाइट>(२५५)}));
        विकल्प १४: स्थिर क: सर्ववस्तु = नया अन्य(); स्थिर ख: बिल्ली = परिवर्तित<बिल्ली>(क);
        विकल्प १५: लिखो(परिवर्तित<दशमलव>("1२"));
        विकल्प १६: स्थिर क: बाइटबफ़र = नया बाइटबफ़र(-१);
        शेष:
            स्थिर ब: बाइट = परिवर्तित<बाइट>(२५५);
            स्थिर ल: लघुपूर्णांक = परिवर्तित<लघुपूर्णांक>(-२१४७४८३६४८);
            लिखो(ब,ल,ब + १, परिवर्तित<पूर्णांक>(-३.९),परिवर्तित<दशमलव>("१२.५"));
            स्थिर मूल: सर्ववस्तु = नया बिल्ली();
            लिखो(प्रकारहै<बिल्ली>(मूल),प्रकारहै<नामी>(मूल),परिवर्तित<नामी>(मूल).नाम(),सुरक्षितरूप<अन्य>(मूल) == रिक्त);
            स्थिर प: सर्ववस्तु = नया जोड़ा<पूर्णांक>(१,२);
            लिखो(प्रकारहै<जोड़ा<पूर्णांक>>(प),प्रकारहै<जोड़ा<पाठ>>(प),परिवर्तित<पूर्णांक>(१));
            स्थिर म: मानचित्र<जोड़ा<पूर्णांक>,पाठ> = नया मानचित्र<जोड़ा<पूर्णांक>,पाठ>{नया जोड़ा<पूर्णांक>(१,२):"ठीक"};
            लिखो(म[नया जोड़ा<पूर्णांक>(१,२)]);
            स्थिर सं: सर्ववस्तु = नया सूची<पूर्णांक>{३};
            लिखो(प्रकारहै<सूची<पूर्णांक>>(सं),प्रकारहै<सूची<पाठ>>(सं),सुरक्षितरूप<सूची<पाठ>>(सं) == रिक्त);
            स्थिर जाल: पूर्णांक[][] = नया पूर्णांक[१][१];
            लिखो(प्रकारहै<पूर्णांक[][]>(जाल),प्रकारहै<पूर्णांक[]>(जाल[०]),प्रकारहै<सूची<जोड़ा<पूर्णांक>>>(म.कुंजियाँ()));
            स्थिर अंक: सर्ववस्तु = ब;
            लिखो(प्रकारहै<बाइट>(अंक),प्रकारहै<पूर्णांक>(अंक),परिवर्तित<बाइट>(अंक));
            लिखो(परिवर्तित<रंग>(५) == रंग.हरा,रंग.नीला.अंक,परिवर्तित<पाठ>(रंग.हरा));
            चयन (रंग.नीला) { विकल्प रंग.नीला: लिखो("नीला"); शेष: लिखो("गलत"); }
            स्थिर बफ: बाइटबफ़र = नया बाइटबफ़र(१६);
            बफ.पूर्णांकलिखो(०,-१,सत्य); बफ.दशमलवलिखो(८,-१.५,असत्य);
            लिखो(बफ[०],बफ.पूर्णांकपढ़ो(०,सत्य),बफ.दशमलवपढ़ो(८,असत्य));
            स्थिर कॉपी: बाइटबफ़र = बफ.काटो(०,२); कॉपी[०] = परिवर्तित<बाइट>(०);
            स्थिर सर: बाइट[] = कॉपी.सरणी();
            लिखो(बफ[०],कॉपी[०],सर[१],प्रकारहै<बाइट[]>(सर),यूटीएफ८पाठ(यूटीएफ८बफ़र("नमस्ते 😀")));
    }
}
