वर्ग वस्तु {}
वर्ग गणना {
    मान संख्या: पूर्णांक;
    निर्माता(आ: सूची<पूर्णांक>) { संख्या = आ[०]; }
    निर्माता(आ: सूची<पाठ>) { संख्या = लंबाई(आ[०]); }
}
कार्य प्रतिलिपि<त>(आ: त[]) -> सूची<त> {
    स्थिर फल: सूची<त> = नया सूची<त>();
    प्रत्येक (मानक: त में आ) { फल.जोड़ो(मानक); }
    लौटाओ फल;
}
कार्य मुख्य() -> शून्य {
    स्थिर संकेत: पूर्णांक = पढ़ो();
    स्थिर अ: पूर्णांक[] = नया पूर्णांक[]{१,२};
    स्थिर ब: सूची<पूर्णांक> = नया सूची<पूर्णांक>{३,४};
    स्थिर म: मानचित्र<पाठ,पूर्णांक> = नया मानचित्र<पाठ,पूर्णांक>{"क":१,"ख":२};
    चयन (संकेत) {
        विकल्प ०:
            स्थिर जाल: पूर्णांक[][] = नया पूर्णांक[२][३];
            जाल[१][२] = ९;
            लिखो(जाल[०][२], जाल[१][२]);
            प्रत्येक (अंक: पूर्णांक में अ) { अ[१] = ७; लिखो(अंक); }
            प्रत्येक (कुंजी: पाठ, मानक: पूर्णांक में म) { म["ख"] = ३; लिखो(कुंजी,मानक); }
            प्रत्येक (कुंजी: पाठ में म.कुंजियाँ()) { म.हटाओ(कुंजी); }
            लिखो(म.खाली());
            स्थिर दश: मानचित्र<दशमलव,पूर्णांक> = नया मानचित्र<दशमलव,पूर्णांक>();
            दश[-०.०] = ६; दश[०.०] = ७; दश[०.० / ०.०] = ८; दश[-(०.० / ०.०)] = ९;
            लिखो(दश.आकार(), दश[०.०], दश[०.० / ०.०]);
            स्थिर चाबी: पूर्णांक[] = नया पूर्णांक[]{१};
            स्थिर तालिका: मानचित्र<पूर्णांक[],पाठ> = नया मानचित्र<पूर्णांक[],पाठ>{चाबी:"ठीक"};
            चाबी[०] = २;
            लिखो(तालिका[चाबी], तालिका.है(नया पूर्णांक[]{२}));
            लिखो(नया गणना(नया सूची<पूर्णांक>{५}).संख्या, नया गणना(नया सूची<पाठ>{"भाष"}).संख्या);
            स्थिर डाटा: सूची<पूर्णांक[]> = प्रतिलिपि<पूर्णांक[]>(नया पूर्णांक[][]{नया पूर्णांक[]{४}});
            लिखो(डाटा[०][०]);
        विकल्प १: लिखो(अ[२]);
        विकल्प २: नया पूर्णांक[-१];
        विकल्प ३: ब.डालो(३,१);
        विकल्प ४: लिखो(म["नहीं"]);
        विकल्प ५:
            स्थिर तालिका: मानचित्र<वस्तु,पूर्णांक> = नया मानचित्र<वस्तु,पूर्णांक>();
            तालिका[रिक्त] = १;
        विकल्प ६: प्रत्येक (मानक: पूर्णांक में ब) { ब.जोड़ो(५); }
        विकल्प ७: प्रत्येक (कुंजी: पाठ, मानक: पूर्णांक में म) { म["नया"] = ३; }
        विकल्प ८: प्रत्येक (कुंजी: पाठ में म) { म.हटाओ(कुंजी); }
        विकल्प ९:
            स्थिर क: पूर्णांक[] = रिक्त;
            लिखो(क[०]);
        विकल्प १०: नया पूर्णांक[०][-१];
        विकल्प ११: नया पूर्णांक[२१४७४८३६४८];
        विकल्प १२: प्रत्येक (मानक: पूर्णांक में ब) { ब.साफ़(); }
        शेष: लिखो("अनजान");
    }
}
