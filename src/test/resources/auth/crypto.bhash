आयात मानक.कूटशब्द; आयात मानक.सुरक्षा; आयात मानक.सुरक्षाघड़ी; आयात मानक.पाठ्य; आयात मानक.परीक्षण;
कार्य मुख्य() -> शून्य {
 परीक्षण.सत्यहै(कूटशब्द.जाँचो("password","$bhash$pbkdf2-sha256$600000$000102030405060708090a0b0c0d0e0f$3bc37118e625093e9b79ed08930ea7af7389591233fdd92dddf369371e60dbc0"),"PBKDF2 UTF-8 reference vector");
 परीक्षण.सत्यहै(कूटशब्द.जाँचो("भारत😀","$bhash$pbkdf2-sha256$600000$000102030405060708090a0b0c0d0e0f$1830bda13082d32f435d15f0fc1e53767279f1296b041a59180ff6cb4f812cc1"),"PBKDF2 UTF-8 reference vector");
 परीक्षण.सत्यहै(कूटशब्द.जाँचो("nul"+पाठ्य.यूटीएफ८पाठ(नया बाइटबफ़र(१))+"password","$bhash$pbkdf2-sha256$600000$000102030405060708090a0b0c0d0e0f$68d32e83bf14efc86e32fede808037bd2373abe1529e663f9d2dcfd64e7c39ce"),"PBKDF2 UTF-8 reference vector");
 परीक्षण.सत्यहै(कूटशब्द.जाँचो("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","$bhash$pbkdf2-sha256$600000$000102030405060708090a0b0c0d0e0f$f54fcda94b341f3a28ba2dc69d33136e82c103775557e88d4f9bc216125f26b9"),"PBKDF2 UTF-8 reference vector");
 स्थिर हैश: पाठ = कूटशब्द.हैशबनाओ("भारत😀");
 परीक्षण.सत्यहै(कूटशब्द.जाँचो("भारत😀",हैश),"hash verifies");
 परीक्षण.सत्यहै(!कूटशब्द.जाँचो("wrong",हैश),"wrong password");
 परीक्षण.सत्यहै(हैश!=कूटशब्द.हैशबनाओ("भारत😀"),"unique salt");
 प्रत्येक (मानक: पाठ में नया सूची<पाठ>{"",हैश+"x",पाठ्य.बदलो(हैश,"600000","1"),पाठ्य.बदलो(हैश,"600000","999999999999999999"),पाठ्य.बदलो(हैश,"sha256","sha1"),पाठ्य.बदलो(हैश,"$bhash$","$other$")}) { परीक्षण.सत्यहै(!कूटशब्द.जाँचो("भारत😀",मानक),"strict versioned encoding"); }
 प्रत्येक (मानक: पाठ में नया सूची<पाठ>{"",पाठ्य.दोहराओ("a",१०२५),पाठ्य.दोहराओ("भ",३४२)}) { मान पकड़ा: तार्किक = असत्य; प्रयास { कूटशब्द.हैशबनाओ(मानक); } पकड़ो (ग: अपवाद) { पकड़ा = सत्य; परीक्षण.बराबर("कूटशब्द १ से १०२४ UTF-8 बाइट होना चाहिए।",ग.संदेश); } परीक्षण.सत्यहै(पकड़ा,"bounded UTF-8 password"); }
 स्थिर पहला: पाठ = सुरक्षा.टोकन(); परीक्षण.बराबर(६४,पाठ्य.लंबाई(पहला)); परीक्षण.सत्यहै(!सुरक्षा.समान(पहला,सुरक्षा.टोकन()),"independent CSPRNG tokens");
 परीक्षण.सत्यहै(सुरक्षा.समान("भारत😀","भारत😀"),"fixed-time UTF-8 comparison"); परीक्षण.सत्यहै(!सुरक्षा.समान("a","b"),"different"); परीक्षण.सत्यहै(!सुरक्षा.समान("a","aa"),"length"); परीक्षण.सत्यहै(सुरक्षा.समान("",""),"empty comparison");
 स्थिर अ: पूर्णांक = सुरक्षाघड़ी.मिलीसेकंड(); परीक्षण.सत्यहै(अ>=० && सुरक्षाघड़ी.मिलीसेकंड()>=अ,"monotonic clock");
}
