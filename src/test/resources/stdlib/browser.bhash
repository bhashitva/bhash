आयात मानक.पाठ्य;
आयात मानक.जेसन;
आयात मानक.यादृच्छिक;
आयात मानक.समय;
आयात मानक.फ़ाइल;
कार्य मुख्य() -> शून्य {
    लिखो(पाठ्य.संख्यापाठ(०.१२५,२), पाठ्य.संख्यापाठ(-०.०,२));
    यादृच्छिक.बीज(०);
    लिखो(यादृच्छिक.पूर्णांकचुनो(०,१००), यादृच्छिक.पूर्णांकचुनो(०,१००), यादृच्छिक.पूर्णांकचुनो(०,१००));
    स्थिर मानक: सर्ववस्तु = जेसन.पढ़ो("{\"सूची\":[1,1.0,null,\"😀\"]}");
    स्थिर मूल: मानचित्र<पाठ,सर्ववस्तु> = परिवर्तित<मानचित्र<पाठ,सर्ववस्तु>>(मानक);
    स्थिर सूचीका: सूची<सर्ववस्तु> = परिवर्तित<सूची<सर्ववस्तु>>(मूल["सूची"]);
    लिखो(प्रकारहै<पूर्णांक>(सूचीका[०]), प्रकारहै<दशमलव>(सूचीका[१]), सूचीका[२] == रिक्त, परिवर्तित<पाठ>(सूचीका[३]));
    लिखो(समय.पाठबनाओ(समय.पढ़ो("2000-02-29T12:34:56.789Z")));
    लिखो(!फ़ाइल.समर्थित());
    प्रयास { फ़ाइल.है("अज्ञात"); } पकड़ो (ग: अपवाद) { लिखो("असमर्थित"); }
    प्रयास { फ़ाइल.पाठपढ़ो("अज्ञात"); } पकड़ो (ग: अपवाद) { लिखो("असमर्थित"); }
    प्रयास { फ़ाइल.पाठलिखो("अज्ञात","पाठ"); } पकड़ो (ग: अपवाद) { लिखो("असमर्थित"); }
    प्रयास { फ़ाइल.बाइटलिखो("अज्ञात",नया बाइटबफ़र(१)); } पकड़ो (ग: अपवाद) { लिखो("असमर्थित"); }
    प्रयास { फ़ाइल.बाइटपढ़ो("अज्ञात"); } पकड़ो (ग: अपवाद) { लिखो("असमर्थित"); }
    प्रयास { जेसन.पढ़ो("{\"क\":1,\"क\":2}"); } पकड़ो (ग: अपवाद) { लिखो("अमान्य"); }
    स्थिर चक्र: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>(); चक्र.जोड़ो(चक्र);
    प्रयास { जेसन.पाठबनाओ(चक्र); } पकड़ो (ग: अपवाद) { लिखो("चक्रीय"); }
}
