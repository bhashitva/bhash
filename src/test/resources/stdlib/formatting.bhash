आयात मानक.पाठस्वरूप उपनाम स्वरूप;
आयात मानक.पाठ्य;
आयात मानक.परीक्षण;

फलन अस्वीकार(साँचा: पाठ, मानक: सूची<सर्ववस्तु>) -> शून्य {
    प्रयास { स्वरूप.बनाओ(साँचा, मानक); }
    पकड़ो (दोष: अपवाद) { लौटाओ; }
    फेंको नया अपवाद("अमान्य स्वरूपण स्वीकार हुआ: " + साँचा);
}

फलन मुख्य() -> शून्य {
    स्थिर मानक: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>{"मीरा", २.६२५, "😀", सत्य, रिक्त,
        -९२२३३७२०३६८५४७७५८०८, परिवर्तित<लघुपूर्णांक>(-२१४७४८३६४८), परिवर्तित<बाइट>(२५५), -०.०};
    लिखो(स्वरूप.बनाओ("{0,-6}|{1,6:F2}|{{{2}}}", मानक));
    लिखो(स्वरूप.बनाओ("{४}:{३}:{०}:{०}", मानक));
    परीक्षण.बराबर("|  कि😀|कि😀  |", स्वरूप.बनाओ("|{0,+5}|{0,-5}|", नया सूची<सर्ववस्तु>{"कि😀"}));
    परीक्षण.बराबर("  😀:मीरा", स्वरूप.बनाओ("{2,3}:{0,1}", मानक));
    परीक्षण.बराबर("2.625|-0.00|255|2.625000000000000", स्वरूप.बनाओ("{1}|{8:f2}|{7:F0}|{1:F15}", मानक));
    परीक्षण.बराबर("-9223372036854775808.00|-2147483648.0|255", स्वरूप.बनाओ("{5:F2}|{6:F1}|{7:F0}", मानक));
    परीक्षण.बराबर("{अ😀}\u0000", स्वरूप.बनाओ("{{अ😀}}\u0000", नया सूची<सर्ववस्तु>()));
    परीक्षण.बराबर("", स्वरूप.बनाओ("", मानक));
    परीक्षण.बराबर("Infinity", स्वरूप.बनाओ("{0}", नया सूची<सर्ववस्तु>{१.० / ०.०}));

    स्थिर गलत: सूची<पाठ> = नया सूची<पाठ>{"{", "}", "{0", "{}", "{0{1}}", "{9}", "{-1}", "{+1}", "{0,}", "{0,2,3}",
        "{0,4097}", "{0,-9223372036854775808}", "{1:}", "{1:D2}", "{1:F}", "{1:F-1}", "{1:F16}", "{0:F2}",
        "{1:F1२}", "{1:F2:F3}", "{9223372036854775808}"};
    प्रत्येक (गलत में साँचा: पाठ) { अस्वीकार(साँचा, मानक); }
    अस्वीकार("{0}", नया सूची<सर्ववस्तु>{नया सूची<पाठ>()});
    अस्वीकार("{0:F2}", नया सूची<सर्ववस्तु>{१.० / ०.०});
    अस्वीकार("", रिक्त);
    अस्वीकार("{" + पाठ्य.दोहराओ("0", ६५) + "}", मानक);
    स्थिर अधिकतम_साँचा: पाठ = पाठ्य.दोहराओ("अ", ६५५३६);
    परीक्षण.बराबर(६५५३६, पाठ्य.लंबाई(स्वरूप.बनाओ(अधिकतम_साँचा, मानक)));
    अस्वीकार(अधिकतम_साँचा + "अ", मानक);
    स्थिर बड़ा: पाठ = पाठ्य.दोहराओ("x", ५२४२८८);
    स्थिर बड़े_मान: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>{बड़ा};
    परीक्षण.बराबर(१०४८५७६, पाठ्य.लंबाई(स्वरूप.बनाओ("{0}{0}", बड़े_मान)));
    अस्वीकार("{0}{0}x", बड़े_मान);
    लिखो("स्वरूपण ठीक");
}
