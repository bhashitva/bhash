आयात मानक.समुच्चय;
आयात मानक.परीक्षण;

वर्ग चिह्न {
    सार्वजनिक मान अंक: पूर्णांक;
    सार्वजनिक निर्माता(अ: पूर्णांक) { यह.अंक = अ; }
}

फलन क्रम(संग्रह: समुच्चय<पूर्णांक>) -> पूर्णांक {
    मान फल: पूर्णांक = ०;
    प्रत्येक (संग्रह में अंक: पूर्णांक) { फल = फल * १० + अंक; }
    लौटाओ फल;
}

फलन वस्तुसमुच्चय(संग्रह: समुच्चय<चिह्न>, गिनती: पूर्णांक[]) -> समुच्चय<चिह्न> {
    गिनती[०] = गिनती[०] + १;
    लौटाओ संग्रह;
}

फलन क्रियाएँ() -> शून्य {
    स्थिर पहला: समुच्चय<पूर्णांक> = नया समुच्चय<पूर्णांक>();
    स्थिर दूसरा: समुच्चय<पूर्णांक> = नया समुच्चय<पूर्णांक>();
    परीक्षण.सत्यहै(पहला.खाली() && पहला.आकार() == ०, "खाली समुच्चय");
    परीक्षण.सत्यहै(पहला.जोड़ो(३) && पहला.जोड़ो(१) && !पहला.जोड़ो(३), "अद्वितीय सदस्य");
    परीक्षण.सत्यहै(पहला.है(३) && !पहला.है(२) && !पहला.हटाओ(२), "सदस्यता");
    दूसरा.जोड़ो(२);
    दूसरा.जोड़ो(१);
    दूसरा.जोड़ो(३);
    स्थिर सब: समुच्चय<पूर्णांक> = पहला.संघ(दूसरा);
    स्थिर उभय: समुच्चय<पूर्णांक> = पहला.प्रतिच्छेद(दूसरा);
    परीक्षण.बराबर(३१२, क्रम(सब));
    परीक्षण.बराबर(३१, क्रम(उभय));
    परीक्षण.बराबर(१३, क्रम(दूसरा.प्रतिच्छेद(पहला)));
    परीक्षण.बराबर(२, क्रम(दूसरा.अंतर(पहला)));
    परीक्षण.सत्यहै(पहला.अंतर(पहला).खाली() && पहला.संघ(पहला).आकार() == २, "स्वयं पर क्रिया");
    परीक्षण.बराबर(३१, क्रम(पहला));
    परीक्षण.बराबर(२१३, क्रम(दूसरा));
    सब.साफ़();
    परीक्षण.सत्यहै(सब.खाली() && पहला.आकार() == २ && दूसरा.आकार() == ३, "स्वतंत्र परिणाम");
    स्थिर प्रति: सूची<पूर्णांक> = पहला.तत्व();
    प्रति.जोड़ो(९);
    परीक्षण.सत्यहै(पहला.हटाओ(३) && !पहला.हटाओ(३) && पहला.जोड़ो(३), "फिर से जोड़ा गया सदस्य");
    परीक्षण.बराबर(१३, क्रम(पहला));
    परीक्षण.सत्यहै(प्रति[०] == ३ && प्रति.आकार == ३ && !पहला.है(९), "स्वतंत्र सूची");
}

फलन समानता() -> शून्य {
    स्थिर शब्द: मानक.समुच्चय<पाठ> = नया मानक.समुच्चय<पाठ>();
    स्थिर पाठ्यांश: पाठ = "भाष";
    परीक्षण.सत्यहै(शब्द.जोड़ो(पाठ्यांश + "😀") && !शब्द.जोड़ो("भाष😀"), "पाठ का मान");
    स्थिर संख्याएँ: समुच्चय<दशमलव> = नया समुच्चय<दशमलव>();
    स्थिर शून्यमान: दशमलव = ०.०;
    परीक्षण.सत्यहै(संख्याएँ.जोड़ो(-शून्यमान) && !संख्याएँ.जोड़ो(शून्यमान), "चिह्न सहित शून्य");
    स्थिर असंख्या: दशमलव = शून्यमान / शून्यमान;
    परीक्षण.सत्यहै(संख्याएँ.जोड़ो(असंख्या) && संख्याएँ.है(असंख्या) && !संख्याएँ.जोड़ो(असंख्या), "NaN");
    स्थिर वस्तुएँ: समुच्चय<चिह्न> = नया समुच्चय<चिह्न>();
    {
        स्थिर अ: चिह्न = नया चिह्न(७);
        स्थिर ब: चिह्न = नया चिह्न(७);
        परीक्षण.सत्यहै(वस्तुएँ.जोड़ो(अ) && वस्तुएँ.जोड़ो(ब) && !वस्तुएँ.जोड़ो(अ), "वस्तु की पहचान");
    }
    स्थिर गिनती: पूर्णांक[] = नया पूर्णांक[]{०};
    मान योग: पूर्णांक = ०;
    प्रत्येक (वस्तुसमुच्चय(वस्तुएँ, गिनती) में व: चिह्न) {
        वस्तुएँ.साफ़();
        स्थिर अस्थायी: चिह्न = नया चिह्न(१);
        योग = योग + व.अंक + अस्थायी.अंक;
    }
    परीक्षण.सत्यहै(योग == १६ && वस्तुएँ.खाली() && गिनती[०] == १, "बदलाव के दौरान पुनरावृत्ति");
    प्रयास {
        वस्तुएँ.जोड़ो(रिक्त);
        फेंको नया अपवाद("रिक्त सदस्य स्वीकार हुआ");
    } पकड़ो (दोष: अपवाद) {
        परीक्षण.सत्यहै(दोष.संदेश != "रिक्त सदस्य स्वीकार हुआ", "रिक्त सदस्य अस्वीकार हुआ");
    }
}

असमकालिक फलन मुख्य() -> शून्य {
    क्रियाएँ();
    समानता();
    स्थिर अंक: समुच्चय<पूर्णांक> = नया समुच्चय<पूर्णांक>();
    अंक.जोड़ो(४);
    अंक.जोड़ो(६);
    मान योग: पूर्णांक = ०;
    प्रत्येक (अंक में अ: पूर्णांक) {
        प्रतीक्षा मानक.कार्य.विलंब(१);
        अंक.साफ़();
        योग = योग + अ;
    }
    परीक्षण.सत्यहै(योग == १० && अंक.खाली(), "प्रतीक्षा के पार स्थिर क्रम");
    लिखो("समुच्चय ठीक");
}
