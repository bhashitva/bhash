संकुल मानक;

सार्वजनिक वर्ग एचटीटीपीअनुरोध {
    सार्वजनिक मान विधि: पाठ;
    सार्वजनिक मान पता: पाठ;
    सार्वजनिक मान शीर्ष: सूची<पाठ>;
    सार्वजनिक मान सामग्री: बाइटबफ़र;
    सार्वजनिक मान समयसीमा: पूर्णांक = १००००;
    सार्वजनिक मान अनुसरणसीमा: पूर्णांक = ५;
    सार्वजनिक निर्माता(विधि: पाठ, पता: पाठ) {
        यह.विधि = विधि; यह.पता = पता;
        यह.शीर्ष = नया सूची<पाठ>(); यह.सामग्री = नया बाइटबफ़र(०);
    }
    सार्वजनिक कार्य शीर्षजोड़ो(नाम: पाठ, मानक: पाठ) -> शून्य {
        जालनियम.शीर्षजाँचो(नाम, मानक); शीर्ष.जोड़ो(नाम); शीर्ष.जोड़ो(मानक);
    }
    सार्वजनिक कार्य शीर्षरखो(नाम: पाठ, मानक: पाठ) -> शून्य {
        जालनियम.शीर्षजाँचो(नाम, मानक);
        स्थिर फल: सूची<पाठ> = नया सूची<पाठ>(); मान क: पूर्णांक = ०;
        जबतक (क < शीर्ष.आकार) {
            यदि (पाठ्य.छोटाअक्षर(शीर्ष[क]) != पाठ्य.छोटाअक्षर(नाम)) { फल.जोड़ो(शीर्ष[क]); फल.जोड़ो(शीर्ष[क+१]); }
            क = क + २;
        }
        यह.शीर्ष = फल; यह.शीर्षजोड़ो(नाम, मानक);
    }
    सार्वजनिक कार्य पाठरखो(मानक: पाठ) -> शून्य {
        यह.बाइटरखो(पाठ्य.यूटीएफ८(मानक)); यह.शीर्षरखो("Content-Type", "text/plain; charset=utf-8");
    }
    सार्वजनिक कार्य बाइटरखो(मानक: बाइटबफ़र) -> शून्य {
        यदि (मानक == रिक्त || मानक.आकार > ८३८८६०८) { फेंको नया अपवाद("HTTP सामग्री की सीमा ८३८८६०८ बाइट है।"); }
        यह.सामग्री = मानक;
    }
}

सार्वजनिक वर्ग एचटीटीपीउत्तर {
    निजी मान अंक: पूर्णांक;
    निजी मान अंतिम: पाठ;
    निजी मान युग्म: सूची<पाठ>;
    निजी मान बाइटें: बाइटबफ़र;
    सार्वजनिक निर्माता(स्थिति: पूर्णांक, पता: पाठ, शीर्ष: सूची<पाठ>, सामग्री: बाइटबफ़र) {
        अंक = स्थिति; अंतिम = पता; युग्म = शीर्ष; बाइटें = सामग्री;
    }
    सार्वजनिक कार्य स्थिति() -> पूर्णांक { लौटाओ अंक; }
    सार्वजनिक कार्य अंतिमपता() -> पाठ { लौटाओ अंतिम; }
    सार्वजनिक कार्य सामग्री() -> बाइटबफ़र { लौटाओ बाइटें; }
    सार्वजनिक कार्य पाठ्यांश() -> पाठ { लौटाओ पाठ्य.यूटीएफ८पाठ(बाइटें); }
    सार्वजनिक कार्य शीर्षमान(नाम: पाठ) -> सूची<पाठ> {
        स्थिर फल: सूची<पाठ> = नया सूची<पाठ>(); मान क: पूर्णांक = ०;
        जबतक (क < युग्म.आकार) {
            यदि (पाठ्य.छोटाअक्षर(युग्म[क]) == पाठ्य.छोटाअक्षर(नाम)) { फल.जोड़ो(युग्म[क+१]); } क = क + २;
        }
        लौटाओ फल;
    }
}

सार्वजनिक वर्ग जालउत्तरप्रवाह पालन बंदनीय {
    सार्वजनिक मान पहचान: पूर्णांक;
    निजी मान बंद: तार्किक = असत्य;
    सार्वजनिक निर्माता() { यह.पहचान = ०; }
    सार्वजनिक कार्य बंदकरो() -> शून्य { यदि (!बंद) { बंद = सत्य; यदि (पहचान > ०) { जालतंत्र.बंदकरो(पहचान); } } }
}

सार्वजनिक वर्ग जालनियम {
    सार्वजनिक साझा कार्य शीर्षजाँचो(नाम: पाठ, मानक: पाठ) -> शून्य {
        यदि (पाठ्य.लंबाई(नाम) == ० || पाठ्य.लंबाई(नाम) > २५६ || पाठ्य.लंबाई(मानक) > ८१९२) { फेंको नया अपवाद("अमान्य HTTP शीर्ष।"); }
        स्थिर अक्षर: पाठ = "!#$%&'*+-.^_`|~0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
        मान क: पूर्णांक = ०;
        जबतक (क < पाठ्य.लंबाई(नाम)) { यदि (!पाठ्य.है(अक्षर,पाठ्य.अंश(नाम,क,क+१))) { फेंको नया अपवाद("अमान्य HTTP शीर्ष।"); } क = क + १; }
        स्थिर ब: बाइटबफ़र = पाठ्य.यूटीएफ८(मानक); क = ०;
        जबतक (क < ब.आकार) { स्थिर व: पूर्णांक = परिवर्तित<पूर्णांक>(ब[क]); यदि (व != ९ && (व < ३२ || व > १२६)) { फेंको नया अपवाद("अमान्य HTTP शीर्ष।"); } क = क + १; }
        स्थिर न: पाठ = पाठ्य.छोटाअक्षर(नाम);
        यदि (पाठ्य.है("|host|content-length|transfer-encoding|connection|expect|upgrade|te|trailer|proxy-connection|proxy-authorization|", "|"+न+"|")) { फेंको नया अपवाद("यह HTTP शीर्ष परिवहन द्वारा निर्धारित होता है।"); }
    }
    सार्वजनिक साझा कार्य शीर्षहै(शीर्ष: सूची<पाठ>, नाम: पाठ) -> तार्किक {
        मान क: पूर्णांक = ०;
        जबतक (क < शीर्ष.आकार) { यदि (पाठ्य.छोटाअक्षर(शीर्ष[क]) == नाम) { लौटाओ सत्य; } क = क+२; } लौटाओ असत्य;
    }
    सार्वजनिक साझा कार्य शीर्षलो(शीर्ष: सूची<पाठ>, नाम: पाठ) -> पाठ {
        मान क: पूर्णांक = ०;
        जबतक (क < शीर्ष.आकार) { यदि (पाठ्य.छोटाअक्षर(शीर्ष[क]) == नाम) { लौटाओ शीर्ष[क+१]; } क = क + २; } लौटाओ "";
    }
    सार्वजनिक साझा कार्य शरीरशीर्षहटाओ(शीर्ष: सूची<पाठ>) -> सूची<पाठ> {
        स्थिर फल: सूची<पाठ> = नया सूची<पाठ>(); मान क: पूर्णांक = ०;
        जबतक (क < शीर्ष.आकार) { यदि (!पाठ्य.आरंभ(पाठ्य.छोटाअक्षर(शीर्ष[क]),"content-")) { फल.जोड़ो(शीर्ष[क]); फल.जोड़ो(शीर्ष[क+१]); } क = क + २; } लौटाओ फल;
    }
    सार्वजनिक साझा कार्य खंडपथ(पथ: पाठ) -> पाठ {
        स्थिर भाग: सूची<पाठ> = पाठ्य.बाँटो(पथ,"/"); स्थिर फल: सूची<पाठ> = नया सूची<पाठ>();
        मान क: पूर्णांक = १;
        जबतक (क < भाग.आकार) {
            स्थिर अ: पाठ = भाग[क];
            यदि (अ == "..") { यदि (फल.आकार > ०) { फल.हटाओ(फल.आकार-१); } }
            अन्यथा यदि (अ != ".") { फल.जोड़ो(अ); }
            क = क + १;
        }
        मान जुड़ा: पाठ = "/" + पाठ्य.जोड़ो(फल,"/");
        यदि ((पाठ्य.अंत(पथ,"/.") || पाठ्य.अंत(पथ,"/..")) && !पाठ्य.अंत(जुड़ा,"/")) { जुड़ा = जुड़ा + "/"; }
        लौटाओ जुड़ा;
    }
    // [canonical URI, origin, path, query, scheme]; ASCII URI, UTF-8 percent encoding.
    सार्वजनिक साझा कार्य पता(मूल: पाठ) -> सूची<पाठ> {
        यदि (पाठ्य.लंबाई(मूल) > ८१९२) { फेंको नया अपवाद("अमान्य HTTP पता।"); }
        मान स: पाठ = मूल; स्थिर खंड: पूर्णांक = पाठ्य.खोजो(स,"#"); यदि (खंड >= ०) { स = पाठ्य.अंश(स,०,खंड); }
        स्थिर ब: बाइटबफ़र = पाठ्य.यूटीएफ८(स); मान क: पूर्णांक = ०;
        जबतक (क < ब.आकार) { स्थिर व: पूर्णांक = परिवर्तित<पूर्णांक>(ब[क]); यदि (व <= ३२ || व >= १२७ || व == ९२) { फेंको नया अपवाद("अमान्य HTTP पता।"); } क = क + १; }
        स्थिर सीमा: पूर्णांक = पाठ्य.खोजो(स,"://"); यदि (सीमा < ०) { फेंको नया अपवाद("अमान्य HTTP पता।"); }
        स्थिर योजना: पाठ = पाठ्य.छोटाअक्षर(पाठ्य.अंश(स,०,सीमा));
        यदि (योजना != "http" && योजना != "https") { फेंको नया अपवाद("अमान्य HTTP पता।"); }
        मान अंत: पूर्णांक = सीमा+३;
        जबतक (अंत < पाठ्य.लंबाई(स) && पाठ्य.अंश(स,अंत,अंत+१) != "/" && पाठ्य.अंश(स,अंत,अंत+१) != "?") { अंत = अंत+१; }
        मान अधिकार: पाठ = पाठ्य.छोटाअक्षर(पाठ्य.अंश(स,सीमा+३,अंत));
        यदि (अधिकार == "" || पाठ्य.है(अधिकार,"@")) { फेंको नया अपवाद("अमान्य HTTP पता।"); }
        मान विभाजक: पूर्णांक = -१; मान होस्ट: पाठ = अधिकार;
        यदि (पाठ्य.आरंभ(अधिकार,"[")) {
            स्थिर बंद: पूर्णांक = पाठ्य.खोजो(अधिकार,"]");
            यदि (बंद <= १) { फेंको नया अपवाद("अमान्य HTTP पता।"); }
            होस्ट = पाठ्य.अंश(अधिकार,०,बंद+१);
            यदि (बंद+१ < पाठ्य.लंबाई(अधिकार)) { यदि (पाठ्य.अंश(अधिकार,बंद+१,बंद+२) != ":") { फेंको नया अपवाद("अमान्य HTTP पता।"); } विभाजक = बंद+१; }
            क = १; जबतक (क < बंद) { यदि (!पाठ्य.है("0123456789abcdef:.",पाठ्य.अंश(अधिकार,क,क+१))) { फेंको नया अपवाद("अमान्य HTTP पता।"); } क = क+१; }
        } अन्यथा {
            विभाजक = पाठ्य.खोजो(अधिकार,":"); यदि (विभाजक >= ०) { होस्ट = पाठ्य.अंश(अधिकार,०,विभाजक); }
            यदि (होस्ट == "") { फेंको नया अपवाद("अमान्य HTTP पता।"); }
            क = ०; जबतक (क < पाठ्य.लंबाई(होस्ट)) { यदि (!पाठ्य.है("0123456789abcdefghijklmnopqrstuvwxyz-.",पाठ्य.अंश(होस्ट,क,क+१))) { फेंको नया अपवाद("अमान्य HTTP पता।"); } क = क+१; }
        }
        यदि (विभाजक >= ०) {
            स्थिर पोर्ट: पाठ = पाठ्य.अंश(अधिकार,विभाजक+१,पाठ्य.लंबाई(अधिकार)); मान अंक: पूर्णांक = ०;
            यदि (पोर्ट == "" || पाठ्य.लंबाई(पोर्ट) > ५) { फेंको नया अपवाद("अमान्य HTTP पता।"); }
            क = ०; जबतक (क < पाठ्य.लंबाई(पोर्ट)) { स्थिर व: पूर्णांक = पाठ्य.खोजो("0123456789",पाठ्य.अंश(पोर्ट,क,क+१)); यदि (व < ०) { फेंको नया अपवाद("अमान्य HTTP पता।"); } अंक = अंक*१०+व; क = क+१; }
            यदि (अंक < १ || अंक > ६५५३५) { फेंको नया अपवाद("अमान्य HTTP पता।"); }
            अधिकार = होस्ट;
            यदि (!(योजना == "http" && अंक == ८०) && !(योजना == "https" && अंक == ४४३)) { अधिकार = अधिकार + ":" + परिवर्तित<पाठ>(अंक); }
        }
        मान शेषपथ: पाठ = पाठ्य.अंश(स,अंत,पाठ्य.लंबाई(स)); मान प्रश्न: पाठ = "";
        स्थिर प्र: पूर्णांक = पाठ्य.खोजो(शेषपथ,"?"); यदि (प्र >= ०) { प्रश्न = पाठ्य.अंश(शेषपथ,प्र,पाठ्य.लंबाई(शेषपथ)); शेषपथ = पाठ्य.अंश(शेषपथ,०,प्र); }
        यदि (शेषपथ == "") { शेषपथ = "/"; }
        स = शेषपथ + प्रश्न; क = ०;
        जबतक (क < पाठ्य.लंबाई(स)) {
            यदि (पाठ्य.अंश(स,क,क+१) == "%") {
                यदि (क+२ >= पाठ्य.लंबाई(स) || !पाठ्य.है("0123456789abcdefABCDEF",पाठ्य.अंश(स,क+१,क+२)) || !पाठ्य.है("0123456789abcdefABCDEF",पाठ्य.अंश(स,क+२,क+३))) { फेंको नया अपवाद("अमान्य HTTP पता।"); }
                क = क+२;
            } क = क+१;
        }
        शेषपथ = जालनियम.खंडपथ(शेषपथ); स्थिर उद्गम: पाठ = योजना+"://"+अधिकार;
        लौटाओ नया सूची<पाठ>{उद्गम+शेषपथ+प्रश्न,उद्गम,शेषपथ,प्रश्न,योजना};
    }
    सार्वजनिक साझा कार्य समाधान(मूल: सूची<पाठ>, संदर्भ: पाठ) -> सूची<पाठ> {
        मान दिशा: पाठ = संदर्भ;
        स्थिर खंड: पूर्णांक = पाठ्य.खोजो(दिशा,"#"); यदि (खंड >= ०) { दिशा = पाठ्य.अंश(दिशा,०,खंड); }
        यदि (दिशा == "") { लौटाओ मूल; }
        यदि (पाठ्य.आरंभ(दिशा,"//")) { लौटाओ जालनियम.पता(मूल[४]+":"+दिशा); }
        स्थिर उपसर्ग: पूर्णांक = पाठ्य.खोजो(दिशा,":"); स्थिर स्लैश: पूर्णांक = पाठ्य.खोजो(दिशा,"/"); स्थिर प्रश्न: पूर्णांक = पाठ्य.खोजो(दिशा,"?");
        यदि (उपसर्ग >= ० && (स्लैश < ० || उपसर्ग < स्लैश) && (प्रश्न < ० || उपसर्ग < प्रश्न)) { लौटाओ जालनियम.पता(दिशा); }
        यदि (पाठ्य.आरंभ(दिशा,"/")) { लौटाओ जालनियम.पता(मूल[१]+दिशा); }
        यदि (पाठ्य.आरंभ(दिशा,"?")) { लौटाओ जालनियम.पता(मूल[१]+मूल[२]+दिशा); }
        स्थिर भाग: सूची<पाठ> = पाठ्य.बाँटो(मूल[२],"/"); भाग.हटाओ(भाग.आकार-१);
        लौटाओ जालनियम.पता(मूल[१]+पाठ्य.जोड़ो(भाग,"/")+"/"+दिशा);
    }
}

सार्वजनिक वर्ग एचटीटीपी {
    सार्वजनिक साझा कार्य कूटित(मानक: पाठ) -> पाठ {
        स्थिर ब: बाइटबफ़र = पाठ्य.यूटीएफ८(मानक); मान फल: पाठ = ""; मान क: पूर्णांक = ०;
        स्थिर वर्ण: पाठ = "0123456789ABCDEF";
        जबतक (क < ब.आकार) {
            स्थिर व: पूर्णांक = परिवर्तित<पूर्णांक>(ब[क]);
            यदि ((व >= ६५ && व <= ९०) || (व >= ९७ && व <= १२२) || (व >= ४८ && व <= ५७) || व == ४५ || व == ४६ || व == ९५ || व == १२६) { फल = फल + पाठ्य.यूटीएफ८पाठ(ब.काटो(क,क+१)); }
            अन्यथा { स्थिर ऊ: पूर्णांक = व / १६; स्थिर नि: पूर्णांक = व % १६; फल = फल + "%" + पाठ्य.अंश(वर्ण,ऊ,ऊ+१) + पाठ्य.अंश(वर्ण,नि,नि+१); }
            क = क+१;
        } लौटाओ फल;
    }
    सार्वजनिक साझा कार्य पाओ(पता: पाठ) -> एचटीटीपीउत्तर { लौटाओ एचटीटीपी.भेजो(नया एचटीटीपीअनुरोध("GET",पता)); }
    सार्वजनिक साझा कार्य भेजो(अनुरोध: एचटीटीपीअनुरोध) -> एचटीटीपीउत्तर {
        मान विधि: पाठ = पाठ्य.बड़ाअक्षर(अनुरोध.विधि);
        यदि (!पाठ्य.है("|GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS|","|"+विधि+"|")) { फेंको नया अपवाद("अमान्य HTTP विधि।"); }
        यदि (अनुरोध.समयसीमा < १ || अनुरोध.समयसीमा > १२००००) { फेंको नया अपवाद("HTTP समयसीमा १ से १२०००० मिलीसेकंड होनी चाहिए।"); }
        यदि (अनुरोध.अनुसरणसीमा < ० || अनुरोध.अनुसरणसीमा > १०) { फेंको नया अपवाद("HTTP अनुसरण सीमा ० से १० होनी चाहिए।"); }
        यदि (अनुरोध.सामग्री == रिक्त || अनुरोध.सामग्री.आकार > ८३८८६०८ || (विधि == "HEAD" && अनुरोध.सामग्री.आकार != ०)) { फेंको नया अपवाद("अमान्य HTTP सामग्री।"); }
        यदि (अनुरोध.शीर्ष == रिक्त || अनुरोध.शीर्ष.आकार % २ != ० || अनुरोध.शीर्ष.आकार > १२८) { फेंको नया अपवाद("अमान्य HTTP शीर्ष।"); }
        मान शीर्ष: सूची<पाठ> = नया सूची<पाठ>(); मान क: पूर्णांक = ०; मान आकार: पूर्णांक = ०;
        जबतक (क < अनुरोध.शीर्ष.आकार) {
            स्थिर नाम: पाठ = अनुरोध.शीर्ष[क]; स्थिर व: पाठ = अनुरोध.शीर्ष[क+१]; जालनियम.शीर्षजाँचो(नाम,व);
            आकार = आकार + पाठ्य.लंबाई(नाम)+पाठ्य.लंबाई(व)+४; शीर्ष.जोड़ो(नाम); शीर्ष.जोड़ो(व); क = क+२;
        }
        यदि (!जालनियम.शीर्षहै(शीर्ष,"accept")) { शीर्ष.जोड़ो("Accept"); शीर्ष.जोड़ो("*/*"); आकार = आकार+१३; }
        यदि (!जालनियम.शीर्षहै(शीर्ष,"user-agent")) { शीर्ष.जोड़ो("User-Agent"); शीर्ष.जोड़ो("Bhash/1"); आकार = आकार+२१; }
        यदि (आकार > ६५५३६) { फेंको नया अपवाद("HTTP शीर्षों की सीमा पार हो गई।"); }
        मान पता: सूची<पाठ> = जालनियम.पता(अनुरोध.पता); मान शरीर: बाइटबफ़र = अनुरोध.सामग्री;
        स्थिर समाप्ति: पूर्णांक = जालतंत्र.घड़ी()+अनुरोध.समयसीमा; मान चक्र: पूर्णांक = ०;
        जबतक (सत्य) {
            स्थिर शेषसमय: पूर्णांक = समाप्ति-जालतंत्र.घड़ी(); यदि (शेषसमय <= ०) { फेंको नया अपवाद("HTTP अनुरोध का समय समाप्त।"); }
            संसाधन (ह: जालउत्तरप्रवाह = नया जालउत्तरप्रवाह()) {
                ह.पहचान = जालतंत्र.भेजो(विधि,पता[०],शीर्ष,शरीर,शेषसमय);
                यदि (जालतंत्र.घड़ी() > समाप्ति) { फेंको नया अपवाद("HTTP अनुरोध का समय समाप्त।"); }
                स्थिर स्थिति: पूर्णांक = जालतंत्र.स्थिति(ह.पहचान); स्थिर उत्तरशीर्ष: सूची<पाठ> = जालतंत्र.शीर्ष(ह.पहचान);
                स्थिर दिशा: पाठ = जालनियम.शीर्षलो(उत्तरशीर्ष,"location");
                यदि (अनुरोध.अनुसरणसीमा != ० && दिशा != "" && (स्थिति == ३०१ || स्थिति == ३०२ || स्थिति == ३०३ || स्थिति == ३०७ || स्थिति == ३०८)) {
                    यदि (चक्र >= अनुरोध.अनुसरणसीमा) { फेंको नया अपवाद("HTTP पुनर्निर्देशन सीमा पार हो गई।"); }
                    स्थिर अगला: सूची<पाठ> = जालनियम.समाधान(पता,दिशा);
                    यदि (पता[४] == "https" && अगला[४] != "https") { फेंको नया अपवाद("HTTPS से HTTP पुनर्निर्देशन अस्वीकार है।"); }
                    यदि (स्थिति == ३०३ && विधि != "HEAD" || (स्थिति == ३०१ || स्थिति == ३०२) && विधि == "POST") { विधि = "GET"; शरीर = नया बाइटबफ़र(०); शीर्ष = जालनियम.शरीरशीर्षहटाओ(शीर्ष); }
                    यदि (अगला[१] != पता[१]) {
                        यदि (विधि != "GET" && विधि != "HEAD") { फेंको नया अपवाद("अन्य उद्गम पर HTTP सामग्री पुनः नहीं भेज सकते।"); }
                        शीर्ष = नया सूची<पाठ>{"Accept","*/*","User-Agent","Bhash/1"};
                    }
                    पता = अगला; चक्र = चक्र+१;
                } अन्यथा {
                    लौटाओ नया एचटीटीपीउत्तर(स्थिति,पता[०],उत्तरशीर्ष,जालतंत्र.सामग्री(ह.पहचान));
                }
            }
        }
        फेंको नया अपवाद("HTTP अनुरोध असफल।");
    }
}
