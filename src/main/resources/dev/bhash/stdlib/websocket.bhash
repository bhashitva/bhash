// SPDX-License-Identifier: Apache-2.0
संकुल मानक;

सार्वजनिक वर्ग वेबसॉकेटत्रुटि विस्तार अपवाद {
    सार्वजनिक मान कोड: पूर्णांक;
    सार्वजनिक निर्माता(कोड: पूर्णांक, संदेश: पाठ) : आधार(संदेश) { यह.कोड = कोड; }
}

सार्वजनिक वर्ग वेबसॉकेटकूट {
    निजी निर्माता() {}
    निजी साझा फलन अक्षर(अ: पूर्णांक) -> पाठ {
        लौटाओ पाठ्य.अंश("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/",अ,अ+१);
    }
    निजी साझा फलन घुमाओ(अ: पूर्णांक, दूरी: पूर्णांक) -> पूर्णांक {
        लौटाओ ((अ << दूरी) | (अ >>> (३२-दूरी))) & ४२९४९६७२९५;
    }
    सार्वजनिक साझा फलन स्वीकृतिलो(कुंजी: पाठ) -> पाठ {
        स्थिर वर्ण: पाठ = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        यदि (पाठ्य.लंबाई(कुंजी)!=२४ || !पाठ्य.अंत(कुंजी,"==")) { फेंको नया वेबत्रुटि(४००,"अमान्य WebSocket कुंजी।"); }
        मान इ: पूर्णांक = ०;
        जबतक (इ<२२) {
            स्थिर अ: पूर्णांक = पाठ्य.खोजो(वर्ण,पाठ्य.अंश(कुंजी,इ,इ+१));
            यदि (अ<० || (इ==२१ && अ%१६!=०)) { फेंको नया वेबत्रुटि(४००,"अमान्य WebSocket कुंजी।"); }
            इ=इ+१;
        }
        // RFC 6455 fixes the input at 60 ASCII bytes. SHA-1 is only the wire checksum.
        स्थिर मूल: बाइटबफ़र = पाठ्य.यूटीएफ८(कुंजी+"258EAFA5-E914-47DA-95CA-C5AB0DC85B11");
        स्थिर संदेश: बाइटबफ़र = नया बाइटबफ़र(१२८);
        इ=०;
        जबतक (इ<६०) { संदेश[इ]=मूल[इ]; इ=इ+१; }
        संदेश[६०]=परिवर्तित<बाइट>(१२८); संदेश[१२६]=परिवर्तित<बाइट>(१); संदेश[१२७]=परिवर्तित<बाइट>(२२४);
        स्थिर सार: सूची<पूर्णांक> = नया सूची<पूर्णांक>{१७३२५८४१९३,४०२३२३३४१७,२५६२३८३१०२,२७१७३३८७८,३२८५३७७५२०};
        मान खंड: पूर्णांक = ०;
        जबतक (खंड<१२८) {
            स्थिर शब्द: सूची<पूर्णांक> = नया सूची<पूर्णांक>();
            इ=०;
            जबतक (इ<१६) {
                स्थिर क: पूर्णांक = खंड+४*इ;
                शब्द.जोड़ो((परिवर्तित<पूर्णांक>(संदेश[क])<<२४) | (परिवर्तित<पूर्णांक>(संदेश[क+१])<<१६) | (परिवर्तित<पूर्णांक>(संदेश[क+२])<<८) | परिवर्तित<पूर्णांक>(संदेश[क+३]));
                इ=इ+१;
            }
            जबतक (इ<८०) { शब्द.जोड़ो(वेबसॉकेटकूट.घुमाओ(शब्द[इ-३]^शब्द[इ-८]^शब्द[इ-१४]^शब्द[इ-१६],१)); इ=इ+१; }
            मान अ: पूर्णांक=सार[०]; मान ब: पूर्णांक=सार[१]; मान स: पूर्णांक=सार[२];
            मान द: पूर्णांक=सार[३]; मान ई: पूर्णांक=सार[४];
            इ=०;
            जबतक (इ<८०) {
                मान फ: पूर्णांक=०; मान क: पूर्णांक=०;
                यदि (इ<२०) { फ=(ब&स)|((~ब)&द); क=१५१८५००२४९; }
                अन्यथा यदि (इ<४०) { फ=ब^स^द; क=१८५९७७५३९३; }
                अन्यथा यदि (इ<६०) { फ=(ब&स)|(ब&द)|(स&द); क=२४००९५९७०८; }
                अन्यथा { फ=ब^स^द; क=३३९५४६९७८२; }
                स्थिर अगला: पूर्णांक=(वेबसॉकेटकूट.घुमाओ(अ,५)+फ+ई+क+शब्द[इ])&४२९४९६७२९५;
                ई=द; द=स; स=वेबसॉकेटकूट.घुमाओ(ब,३०); ब=अ; अ=अगला; इ=इ+१;
            }
            सार[०]=(सार[०]+अ)&४२९४९६७२९५; सार[१]=(सार[१]+ब)&४२९४९६७२९५;
            सार[२]=(सार[२]+स)&४२९४९६७२९५; सार[३]=(सार[३]+द)&४२९४९६७२९५; सार[४]=(सार[४]+ई)&४२९४९६७२९५;
            खंड=खंड+६४;
        }
        स्थिर बाइटें: बाइटबफ़र = नया बाइटबफ़र(२०);
        इ=०;
        जबतक (इ<२०) {
            बाइटें[इ]=परिवर्तित<बाइट>((सार[इ/४] >>> (२४-८*(इ%४)))&२५५); इ=इ+१;
        }
        मान फल: पाठ=""; इ=०;
        जबतक (इ<१८) {
            स्थिर अ: पूर्णांक=परिवर्तित<पूर्णांक>(बाइटें[इ]);
            स्थिर ब: पूर्णांक=परिवर्तित<पूर्णांक>(बाइटें[इ+१]);
            स्थिर स: पूर्णांक=परिवर्तित<पूर्णांक>(बाइटें[इ+२]);
            फल=फल+वेबसॉकेटकूट.अक्षर(अ>>>२)+वेबसॉकेटकूट.अक्षर(((अ&३)<<४)|(ब>>>४))+वेबसॉकेटकूट.अक्षर(((ब&१५)<<२)|(स>>>६))+वेबसॉकेटकूट.अक्षर(स&६३);
            इ=इ+३;
        }
        स्थिर अ: पूर्णांक=परिवर्तित<पूर्णांक>(बाइटें[१८]); स्थिर ब: पूर्णांक=परिवर्तित<पूर्णांक>(बाइटें[१९]);
        लौटाओ फल+वेबसॉकेटकूट.अक्षर(अ>>>२)+वेबसॉकेटकूट.अक्षर(((अ&३)<<४)|(ब>>>४))+वेबसॉकेटकूट.अक्षर((ब&१५)<<२)+"=";
    }

    सार्वजनिक साझा फलन मान्यकोड(कोड: पूर्णांक) -> तार्किक {
        लौटाओ (कोड>=१००० && कोड<=१०१४ && कोड!=१००४ && कोड!=१००५ && कोड!=१००६) || (कोड>=३००० && कोड<=४९९९);
    }
    सार्वजनिक साझा फलन बंदसामग्री(कोड: पूर्णांक, कारण: पाठ) -> बाइटबफ़र {
        स्थिर विवरण: बाइटबफ़र=पाठ्य.यूटीएफ८(कारण);
        यदि (!वेबसॉकेटकूट.मान्यकोड(कोड) || कोड==१०१० || विवरण.आकार>१२३) { फेंको नया अपवाद("अमान्य WebSocket बंद संकेत।"); }
        स्थिर फल: बाइटबफ़र=नया बाइटबफ़र(विवरण.आकार+२);
        फल[०]=परिवर्तित<बाइट>(कोड>>>८); फल[१]=परिवर्तित<बाइट>(कोड&२५५);
        मान इ: पूर्णांक=०; जबतक(इ<विवरण.आकार){फल[इ+२]=विवरण[इ]; इ=इ+१;}
        लौटाओ फल;
    }
    सार्वजनिक साझा फलन फ़्रेम(कोड: पूर्णांक, अंतिम: तार्किक, सामग्री: बाइटबफ़र, आरंभ: पूर्णांक, आकार: पूर्णांक) -> बाइटबफ़र {
        मान शीर्ष: पूर्णांक=२;
        यदि (आकार>१२५) { शीर्ष=४; }
        स्थिर फल: बाइटबफ़र=नया बाइटबफ़र(शीर्ष+आकार);
        मान पहला: पूर्णांक=कोड;
        यदि (अंतिम) { पहला=पहला|१२८; }
        फल[०]=परिवर्तित<बाइट>(पहला);
        यदि (शीर्ष==२) { फल[१]=परिवर्तित<बाइट>(आकार); }
        अन्यथा { फल[१]=परिवर्तित<बाइट>(१२६); फल[२]=परिवर्तित<बाइट>(आकार>>>८); फल[३]=परिवर्तित<बाइट>(आकार&२५५); }
        मान इ: पूर्णांक=०; जबतक(इ<आकार){फल[शीर्ष+इ]=सामग्री[आरंभ+इ]; इ=इ+१;}
        लौटाओ फल;
    }
}

सार्वजनिक वर्ग वेबसॉकेटफ़्रेम {
    सार्वजनिक मान कोड: पूर्णांक;
    सार्वजनिक मान अंतिम: तार्किक;
    सार्वजनिक मान सामग्री: बाइटबफ़र;
    सार्वजनिक निर्माता(कोड: पूर्णांक, अंतिम: तार्किक, सामग्री: बाइटबफ़र) { यह.कोड=कोड; यह.अंतिम=अंतिम; यह.सामग्री=सामग्री; }
}

सार्वजनिक वर्ग वेबसॉकेटपाठक {
    निजी मान खंड: बाइटबफ़र;
    निजी मान क्रम: पूर्णांक=०;
    निजी मान शीर्ष: बाइटबफ़र;
    निजी मान गिने: पूर्णांक=०;
    निजी मान लंबाई: पूर्णांक=२;
    निजी मान सामग्री: बाइटबफ़र;
    निजी मान भरे: पूर्णांक=०;
    निजी मान सीमा: पूर्णांक=०;
    सार्वजनिक निर्माता() { शीर्ष=नया बाइटबफ़र(१४); }

    निजी फलन आकारलो() -> पूर्णांक {
        स्थिर छोटा: पूर्णांक=परिवर्तित<पूर्णांक>(शीर्ष[१])&१२७;
        यदि (छोटा<१२६) { लौटाओ छोटा; }
        यदि (छोटा==१२७ && (परिवर्तित<पूर्णांक>(शीर्ष[२])&१२८)!=०) { फेंको नया वेबसॉकेटत्रुटि(१००२,"अमान्य फ़्रेम लंबाई।"); }
        मान आकार: पूर्णांक=०; मान इ: पूर्णांक=२;
        जबतक (इ<लंबाई-४) {
            आकार=आकार*२५६+परिवर्तित<पूर्णांक>(शीर्ष[इ]); इ=इ+१;
            यदि (आकार>२६२१४४) { फेंको नया वेबसॉकेटत्रुटि(१००९,"WebSocket संदेश बहुत बड़ा है।"); }
        }
        यदि (आकार<१२६ || (छोटा==१२७ && आकार<६५५३६)) { फेंको नया वेबसॉकेटत्रुटि(१००२,"अमान्य फ़्रेम लंबाई।"); }
        लौटाओ आकार;
    }

    सार्वजनिक फलन पढ़ो(धारा: द्विदिशधारा) -> वेबसॉकेटफ़्रेम {
        यदि (सीमा!=० && कार्यघड़ी.अब()>=सीमा) { फेंको नया वेबसॉकेटत्रुटि(१००८,"WebSocket फ़्रेम का समय समाप्त।"); }
        यदि (खंड==रिक्त || क्रम==खंड.आकार) {
            खंड=धारा.पढ़ो(); क्रम=०;
            यदि (खंड==रिक्त) { लौटाओ रिक्त; }
            यदि (खंड.आकार==०) { फेंको नया वेबसॉकेटत्रुटि(१००६,"WebSocket संबंध टूट गया।"); }
            यदि (खंड.आकार>८१९२) { फेंको नया अपवाद("WebSocket धारा खंड बहुत बड़ा है।"); }
        }
        यदि (गिने==०) { सीमा=कार्यघड़ी.अब()+१००००; }
        जबतक (क्रम<खंड.आकार && गिने<लंबाई) {
            शीर्ष[गिने]=खंड[क्रम]; गिने=गिने+१; क्रम=क्रम+१;
            यदि (गिने==२) {
                स्थिर पहला: पूर्णांक=परिवर्तित<पूर्णांक>(शीर्ष[०]);
                स्थिर दूसरा: पूर्णांक=परिवर्तित<पूर्णांक>(शीर्ष[१]);
                स्थिर कोड: पूर्णांक=पहला&१५; स्थिर छोटा: पूर्णांक=दूसरा&१२७;
                यदि ((पहला&११२)!=० || (दूसरा&१२८)==० || (कोड>२ && कोड<८) || कोड>१० || (कोड>=८ && ((पहला&१२८)==० || छोटा>१२५))) {
                    फेंको नया वेबसॉकेटत्रुटि(१००२,"अमान्य WebSocket फ़्रेम।");
                }
                लंबाई=६; यदि (छोटा==१२६){लंबाई=८;} अन्यथा यदि (छोटा==१२७){लंबाई=१४;}
            }
        }
        यदि (गिने<लंबाई) { लौटाओ रिक्त; }
        यदि (सामग्री==रिक्त) { सामग्री=नया बाइटबफ़र(यह.आकारलो()); }
        जबतक (क्रम<खंड.आकार && भरे<सामग्री.आकार) {
            सामग्री[भरे]=परिवर्तित<बाइट>(परिवर्तित<पूर्णांक>(खंड[क्रम])^परिवर्तित<पूर्णांक>(शीर्ष[लंबाई-४+भरे%४]));
            भरे=भरे+१; क्रम=क्रम+१;
        }
        यदि (भरे<सामग्री.आकार) { लौटाओ रिक्त; }
        स्थिर पहला: पूर्णांक=परिवर्तित<पूर्णांक>(शीर्ष[०]);
        स्थिर फल: वेबसॉकेटफ़्रेम=नया वेबसॉकेटफ़्रेम(पहला&१५,(पहला&१२८)!=०,सामग्री);
        सामग्री=रिक्त; गिने=०; भरे=०; लंबाई=२; सीमा=०;
        लौटाओ फल;
    }
}

सार्वजनिक वर्ग वेबसॉकेटसंदेश {
    सार्वजनिक मान प्रकार: पाठ;
    सार्वजनिक मान पाठ्यांश: पाठ;
    सार्वजनिक मान बाइटें: बाइटबफ़र;
    सार्वजनिक मान कोड: पूर्णांक;
    सार्वजनिक निर्माता(प्रकार: पाठ, पाठ्यांश: पाठ, बाइटें: बाइटबफ़र, कोड: पूर्णांक) {
        यह.प्रकार=प्रकार; यह.पाठ्यांश=पाठ्यांश; यह.बाइटें=बाइटें; यह.कोड=कोड;
    }
}

सार्वजनिक वर्ग वेबसॉकेटसंदर्भ {
    निजी मान प्रबंधक: सत्रप्रबंधक;
    निजी मान प्रवेश: सत्र;
    सार्वजनिक मान पथमान: मानचित्र<पाठ,पाठ>;
    सार्वजनिक मान उपप्रोटोकॉल: पाठ;
    सार्वजनिक निर्माता(प्रबंधक: सत्रप्रबंधक, प्रवेश: सत्र, पथमान: मानचित्र<पाठ,पाठ>, उपप्रोटोकॉल: पाठ) {
        यह.प्रबंधक=प्रबंधक; यह.प्रवेश=प्रवेश; यह.पथमान=पथमान; यह.उपप्रोटोकॉल=उपप्रोटोकॉल;
    }
    सार्वजनिक फलन जीवितहै() -> तार्किक { लौटाओ प्रबंधक.आंतरिकजीवितहै(प्रवेश); }
    सार्वजनिक फलन अधिकृत() -> सत्र {
        यदि (!यह.जीवितहै()) { फेंको नया वेबसॉकेटत्रुटि(१००८,"WebSocket सत्र समाप्त।"); }
        लौटाओ प्रवेश;
    }
}

सार्वजनिक अनुबंध वेबसॉकेटचालक {
    फलन संभालो(संदर्भ: वेबसॉकेटसंदर्भ, संबंध: वेबसॉकेटसंबंध, चिह्न: निरस्तीकरणचिह्न) -> कार्यफल<कार्यशून्य>;
}

सार्वजनिक वर्ग वेबसॉकेटसंबंध {
    निजी मान धारा: द्विदिशधारा;
    निजी मान पाठक: वेबसॉकेटपाठक;
    निजी मान बंद: तार्किक=असत्य;
    निजी मान मुक्त: तार्किक=असत्य;
    निजी मान चलरहा: तार्किक=असत्य;
    निजी मान संदर्भमान: वेबसॉकेटसंदर्भ;
    निजी मान दोष: वेबसॉकेटत्रुटि;
    निजी मान आगम: वेबसॉकेटसंदेश;
    निजी मान आगमसीमा: पूर्णांक=०;
    निजी मान ग्रहण: तार्किक=असत्य;
    निजी मान खंडित: बाइटबफ़र;
    निजी मान खंडकोड: पूर्णांक;
    निजी मान खंडआकार: पूर्णांक;
    निजी मान खंडगिनती: पूर्णांक;
    निजी मान खंडसीमा: पूर्णांक;
    निजी मान प्रेषण: तार्किक=असत्य;
    निजी मान प्रेषणसफल: तार्किक;
    निजी मान प्रेषणशुरू: तार्किक;
    निजी मान निर्गम: बाइटबफ़र;
    निजी मान निर्गमकोड: पूर्णांक;
    निजी मान निर्गमक्रम: पूर्णांक;
    निजी मान निर्गमसीमा: पूर्णांक;
    निजी मान प्रेषणचिह्न: निरस्तीकरणचिह्न;
    निजी मान प्रेषणकार्यचिह्न: निरस्तीकरणचिह्न;
    निजी मान लिखावट: बाइटबफ़र;
    निजी मान लिखाक्रम: पूर्णांक;
    निजी मान लिखाकोड: पूर्णांक;
    निजी मान लिखामात्रा: पूर्णांक;
    निजी मान लिखाअंतिम: तार्किक;
    निजी मान पोंग: बाइटबफ़र;
    निजी मान पिंग: बाइटबफ़र;
    निजी मान पिंगपहचान: पाठ;
    निजी मान पिंगसीमा: पूर्णांक=०;
    निजी मान अगलापिंग: पूर्णांक;
    निजी मान समापन: बाइटबफ़र;
    निजी मान समापनसीमा: पूर्णांक;
    निजी मान बंदभेजा: तार्किक=असत्य;
    निजी मान बंदपाया: तार्किक=असत्य;
    निजी मान समापनफल: वेबसॉकेटसंदेश;
    निजी मान अमान्यधारा: तार्किक=असत्य;

    सार्वजनिक निर्माता(धारा: द्विदिशधारा) {
        यदि (धारा==रिक्त) { फेंको नया अपवाद("WebSocket धारा रिक्त है।"); }
        यह.धारा=धारा; पाठक=नया वेबसॉकेटपाठक();
    }

    निजी फलन बंददोष() -> शून्य {
        यदि (दोष!=रिक्त) { फेंको दोष; }
        फेंको नया वेबसॉकेटत्रुटि(१०००,"WebSocket संबंध बंद है।");
    }
    निजी फलन प्रवेशजाँचो() -> शून्य {
        यदि (संदर्भमान!=रिक्त) { संदर्भमान.अधिकृत(); }
    }
    निजी फलन समापनशुरू(सामग्री: बाइटबफ़र) -> शून्य {
        यदि (समापन!=रिक्त || बंद) { लौटाओ; }
        समापन=सामग्री; समापनसीमा=कार्यघड़ी.अब()+३०००;
        निर्गम=रिक्त; खंडित=रिक्त;
        यदि (लिखावट!=रिक्त && लिखाक्रम==०) { लिखावट=रिक्त; }
    }
    निजी फलन असफल(गलती: वेबसॉकेटत्रुटि) -> शून्य {
        यदि (दोष==रिक्त) { दोष=गलती; }
        आगम=रिक्त; अमान्यधारा=सत्य;
        यदि (गलती.कोड==१००६ || (लिखावट!=रिक्त && लिखाक्रम!=०)) { बंद=सत्य; }
        अन्यथा { यह.समापनशुरू(वेबसॉकेटकूट.बंदसामग्री(गलती.कोड,"")); }
    }
    सार्वजनिक फलन पाओ() -> कार्यफल<वेबसॉकेटसंदेश> { लौटाओ यह.पाओ(कार्य.वर्तमानचिह्न()); }
    सार्वजनिक असमकालिक फलन पाओ(चिह्न: निरस्तीकरणचिह्न) -> वेबसॉकेटसंदेश {
        यदि (ग्रहण) { फेंको नया वेबसॉकेटत्रुटि(१००८,"एक WebSocket पढ़ना पहले से चालू है।"); }
        ग्रहण=सत्य;
        प्रयास {
            जबतक (सत्य) {
                चिह्न.जाँचो();
                यह.प्रवेशजाँचो();
                यदि (आगम!=रिक्त) {
                    स्थिर फल: वेबसॉकेटसंदेश=आगम; आगम=रिक्त; लौटाओ फल;
                }
                यदि (समापनफल!=रिक्त) {
                    स्थिर फल: वेबसॉकेटसंदेश=समापनफल; समापनफल=रिक्त; लौटाओ फल;
                }
                यदि (बंद || समापन!=रिक्त) { यह.बंददोष(); }
                प्रतीक्षा कार्य.विलंब(५,चिह्न);
            }
        } अंततः { ग्रहण=असत्य; }
        लौटाओ रिक्त;
    }
    सार्वजनिक फलन पाठभेजो(मानक: पाठ) -> कार्यफल<कार्यशून्य> { लौटाओ यह.पाठभेजो(मानक,कार्य.वर्तमानचिह्न()); }
    सार्वजनिक फलन पाठभेजो(मानक: पाठ, चिह्न: निरस्तीकरणचिह्न) -> कार्यफल<कार्यशून्य> {
        यह.भेजजाँचो(पाठ्य.लंबाई(मानक),चिह्न);
        लौटाओ यह.भेजोतैयार(१,पाठ्य.यूटीएफ८(मानक),चिह्न);
    }
    सार्वजनिक फलन बाइटभेजो(मानक: बाइटबफ़र) -> कार्यफल<कार्यशून्य> { लौटाओ यह.बाइटभेजो(मानक,कार्य.वर्तमानचिह्न()); }
    सार्वजनिक फलन बाइटभेजो(मानक: बाइटबफ़र, चिह्न: निरस्तीकरणचिह्न) -> कार्यफल<कार्यशून्य> {
        यह.भेजजाँचो(मानक.आकार,चिह्न);
        लौटाओ यह.भेजोतैयार(२,मानक.काटो(०,मानक.आकार),चिह्न);
    }
    निजी फलन भेजजाँचो(आकार: पूर्णांक, चिह्न: निरस्तीकरणचिह्न) -> शून्य {
        चिह्न.जाँचो();
        यह.प्रवेशजाँचो();
        यदि (बंद || समापन!=रिक्त) { यह.बंददोष(); }
        यदि (प्रेषण) { फेंको नया वेबसॉकेटत्रुटि(१००८,"एक WebSocket भेजना पहले से चालू है।"); }
        यदि (आकार>२६२१४४) { फेंको नया वेबसॉकेटत्रुटि(१००९,"WebSocket संदेश बहुत बड़ा है।"); }
    }
    निजी फलन भेजोतैयार(कोड: पूर्णांक, मानक: बाइटबफ़र, चिह्न: निरस्तीकरणचिह्न) -> कार्यफल<कार्यशून्य> {
        यह.भेजजाँचो(मानक.आकार,चिह्न);
        स्थिर प्रवेश: वेबसॉकेटप्रेषणप्रवेश=नया वेबसॉकेटप्रेषणप्रवेश(यह);
        प्रेषण=सत्य; प्रेषणसफल=असत्य; प्रेषणशुरू=असत्य;
        प्रयास {
            स्थिर काम: कार्यफल<कार्यशून्य> = यह.भेजो(कोड,मानक,चिह्न,कार्यघड़ी.अब()+१००००);
            यदि (काम.समाप्तहै()) { प्रवेश.बंदकरो(); }
            अन्यथा { काम.आंतरिकप्रवेश=प्रवेश; }
            लौटाओ काम;
        } पकड़ो (गलती: अपवाद) { प्रवेश.बंदकरो(); फेंको गलती; }
    }
    निजी असमकालिक फलन भेजो(कोड: पूर्णांक, मानक: बाइटबफ़र, चिह्न: निरस्तीकरणचिह्न, सीमा: पूर्णांक) -> शून्य {
        चिह्न.जाँचो();
        यदि (बंद || समापन!=रिक्त) { यह.बंददोष(); }
        यदि (कार्यघड़ी.अब()>=सीमा) { फेंको नया समयसीमाअपवाद(); }
        प्रेषणचिह्न=चिह्न; प्रेषणकार्यचिह्न=कार्य.वर्तमानचिह्न();
        निर्गम=मानक; निर्गमकोड=कोड; निर्गमक्रम=०; निर्गमसीमा=सीमा;
        जबतक (!प्रेषणसफल) {
            यदि (बंद || समापन!=रिक्त) { यह.बंददोष(); }
            यदि (कार्यघड़ी.अब()>=निर्गमसीमा) { फेंको नया समयसीमाअपवाद(); }
            प्रतीक्षा कार्य.विलंब(५,चिह्न);
        }
    }
    सार्वजनिक फलन आंतरिकप्रेषणछोड़ो() -> शून्य {
        यदि (!प्रेषणसफल && समापन==रिक्त) { यह.निर्गमरद्दकरो(); }
        प्रेषणचिह्न=रिक्त; प्रेषणकार्यचिह्न=रिक्त;
        निर्गम=रिक्त; प्रेषण=असत्य;
    }
    निजी फलन निर्गमरद्दकरो() -> शून्य {
        यदि (प्रेषणशुरू) {
            दोष=नया वेबसॉकेटत्रुटि(१००६,"WebSocket प्रेषण बीच में रुका।");
            बंद=सत्य;
        } अन्यथा यदि (लिखावट!=रिक्त && लिखाकोड<८) { लिखावट=रिक्त; }
        निर्गम=रिक्त;
    }
    सार्वजनिक फलन बंदकरो() -> कार्यफल<कार्यशून्य> { लौटाओ यह.बंदकरो(१०००,""); }
    सार्वजनिक असमकालिक फलन बंदकरो(कोड: पूर्णांक, कारण: पाठ) -> शून्य {
        यदि (!चलरहा) { फेंको नया अपवाद("WebSocket सत्र चालू नहीं है।"); }
        यदि (!बंद && समापन==रिक्त) { यह.समापनशुरू(वेबसॉकेटकूट.बंदसामग्री(कोड,कारण)); }
        जबतक (!मुक्त) { प्रतीक्षा कार्य.विलंब(५); }
        यदि (दोष!=रिक्त) { फेंको दोष; }
    }

    निजी फलन संदेशरखो(कोड: पूर्णांक, सामग्री: बाइटबफ़र) -> शून्य {
        यदि (कोड==१) {
            मान मानक: पाठ="";
            प्रयास { मानक=पाठ्य.यूटीएफ८पाठ(सामग्री); }
            पकड़ो (गलती: अपवाद) { फेंको नया वेबसॉकेटत्रुटि(१००७,"अमान्य WebSocket UTF-8।"); }
            आगम=नया वेबसॉकेटसंदेश("पाठ",मानक,रिक्त,०);
        } अन्यथा { आगम=नया वेबसॉकेटसंदेश("बाइट", "",सामग्री,०); }
        आगमसीमा=कार्यघड़ी.अब()+१००००;
    }
    निजी फलन पढ़ाफ़्रेम(फ़्रेम: वेबसॉकेटफ़्रेम) -> शून्य {
        स्थिर कोड: पूर्णांक=फ़्रेम.कोड;
        स्थिर सामग्री: बाइटबफ़र=फ़्रेम.सामग्री;
        यदि (कोड==८) {
            यदि (सामग्री.आकार==१) { फेंको नया वेबसॉकेटत्रुटि(१००२,"अमान्य WebSocket बंद फ़्रेम।"); }
            मान स्थिति: पूर्णांक=०; मान कारण: पाठ="";
            यदि (सामग्री.आकार>=२) {
                स्थिति=२५६*परिवर्तित<पूर्णांक>(सामग्री[०])+परिवर्तित<पूर्णांक>(सामग्री[१]);
                यदि (!वेबसॉकेटकूट.मान्यकोड(स्थिति)) { फेंको नया वेबसॉकेटत्रुटि(१००२,"अमान्य WebSocket बंद संकेत।"); }
                प्रयास { कारण=पाठ्य.यूटीएफ८पाठ(सामग्री.काटो(२,सामग्री.आकार)); }
                पकड़ो (गलती: अपवाद) { फेंको नया वेबसॉकेटत्रुटि(१००७,"अमान्य WebSocket बंद कारण।"); }
            }
            बंदपाया=सत्य;
            समापनफल=नया वेबसॉकेटसंदेश("बंद",कारण,रिक्त,स्थिति);
            यदि (स्थिति==१०१०) { यह.समापनशुरू(वेबसॉकेटकूट.बंदसामग्री(१०००,"")); }
            अन्यथा { यह.समापनशुरू(सामग्री); }
            लौटाओ;
        }
        यदि (कोड==९) { पोंग=सामग्री; लौटाओ; }
        यदि (कोड==१०) {
            यदि (पिंगसीमा!=० && सामग्री.आकार<=२०) {
                प्रयास { यदि (पाठ्य.यूटीएफ८पाठ(सामग्री)==पिंगपहचान) { पिंगसीमा=०; } }
                पकड़ो (गलती: अपवाद) { }
            }
            लौटाओ;
        }
        यदि (समापन!=रिक्त) { लौटाओ; }
        यदि ((कोड==० && खंडित==रिक्त) || (कोड!=० && खंडित!=रिक्त)) { फेंको नया वेबसॉकेटत्रुटि(१००२,"अमान्य WebSocket खंड क्रम।"); }
        यदि (कोड!=० && फ़्रेम.अंतिम) { यह.संदेशरखो(कोड,सामग्री); लौटाओ; }
        यदि (कोड!=०) {
            खंडित=नया बाइटबफ़र(२६२१४४); खंडकोड=कोड; खंडआकार=०;
            खंडगिनती=०; खंडसीमा=कार्यघड़ी.अब()+१००००;
        }
        खंडगिनती=खंडगिनती+१;
        यदि (खंडगिनती>१२८ || खंडआकार+सामग्री.आकार>२६२१४४) { फेंको नया वेबसॉकेटत्रुटि(१००९,"WebSocket संदेश बहुत बड़ा है।"); }
        मान इ: पूर्णांक=०;
        जबतक (इ<सामग्री.आकार) { खंडित[खंडआकार]=सामग्री[इ]; खंडआकार=खंडआकार+१; इ=इ+१; }
        यदि (फ़्रेम.अंतिम) {
            स्थिर जुड़ा: बाइटबफ़र=खंडित.काटो(०,खंडआकार); खंडित=रिक्त;
            यह.संदेशरखो(खंडकोड,जुड़ा);
        }
    }

    निजी फलन नियंत्रणरखो(कोड: पूर्णांक, सामग्री: बाइटबफ़र) -> शून्य {
        लिखाकोड=कोड; लिखावट=वेबसॉकेटकूट.फ़्रेम(कोड,सत्य,सामग्री,०,सामग्री.आकार); लिखाक्रम=०;
    }
    निजी फलन लिखावटचुनो() -> शून्य {
        यदि (लिखावट!=रिक्त) { लौटाओ; }
        यदि (समापन!=रिक्त && !बंदभेजा) { यह.नियंत्रणरखो(८,समापन); लौटाओ; }
        यदि (पोंग!=रिक्त) { यह.नियंत्रणरखो(१०,पोंग); पोंग=रिक्त; लौटाओ; }
        यदि (बंदभेजा) { लौटाओ; }
        यदि (पिंग!=रिक्त) { यह.नियंत्रणरखो(९,पिंग); पिंग=रिक्त; लौटाओ; }
        यदि (निर्गम==रिक्त) { लौटाओ; }
        लिखाकोड=०; यदि (निर्गमक्रम==०) { लिखाकोड=निर्गमकोड; }
        लिखामात्रा=निर्गम.आकार-निर्गमक्रम;
        यदि (लिखामात्रा>४०९६) { लिखामात्रा=४०९६; }
        लिखाअंतिम=निर्गमक्रम+लिखामात्रा==निर्गम.आकार;
        लिखावट=वेबसॉकेटकूट.फ़्रेम(लिखाकोड,लिखाअंतिम,निर्गम,निर्गमक्रम,लिखामात्रा); लिखाक्रम=०;
    }
    निजी फलन लिखावटभेजो() -> शून्य {
        यह.लिखावटचुनो();
        यदि (लिखावट==रिक्त) { लौटाओ; }
        मान भाग: बाइटबफ़र=लिखावट;
        यदि (लिखाक्रम!=०) { भाग=लिखावट.काटो(लिखाक्रम,लिखावट.आकार); }
        स्थिर भेजे: पूर्णांक=धारा.भेजो(भाग);
        यदि (भेजे<० || भेजे>भाग.आकार) { फेंको नया अपवाद("अमान्य WebSocket धारा लेखन।"); }
        यदि (भेजे==०) { लौटाओ; }
        यदि (लिखाकोड<८) { प्रेषणशुरू=सत्य; }
        लिखाक्रम=लिखाक्रम+भेजे;
        यदि (लिखाक्रम!=लिखावट.आकार) { लौटाओ; }
        लिखावट=रिक्त;
        यदि (लिखाकोड==८) { बंदभेजा=सत्य; }
        यदि (लिखाकोड==९) { पिंगसीमा=कार्यघड़ी.अब()+१००००; }
        यदि (लिखाकोड<८ && निर्गम!=रिक्त) {
            निर्गमक्रम=निर्गमक्रम+लिखामात्रा;
            यदि (लिखाअंतिम) { निर्गम=रिक्त; प्रेषणसफल=सत्य; }
        }
    }

    निजी फलन धाराछोड़ो() -> शून्य {
        यदि (मुक्त) { लौटाओ; }
        प्रयास { धारा.बंदकरो(); }
        अंततः { मुक्त=सत्य; धारा=रिक्त; पाठक=रिक्त; निर्गम=रिक्त; खंडित=रिक्त; लिखावट=रिक्त; पिंग=रिक्त; पोंग=रिक्त; }
    }
    सार्वजनिक असमकालिक फलन चलाओ(संदर्भ: वेबसॉकेटसंदर्भ, चालक: वेबसॉकेटचालक, रोक: निरस्तीकरणचिह्न) -> शून्य {
        यदि (चलरहा || बंद || चालक==रिक्त || रोक==रिक्त) { फेंको नया अपवाद("अमान्य WebSocket सत्र।"); }
        चलरहा=सत्य; संदर्भमान=संदर्भ; अगलापिंग=कार्यघड़ी.अब()+३००००;
        स्थिर जीवन: निरस्तीकरणस्रोत=नया निरस्तीकरणस्रोत();
        मान काम: कार्यफल<कार्यशून्य> = रिक्त;
        प्रयास {
            काम=चालक.संभालो(संदर्भ,यह,जीवन.चिह्नलो());
            यदि (काम==रिक्त) { फेंको नया अपवाद("WebSocket चालक कार्य रिक्त है।"); }
            जबतक (!बंद) {
                स्थिर अब: पूर्णांक=कार्यघड़ी.अब();
                यदि (समापन==रिक्त) {
                    यदि (रोक.निरस्तहै()) { यह.समापनशुरू(वेबसॉकेटकूट.बंदसामग्री(१००१,"")); }
                    अन्यथा यदि (संदर्भ!=रिक्त && !संदर्भ.जीवितहै()) { यह.असफल(नया वेबसॉकेटत्रुटि(१००८,"WebSocket सत्र समाप्त।")); }
                    अन्यथा यदि (काम.समाप्तहै()) {
                        प्रयास { काम.आंतरिकपरिणामजाँचो(); यह.समापनशुरू(वेबसॉकेटकूट.बंदसामग्री(१०००,"")); }
                        पकड़ो (गलती: अपवाद) { यह.असफल(नया वेबसॉकेटत्रुटि(१०११,"WebSocket चालक असफल।")); }
                    } अन्यथा यदि ((आगम!=रिक्त && अब>=आगमसीमा) || (खंडित!=रिक्त && अब>=खंडसीमा) || (पिंगसीमा!=० && अब>=पिंगसीमा)) {
                        यह.असफल(नया वेबसॉकेटत्रुटि(१००८,"WebSocket समयसीमा समाप्त।"));
                    } अन्यथा यदि (पिंगसीमा==० && पिंग==रिक्त && अब>=अगलापिंग) {
                        पिंगपहचान=वेब.अंक(अब); पिंग=पाठ्य.यूटीएफ८(पिंगपहचान); अगलापिंग=अब+३००००;
                    }
                }
                यदि (समापन!=रिक्त && अब>=समापनसीमा) {
                    यदि (!बंदपाया && दोष==रिक्त) { दोष=नया वेबसॉकेटत्रुटि(१००६,"WebSocket बंद करने की समयसीमा समाप्त।"); }
                    बंद=सत्य;
                }
                यदि (बंदभेजा && (अमान्यधारा || बंदपाया)) { बंद=सत्य; }
                यदि (!बंद && !अमान्यधारा && !बंदपाया && (आगम==रिक्त || समापन!=रिक्त)) {
                    प्रयास {
                        स्थिर फ़्रेम: वेबसॉकेटफ़्रेम=पाठक.पढ़ो(धारा);
                        यदि (फ़्रेम!=रिक्त) { अगलापिंग=अब+३००००; यह.पढ़ाफ़्रेम(फ़्रेम); }
                    } पकड़ो (गलती: वेबसॉकेटत्रुटि) { यह.असफल(गलती); }
                }
                यदि (निर्गम!=रिक्त && (अब>=निर्गमसीमा || प्रेषणचिह्न.निरस्तहै() || प्रेषणकार्यचिह्न.निरस्तहै())) {
                    यह.निर्गमरद्दकरो();
                }
                यदि (!बंद) { यह.लिखावटभेजो(); प्रतीक्षा कार्य.विलंब(५); }
            }
            यह.धाराछोड़ो();
            // Give pending operations a turn to observe the transport outcome.
            यदि (!काम.समाप्तहै()) { प्रतीक्षा कार्य.विलंब(२५); }
        } पकड़ो (गलती: निरस्तअपवाद) {
            यदि (!बंद && लिखावट==रिक्त) {
                प्रयास { यह.समापनशुरू(वेबसॉकेटकूट.बंदसामग्री(१००१,"")); यह.लिखावटभेजो(); }
                पकड़ो (अनदेखा: अपवाद) { }
            }
        } पकड़ो (गलती: अपवाद) {
            यदि (दोष==रिक्त) { दोष=नया वेबसॉकेटत्रुटि(१००६,"WebSocket संबंध असफल।"); }
        } अंततः {
            बंद=सत्य; जीवन.निरस्तकरो();
            यदि (काम!=रिक्त) {
                काम.आंतरिकदेखो();
                यदि (!काम.समाप्तहै()) { काम.आंतरिकचिह्न.निरस्तकरो(); }
            }
            यह.धाराछोड़ो(); संदर्भमान=रिक्त;
        }
    }
}

सार्वजनिक वर्ग वेबसॉकेटप्रेषणप्रवेश पालन बंदनीय {
    निजी मान संबंध: वेबसॉकेटसंबंध;
    सार्वजनिक निर्माता(संबंध: वेबसॉकेटसंबंध) { यह.संबंध=संबंध; }
    सार्वजनिक फलन बंदकरो() -> शून्य { संबंध.आंतरिकप्रेषणछोड़ो(); }
}

सार्वजनिक वर्ग वेबसॉकेटमार्गप्रविष्टि {
    सार्वजनिक मान खंड: सूची<पाठ>;
    सार्वजनिक मान प्रबंधक: सत्रप्रबंधक;
    सार्वजनिक मान भूमिका: पाठ;
    सार्वजनिक मान उपप्रोटोकॉल: पाठ;
    सार्वजनिक मान चालक: वेबसॉकेटचालक;
    सार्वजनिक निर्माता(खंड: सूची<पाठ>, प्रबंधक: सत्रप्रबंधक, भूमिका: पाठ, उपप्रोटोकॉल: पाठ, चालक: वेबसॉकेटचालक) {
        यह.खंड=खंड; यह.प्रबंधक=प्रबंधक; यह.भूमिका=भूमिका; यह.उपप्रोटोकॉल=उपप्रोटोकॉल; यह.चालक=चालक;
    }
}

सार्वजनिक वर्ग वेबसॉकेटमार्ग पालन असमवेबउन्नयन {
    निजी मान मार्ग: सूची<वेबसॉकेटमार्गप्रविष्टि>;
    निजी मान चालू: पूर्णांक=०;
    निजी मान क्षमता: पूर्णांक=८;

    सार्वजनिक निर्माता() { मार्ग=नया सूची<वेबसॉकेटमार्गप्रविष्टि>(); }
    सार्वजनिक निर्माता(सीमा: पूर्णांक) {
        यदि (सीमा<१ || सीमा>६३) { फेंको नया अपवाद("WebSocket संबंध सीमा १ से ६३ तक होनी चाहिए।"); }
        क्षमता=सीमा;
        मार्ग=नया सूची<वेबसॉकेटमार्गप्रविष्टि>();
    }
    निजी साझा फलन चिह्नमान्य(मानक: पाठ) -> तार्किक {
        यदि (मानक=="" || पाठ्य.लंबाई(मानक)>१२८) { लौटाओ असत्य; }
        मान इ: पूर्णांक=०;
        जबतक (इ<पाठ्य.लंबाई(मानक)) {
            यदि (!पाठ्य.है("!#$%&'*+-.^_|~ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789`",पाठ्य.अंश(मानक,इ,इ+१))) { लौटाओ असत्य; }
            इ=इ+१;
        }
        लौटाओ सत्य;
    }
    निजी साझा फलन है(सूचीमान: सूची<पाठ>, अपेक्षित: पाठ, छोटाकरें: तार्किक) -> तार्किक {
        मान मिला: तार्किक=असत्य;
        प्रत्येक (सूचीमान में पंक्ति: पाठ) {
            प्रत्येक (पाठ्य.बाँटो(पंक्ति,",") में खंड: पाठ) {
                मान मानक: पाठ=पाठ्य.छाँटो(खंड);
                यदि (!छोटाकरें && !वेबसॉकेटमार्ग.चिह्नमान्य(मानक)) { फेंको नया वेबत्रुटि(४००,"अमान्य WebSocket उपप्रोटोकॉल।"); }
                यदि (छोटाकरें) { मानक=पाठ्य.छोटाअक्षर(मानक); }
                यदि (मानक==अपेक्षित) { मिला=सत्य; }
            }
        }
        लौटाओ मिला;
    }
    सार्वजनिक फलन जोड़ो(पथ: पाठ, प्रबंधक: सत्रप्रबंधक, भूमिका: पाठ, चालक: वेबसॉकेटचालक) -> शून्य {
        यह.जोड़ो(पथ,प्रबंधक,भूमिका,"",चालक);
    }
    सार्वजनिक फलन जोड़ो(पथ: पाठ, प्रबंधक: सत्रप्रबंधक, भूमिका: पाठ, उपप्रोटोकॉल: पाठ, चालक: वेबसॉकेटचालक) -> शून्य {
        यदि (प्रबंधक==रिक्त || चालक==रिक्त || मार्ग.आकार>=१२८ || (उपप्रोटोकॉल!="" && !वेबसॉकेटमार्ग.चिह्नमान्य(उपप्रोटोकॉल))) {
            फेंको नया अपवाद("अमान्य WebSocket मार्ग।");
        }
        मार्ग.जोड़ो(नया वेबसॉकेटमार्गप्रविष्टि(वेब.आंतरिकमार्गखंड("GET",पथ),प्रबंधक,भूमिका,उपप्रोटोकॉल,चालक));
    }
    सार्वजनिक फलन आंतरिकछोड़ो() -> शून्य { चालू=चालू-१; }
    सार्वजनिक फलन चुनो(अनुरोध: वेबअनुरोध) -> असमवेबउन्नतचालक {
        स्थिर कुंजी: सूची<पाठ> = अनुरोध.शीर्षमान("sec-websocket-key");
        स्थिर संस्करण: सूची<पाठ> = अनुरोध.शीर्षमान("sec-websocket-version");
        स्थिर उन्नयन: तार्किक=वेबसॉकेटमार्ग.है(अनुरोध.शीर्षमान("upgrade"),"websocket",सत्य);
        यदि (!उन्नयन && कुंजी.आकार==० && संस्करण.आकार==०) { लौटाओ रिक्त; }
        यदि (अनुरोध.विधि!="GET" || अनुरोध.संस्करण!="HTTP/1.1" || अनुरोध.सामग्री.आकार!=० || !उन्नयन ||
            !वेबसॉकेटमार्ग.है(अनुरोध.शीर्षमान("connection"),"upgrade",सत्य) || कुंजी.आकार!=१ || संस्करण.आकार!=१) {
            फेंको नया वेबत्रुटि(४००,"अमान्य WebSocket उन्नयन।");
        }
        यदि (संस्करण[०]!="13") {
            स्थिर गलती: वेबत्रुटि=नया वेबत्रुटि(४२६,"WebSocket संस्करण १३ आवश्यक है।");
            गलती.शीर्षनाम="Sec-WebSocket-Version"; गलती.शीर्षमूल्य="13"; फेंको गलती;
        }
        स्थिर खंड: सूची<पाठ> = पाठ्य.बाँटो(अनुरोध.पथ,"/");
        प्रत्येक (मार्ग में प: वेबसॉकेटमार्गप्रविष्टि) {
            स्थिर चर: मानचित्र<पाठ,पाठ> = वेब.आंतरिकमार्गमान(खंड,प.खंड);
            यदि (चर!=रिक्त) {
                यदि (अनुरोध.शीर्षमान("origin").आकार!=१) { फेंको नया वेबत्रुटि(४०३,"WebSocket के लिए एक Origin चाहिए।"); }
                स्थिर प्रवेश: सत्र=प.प्रबंधक.अधिकृत(अनुरोध,प.भूमिका);
                स्थिर प्रस्ताव: सूची<पाठ> = अनुरोध.शीर्षमान("sec-websocket-protocol");
                स्थिर मेल: तार्किक=वेबसॉकेटमार्ग.है(प्रस्ताव,प.उपप्रोटोकॉल,असत्य);
                यदि (प.उपप्रोटोकॉल!="" && !मेल) { फेंको नया वेबत्रुटि(४००,"WebSocket उपप्रोटोकॉल मेल नहीं खाता।"); }
                यदि (चालू>=क्षमता) { फेंको नया वेबत्रुटि(५०३,"WebSocket संबंध सीमा।"); }
                मान उत्तर: पाठ="HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: "+वेबसॉकेटकूट.स्वीकृतिलो(कुंजी[०])+"\r\n";
                यदि (प.उपप्रोटोकॉल!="") { उत्तर=उत्तर+"Sec-WebSocket-Protocol: "+प.उपप्रोटोकॉल+"\r\n"; }
                स्थिर संदर्भ: वेबसॉकेटसंदर्भ=नया वेबसॉकेटसंदर्भ(प.प्रबंधक,प्रवेश,चर,प.उपप्रोटोकॉल);
                स्थिर फल: वेबसॉकेटउन्नयन=नया वेबसॉकेटउन्नयन(यह,प.चालक,संदर्भ,पाठ्य.यूटीएफ८(उत्तर+"\r\n"));
                चालू=चालू+१; लौटाओ फल;
            }
        }
        फेंको नया वेबत्रुटि(४०४,"WebSocket मार्ग उपलब्ध नहीं है।");
    }
}

सार्वजनिक वर्ग वेबसॉकेटउन्नयन पालन असमवेबउन्नतचालक {
    निजी मान मार्ग: वेबसॉकेटमार्ग;
    निजी मान चालक: वेबसॉकेटचालक;
    निजी मान संदर्भ: वेबसॉकेटसंदर्भ;
    निजी मान उत्तर: बाइटबफ़र;
    सार्वजनिक निर्माता(मार्ग: वेबसॉकेटमार्ग, चालक: वेबसॉकेटचालक, संदर्भ: वेबसॉकेटसंदर्भ, उत्तर: बाइटबफ़र) {
        यह.मार्ग=मार्ग; यह.चालक=चालक; यह.संदर्भ=संदर्भ; यह.उत्तर=उत्तर;
    }
    सार्वजनिक फलन उत्तरलो() -> बाइटबफ़र { लौटाओ उत्तर; }
    सार्वजनिक फलन चलाओ(धारा: द्विदिशधारा, रोक: निरस्तीकरणचिह्न) -> कार्यफल<कार्यशून्य> {
        स्थिर संबंध: वेबसॉकेटसंबंध=नया वेबसॉकेटसंबंध(धारा);
        लौटाओ संबंध.चलाओ(संदर्भ,चालक,रोक);
    }
    सार्वजनिक फलन बंदकरो() -> शून्य { यदि (मार्ग!=रिक्त) { मार्ग.आंतरिकछोड़ो(); मार्ग=रिक्त; } }
}
