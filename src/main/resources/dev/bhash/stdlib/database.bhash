संकुल मानक;

सार्वजनिक वर्ग पोस्टग्रेसविन्यास {
    सार्वजनिक मान मेज़बान: पाठ = "localhost";
    सार्वजनिक मान पोर्ट: पूर्णांक = ५४३२;
    सार्वजनिक मान डेटाबेस: पाठ = "postgres";
    सार्वजनिक मान उपयोगकर्ता: पाठ = "postgres";
    सार्वजनिक मान गुप्तशब्द: पाठ = "";
    सार्वजनिक मान सुरक्षा: पाठ = "verify-full";
    सार्वजनिक मान प्रमाणपत्र: पाठ = "";
    सार्वजनिक मान संबंधसमय: पूर्णांक = १०;
    सार्वजनिक मान कथनसमय: पूर्णांक = ३००००;
    सार्वजनिक फलन विन्यासपाठ() -> पाठ {
        यदि (पोर्ट < १ || पोर्ट > ६५५३५ || संबंधसमय < १ || संबंधसमय > ६० || कथनसमय < १ || कथनसमय > ६०००००) { फेंको नया अपवाद("अमान्य PostgreSQL समय या पोर्ट।"); }
        यदि (सुरक्षा != "verify-full" && सुरक्षा != "disable") { फेंको नया अपवाद("PostgreSQL सुरक्षा verify-full या स्पष्ट disable रखें।"); }
        स्थिर मानसूची: सूची<पाठ> = नया सूची<पाठ>{मेज़बान,एसक्यूएलनियम.अंक(पोर्ट),डेटाबेस,उपयोगकर्ता,गुप्तशब्द,सुरक्षा,प्रमाणपत्र,एसक्यूएलनियम.अंक(संबंधसमय),एसक्यूएलनियम.अंक(कथनसमय)};
        मान फल: पाठ = "";
        प्रत्येक (मानसूची में व: पाठ) {
            यदि (पाठ्य.है(व,"\n") || पाठ्य.है(व,"\r") || पाठ्य.है(व,"\u0000") || पाठ्य.यूटीएफ८(व).आकार > ४०९६) { फेंको नया अपवाद("अमान्य PostgreSQL विन्यास।"); }
            फल = फल + व + "\n";
        }
        यदि (मेज़बान == "" || डेटाबेस == "" || उपयोगकर्ता == "") { फेंको नया अपवाद("अमान्य PostgreSQL विन्यास।"); }
        लौटाओ फल;
    }
}

सार्वजनिक वर्ग डेटा {
    सार्वजनिक साझा फलन एसक्यूलाइट(पथ: पाठ) -> डेटासंबंध { लौटाओ नया डेटासंबंध(पथ,रिक्त); }
    सार्वजनिक साझा फलन पोस्टग्रेस(विन्यास: पोस्टग्रेसविन्यास) -> डेटासंबंध { लौटाओ नया डेटासंबंध("",विन्यास); }
}

सार्वजनिक वर्ग डेटासंबंध पालन बंदनीय {
    निजी मान स्थानीय: डेटाबेस;
    निजी मान पहचान: पूर्णांक = ०;
    निजी मान बंद: तार्किक = असत्य;
    सार्वजनिक निर्माता(पथ: पाठ, विन्यास: पोस्टग्रेसविन्यास) {
        यदि (विन्यास == रिक्त) { स्थानीय = एसक्यूलाइट.खोलो(पथ); }
        अन्यथा { पहचान = पोस्टतंत्र.खोलो(विन्यास.विन्यासपाठ()); }
    }
    सार्वजनिक फलन प्रदाता() -> पाठ { यदि (स्थानीय != रिक्त) { लौटाओ "sqlite"; } लौटाओ "postgresql"; }
    सार्वजनिक फलन जाँचो() -> शून्य { यदि (बंद) { फेंको नया अपवाद("डेटासंबंध बंद है।"); } }
    सार्वजनिक फलन तैयार(एसक्यूएल: पाठ) -> डेटाकथन {
        यह.जाँचो();
        यदि (स्थानीय != रिक्त) { लौटाओ नया डेटाकथन(यह,स्थानीय.तैयार(एसक्यूएल),०); }
        स्थिर बदला: पाठ = एसक्यूएलनियम.पोस्टग्रेस(एसक्यूएल);
        लौटाओ नया डेटाकथन(यह,रिक्त,पोस्टतंत्र.तैयार(पहचान,एसक्यूएल,बदला));
    }
    सार्वजनिक फलन लेनदेन() -> डेटालेनदेन {
        यह.जाँचो(); यदि (स्थानीय != रिक्त) { लौटाओ नया डेटालेनदेन(यह,स्थानीय.लेनदेन(),०,०); }
        लौटाओ नया डेटालेनदेन(यह,रिक्त,पहचान,पोस्टतंत्र.लेनदेन(पहचान,०,०));
    }
    सार्वजनिक फलन बंदकरो() -> शून्य {
        यदि (!बंद) { बंद = सत्य; यदि (स्थानीय != रिक्त) { स्थानीय.बंदकरो(); } अन्यथा { पोस्टतंत्र.बंदकरो(पहचान); } }
    }
}

सार्वजनिक वर्ग डेटाकथन पालन बंदनीय {
    निजी मान मालिक: डेटासंबंध;
    निजी मान स्थानीय: कथन;
    निजी मान पहचान: पूर्णांक;
    निजी मान बंद: तार्किक = असत्य;
    सार्वजनिक निर्माता(मालिक: डेटासंबंध, स्थानीय: कथन, पहचान: पूर्णांक) { यह.मालिक=मालिक; यह.स्थानीय=स्थानीय; यह.पहचान=पहचान; }
    निजी फलन जाँचो() -> शून्य { मालिक.जाँचो(); यदि (बंद) { फेंको नया अपवाद("डेटाकथन बंद है।"); } }
    सार्वजनिक फलन बंधनसंख्या() -> पूर्णांक { यह.जाँचो(); यदि (स्थानीय != रिक्त) { लौटाओ स्थानीय.बंधनसंख्या(); } अन्यथा { लौटाओ पोस्टतंत्र.बंधनसंख्या(पहचान); } }
    सार्वजनिक फलन पूर्णांकरखो(क्रम: पूर्णांक, मानक: पूर्णांक) -> शून्य { यह.जाँचो(); यदि (स्थानीय != रिक्त) { स्थानीय.पूर्णांकरखो(क्रम,मानक); } अन्यथा { पोस्टतंत्र.पूर्णांकरखो(पहचान,क्रम,मानक); } }
    सार्वजनिक फलन दशमलवरखो(क्रम: पूर्णांक, मानक: दशमलव) -> शून्य { यह.जाँचो(); यदि (स्थानीय != रिक्त) { स्थानीय.दशमलवरखो(क्रम,मानक); } अन्यथा { पोस्टतंत्र.दशमलवरखो(पहचान,क्रम,मानक); } }
    सार्वजनिक फलन तार्किकरखो(क्रम: पूर्णांक, मानक: तार्किक) -> शून्य { यह.जाँचो(); यदि (स्थानीय != रिक्त) { स्थानीय.तार्किकरखो(क्रम,मानक); } अन्यथा { पोस्टतंत्र.तार्किकरखो(पहचान,क्रम,मानक); } }
    सार्वजनिक फलन पाठरखो(क्रम: पूर्णांक, मानक: पाठ) -> शून्य { यह.जाँचो(); यदि (स्थानीय != रिक्त) { स्थानीय.पाठरखो(क्रम,मानक); } अन्यथा { पोस्टतंत्र.पाठरखो(पहचान,क्रम,मानक); } }
    सार्वजनिक फलन बाइटरखो(क्रम: पूर्णांक, मानक: बाइटबफ़र) -> शून्य { यह.जाँचो(); यदि (स्थानीय != रिक्त) { स्थानीय.बाइटरखो(क्रम,मानक); } अन्यथा { पोस्टतंत्र.बाइटरखो(पहचान,क्रम,मानक); } }
    सार्वजनिक फलन रिक्तरखो(क्रम: पूर्णांक) -> शून्य { यह.जाँचो(); यदि (स्थानीय != रिक्त) { स्थानीय.रिक्तरखो(क्रम); } अन्यथा { पोस्टतंत्र.रिक्तरखो(पहचान,क्रम); } }
    सार्वजनिक फलन चलाओ() -> पूर्णांक { यह.जाँचो(); यदि (स्थानीय != रिक्त) { लौटाओ स्थानीय.चलाओ(); } अन्यथा { लौटाओ पोस्टतंत्र.चलाओ(पहचान); } }
    सार्वजनिक फलन अगला() -> तार्किक { यह.जाँचो(); यदि (स्थानीय != रिक्त) { लौटाओ स्थानीय.अगला(); } अन्यथा { लौटाओ पोस्टतंत्र.अगला(पहचान); } }
    सार्वजनिक फलन रीसेट() -> शून्य { यह.जाँचो(); यदि (स्थानीय != रिक्त) { स्थानीय.रीसेट(); } अन्यथा { पोस्टतंत्र.रीसेट(पहचान); } }
    सार्वजनिक फलन बंधनमिटाओ() -> शून्य { यह.जाँचो(); यदि (स्थानीय != रिक्त) { स्थानीय.बंधनमिटाओ(); } अन्यथा { पोस्टतंत्र.बंधनमिटाओ(पहचान); } }
    सार्वजनिक फलन स्तंभसंख्या() -> पूर्णांक { यह.जाँचो(); यदि (स्थानीय != रिक्त) { लौटाओ स्थानीय.स्तंभसंख्या(); } अन्यथा { लौटाओ पोस्टतंत्र.स्तंभसंख्या(पहचान); } }
    सार्वजनिक फलन स्तंभनाम(क्रम: पूर्णांक) -> पाठ { यह.जाँचो(); यदि (स्थानीय != रिक्त) { लौटाओ स्थानीय.स्तंभनाम(क्रम); } अन्यथा { लौटाओ पोस्टतंत्र.स्तंभनाम(पहचान,क्रम); } }
    सार्वजनिक फलन प्रकार(क्रम: पूर्णांक) -> पाठ { यह.जाँचो(); यदि (स्थानीय != रिक्त) { लौटाओ स्थानीय.प्रकार(क्रम); } अन्यथा { लौटाओ पोस्टतंत्र.प्रकार(पहचान,क्रम); } }
    सार्वजनिक फलन रिक्तहै(क्रम: पूर्णांक) -> तार्किक { यह.जाँचो(); यदि (स्थानीय != रिक्त) { लौटाओ स्थानीय.रिक्तहै(क्रम); } अन्यथा { लौटाओ पोस्टतंत्र.रिक्तहै(पहचान,क्रम); } }
    सार्वजनिक फलन पूर्णांकलो(क्रम: पूर्णांक) -> पूर्णांक { यह.जाँचो(); यदि (स्थानीय != रिक्त) { लौटाओ स्थानीय.पूर्णांकलो(क्रम); } अन्यथा { लौटाओ पोस्टतंत्र.पूर्णांकलो(पहचान,क्रम); } }
    सार्वजनिक फलन दशमलवलो(क्रम: पूर्णांक) -> दशमलव { यह.जाँचो(); यदि (स्थानीय != रिक्त) { लौटाओ स्थानीय.दशमलवलो(क्रम); } अन्यथा { लौटाओ पोस्टतंत्र.दशमलवलो(पहचान,क्रम); } }
    सार्वजनिक फलन तार्किकलो(क्रम: पूर्णांक) -> तार्किक { यह.जाँचो(); यदि (स्थानीय != रिक्त) { लौटाओ स्थानीय.तार्किकलो(क्रम); } अन्यथा { लौटाओ पोस्टतंत्र.तार्किकलो(पहचान,क्रम); } }
    सार्वजनिक फलन पाठलो(क्रम: पूर्णांक) -> पाठ { यह.जाँचो(); यदि (स्थानीय != रिक्त) { लौटाओ स्थानीय.पाठलो(क्रम); } अन्यथा { लौटाओ पोस्टतंत्र.पाठलो(पहचान,क्रम); } }
    सार्वजनिक फलन बाइटलो(क्रम: पूर्णांक) -> बाइटबफ़र { यह.जाँचो(); यदि (स्थानीय != रिक्त) { लौटाओ स्थानीय.बाइटलो(क्रम); } अन्यथा { लौटाओ पोस्टतंत्र.बाइटलो(पहचान,क्रम); } }
    सार्वजनिक फलन बंदकरो() -> शून्य { यदि (!बंद) { बंद = सत्य; यदि (स्थानीय != रिक्त) { स्थानीय.बंदकरो(); } अन्यथा { पोस्टतंत्र.कथनबंद(पहचान); } } }
}
सार्वजनिक वर्ग डेटालेनदेन पालन बंदनीय {
    निजी मान मालिक: डेटासंबंध; निजी मान स्थानीय: लेनदेन; निजी मान पहचान: पूर्णांक; निजी मान चिह्न: पूर्णांक; निजी मान समाप्त: तार्किक = असत्य;
    सार्वजनिक निर्माता(मालिक: डेटासंबंध, स्थानीय: लेनदेन, पहचान: पूर्णांक, चिह्न: पूर्णांक) { यह.मालिक=मालिक; यह.स्थानीय=स्थानीय; यह.पहचान=पहचान; यह.चिह्न=चिह्न; }
    सार्वजनिक फलन सहेजो() -> शून्य { मालिक.जाँचो(); यदि (समाप्त) { फेंको नया अपवाद("डेटालेनदेन सक्रिय नहीं है।"); } यदि (स्थानीय != रिक्त) { स्थानीय.सहेजो(); } अन्यथा { पोस्टतंत्र.लेनदेन(पहचान,चिह्न,१); } समाप्त=सत्य; }
    सार्वजनिक फलन वापसलो() -> शून्य { मालिक.जाँचो(); यदि (समाप्त) { फेंको नया अपवाद("डेटालेनदेन सक्रिय नहीं है।"); } यदि (स्थानीय != रिक्त) { स्थानीय.वापसलो(); } अन्यथा { पोस्टतंत्र.लेनदेन(पहचान,चिह्न,२); } समाप्त=सत्य; }
    सार्वजनिक फलन बंदकरो() -> शून्य { यदि (!समाप्त) { समाप्त=सत्य; यदि (स्थानीय != रिक्त) { स्थानीय.बंदकरो(); } अन्यथा { पोस्टतंत्र.लेनदेन(पहचान,चिह्न,३); } } }
}

// PostgreSQL's native placeholder syntax differs from JDBC/SQLite. Values never enter SQL.
सार्वजनिक वर्ग एसक्यूएलनियम {
    सार्वजनिक साझा फलन अंक(मानक: पूर्णांक) -> पाठ {
        स्थिर देवनागरी: पाठ = "०१२३४५६७८९"; स्थिर अंग्रेज़ी: पाठ = "0123456789";
        मान फल: पाठ = परिवर्तित<पाठ>(मानक); मान क: पूर्णांक=०;
        जबतक (क < १०) { फल=पाठ्य.बदलो(फल,पाठ्य.अंश(देवनागरी,क,क+१),पाठ्य.अंश(अंग्रेज़ी,क,क+१)); क=क+१; } लौटाओ फल;
    }
    सार्वजनिक साझा फलन पोस्टग्रेस(मूल: पाठ) -> पाठ {
        डेटानियम.पाठजाँचो(मूल,६५५३६);
        मान फल: पाठ = ""; मान उद्धरण: पाठ = ""; मान टिप्पणी: पूर्णांक = ०; मान क्रम: पूर्णांक = ०; मान बंद: तार्किक = असत्य;
        मान क: पूर्णांक = ०; स्थिर न: पूर्णांक = पाठ्य.लंबाई(मूल); मान पहला: पाठ = "";
        जबतक (क < न) {
            स्थिर अ: पाठ = पाठ्य.अंश(मूल,क,क+१); मान अग: पाठ = ""; यदि (क+१ < न) { अग=पाठ्य.अंश(मूल,क+१,क+२); }
            यदि (टिप्पणी == १) { यदि (अ == "\n" || अ == "\r") { टिप्पणी=०; } }
            अन्यथा यदि (टिप्पणी == २) {
                यदि (अ == "/" && अग == "*") { टिप्पणी=टिप्पणी+१; फल=फल+अ+अग; क=क+२; जारी; }
                यदि (अ == "*" && अग == "/") { टिप्पणी=०; फल=फल+अ+अग; क=क+२; जारी; }
            }
            अन्यथा यदि (टिप्पणी > २) {
                यदि (अ == "/" && अग == "*") { टिप्पणी=टिप्पणी+१; फल=फल+अ+अग; क=क+२; जारी; }
                यदि (अ == "*" && अग == "/") { टिप्पणी=टिप्पणी-१; फल=फल+अ+अग; क=क+२; जारी; }
            }
            अन्यथा यदि (उद्धरण != "") {
                यदि (अ == उद्धरण) { यदि (अग == उद्धरण) { फल=फल+अ+अग; क=क+२; जारी; } उद्धरण=""; }
            }
            अन्यथा यदि (अ == "-" && अग == "-") { टिप्पणी=१; }
            अन्यथा यदि (अ == "/" && अग == "*") { टिप्पणी=२; फल=फल+अ+अग; क=क+२; जारी; }
            अन्यथा यदि (!पाठ्य.है(" \t\r\n",अ)) {
                यदि (बंद) { फेंको नया अपवाद("एक PostgreSQL कथन ही दें।"); }
                यदि (पहला == "") {
                    मान अंत: पूर्णांक = क; जबतक (अंत < न && पाठ्य.है("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ",पाठ्य.अंश(मूल,अंत,अंत+१))) { अंत=अंत+१; }
                    पहला=पाठ्य.बड़ाअक्षर(पाठ्य.अंश(मूल,क,अंत));
                    यदि (पहला == "" || पाठ्य.है("|BEGIN|START|COMMIT|END|ROLLBACK|SAVEPOINT|RELEASE|PREPARE|EXECUTE|DEALLOCATE|COPY|DISCARD|SET|RESET|","|"+पहला+"|")) { फेंको नया अपवाद("असमर्थित PostgreSQL कथन।"); }
                }
                यदि (अ == "'") { यदि (क > ० && पाठ्य.है("eE",पाठ्य.अंश(मूल,क-१,क))) { फेंको नया अपवाद("PostgreSQL escape strings समर्थित नहीं हैं।"); } उद्धरण="'"; } अन्यथा यदि (अ == "\"") { उद्धरण="\""; }
                अन्यथा यदि (अ == "$" || अ == "\\") { फेंको नया अपवाद("PostgreSQL में साधारण उद्धरण और ? मापदंड उपयोग करें।"); }
                अन्यथा यदि (अ == ";") { बंद=सत्य; }
                अन्यथा यदि (अ == "?") { यदि (अग != "" && पाठ्य.है("0123456789?",अग)) { फेंको नया अपवाद("केवल अनाम ? मापदंड समर्थित हैं।"); } क्रम=क्रम+१; यदि (क्रम > ९९९) { फेंको नया अपवाद("मापदंड सीमा ९९९ है।"); } फल=फल+"$"+एसक्यूएलनियम.अंक(क्रम); क=क+१; जारी; }
            }
            फल=फल+अ; क=क+१;
        }
        यदि (पहला == "" || उद्धरण != "" || टिप्पणी >= २) { फेंको नया अपवाद("अमान्य PostgreSQL कथन।"); }
        लौटाओ फल;
    }
}
