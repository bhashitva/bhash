संकुल मानक;

सार्वजनिक वर्ग लेनदेनपरिणामअज्ञातअपवाद विस्तार अपवाद {
    सार्वजनिक निर्माता():आधार("लेनदेन का परिणाम अज्ञात है; स्वचालित पुनःप्रयास न करें।"){}
}

// A provider registration owns copied arguments, completion and unclaimed results.
सार्वजनिक वर्ग असमडेटाक्रिया {
    सार्वजनिक मान पहचान:पूर्णांक=०;
    सार्वजनिक मान प्रतिबद्ध:तार्किक=असत्य;
    सार्वजनिक मान पहलेनिरस्त:तार्किक=असत्य;
    सार्वजनिक फलन ठहरो(चिह्न:निरस्तीकरणचिह्न)->कार्यफल<पूर्णांक> {
        स्थिर क:असमडेटाप्रतीक्षा=नया असमडेटाप्रतीक्षा(पहचान,चिह्न,प्रतिबद्ध,पहलेनिरस्त);
        कार्यतंत्र.आरम्भ(क);लौटाओ क;
    }
    सार्वजनिक असमकालिक फलन बंदकरो()->शून्य {
        यदि(पहचान!=०){
            असमडाटातंत्र.निरस्त(पहचान);
            जबतक(!असमडाटातंत्र.पूराहै(पहचान)){प्रतीक्षा कार्य.विलंब(१);}
            असमडाटातंत्र.बंदकरो(पहचान);पहचान=०;
        }
    }
}

सार्वजनिक वर्ग असमडेटा {
    सार्वजनिक साझा फलन एसक्यूलाइट(पथ:पाठ)->कार्यफल<असमडेटासंबंध> {लौटाओ असमडेटा.एसक्यूलाइट(पथ,कार्य.वर्तमानचिह्न());}
    सार्वजनिक साझा फलन एसक्यूलाइट(पथ:पाठ,चिह्न:निरस्तीकरणचिह्न)->कार्यफल<असमडेटासंबंध> {लौटाओ असमडेटा.खोलो(०,पथ,चिह्न);}
    सार्वजनिक साझा फलन पोस्टग्रेस(विन्यास:पोस्टग्रेसविन्यास)->कार्यफल<असमडेटासंबंध> {लौटाओ असमडेटा.पोस्टग्रेस(विन्यास,कार्य.वर्तमानचिह्न());}
    सार्वजनिक साझा फलन पोस्टग्रेस(विन्यास:पोस्टग्रेसविन्यास,चिह्न:निरस्तीकरणचिह्न)->कार्यफल<असमडेटासंबंध> {
        प्रयास{लौटाओ असमडेटा.खोलो(१,विन्यास.विन्यासपाठ(),चिह्न);}
        पकड़ो(द:अपवाद){लौटाओ कार्यफल<असमडेटासंबंध>.असफल(द);}
    }
    निजी साझा असमकालिक फलन खोलो(प्रकार:पूर्णांक,पाठ्यांश:पाठ,चिह्न:निरस्तीकरणचिह्न)->असमडेटासंबंध {
        यदि(प्रकार==०){डेटानियम.पथजाँचो(पाठ्यांश);}
        चिह्न.जाँचो();कार्य.वर्तमानचिह्न().जाँचो();
        असमकालिक संसाधन(क:असमडेटाक्रिया=नया असमडेटाक्रिया()){
            क.पहचान=असमडाटातंत्र.आरम्भ(प्रकार,०,पाठ्यांश,नया सूची<सर्ववस्तु>());
            स्थिर पहचान:पूर्णांक=प्रतीक्षा क.ठहरो(चिह्न);
            लौटाओ नया असमडेटासंबंध(पहचान,प्रकार==१);
        }
    }
}

// Releasing a queued operation must also release its connection's busy flag.
सार्वजनिक वर्ग असमडेटाप्रवेश पालन बंदनीय {
    निजी मान संबंध:असमडेटासंबंध;
    सार्वजनिक निर्माता(स:असमडेटासंबंध){संबंध=स;}
    सार्वजनिक फलन बंदकरो()->शून्य {यदि(संबंध!=रिक्त){संबंध.आंतरिकव्यस्त=असत्य;संबंध=रिक्त;}}
}

सार्वजनिक वर्ग असमडेटासंबंध {
    सार्वजनिक मान आंतरिकपहचान:पूर्णांक;
    सार्वजनिक मान आंतरिकपोस्टग्रेस:तार्किक;
    सार्वजनिक मान आंतरिकव्यस्त:तार्किक=असत्य;
    सार्वजनिक मान आंतरिकपट्टा:कार्यआधार;
    सार्वजनिक मान आंतरिकवापस:तार्किक=असत्य;
    निजी मान बंदकार्य:कार्यफल<शून्य>;
    सार्वजनिक निर्माता(पहचान:पूर्णांक,पोस्ट:तार्किक){आंतरिकपहचान=पहचान;आंतरिकपोस्टग्रेस=पोस्ट;}
    सार्वजनिक फलन जाँचो()->शून्य {
        यदि(आंतरिकपहचान==० || बंदकार्य!=रिक्त){फेंको नया अपवाद("असमकालिक डेटासंबंध बंद है।");}
        यदि(आंतरिकव्यस्त){फेंको नया अपवाद("असमकालिक डेटासंबंध व्यस्त है।");}
        यदि(आंतरिकपट्टा!=रिक्त){
            मान क:कार्यआधार=कार्यतंत्र.मालिकलो();
            जबतक(क!=रिक्त && क!=आंतरिकपट्टा){क=क.आंतरिकमालिक;}
            यदि(क==रिक्त){फेंको नया अपवाद("डेटालेनदेन दूसरे कार्य के स्वामित्व में है।");}
        }
    }
    सार्वजनिक फलन आंतरिकलो()->असमडेटाप्रवेश {यह.जाँचो();आंतरिकव्यस्त=सत्य;लौटाओ नया असमडेटाप्रवेश(यह);}
    सार्वजनिक फलन तैयार(एसक्यूएल:पाठ)->कार्यफल<असमडेटाकथन> {लौटाओ यह.तैयार(एसक्यूएल,कार्य.वर्तमानचिह्न());}
    सार्वजनिक फलन तैयार(एसक्यूएल:पाठ,चिह्न:निरस्तीकरणचिह्न)->कार्यफल<असमडेटाकथन> {
        मान प्रवेश:असमडेटाप्रवेश=रिक्त;
        प्रयास{
            प्रवेश=यह.आंतरिकलो();
            यदि(आंतरिकवापस){फेंको नया अपवाद("डेटालेनदेन असफल है; वापस लें।");}
            यदि(आंतरिकपोस्टग्रेस){स्थिर जाँचा:पाठ=एसक्यूएलनियम.पोस्टग्रेस(एसक्यूएल);}अन्यथा{डेटानियम.कथनजाँचो(एसक्यूएल);}
            स्थिर क:कार्यफल<असमडेटाकथन> = यह.तैयारचलाओ(एसक्यूएल,चिह्न);
            यदि(क.समाप्तहै()){प्रवेश.बंदकरो();}अन्यथा{क.आंतरिकप्रवेश=प्रवेश;}लौटाओ क;
        }पकड़ो(द:अपवाद){यदि(प्रवेश!=रिक्त){प्रवेश.बंदकरो();}लौटाओ कार्यफल<असमडेटाकथन>.असफल(द);}
    }
    निजी असमकालिक फलन तैयारचलाओ(एसक्यूएल:पाठ,चिह्न:निरस्तीकरणचिह्न)->असमडेटाकथन {
        चिह्न.जाँचो();कार्य.वर्तमानचिह्न().जाँचो();
        प्रयास{
            असमकालिक संसाधन(क:असमडेटाक्रिया=नया असमडेटाक्रिया()){
                स्थिर रूप:सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>();
                यदि(आंतरिकपोस्टग्रेस){रूप.जोड़ो(एसक्यूएलनियम.पोस्टग्रेस(एसक्यूएल));}
                क.पहचान=असमडाटातंत्र.आरम्भ(२,आंतरिकपहचान,एसक्यूएल,रूप);
                स्थिर पहचान:पूर्णांक=प्रतीक्षा क.ठहरो(चिह्न);
                लौटाओ नया असमडेटाकथन(यह,पहचान,असमडाटातंत्र.बंधन(पहचान));
            }
        }पकड़ो(द:अपवाद){यदि(आंतरिकपट्टा!=रिक्त){आंतरिकवापस=सत्य;}फेंको द;}
    }
    सार्वजनिक फलन लेनदेन()->कार्यफल<असमडेटालेनदेन> {लौटाओ यह.लेनदेन(कार्य.वर्तमानचिह्न());}
    सार्वजनिक फलन लेनदेन(चिह्न:निरस्तीकरणचिह्न)->कार्यफल<असमडेटालेनदेन> {
        मान प्रवेश:असमडेटाप्रवेश=रिक्त;
        प्रयास{
            प्रवेश=यह.आंतरिकलो();यदि(आंतरिकपट्टा!=रिक्त){फेंको नया अपवाद("डेटालेनदेन पहले सक्रिय है।");}
            स्थिर क:कार्यफल<असमडेटालेनदेन> = यह.लेनदेनचलाओ(चिह्न,कार्यतंत्र.मालिकलो());
            यदि(क.समाप्तहै()){प्रवेश.बंदकरो();}अन्यथा{क.आंतरिकप्रवेश=प्रवेश;}लौटाओ क;
        }पकड़ो(द:अपवाद){यदि(प्रवेश!=रिक्त){प्रवेश.बंदकरो();}लौटाओ कार्यफल<असमडेटालेनदेन>.असफल(द);}
    }
    निजी असमकालिक फलन लेनदेनचलाओ(चिह्न:निरस्तीकरणचिह्न,मालिक:कार्यआधार)->असमडेटालेनदेन {
        आंतरिकपट्टा=मालिक;आंतरिकवापस=असत्य;
        प्रयास{प्रतीक्षा यह.आदेशचलाओ(६,आंतरिकपहचान,चिह्न);लौटाओ नया असमडेटालेनदेन(यह);}
        पकड़ो(द:अपवाद){आंतरिकपट्टा=रिक्त;फेंको द;}
    }
    सार्वजनिक फलन आंतरिकआदेश(क्रिया:पूर्णांक,चिह्न:निरस्तीकरणचिह्न)->कार्यफल<शून्य> {
        मान प्रवेश:असमडेटाप्रवेश=रिक्त;
        प्रयास{
            प्रवेश=यह.आंतरिकलो();
            यदि(क्रिया==७ && आंतरिकवापस){फेंको नया अपवाद("डेटालेनदेन असफल है; वापस लें।");}
            स्थिर क:कार्यफल<शून्य> = यह.आदेशचलाओ(क्रिया,आंतरिकपहचान,चिह्न);
            यदि(क.समाप्तहै()){प्रवेश.बंदकरो();}अन्यथा{क.आंतरिकप्रवेश=प्रवेश;}लौटाओ क;
        }पकड़ो(द:अपवाद){यदि(प्रवेश!=रिक्त){प्रवेश.बंदकरो();}लौटाओ कार्यफल<शून्य>.असफल(द);}
    }
    निजी असमकालिक फलन आदेशचलाओ(क्रिया:पूर्णांक,प:पूर्णांक,चिह्न:निरस्तीकरणचिह्न)->शून्य {
        यदि(क्रिया!=८ && क्रिया!=९){चिह्न.जाँचो();कार्य.वर्तमानचिह्न().जाँचो();}
        प्रयास{
            असमकालिक संसाधन(क:असमडेटाक्रिया=नया असमडेटाक्रिया()){
                क.पहचान=असमडाटातंत्र.आरम्भ(क्रिया,प,"",नया सूची<सर्ववस्तु>());
                क.प्रतिबद्ध=क्रिया==७ || क्रिया==८ || क्रिया==९;क.पहलेनिरस्त=क्रिया==७;
                स्थिर फल:पूर्णांक=प्रतीक्षा क.ठहरो(चिह्न);
            }
            यदि(क्रिया==७ || क्रिया==८){आंतरिकपट्टा=रिक्त;आंतरिकवापस=असत्य;}
        }पकड़ो(द:अपवाद){
            आंतरिकवापस=सत्य;
            यदि(द.संदेश=="लेनदेन का परिणाम अज्ञात है; स्वचालित पुनःप्रयास न करें।"){
                आंतरिकपहचान=०;आंतरिकपट्टा=रिक्त;फेंको नया लेनदेनपरिणामअज्ञातअपवाद();
            }फेंको द;
        }अंततः{यदि(क्रिया==९){आंतरिकपहचान=०;आंतरिकपट्टा=रिक्त;}}
    }
    सार्वजनिक फलन बंदकरो()->कार्यफल<शून्य> {
        यदि(बंदकार्य!=रिक्त){लौटाओ बंदकार्य;}
        यदि(आंतरिकपहचान==०){बंदकार्य=कार्य.पूरा();लौटाओ बंदकार्य;}
        स्थिर क:कार्यफल<शून्य> = यह.आंतरिकआदेश(९,नया निरस्तीकरणचिह्न());
        यदि(क.आंतरिकस्थिति>=२){लौटाओ क;}बंदकार्य=क;लौटाओ बंदकार्य;
    }

}

// Polling never runs Bhash code on a provider worker. Commit acknowledgement is
// deliberately non-cancellable once dispatched; cancellation cannot mean rollback.
सार्वजनिक वर्ग असमडेटाप्रतीक्षा विस्तार कार्यफल<पूर्णांक> {
    निजी मान पहचान:पूर्णांक;निजी मान चिह्न:निरस्तीकरणचिह्न;
    निजी मान प्रतिबद्ध:तार्किक;निजी मान पहलेनिरस्त:तार्किक;निजी मान रखा:तार्किक=असत्य;निजी मान दोष:अपवाद;
    सार्वजनिक निर्माता(प:पूर्णांक,च:निरस्तीकरणचिह्न,स:तार्किक,पहले:तार्किक){पहचान=प;चिह्न=च;प्रतिबद्ध=स;पहलेनिरस्त=पहले;}
    सार्वजनिक अधिलेखन फलन आगे()->शून्य {
        यदि((!प्रतिबद्ध || (पहलेनिरस्त && !असमडाटातंत्र.प्रेषितहै(पहचान))) && दोष==रिक्त){
            प्रयास{चिह्न.जाँचो();आंतरिकचिह्न.चिह्नलो().जाँचो();}
            पकड़ो(द:अपवाद){दोष=द;असमडाटातंत्र.निरस्त(पहचान);}
        }
        यदि(असमडाटातंत्र.पूराहै(पहचान)){
            यदि(दोष!=रिक्त){फेंको दोष;}
            आंतरिकमूल्य=असमडाटातंत्र.फल(पहचान);यह.आंतरिकसफल();लौटाओ;
        }
        यदि(!रखा){रखा=सत्य;कार्यतंत्र.समयरखो(यह);}
    }
    सार्वजनिक अधिलेखन फलन आंतरिकमुक्तकरो()->शून्य {चिह्न=रिक्त;दोष=रिक्त;}
}

सार्वजनिक वर्ग असमडेटाकथन {
    निजी मान संबंध:असमडेटासंबंध;
    निजी मान पहचान:पूर्णांक;
    निजी मान मानसूची:सूची<सर्ववस्तु>;
    निजी मान बँधे:सूची<तार्किक>;
    निजी मान पंक्तियाँ:सूची<सूची<सर्ववस्तु>>;
    निजी मान प्रकारसूची:सूची<सूची<पाठ>>;
    निजी मान नाम:सूची<पाठ>;
    निजी मान पंक्ति:पूर्णांक=-१;
    निजी मान चलाया:तार्किक=असत्य;
    निजी मान बंदकार्य:कार्यफल<शून्य>;
    सार्वजनिक निर्माता(स:असमडेटासंबंध,प:पूर्णांक,संख्या:पूर्णांक){
        संबंध=स;पहचान=प;मानसूची=नया सूची<सर्ववस्तु>();बँधे=नया सूची<तार्किक>();
        मान क:पूर्णांक=०;जबतक(क<संख्या){मानसूची.जोड़ो(रिक्त);बँधे.जोड़ो(असत्य);क=क+१;}
        पंक्तियाँ=नया सूची<सूची<सर्ववस्तु>>();प्रकारसूची=नया सूची<सूची<पाठ>>();नाम=नया सूची<पाठ>();
    }
    निजी फलन जाँचो()->शून्य {संबंध.जाँचो();यदि(पहचान==० || बंदकार्य!=रिक्त){फेंको नया अपवाद("असमकालिक डेटाकथन बंद है।");}}
    सार्वजनिक फलन बंधनसंख्या()->पूर्णांक {यह.जाँचो();लौटाओ मानसूची.आकार;}
    निजी फलन रखो(क्रम:पूर्णांक,व:सर्ववस्तु)->शून्य {
        यह.जाँचो();यदि(चलाया){फेंको नया अपवाद("डेटाकथन को रीसेट करें।");}
        यदि(क्रम<१ || क्रम>मानसूची.आकार){फेंको नया अपवाद("डेटाकथन बंधन सूचकांक सीमा से बाहर है।");}
        मानसूची[क्रम-१]=व;बँधे[क्रम-१]=सत्य;
    }
    सार्वजनिक फलन पूर्णांकरखो(क्रम:पूर्णांक,व:पूर्णांक)->शून्य {यह.रखो(क्रम,व);}
    सार्वजनिक फलन दशमलवरखो(क्रम:पूर्णांक,व:दशमलव)->शून्य {यदि(व!=व || व-व!=०.०){फेंको नया अपवाद("डेटाकथन में सीमित दशमलव मान दें।");}यह.रखो(क्रम,व);}
    सार्वजनिक फलन तार्किकरखो(क्रम:पूर्णांक,व:तार्किक)->शून्य {यह.रखो(क्रम,व);}
    सार्वजनिक फलन पाठरखो(क्रम:पूर्णांक,व:पाठ)->शून्य {यदि(पाठ्य.यूटीएफ८(व).आकार>८३८८६०८){फेंको नया अपवाद("अमान्य डेटाकथन पाठ।");}यह.रखो(क्रम,व);}
    सार्वजनिक फलन बाइटरखो(क्रम:पूर्णांक,व:बाइटबफ़र)->शून्य {यदि(व==रिक्त || व.आकार>८३८८६०८){फेंको नया अपवाद("अमान्य डेटाकथन बाइटबफ़र।");}यह.रखो(क्रम,व.काटो(०,व.आकार));}
    सार्वजनिक फलन रिक्तरखो(क्रम:पूर्णांक)->शून्य {यह.रखो(क्रम,रिक्त);}
    सार्वजनिक फलन चलाओ()->कार्यफल<पूर्णांक> {लौटाओ यह.चलाओ(कार्य.वर्तमानचिह्न());}
    सार्वजनिक फलन चलाओ(चिह्न:निरस्तीकरणचिह्न)->कार्यफल<पूर्णांक> {लौटाओ यह.आरम्भ(३,चिह्न);}
    निजी फलन आरम्भ(क्रिया:पूर्णांक,चिह्न:निरस्तीकरणचिह्न)->कार्यफल<पूर्णांक> {
        मान प्रवेश:असमडेटाप्रवेश=रिक्त;
        प्रयास{
            यह.जाँचो();यदि(चलाया){फेंको नया अपवाद("डेटाकथन को रीसेट करें।");}
            यदि(संबंध.आंतरिकवापस){फेंको नया अपवाद("डेटालेनदेन असफल है; वापस लें।");}
            प्रत्येक(बँधे में ब:तार्किक){यदि(!ब){फेंको नया अपवाद("डेटाकथन के सभी मापदंड बाँधें।");}}
            स्थिर प्रति:सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>();प्रत्येक(मानसूची में व:सर्ववस्तु){प्रति.जोड़ो(व);}
            प्रवेश=संबंध.आंतरिकलो();चलाया=सत्य;
            स्थिर क:कार्यफल<पूर्णांक> = यह.चलाओभीतर(क्रिया,प्रति,चिह्न);
            यदि(क.समाप्तहै()){प्रवेश.बंदकरो();}अन्यथा{क.आंतरिकप्रवेश=प्रवेश;}लौटाओ क;
        }पकड़ो(द:अपवाद){यदि(प्रवेश!=रिक्त){प्रवेश.बंदकरो();}लौटाओ कार्यफल<पूर्णांक>.असफल(द);}
    }
    निजी असमकालिक फलन चलाओभीतर(क्रिया:पूर्णांक,प्रति:सूची<सर्ववस्तु>,चिह्न:निरस्तीकरणचिह्न)->पूर्णांक {
        चिह्न.जाँचो();कार्य.वर्तमानचिह्न().जाँचो();
        प्रयास{
            असमकालिक संसाधन(क:असमडेटाक्रिया=नया असमडेटाक्रिया()){
                क.पहचान=असमडाटातंत्र.आरम्भ(क्रिया,पहचान,"",प्रति);
                स्थिर फल:पूर्णांक=प्रतीक्षा क.ठहरो(चिह्न);
                यदि(क्रिया==४){यह.परिणामलो(क.पहचान);}लौटाओ फल;
            }
        }पकड़ो(द:अपवाद){यदि(संबंध.आंतरिकपट्टा!=रिक्त){संबंध.आंतरिकवापस=सत्य;}फेंको द;}
    }
    निजी फलन परिणामलो(क:पूर्णांक)->शून्य {
        स्थिर स्तंभ:पूर्णांक=असमडाटातंत्र.स्तंभ(क);मान इ:पूर्णांक=०;
        जबतक(इ<स्तंभ){नाम.जोड़ो(असमडाटातंत्र.नाम(क,इ));इ=इ+१;}
        मान प:पूर्णांक=०;जबतक(प<असमडाटातंत्र.पंक्तियाँ(क)){
            स्थिर मानपंक्ति:सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>();स्थिर प्रकारपंक्ति:सूची<पाठ> = नया सूची<पाठ>();इ=०;
            जबतक(इ<स्तंभ){
                स्थिर प्रकार:पाठ=असमडाटातंत्र.प्रकार(क,प,इ);मान व:सर्ववस्तु=रिक्त;
                यदि(!असमडाटातंत्र.रिक्तहै(क,प,इ)){
                    यदि(प्रकार=="पूर्णांक"){व=असमडाटातंत्र.पूर्णांकलो(क,प,इ);}
                    अन्यथा यदि(प्रकार=="दशमलव"){व=असमडाटातंत्र.दशमलवलो(क,प,इ);}
                    अन्यथा यदि(प्रकार=="तार्किक"){व=असमडाटातंत्र.पूर्णांकलो(क,प,इ)!=०;}
                    अन्यथा यदि(प्रकार=="बाइटबफ़र"){व=असमडाटातंत्र.बाइटलो(क,प,इ);}
                    अन्यथा{व=असमडाटातंत्र.पाठलो(क,प,इ);}
                }
                मानपंक्ति.जोड़ो(व);प्रकारपंक्ति.जोड़ो(प्रकार);इ=इ+१;
            }
            पंक्तियाँ.जोड़ो(मानपंक्ति);प्रकारसूची.जोड़ो(प्रकारपंक्ति);प=प+१;
        }
    }
    सार्वजनिक फलन अगला()->कार्यफल<तार्किक> {लौटाओ यह.अगला(कार्य.वर्तमानचिह्न());}
    सार्वजनिक फलन अगला(चिह्न:निरस्तीकरणचिह्न)->कार्यफल<तार्किक> {
        प्रयास{
            यह.जाँचो();चिह्न.जाँचो();
            मान पढ़ना:कार्यफल<पूर्णांक> = रिक्त;
            यदि(!चलाया){पढ़ना=यह.आरम्भ(४,चिह्न);}
            लौटाओ यह.अगलाभीतर(पढ़ना,चिह्न);
        }पकड़ो(द:अपवाद){लौटाओ कार्यफल<तार्किक>.असफल(द);}
    }
    निजी असमकालिक फलन अगलाभीतर(पढ़ना:कार्यफल<पूर्णांक>,चिह्न:निरस्तीकरणचिह्न)->तार्किक {
        यदि(पढ़ना!=रिक्त){स्थिर संख्या:पूर्णांक=प्रतीक्षा पढ़ना;}
        यह.जाँचो();चिह्न.जाँचो();पंक्ति=पंक्ति+१;लौटाओ पंक्ति<पंक्तियाँ.आकार;
    }
    सार्वजनिक असमकालिक फलन रीसेट()->शून्य {यह.जाँचो();पंक्तियाँ.साफ़();प्रकारसूची.साफ़();नाम.साफ़();पंक्ति=-१;चलाया=असत्य;}
    सार्वजनिक फलन बंधनमिटाओ()->शून्य {यह.जाँचो();यदि(चलाया){फेंको नया अपवाद("डेटाकथन को रीसेट करें।");}मान क:पूर्णांक=०;जबतक(क<बँधे.आकार){बँधे[क]=असत्य;मानसूची[क]=रिक्त;क=क+१;}}
    सार्वजनिक फलन स्तंभसंख्या()->पूर्णांक {यह.जाँचो();लौटाओ नाम.आकार;}
    सार्वजनिक फलन स्तंभनाम(क्रम:पूर्णांक)->पाठ {यह.जाँचो();लौटाओ नाम[क्रम];}
    निजी फलन मानलो(क्रम:पूर्णांक)->सर्ववस्तु {यह.जाँचो();यदि(पंक्ति<० || पंक्ति>=पंक्तियाँ.आकार){फेंको नया अपवाद("डेटाकथन की वर्तमान पंक्ति नहीं है।");}लौटाओ पंक्तियाँ[पंक्ति][क्रम];}
    सार्वजनिक फलन प्रकार(क्रम:पूर्णांक)->पाठ {स्थिर व:सर्ववस्तु=यह.मानलो(क्रम);लौटाओ प्रकारसूची[पंक्ति][क्रम];}
    सार्वजनिक फलन रिक्तहै(क्रम:पूर्णांक)->तार्किक {लौटाओ यह.मानलो(क्रम)==रिक्त;}
    सार्वजनिक फलन पूर्णांकलो(क्रम:पूर्णांक)->पूर्णांक {लौटाओ परिवर्तित<पूर्णांक>(यह.मानलो(क्रम));}
    सार्वजनिक फलन दशमलवलो(क्रम:पूर्णांक)->दशमलव {स्थिर व:सर्ववस्तु=यह.मानलो(क्रम);यदि(प्रकारहै<पूर्णांक>(व)){लौटाओ परिवर्तित<दशमलव>(परिवर्तित<पूर्णांक>(व));}लौटाओ परिवर्तित<दशमलव>(व);}
    सार्वजनिक फलन तार्किकलो(क्रम:पूर्णांक)->तार्किक {स्थिर व:सर्ववस्तु=यह.मानलो(क्रम);यदि(प्रकारहै<तार्किक>(व)){लौटाओ परिवर्तित<तार्किक>(व);}स्थिर क:पूर्णांक=परिवर्तित<पूर्णांक>(व);यदि(क!=० && क!=१){फेंको नया अपवाद("डेटाकथन तार्किक मान ० या १ होना चाहिए।");}लौटाओ क==१;}
    सार्वजनिक फलन पाठलो(क्रम:पूर्णांक)->पाठ {लौटाओ परिवर्तित<पाठ>(यह.मानलो(क्रम));}
    सार्वजनिक फलन बाइटलो(क्रम:पूर्णांक)->बाइटबफ़र {स्थिर ब:बाइटबफ़र=परिवर्तित<बाइटबफ़र>(यह.मानलो(क्रम));लौटाओ ब.काटो(०,ब.आकार);}
    सार्वजनिक फलन बंदकरो()->कार्यफल<शून्य> {
        यदि(बंदकार्य!=रिक्त){लौटाओ बंदकार्य;}
        यदि(पहचान==० || संबंध.आंतरिकपहचान==०){पहचान=०;बंदकार्य=कार्य.पूरा();लौटाओ बंदकार्य;}
        मान प्रवेश:असमडेटाप्रवेश=रिक्त;
        प्रयास{
            प्रवेश=संबंध.आंतरिकलो();बंदकार्य=यह.बंदचलाओ();
            यदि(बंदकार्य.समाप्तहै()){प्रवेश.बंदकरो();}अन्यथा{बंदकार्य.आंतरिकप्रवेश=प्रवेश;}लौटाओ बंदकार्य;
        }पकड़ो(द:अपवाद){यदि(प्रवेश!=रिक्त){प्रवेश.बंदकरो();}लौटाओ कार्यफल<शून्य>.असफल(द);}
    }
    निजी असमकालिक फलन बंदचलाओ()->शून्य {
        प्रयास{
            असमकालिक संसाधन(क:असमडेटाक्रिया=नया असमडेटाक्रिया()){
                क.पहचान=असमडाटातंत्र.आरम्भ(५,पहचान,"",नया सूची<सर्ववस्तु>());क.प्रतिबद्ध=सत्य;
                स्थिर फल:पूर्णांक=प्रतीक्षा क.ठहरो(नया निरस्तीकरणचिह्न());
            }
        }अंततः{पहचान=०;पंक्तियाँ.साफ़();प्रकारसूची.साफ़();नाम.साफ़();मानसूची.साफ़();बँधे.साफ़();}
    }

}

सार्वजनिक वर्ग असमडेटालेनदेन {
    निजी मान संबंध:असमडेटासंबंध;निजी मान समाप्त:तार्किक=असत्य;
    निजी मान बंदकार्य:कार्यफल<शून्य>;
    सार्वजनिक निर्माता(स:असमडेटासंबंध){संबंध=स;}
    सार्वजनिक असमकालिक फलन सहेजो()->शून्य {प्रतीक्षा यह.सहेजो(कार्य.वर्तमानचिह्न());}
    सार्वजनिक असमकालिक फलन सहेजो(चिह्न:निरस्तीकरणचिह्न)->शून्य {
        यदि(समाप्त){फेंको नया अपवाद("डेटालेनदेन सक्रिय नहीं है।");}
        प्रतीक्षा संबंध.आंतरिकआदेश(७,चिह्न);समाप्त=सत्य;
    }
    सार्वजनिक असमकालिक फलन वापसलो()->शून्य {
        यदि(समाप्त){फेंको नया अपवाद("डेटालेनदेन सक्रिय नहीं है।");}
        प्रतीक्षा संबंध.आंतरिकआदेश(८,नया निरस्तीकरणचिह्न());समाप्त=सत्य;
    }
    सार्वजनिक फलन बंदकरो()->कार्यफल<शून्य> {
        यदि(बंदकार्य!=रिक्त){लौटाओ बंदकार्य;}
        यदि(समाप्त || संबंध.आंतरिकपहचान==०){बंदकार्य=कार्य.पूरा();}अन्यथा{बंदकार्य=यह.वापसलो();}
        लौटाओ बंदकार्य;
    }
}
