संकुल मानक;

सार्वजनिक वर्ग एसक्यूलाइट {
    सार्वजनिक साझा कार्य खोलो(पथ: पाठ) -> डेटाबेस { लौटाओ नया डेटाबेस(पथ); }
    सार्वजनिक साझा कार्य संस्करण() -> पाठ { लौटाओ डाटातंत्र.संस्करण(); }
}

// Implementation state shared by statements and transaction scopes. Not a stable API.
सार्वजनिक वर्ग डेटाअवस्था {
    सार्वजनिक मान पहचान: पूर्णांक = ०;
    सार्वजनिक कार्य जाँचो() -> शून्य {
        यदि (पहचान == ०) { फेंको नया अपवाद("SQLite डेटाबेस बंद है।"); }
    }
}

सार्वजनिक वर्ग डेटाबेस पालन बंदनीय {
    निजी मान अवस्था: डेटाअवस्था;
    सार्वजनिक निर्माता(पथ: पाठ) {
        डेटानियम.पथजाँचो(पथ);
        अवस्था = नया डेटाअवस्था();
        अवस्था.पहचान = डाटातंत्र.खोलो(पथ);
    }
    सार्वजनिक कार्य तैयार(एसक्यूएल: पाठ) -> कथन {
        अवस्था.जाँचो(); लौटाओ नया कथन(अवस्था,एसक्यूएल);
    }
    सार्वजनिक कार्य लेनदेन() -> लेनदेन {
        अवस्था.जाँचो(); लौटाओ नया लेनदेन(अवस्था);
    }
    सार्वजनिक कार्य बंदकरो() -> शून्य {
        यदि (अवस्था.पहचान != ०) {
            स्थिर पुराना: पूर्णांक = अवस्था.पहचान; अवस्था.पहचान = ०;
            डाटातंत्र.बंदकरो(पुराना);
        }
    }
}

सार्वजनिक वर्ग कथन पालन बंदनीय {
    निजी मान अवस्था: डेटाअवस्था;
    निजी मान पहचान: पूर्णांक = ०;
    // The state parameter is an implementation detail; use डेटाबेस.तैयार.
    सार्वजनिक निर्माता(अवस्था: डेटाअवस्था, एसक्यूएल: पाठ) {
        यह.अवस्था = अवस्था; अवस्था.जाँचो(); डेटानियम.कथनजाँचो(एसक्यूएल);
        पहचान = डाटातंत्र.तैयार(अवस्था.पहचान,एसक्यूएल);
    }
    निजी कार्य जाँचो() -> शून्य {
        अवस्था.जाँचो(); यदि (पहचान == ०) { फेंको नया अपवाद("SQLite कथन बंद है।"); }
    }
    सार्वजनिक कार्य बंधनसंख्या() -> पूर्णांक { यह.जाँचो(); लौटाओ डाटातंत्र.बंधन(पहचान); }
    सार्वजनिक कार्य पूर्णांकरखो(क्रम: पूर्णांक, मानक: पूर्णांक) -> शून्य { यह.जाँचो(); डाटातंत्र.पूर्णांकरखो(पहचान,क्रम,मानक); }
    सार्वजनिक कार्य दशमलवरखो(क्रम: पूर्णांक, मानक: दशमलव) -> शून्य {
        यह.जाँचो(); यदि (मानक != मानक || मानक-मानक != ०.०) { फेंको नया अपवाद("SQLite में सीमित दशमलव मान दें।"); }
        डाटातंत्र.दशमलवरखो(पहचान,क्रम,मानक);
    }
    सार्वजनिक कार्य तार्किकरखो(क्रम: पूर्णांक, मानक: तार्किक) -> शून्य {
        यदि (मानक) { यह.पूर्णांकरखो(क्रम,१); } अन्यथा { यह.पूर्णांकरखो(क्रम,०); }
    }
    सार्वजनिक कार्य पाठरखो(क्रम: पूर्णांक, मानक: पाठ) -> शून्य {
        यह.जाँचो(); डाटातंत्र.बाइटरखो(पहचान,क्रम,३,पाठ्य.यूटीएफ८(मानक));
    }
    सार्वजनिक कार्य बाइटरखो(क्रम: पूर्णांक, मानक: बाइटबफ़र) -> शून्य {
        यह.जाँचो(); यदि (मानक == रिक्त) { फेंको नया अपवाद("SQLite बाइटबफ़र रिक्त है।"); }
        डाटातंत्र.बाइटरखो(पहचान,क्रम,४,मानक);
    }
    सार्वजनिक कार्य रिक्तरखो(क्रम: पूर्णांक) -> शून्य { यह.जाँचो(); डाटातंत्र.रिक्तरखो(पहचान,क्रम); }
    सार्वजनिक कार्य चलाओ() -> पूर्णांक { यह.जाँचो(); लौटाओ डाटातंत्र.चलाओ(पहचान); }
    सार्वजनिक कार्य अगला() -> तार्किक { यह.जाँचो(); लौटाओ डाटातंत्र.अगला(पहचान); }
    सार्वजनिक कार्य रीसेट() -> शून्य { यह.जाँचो(); डाटातंत्र.रीसेट(पहचान); }
    सार्वजनिक कार्य बंधनमिटाओ() -> शून्य { यह.जाँचो(); डाटातंत्र.मिटाओ(पहचान); }
    सार्वजनिक कार्य स्तंभसंख्या() -> पूर्णांक { यह.जाँचो(); लौटाओ डाटातंत्र.स्तंभ(पहचान); }
    सार्वजनिक कार्य स्तंभनाम(क्रम: पूर्णांक) -> पाठ { यह.जाँचो(); लौटाओ डाटातंत्र.नाम(पहचान,क्रम); }
    सार्वजनिक कार्य प्रकार(क्रम: पूर्णांक) -> पाठ {
        यह.जाँचो(); स्थिर क: पूर्णांक = डाटातंत्र.प्रकार(पहचान,क्रम);
        यदि (क == १) { लौटाओ "पूर्णांक"; } यदि (क == २) { लौटाओ "दशमलव"; }
        यदि (क == ३) { लौटाओ "पाठ"; } यदि (क == ४) { लौटाओ "बाइटबफ़र"; } लौटाओ "रिक्त";
    }
    सार्वजनिक कार्य रिक्तहै(क्रम: पूर्णांक) -> तार्किक { यह.जाँचो(); लौटाओ डाटातंत्र.प्रकार(पहचान,क्रम) == ५; }
    सार्वजनिक कार्य पूर्णांकलो(क्रम: पूर्णांक) -> पूर्णांक { यह.जाँचो(); लौटाओ डाटातंत्र.पूर्णांकलो(पहचान,क्रम); }
    सार्वजनिक कार्य दशमलवलो(क्रम: पूर्णांक) -> दशमलव { यह.जाँचो(); लौटाओ डाटातंत्र.दशमलवलो(पहचान,क्रम); }
    सार्वजनिक कार्य तार्किकलो(क्रम: पूर्णांक) -> तार्किक {
        स्थिर क: पूर्णांक = यह.पूर्णांकलो(क्रम);
        यदि (क != ० && क != १) { फेंको नया अपवाद("SQLite तार्किक मान ० या १ होना चाहिए।"); } लौटाओ क == १;
    }
    सार्वजनिक कार्य पाठलो(क्रम: पूर्णांक) -> पाठ { यह.जाँचो(); लौटाओ पाठ्य.यूटीएफ८पाठ(डाटातंत्र.बाइटलो(पहचान,क्रम,३)); }
    सार्वजनिक कार्य बाइटलो(क्रम: पूर्णांक) -> बाइटबफ़र { यह.जाँचो(); लौटाओ डाटातंत्र.बाइटलो(पहचान,क्रम,४); }
    सार्वजनिक कार्य बंदकरो() -> शून्य {
        यदि (पहचान != ०) { स्थिर पुराना: पूर्णांक = पहचान; पहचान = ०; डाटातंत्र.कथनबंद(पुराना); }
    }
}

सार्वजनिक वर्ग लेनदेन पालन बंदनीय {
    निजी मान अवस्था: डेटाअवस्था;
    निजी मान चिह्न: पूर्णांक = ०;
    निजी मान समाप्त: तार्किक = असत्य;
    // Use डेटाबेस.लेनदेन; allocation precedes the transaction side effect.
    सार्वजनिक निर्माता(अवस्था: डेटाअवस्था) {
        यह.अवस्था = अवस्था; अवस्था.जाँचो(); चिह्न = डाटातंत्र.लेनदेन(अवस्था.पहचान,०,०);
    }
    सार्वजनिक कार्य सहेजो() -> शून्य {
        यदि (समाप्त) { फेंको नया अपवाद("SQLite लेनदेन सक्रिय नहीं है।"); }
        अवस्था.जाँचो(); डाटातंत्र.लेनदेन(अवस्था.पहचान,चिह्न,१); समाप्त = सत्य;
    }
    सार्वजनिक कार्य वापसलो() -> शून्य {
        यदि (समाप्त) { फेंको नया अपवाद("SQLite लेनदेन सक्रिय नहीं है।"); }
        अवस्था.जाँचो(); डाटातंत्र.लेनदेन(अवस्था.पहचान,चिह्न,२); समाप्त = सत्य;
    }
    सार्वजनिक कार्य बंदकरो() -> शून्य {
        यदि (!समाप्त) {
            समाप्त = सत्य;
            यदि (अवस्था.पहचान != ०) { डाटातंत्र.लेनदेन(अवस्था.पहचान,चिह्न,३); }
        }
    }
}

// Shared portable SQL/path policy. Internal implementation, not application API.
सार्वजनिक वर्ग डेटानियम {
    सार्वजनिक साझा कार्य पाठजाँचो(मानक: पाठ, सीमा: पूर्णांक) -> शून्य {
        स्थिर ब: बाइटबफ़र = पाठ्य.यूटीएफ८(मानक);
        यदि (ब.आकार == ० || ब.आकार > सीमा) { फेंको नया अपवाद("अमान्य SQLite पाठ।"); }
        मान क: पूर्णांक = ०;
        जबतक (क < ब.आकार) { यदि (परिवर्तित<पूर्णांक>(ब[क]) == ०) { फेंको नया अपवाद("अमान्य SQLite पाठ।"); } क = क+१; }
    }
    सार्वजनिक साझा कार्य पथजाँचो(पथ: पाठ) -> शून्य {
        डेटानियम.पाठजाँचो(पथ,४०९६); स्थिर न: पाठ = पाठ्य.छोटाअक्षर(पथ);
        यदि (पाठ्य.आरंभ(न,"file:") || पाठ्य.आरंभ(न,"jdbc:") || पाठ्य.है(पथ,"?") || पाठ्य.है(पथ,"#")) {
            फेंको नया अपवाद("SQLite में स्थानीय फ़ाइल पथ या :memory: दें।");
        }
    }
    सार्वजनिक साझा कार्य कथनजाँचो(एसक्यूएल: पाठ) -> शून्य {
        डेटानियम.पाठजाँचो(एसक्यूएल,६५५३६);
        मान क: पूर्णांक = ०; स्थिर न: पूर्णांक = पाठ्य.लंबाई(एसक्यूएल);
        मान उद्धरण: पाठ = ""; मान टिप्पणी: पूर्णांक = ०;
        मान समाप्त: तार्किक = असत्य; मान देखा: तार्किक = असत्य; मान गिनती: पूर्णांक = ०;
        जबतक (क < न) {
            स्थिर अ: पाठ = पाठ्य.अंश(एसक्यूएल,क,क+१); मान अग: पाठ = "";
            यदि (क+१ < न) { अग = पाठ्य.अंश(एसक्यूएल,क+१,क+२); }
            यदि (टिप्पणी == १) { यदि (अ == "\n" || अ == "\r") { टिप्पणी = ०; } }
            अन्यथा यदि (टिप्पणी == २) { यदि (अ == "*" && अग == "/") { टिप्पणी = ०; क = क+१; } }
            अन्यथा यदि (उद्धरण != "") {
                यदि (अ == उद्धरण) {
                    यदि (अग == उद्धरण && उद्धरण != "]") { क = क+१; } अन्यथा { उद्धरण = ""; }
                }
            }
            अन्यथा यदि (अ == "-" && अग == "-") { टिप्पणी = १; क = क+१; }
            अन्यथा यदि (अ == "/" && अग == "*") { टिप्पणी = २; क = क+१; }
            अन्यथा यदि (!पाठ्य.है(" \t\n\r\u000c",अ)) {
                यदि (समाप्त) { फेंको नया अपवाद("एक SQLite कथन ही दें।"); }
                यदि (!देखा) {
                    मान अंत: पूर्णांक = क;
                    जबतक (अंत < न && पाठ्य.है("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ",पाठ्य.अंश(एसक्यूएल,अंत,अंत+१))) { अंत = अंत+१; }
                    स्थिर शब्द: पाठ = पाठ्य.बड़ाअक्षर(पाठ्य.अंश(एसक्यूएल,क,अंत));
                    यदि (शब्द == "") { फेंको नया अपवाद("SQLite कथन असफल।"); }
                    यदि (पाठ्य.है("|BEGIN|COMMIT|END|ROLLBACK|SAVEPOINT|RELEASE|","|"+शब्द+"|")) { फेंको नया अपवाद("लेनदेन के लिए SQLite संसाधन API उपयोग करें।"); }
                    यदि (शब्द == "ATTACH" || शब्द == "DETACH") { फेंको नया अपवाद("SQLite ATTACH और DETACH उपलब्ध नहीं हैं।"); }
                    देखा = सत्य;
                }
                यदि (अ == ";") { समाप्त = सत्य; }
                अन्यथा यदि (अ == "'" || अ == "\"" || अ == "`") { उद्धरण = अ; }
                अन्यथा यदि (अ == "[") { उद्धरण = "]"; }
                अन्यथा यदि (अ == ":" || अ == "@" || अ == "$" || (अ == "?" && अग != "" && पाठ्य.है("0123456789",अग))) { फेंको नया अपवाद("SQLite में केवल ? मापदंड दें।"); }
                अन्यथा यदि (अ == "?") { गिनती = गिनती+१; यदि (गिनती > ९९९) { फेंको नया अपवाद("SQLite मापदंड सीमा ९९९ है।"); } }
            }
            क = क+१;
        }
        यदि (!देखा || उद्धरण != "" || टिप्पणी == २) { फेंको नया अपवाद("SQLite कथन असफल।"); }
    }
}
