संकुल मानक;

सार्वजनिक अनुबंध असमवेबचालक {
    फलन संभालो(अनुरोध: वेबअनुरोध, चिह्न: निरस्तीकरणचिह्न) -> कार्यफल<वेबउत्तर>;
}

सार्वजनिक वर्ग समवेबचालक पालन असमवेबचालक {
    निजी मान चालक: वेबचालक;
    सार्वजनिक निर्माता(चालक: वेबचालक) {
        यदि (चालक == रिक्त) { फेंको नया अपवाद("वेब चालक रिक्त है।"); }
        यह.चालक = चालक;
    }
    सार्वजनिक फलन संभालो(अनुरोध: वेबअनुरोध, चिह्न: निरस्तीकरणचिह्न) -> कार्यफल<वेबउत्तर> {
        चिह्न.जाँचो();
        लौटाओ कार्यफल<वेबउत्तर>.पूरा(चालक.संभालो(अनुरोध));
    }
}

सार्वजनिक वर्ग असमवेबमार्ग {
    सार्वजनिक मान विधि: पाठ;
    सार्वजनिक मान खंड: सूची<पाठ>;
    सार्वजनिक मान चालक: असमवेबचालक;
    सार्वजनिक निर्माता(विधि: पाठ, खंड: सूची<पाठ>, चालक: असमवेबचालक) {
        यह.विधि = विधि; यह.खंड = खंड; यह.चालक = चालक;
    }
}

सार्वजनिक वर्ग असमवेबअनुप्रयोग पालन असमवेबचालक {
    निजी मान मार्ग: सूची<असमवेबमार्ग>;
    सार्वजनिक निर्माता() { मार्ग = नया सूची<असमवेबमार्ग>(); }
    सार्वजनिक फलन जोड़ो(विधि: पाठ, पथ: पाठ, चालक: असमवेबचालक) -> शून्य {
        यदि (चालक == रिक्त || मार्ग.आकार >= १२८) { फेंको नया अपवाद("अमान्य वेब मार्ग।"); }
        मार्ग.जोड़ो(नया असमवेबमार्ग(विधि,वेब.आंतरिकमार्गखंड(विधि,पथ),चालक));
    }
    सार्वजनिक फलन समजोड़ो(विधि: पाठ, पथ: पाठ, चालक: वेबचालक) -> शून्य {
        यह.जोड़ो(विधि,पथ,नया समवेबचालक(चालक));
    }
    सार्वजनिक फलन संभालो(अनुरोध: वेबअनुरोध, चिह्न: निरस्तीकरणचिह्न) -> कार्यफल<वेबउत्तर> {
        चिह्न.जाँचो();
        स्थिर खंड: सूची<पाठ> = पाठ्य.बाँटो(अनुरोध.पथ,"/");
        स्थिर अनुमत: सूची<पाठ> = नया सूची<पाठ>();
        प्रत्येक (यह.मार्ग में मार्ग: असमवेबमार्ग) {
            स्थिर चर: मानचित्र<पाठ,पाठ> = वेब.आंतरिकमार्गमान(खंड,मार्ग.खंड);
            यदि (चर != रिक्त) {
                यदि (अनुरोध.विधि == मार्ग.विधि || (अनुरोध.विधि == "HEAD" && मार्ग.विधि == "GET")) {
                    अनुरोध.पथमान = चर;
                    लौटाओ मार्ग.चालक.संभालो(अनुरोध,चिह्न);
                }
                अनुमत.जोड़ो(मार्ग.विधि);
                यदि (मार्ग.विधि == "GET") { अनुमत.जोड़ो("HEAD"); }
            }
        }
        यदि (अनुमत.आकार > ०) {
            स्थिर उत्तर: वेबउत्तर = वेब.त्रुटि(४०५);
            उत्तर.शीर्षरखो("Allow",पाठ्य.जोड़ो(अनुमत,", "));
            लौटाओ कार्यफल<वेबउत्तर>.पूरा(उत्तर);
        }
        लौटाओ कार्यफल<वेबउत्तर>.पूरा(वेब.त्रुटि(४०४));
    }
}

सार्वजनिक वर्ग असमसुरक्षितवेब पालन असमवेबचालक {
    निजी मान सत्रमान: सत्रप्रबंधक;
    निजी मान चालक: असमवेबचालक;
    सार्वजनिक निर्माता(सत्रमान: सत्रप्रबंधक, चालक: असमवेबचालक) {
        यह.सत्रमान = सत्रमान; यह.चालक = चालक;
    }
    सार्वजनिक असमकालिक फलन संभालो(अनुरोध: वेबअनुरोध, चिह्न: निरस्तीकरणचिह्न) -> वेबउत्तर {
        चिह्न.जाँचो();
        मान फल: वेबउत्तर = रिक्त;
        प्रयास {
            सत्रमान.सीएसआरएफजाँचो(अनुरोध);
            फल = प्रतीक्षा चालक.संभालो(अनुरोध,चिह्न);
        } पकड़ो (दोष: वेबत्रुटि) { फल = वेब.त्रुटि(दोष.स्थिति); }
        फल.शीर्षरखो("Cache-Control","no-store");
        फल.शीर्षरखो("X-Content-Type-Options","nosniff");
        फल.शीर्षरखो("Referrer-Policy","same-origin");
        लौटाओ फल;
    }
}

// Null read means no progress, an empty read means EOF. Only the session pump writes.
सार्वजनिक अनुबंध द्विदिशधारा विस्तार बंदनीय {
    फलन पढ़ो() -> बाइटबफ़र;
    फलन भेजो(खंड: बाइटबफ़र) -> पूर्णांक;
}

सार्वजनिक वर्ग असमसॉकेटधारा पालन द्विदिशधारा {
    निजी मान संबंध: वेबसंबंध;
    निजी मान बचाखंड: बाइटबफ़र;
    सार्वजनिक निर्माता(संबंध: वेबसंबंध, बचाखंड: बाइटबफ़र) { यह.संबंध = संबंध; यह.बचाखंड = बचाखंड; }
    सार्वजनिक फलन पढ़ो() -> बाइटबफ़र {
        यदि (बचाखंड != रिक्त) { स्थिर फल: बाइटबफ़र = बचाखंड; बचाखंड = रिक्त; लौटाओ फल; }
        लौटाओ सर्वरतंत्र.तुरंतपढ़ो(संबंध.पहचान);
    }
    सार्वजनिक फलन भेजो(खंड: बाइटबफ़र) -> पूर्णांक { लौटाओ सर्वरतंत्र.तुरंतलिखो(संबंध.पहचान,खंड); }
    सार्वजनिक फलन बंदकरो() -> शून्य { बचाखंड = रिक्त; संबंध.बंदकरो(); }
}

सार्वजनिक वर्ग असमवेबआगमन {
    सार्वजनिक मान अनुरोध: वेबअनुरोध;
    सार्वजनिक मान बचाखंड: बाइटबफ़र;
    सार्वजनिक निर्माता(अनुरोध: वेबअनुरोध, बचाखंड: बाइटबफ़र) { यह.अनुरोध = अनुरोध; यह.बचाखंड = बचाखंड; }
}

सार्वजनिक अनुबंध असमवेबउन्नयन {
    फलन चुनो(अनुरोध: वेबअनुरोध) -> असमवेबउन्नतचालक;
}

सार्वजनिक अनुबंध असमवेबउन्नतचालक विस्तार बंदनीय {
    फलन उत्तरलो() -> बाइटबफ़र;
    फलन चलाओ(धारा: द्विदिशधारा, रोक: निरस्तीकरणचिह्न) -> कार्यफल<कार्यशून्य>;
}

सार्वजनिक वर्ग असमवेबधारा {
    निजी निर्माता() {}

    सार्वजनिक साझा असमकालिक फलन अनुरोधलो(पहचान: पूर्णांक, चिह्न: निरस्तीकरणचिह्न) -> असमवेबआगमन {
        स्थिर समय: पूर्णांक = कार्यघड़ी.अब() + १००००;
        // Request line, all allowed header bytes, and the final CRLF.
        स्थिर शीर्ष: बाइटबफ़र = नया बाइटबफ़र(२०४८४);
        मान गिने: पूर्णांक = ०;
        मान पंक्तिलंबाई: पूर्णांक = ०;
        मान सीआर: तार्किक = असत्य;
        मान भाग: वेबशीर्षभाग = रिक्त;
        मान शरीर: बाइटबफ़र = रिक्त;
        मान बचाखंड: बाइटबफ़र = रिक्त;
        मान शरीरक्रम: पूर्णांक = ०;
        जबतक (भाग == रिक्त || शरीरक्रम < शरीर.आकार) {
            चिह्न.जाँचो();
            यदि (कार्यघड़ी.अब() >= समय) { फेंको नया वेबत्रुटि(४०८,"HTTP संबंध का समय समाप्त।"); }
            स्थिर खंड: बाइटबफ़र = सर्वरतंत्र.तुरंतपढ़ो(पहचान);
            यदि (खंड == रिक्त) {
                प्रतीक्षा कार्य.विलंब(५,चिह्न);
            } अन्यथा {
                यदि (खंड.आकार == ०) { फेंको नया वेबत्रुटि(४००,"अपूर्ण HTTP अनुरोध।"); }
                मान क: पूर्णांक = ०;
                जबतक (क < खंड.आकार && भाग == रिक्त) {
                    स्थिर अ: पूर्णांक = परिवर्तित<पूर्णांक>(खंड[क]);
                    यदि (गिने >= शीर्ष.आकार) { फेंको नया वेबत्रुटि(४३१,"बहुत अधिक HTTP शीर्ष।"); }
                    शीर्ष[गिने] = खंड[क]; गिने = गिने + १; क = क + १;
                    यदि (सीआर) {
                        यदि (अ != १०) { फेंको नया वेबत्रुटि(४००,"HTTP में CRLF दें।"); }
                        यदि (पंक्तिलंबाई == ०) {
                            स्थिर पठन: वेबसंबंध = नया वेबसंबंध();
                            पठन.आंतरिकखंडरखो(शीर्ष.काटो(०,गिने));
                            भाग = पठन.आंतरिकशीर्षलो();
                            शरीर = नया बाइटबफ़र(भाग.आकार);
                        }
                        सीआर = असत्य; पंक्तिलंबाई = ०;
                    } अन्यथा यदि (अ == १३) {
                        सीआर = सत्य;
                    } अन्यथा {
                        यदि (पंक्तिलंबाई == ४०९६ || (अ < ३२ && अ != ९) || अ > १२६) { फेंको नया वेबत्रुटि(४००,"अमान्य HTTP पंक्ति।"); }
                        पंक्तिलंबाई = पंक्तिलंबाई + १;
                    }
                }
                यदि (भाग != रिक्त) {
                    जबतक (क < खंड.आकार && शरीरक्रम < शरीर.आकार) {
                        शरीर[शरीरक्रम] = खंड[क]; शरीरक्रम = शरीरक्रम + १; क = क + १;
                    }
                    यदि (क < खंड.आकार) { बचाखंड = खंड.काटो(क,खंड.आकार); }
                }
                यदि (भाग == रिक्त || शरीरक्रम < शरीर.आकार) { प्रतीक्षा कार्य.छोड़ो(); }
            }
        }
        लौटाओ नया असमवेबआगमन(भाग.अनुरोधबनाओ(शरीर),बचाखंड);
    }

    सार्वजनिक साझा असमकालिक फलन भेजो(पहचान: पूर्णांक, सामग्री: बाइटबफ़र, समय: पूर्णांक, चिह्न: निरस्तीकरणचिह्न) -> शून्य {
        मान क्रम: पूर्णांक = ०;
        जबतक (क्रम < सामग्री.आकार) {
            चिह्न.जाँचो();
            यदि (कार्यघड़ी.अब() >= समय) { फेंको नया समयसीमाअपवाद(); }
            मान अंत: पूर्णांक = क्रम + ८१९२;
            यदि (अंत > सामग्री.आकार) { अंत = सामग्री.आकार; }
            स्थिर खंड: बाइटबफ़र = सामग्री.काटो(क्रम,अंत);
            मान लिखे: पूर्णांक = सर्वरतंत्र.तुरंतलिखो(पहचान,खंड);
            जबतक (लिखे == ०) {
                प्रतीक्षा कार्य.विलंब(५,चिह्न);
                यदि (कार्यघड़ी.अब() >= समय) { फेंको नया समयसीमाअपवाद(); }
                लिखे = सर्वरतंत्र.तुरंतलिखो(पहचान,खंड);
            }
            क्रम = क्रम + लिखे;
            यदि (क्रम < सामग्री.आकार) { प्रतीक्षा कार्य.छोड़ो(); }
        }
    }
}

सार्वजनिक वर्ग असमएचटीटीपीसर्वर पालन बंदनीय {
    निजी मान सुनना: वेबसंबंध;
    निजी मान रुका: तार्किक = असत्य;
    निजी मान चलरहा: तार्किक = असत्य;
    निजी मान समयसीमा: पूर्णांक;

    सार्वजनिक निर्माता(पता: पाठ, पोर्ट: पूर्णांक) {
        समयसीमा = १००००;
        सुनना = नया वेबसंबंध();
        सुनना.पहचान = सर्वरतंत्र.खोलो(पता,पोर्ट);
    }
    सार्वजनिक निर्माता(पता: पाठ, पोर्ट: पूर्णांक, समय: पूर्णांक) {
        यदि (समय < १ || समय > ६००००) { फेंको नया अपवाद("अमान्य HTTP चालक समयसीमा।"); }
        समयसीमा = समय;
        सुनना = नया वेबसंबंध();
        सुनना.पहचान = सर्वरतंत्र.खोलो(पता,पोर्ट);
    }
    सार्वजनिक फलन पोर्ट() -> पूर्णांक { लौटाओ सर्वरतंत्र.पोर्ट(सुनना.पहचान); }
    सार्वजनिक फलन रोको() -> शून्य { रुका = सत्य; }
    सार्वजनिक फलन बंदकरो() -> शून्य { यह.रोको(); सुनना.बंदकरो(); }

    सार्वजनिक फलन चलाओ(चालक: असमवेबचालक) -> कार्यफल<कार्यशून्य> {
        लौटाओ यह.उन्नयनचलाओ(चालक,रिक्त,कार्य.वर्तमानचिह्न());
    }
    सार्वजनिक फलन चलाओ(चालक: असमवेबचालक, चिह्न: निरस्तीकरणचिह्न) -> कार्यफल<कार्यशून्य> {
        लौटाओ यह.उन्नयनचलाओ(चालक,रिक्त,चिह्न);
    }
    सार्वजनिक फलन उन्नयनचलाओ(चालक: असमवेबचालक, उन्नयन: असमवेबउन्नयन) -> कार्यफल<कार्यशून्य> {
        लौटाओ यह.उन्नयनचलाओ(चालक,उन्नयन,कार्य.वर्तमानचिह्न());
    }
    सार्वजनिक असमकालिक फलन उन्नयनचलाओ(चालक: असमवेबचालक, उन्नयन: असमवेबउन्नयन, चिह्न: निरस्तीकरणचिह्न) -> शून्य {
        यदि (चालक == रिक्त || चिह्न == रिक्त || चलरहा || सुनना.पहचान == ०) { फेंको नया अपवाद("अमान्य असमकालिक HTTP सर्वर या चालक।"); }
        स्थिर बच्चे: सूची<कार्यफल<कार्यशून्य>> = नया सूची<कार्यफल<कार्यशून्य>>();
        स्थिर रोक: निरस्तीकरणस्रोत = नया निरस्तीकरणस्रोत(चिह्न);
        चलरहा = सत्य;
        प्रयास {
            जबतक (!रुका && सर्वरतंत्र.रोकचिह्न() == ०) {
                चिह्न.जाँचो();
                मान क: पूर्णांक = ०;
                जबतक (क < बच्चे.आकार) {
                    स्थिर सेवा: कार्यफल<कार्यशून्य> = बच्चे[क];
                    यदि (सेवा.समाप्तहै()) {
                        स्थिर समाप्त: कार्यफल<कार्यशून्य> = बच्चे.हटाओ(क);
                        प्रतीक्षा समाप्त;
                    }
                    अन्यथा { क = क + १; }
                }
                यदि (!रुका && बच्चे.आकार < १६) {
                    स्थिर खुला: वेबसंबंध = नया वेबसंबंध();
                    खुला.पहचान = सर्वरतंत्र.तुरंतस्वीकारो(सुनना.पहचान);
                    यदि (खुला.पहचान != ०) {
                        प्रयास {
                            स्थिर सेवा: कार्यफल<कार्यशून्य> = यह.सेवा(खुला,चालक,उन्नयन,रोक.चिह्नलो());
                            सेवा.आंतरिकप्रवेश = खुला;
                            बच्चे.जोड़ो(सेवा);
                        }
                        पकड़ो (दोष: अपवाद) { खुला.बंदकरो(); फेंको दोष; }
                    }
                }
                प्रतीक्षा कार्य.विलंब(५,चिह्न);
            }
        } अंततः { रोक.निरस्तकरो(); यह.बंदकरो(); चलरहा = असत्य; }
    }

    निजी असमकालिक फलन सेवा(खुला: वेबसंबंध, चालक: असमवेबचालक, उन्नयन: असमवेबउन्नयन, रोक: निरस्तीकरणचिह्न) -> शून्य {
        मान उन्नत: असमवेबउन्नतचालक = रिक्त;
        प्रयास {
            मान उत्तर: वेबउत्तर = रिक्त;
            मान शीर्षमात्र: तार्किक = असत्य;
            मान आगमन: असमवेबआगमन = रिक्त;
            प्रयास {
                आगमन = प्रतीक्षा असमवेबधारा.अनुरोधलो(खुला.पहचान,रोक);
                स्थिर अनुरोध: वेबअनुरोध = आगमन.अनुरोध;
                शीर्षमात्र = अनुरोध.विधि == "HEAD";
                यदि (उन्नयन != रिक्त) { उन्नत = उन्नयन.चुनो(अनुरोध); }
                यदि (उन्नत == रिक्त) {
                    उत्तर = प्रतीक्षा यह.चालकचलाओ(खुला.पहचान,चालक,अनुरोध,रोक);
                    खुला.उत्तरशीर्ष(उत्तर);
                }
            } पकड़ो (दोष: निरस्तअपवाद) { लौटाओ; }
            पकड़ो (दोष: समयसीमाअपवाद) { उत्तर = वेब.त्रुटि(५०४); }
            पकड़ो (दोष: वेबत्रुटि) {
                उत्तर = वेब.त्रुटि(दोष.स्थिति);
                यदि (दोष.शीर्षनाम != "") { उत्तर.शीर्षरखो(दोष.शीर्षनाम,दोष.शीर्षमूल्य); }
            }
            पकड़ो (दोष: अपवाद) { लेखा.सूचना("वेब अनुरोध में आंतरिक त्रुटि।"); उत्तर = वेब.त्रुटि(५००); }

            रोक.जाँचो();
            यदि (उन्नत != रिक्त) {
                स्थिर धारा: द्विदिशधारा = नया असमसॉकेटधारा(खुला,आगमन.बचाखंड);
                प्रतीक्षा असमवेबधारा.भेजो(खुला.पहचान,उन्नत.उत्तरलो(),कार्यघड़ी.अब()+१००००,रोक);
                प्रतीक्षा उन्नत.चलाओ(धारा,रोक);
                लौटाओ;
            }
            स्थिर शीर्ष: बाइटबफ़र = पाठ्य.यूटीएफ८(खुला.उत्तरशीर्ष(उत्तर));
            मान शरीर: बाइटबफ़र = रिक्त;
            यदि (!शीर्षमात्र && उत्तर.स्थिति != २०४ && उत्तर.स्थिति != ३०४) {
                शरीर = उत्तर.सामग्री.काटो(०,उत्तर.सामग्री.आकार);
            }
            स्थिर समय: पूर्णांक = कार्यघड़ी.अब() + १००००;
            प्रतीक्षा असमवेबधारा.भेजो(खुला.पहचान,शीर्ष,समय,रोक);
            यदि (शरीर != रिक्त) { प्रतीक्षा असमवेबधारा.भेजो(खुला.पहचान,शरीर,समय,रोक); }
        } पकड़ो (दोष: निरस्तअपवाद) { लौटाओ; }
        पकड़ो (दोष: अपवाद) { लेखा.सूचना("वेब उत्तर भेजा नहीं जा सका।"); }
        अंततः { यदि (उन्नत!=रिक्त) { उन्नत.बंदकरो(); } }
    }

    निजी असमकालिक फलन चालकचलाओ(पहचान: पूर्णांक, चालक: असमवेबचालक, अनुरोध: वेबअनुरोध, रोक: निरस्तीकरणचिह्न) -> वेबउत्तर {
        रोक.जाँचो();
        स्थिर समय: निरस्तीकरणस्रोत = नया निरस्तीकरणस्रोत(समयसीमा);
        स्थिर काम: कार्यफल<वेबउत्तर> = चालक.संभालो(अनुरोध,समय.चिह्नलो());
        यदि (काम == रिक्त) { फेंको नया अपवाद("अमान्य असमकालिक वेब उत्तर।"); }
        प्रयास {
            जबतक (!काम.समाप्तहै()) {
                रोक.जाँचो(); समय.चिह्नलो().जाँचो();
                // This profile treats EOF after the request as abandonment.
                मान अतिरिक्त: बाइटबफ़र = रिक्त;
                प्रयास { अतिरिक्त = सर्वरतंत्र.तुरंतपढ़ो(पहचान); }
                पकड़ो (दोष: अपवाद) { समय.निरस्तकरो(); समय.चिह्नलो().जाँचो(); }
                यदि (अतिरिक्त != रिक्त && अतिरिक्त.आकार == ०) { समय.निरस्तकरो(); समय.चिह्नलो().जाँचो(); }
                प्रतीक्षा कार्य.विलंब(५,रोक);
            }
            समय.चिह्नलो().जाँचो();
            लौटाओ प्रतीक्षा काम;
        } अंततः {
            यदि (!काम.समाप्तहै()) { समय.निरस्तकरो(); काम.आंतरिकचिह्न.निरस्तकरो(); }
        }
    }
}
