संकुल मानक;

सार्वजनिक अभिलेख माइग्रेशन(संस्करण: पूर्णांक, नाम: पाठ, कथन: सूची<पाठ>);
सार्वजनिक अभिलेख माइग्रेशनस्थिति(संस्करण: पूर्णांक, नाम: पाठ, चेकसम: पाठ, लागू: तार्किक);

सार्वजनिक वर्ग माइग्रेशनयोजना {
    निजी मान योजना: सूची<माइग्रेशन>;
    सार्वजनिक निर्माता(मूल: सूची<माइग्रेशन>) {
        योजना=नया सूची<माइग्रेशन>(); मान पिछला: पूर्णांक=०;
        प्रत्येक (मूल में म: माइग्रेशन) {
            यदि (म.संस्करण <= पिछला || म.नाम == "" || म.कथन.आकार == ०) { फेंको नया अपवाद("माइग्रेशन संस्करण बढ़ते क्रम में और नाम सहित दें।"); }
            यदि (पाठ्य.यूटीएफ८(म.नाम).आकार > २५६) { फेंको नया अपवाद("माइग्रेशन नाम बहुत बड़ा है।"); }
            स्थिर कथन: सूची<पाठ> = नया सूची<पाठ>();
            प्रत्येक (म.कथन में क: पाठ) {
                // Validate one statement and restrict migrations to transactional schema/data SQL.
                एसक्यूएलनियम.पोस्टग्रेस(क);
                स्थिर आरंभ: पाठ = पाठ्य.बड़ाअक्षर(पाठ्य.छाँटो(क));
                यदि (!(पाठ्य.आरंभ(आरंभ,"CREATE ") || पाठ्य.आरंभ(आरंभ,"ALTER ") || पाठ्य.आरंभ(आरंभ,"DROP ") || पाठ्य.आरंभ(आरंभ,"INSERT ") || पाठ्य.आरंभ(आरंभ,"UPDATE ") || पाठ्य.आरंभ(आरंभ,"DELETE "))) { फेंको नया अपवाद("माइग्रेशन में स्पष्ट CREATE/ALTER/DROP/INSERT/UPDATE/DELETE कथन दें।"); }
                कथन.जोड़ो(क);
            }
            योजना.जोड़ो(नया माइग्रेशन(म.संस्करण,म.नाम,कथन)); पिछला=म.संस्करण;
        }
    }
    निजी फलन चेकसम(म: माइग्रेशन) -> पाठ {
        मान पाठ्यांश: पाठ="bhash-migration-v1:"+एसक्यूएलनियम.अंक(म.संस्करण)+":"+एसक्यूएलनियम.अंक(पाठ्य.यूटीएफ८(म.नाम).आकार)+":"+म.नाम;
        प्रत्येक (म.कथन में क: पाठ) { पाठ्यांश=पाठ्यांश+":"+एसक्यूएलनियम.अंक(पाठ्य.यूटीएफ८(क).आकार)+":"+क; }
        लौटाओ डेटाचेकसम.शा२५६(पाठ्यांश);
    }
    निजी फलन आरंभ(ड: डेटासंबंध) -> शून्य {
        यदि (ड.प्रदाता() == "postgresql") {
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT pg_advisory_xact_lock(73536281129411)")) { क.अगला(); }
        }
        संसाधन (क: डेटाकथन=ड.तैयार("CREATE TABLE IF NOT EXISTS bhash_schema_history (version BIGINT PRIMARY KEY, name TEXT NOT NULL, checksum TEXT NOT NULL)")) { क.चलाओ(); }
        // Obtain SQLite's write lock before reading history. PostgreSQL uses the advisory lock above.
        यदि (ड.प्रदाता() == "sqlite") {
            संसाधन (क: डेटाकथन=ड.तैयार("UPDATE bhash_schema_history SET version=version WHERE version=-1")) { क.चलाओ(); }
        }
    }
    निजी फलन निरीक्षण(ड: डेटासंबंध) -> सूची<माइग्रेशनस्थिति> {
        स्थिर फल: सूची<माइग्रेशनस्थिति> = नया सूची<माइग्रेशनस्थिति>(); मान क्रम: पूर्णांक=०;
        संसाधन (क: डेटाकथन=ड.तैयार("SELECT version,name,checksum FROM bhash_schema_history ORDER BY version")) {
            जबतक (क.अगला()) {
                यदि (क्रम >= योजना.आकार) { फेंको नया अपवाद("डेटाबेस में इस अनुप्रयोग से नया या अज्ञात माइग्रेशन है।"); }
                स्थिर म: माइग्रेशन=योजना[क्रम]; स्थिर श: पाठ=यह.चेकसम(म);
                यदि (क.पूर्णांकलो(०)!=म.संस्करण || क.पाठलो(१)!=म.नाम || क.पाठलो(२)!=श) { फेंको नया अपवाद("लागू माइग्रेशन का नाम, क्रम या चेकसम बदल गया है।"); }
                फल.जोड़ो(नया माइग्रेशनस्थिति(म.संस्करण,म.नाम,श,सत्य)); क्रम=क्रम+१;
            }
        }
        जबतक (क्रम < योजना.आकार) { स्थिर म: माइग्रेशन=योजना[क्रम]; फल.जोड़ो(नया माइग्रेशनस्थिति(म.संस्करण,म.नाम,यह.चेकसम(म),असत्य)); क्रम=क्रम+१; }
        लौटाओ फल;
    }
    सार्वजनिक फलन स्थिति(ड: डेटासंबंध) -> सूची<माइग्रेशनस्थिति> {
        संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) { यह.आरंभ(ड); स्थिर फल: सूची<माइग्रेशनस्थिति> = यह.निरीक्षण(ड); ल.सहेजो(); लौटाओ फल; }
    }
    सार्वजनिक फलन जाँचो(ड: डेटासंबंध) -> शून्य { यह.स्थिति(ड); }
    सार्वजनिक फलन लागूकरो(ड: डेटासंबंध) -> पूर्णांक {
        मान गिनती: पूर्णांक=०;
        संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {
            यह.आरंभ(ड); स्थिर स्थिति: सूची<माइग्रेशनस्थिति> = यह.निरीक्षण(ड); मान क्रम: पूर्णांक=०;
            प्रत्येक (योजना में म: माइग्रेशन) {
                यदि (!स्थिति[क्रम].लागू) {
                    प्रत्येक (म.कथन में एसक्यूएल: पाठ) { संसाधन (क: डेटाकथन=ड.तैयार(एसक्यूएल)) { क.चलाओ(); } }
                    संसाधन (क: डेटाकथन=ड.तैयार("INSERT INTO bhash_schema_history(version,name,checksum) VALUES (?,?,?)")) {
                        क.पूर्णांकरखो(१,म.संस्करण); क.पाठरखो(२,म.नाम); क.पाठरखो(३,स्थिति[क्रम].चेकसम); क.चलाओ();
                    }
                    गिनती=गिनती+१;
                }
                क्रम=क्रम+१;
            }
            ल.सहेजो();
        }
        लौटाओ गिनती;
    }
}

// Pure Bhash SHA-256: one implementation, byte-identical checksums on every target.
सार्वजनिक वर्ग डेटाचेकसम {
    निजी साझा फलन घुमाओ(व: पूर्णांक, न: पूर्णांक) -> पूर्णांक { लौटाओ ((व >> न) | (व << (३२-न))) & ४२९४९६७२९५; }
    सार्वजनिक साझा फलन शा२५६(पाठ्यांश: पाठ) -> पाठ {
        स्थिर मूल: बाइटबफ़र=पाठ्य.यूटीएफ८(पाठ्यांश); स्थिर आकार: पूर्णांक=((मूल.आकार+९+६३)/६४)*६४;
        स्थिर ब: बाइटबफ़र=नया बाइटबफ़र(आकार); मान क: पूर्णांक=०;
        जबतक (क < मूल.आकार) { ब[क]=मूल[क]; क=क+१; } ब[मूल.आकार]=परिवर्तित<बाइट>(१२८);
        मान न: पूर्णांक=मूल.आकार*८; क=०; जबतक (क < ८) { ब[आकार-१-क]=परिवर्तित<बाइट>(न & २५५); न=न >> ८; क=क+१; }
        स्थिर ह: पूर्णांक[]=नया पूर्णांक[]{१७७९०३३७०३,३१४४१३४२७७,१०१३९०४२४२,२७७३४८०७६२,१३५९८९३११९,२६००८२२९२४,५२८७३४६३५,१५४१४५९२२५};
        स्थिर ट: पूर्णांक[]=नया पूर्णांक[]{
            १११६३५२४०८,१८९९४४७४४१,३०४९३२३४७१,३९२१००९५७३,९६१९८७१६३,१५०८९७०९९३,२४५३६३५७४८,२८७०७६३२२१,
            ३६२४३८१०८०,३१०५९८४०१,६०७२२५२७८,१४२६८८१९८७,१९२५०७८३८८,२१६२०७८२०६,२६१४८८८१०३,३२४८२२२५८०,
            ३८३५३९०४०१,४०२२२२४७७४,२६४३४७०७८,६०४८०७६२८,७७०२५५९८३,१२४९१५०१२२,१५५५०८१६९२,१९९६०६४९८६,
            २५५४२२०८८२,२८२१८३४३४९,२९५२९९६८०८,३२१०३१३६७१,३३३६५७१८९१,३५८४५२८७११,११३९२६९९३,३३८२४१८९५,
            ६६६३०७२०५,७७३५२९९१२,१२९४७५७३७२,१३९६१८२२९१,१६९५१८३७००,१९८६६६१०५१,२१७७०२६३५०,२४५६९५६०३७,
            २७३०४८५९२१,२८२०३०२४११,३२५९७३०८००,३३४५७६४७७१,३५१६०६५८१७,३६००३५२८०४,४०९४५७१९०९,२७५४२३३४४,
            ४३०२२७७३४,५०६९४८६१६,६५९०६०५५६,८८३९९७८७७,९५८१३९५७१,१३२२८२२२१८,१५३७००२०६३,१७४७८७३७७९,
            १९५५५६२२२२,२०२४१०४८१५,२२२७७३०४५२,२३६१८५२४२४,२४२८४३६४७४,२७५६७३४१८७,३२०४०३१४७९,३३२९३२५२९८};
        स्थिर व: पूर्णांक[]=नया पूर्णांक[६४]; मान खंड: पूर्णांक=०;
        जबतक (खंड < आकार) {
            क=०; जबतक (क < १६) { व[क]=(परिवर्तित<पूर्णांक>(ब[खंड+क*४]) << २४) | (परिवर्तित<पूर्णांक>(ब[खंड+क*४+१]) << १६) | (परिवर्तित<पूर्णांक>(ब[खंड+क*४+२]) << ८) | परिवर्तित<पूर्णांक>(ब[खंड+क*४+३]); क=क+१; }
            जबतक (क < ६४) { स्थिर अ: पूर्णांक=व[क-१५]; स्थिर य: पूर्णांक=व[क-२]; स्थिर स०: पूर्णांक=डेटाचेकसम.घुमाओ(अ,७)^डेटाचेकसम.घुमाओ(अ,१८)^(अ >> ३); स्थिर स१: पूर्णांक=डेटाचेकसम.घुमाओ(य,१७)^डेटाचेकसम.घुमाओ(य,१९)^(य >> १०); व[क]=(व[क-१६]+स०+व[क-७]+स१)&४२९४९६७२९५; क=क+१; }
            मान अ: पूर्णांक=ह[०]; मान आ: पूर्णांक=ह[१]; मान इ: पूर्णांक=ह[२]; मान ई: पूर्णांक=ह[३]; मान उ: पूर्णांक=ह[४]; मान ऊ: पूर्णांक=ह[५]; मान ए: पूर्णांक=ह[६]; मान ऐ: पूर्णांक=ह[७];
            क=०; जबतक (क < ६४) {
                स्थिर स१: पूर्णांक=डेटाचेकसम.घुमाओ(उ,६)^डेटाचेकसम.घुमाओ(उ,११)^डेटाचेकसम.घुमाओ(उ,२५);
                स्थिर चुन: पूर्णांक=(उ & ऊ)^((~उ)&ए); स्थिर त१: पूर्णांक=(ऐ+स१+चुन+ट[क]+व[क])&४२९४९६७२९५;
                स्थिर स०: पूर्णांक=डेटाचेकसम.घुमाओ(अ,२)^डेटाचेकसम.घुमाओ(अ,१३)^डेटाचेकसम.घुमाओ(अ,२२); स्थिर बहु: पूर्णांक=(अ&आ)^(अ&इ)^(आ&इ); स्थिर त२: पूर्णांक=(स०+बहु)&४२९४९६७२९५;
                ऐ=ए; ए=ऊ; ऊ=उ; उ=(ई+त१)&४२९४९६७२९५; ई=इ; इ=आ; आ=अ; अ=(त१+त२)&४२९४९६७२९५; क=क+१;
            }
            ह[०]=(ह[०]+अ)&४२९४९६७२९५; ह[१]=(ह[१]+आ)&४२९४९६७२९५; ह[२]=(ह[२]+इ)&४२९४९६७२९५; ह[३]=(ह[३]+ई)&४२९४९६७२९५; ह[४]=(ह[४]+उ)&४२९४९६७२९५; ह[५]=(ह[५]+ऊ)&४२९४९६७२९५; ह[६]=(ह[६]+ए)&४२९४९६७२९५; ह[७]=(ह[७]+ऐ)&४२९४९६७२९५; खंड=खंड+६४;
        }
        मान फल: पाठ=""; स्थिर अंक: पाठ="0123456789abcdef"; क=०;
        जबतक (क < ८) { मान प: पूर्णांक=२८; जबतक (प >= ०) { स्थिर अ: पूर्णांक=(ह[क] >> प)&१५; फल=फल+पाठ्य.अंश(अंक,अ,अ+१); प=प-४; } क=क+१; }
        लौटाओ फल;
    }
}
