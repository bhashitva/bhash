संकुल मानक;

// Internal scheduler protocol. Only the dispatcher mutates this graph.
// No foreign callback may invoke these methods or retain managed pointers.
सार्वजनिक वर्ग निरस्तअपवाद विस्तार अपवाद {
    सार्वजनिक मान आंतरिकपहचान: तार्किक=असत्य;
    सार्वजनिक निर्माता() : आधार("कार्य निरस्त किया गया।") {}
}
सार्वजनिक वर्ग समयसीमाअपवाद विस्तार अपवाद {
    सार्वजनिक निर्माता() : आधार("कार्य की समयसीमा समाप्त।") {}
}
सार्वजनिक वर्ग कार्यशून्य {}

सार्वजनिक वर्ग निरस्तीकरणचिह्न {
    निजी मान स्रोत: निरस्तीकरणस्रोत;
    निजी मान ऊपर: निरस्तीकरणचिह्न;
    सार्वजनिक निर्माता() {}
    सार्वजनिक निर्माता(मूल: निरस्तीकरणस्रोत, पूर्व: निरस्तीकरणचिह्न) { स्रोत=मूल; ऊपर = पूर्व; }
    सार्वजनिक फलन निरस्तहै() -> तार्किक {
        मान क: निरस्तीकरणचिह्न = यह;
        जबतक (क != रिक्त) {
            यदि (क.स्रोत != रिक्त && क.स्रोत.अनुरोधहै()) { लौटाओ सत्य; }
            क = क.ऊपर;
        }
        लौटाओ असत्य;
    }
    सार्वजनिक फलन जाँचो() -> शून्य {
        मान क:निरस्तीकरणचिह्न=यह;
        जबतक(क!=रिक्त){यदि(क.स्रोत!=रिक्त && क.स्रोत.समयसमाप्तहै()){फेंको नया समयसीमाअपवाद();}क=क.ऊपर;}
        यदि (यह.निरस्तहै()) { स्थिर दोष:निरस्तअपवाद=नया निरस्तअपवाद(); दोष.आंतरिकपहचान=सत्य; फेंको दोष; }
    }
}
सार्वजनिक वर्ग निरस्तीकरणस्रोत पालन बंदनीय {
    निजी मान अनुरोध: तार्किक = असत्य;
    निजी मान चिह्न: निरस्तीकरणचिह्न;
    निजी मान पूर्वचिह्न: निरस्तीकरणचिह्न;
    निजी मान बंद: तार्किक = असत्य;
    निजी मान समयसीमा: पूर्णांक=-१;
    निजी मान समयसमाप्त: तार्किक=असत्य;
    सार्वजनिक निर्माता() {}
    सार्वजनिक निर्माता(पूर्व: निरस्तीकरणचिह्न) { पूर्वचिह्न=पूर्व; }
    सार्वजनिक निर्माता(मिलीसेकंड:पूर्णांक) {
        यदि(मिलीसेकंड<० || मिलीसेकंड>२१४७४८३६४७){फेंको नया अपवाद("अमान्य समयसीमा।");}
        समयसीमा=कार्यघड़ी.अब()+मिलीसेकंड;
    }
    सार्वजनिक फलन चिह्नलो() -> निरस्तीकरणचिह्न {
        यदि (चिह्न == रिक्त) { चिह्न = नया निरस्तीकरणचिह्न(यह, पूर्वचिह्न); }
        लौटाओ चिह्न;
    }
    सार्वजनिक फलन समयसमाप्तहै()->तार्किक { यदि(!बंद && समयसीमा>=० && कार्यघड़ी.अब()>=समयसीमा){समयसमाप्त=सत्य;अनुरोध=सत्य;}लौटाओ समयसमाप्त; }
    सार्वजनिक फलन अनुरोधहै() -> तार्किक { यदि(यह.समयसमाप्तहै()){लौटाओ सत्य;} लौटाओ अनुरोध; }
    सार्वजनिक फलन निरस्तकरो() -> शून्य {
        यदि (बंद) { फेंको नया अपवाद("निरस्तीकरणस्रोत बंद है।"); }
        यह.अनुरोध = सत्य;
    }
    सार्वजनिक फलन बंदकरो() -> शून्य { बंद = सत्य; }
}

सार्वजनिक वर्ग कार्यआधार {
    सार्वजनिक मान आंतरिकसीमा:कार्यआधार;
    सार्वजनिक मान आंतरिकआवरण:तार्किक=असत्य;
    // 0 pending, 1 succeeded, 2 failed, 3 cancelled.
    सार्वजनिक मान आंतरिकस्थिति: पूर्णांक = ०;
    सार्वजनिक मान आंतरिकगलती: अपवाद;
    सार्वजनिक मान आंतरिकदेखा: तार्किक = असत्य;
    सार्वजनिक मान आंतरिककतार: तार्किक = असत्य;
    सार्वजनिक मान आंतरिकआरम्भ: तार्किक = असत्य;
    सार्वजनिक मान आंतरिकगिना: तार्किक = असत्य;
    सार्वजनिक मान आंतरिकसमापन: तार्किक = असत्य;
    सार्वजनिक मान आंतरिकशरीरस्थिति: पूर्णांक = १;
    सार्वजनिक मान आंतरिकमालिक: कार्यआधार;
    सार्वजनिक मान आंतरिकपर्यवेक्षक:कार्यआधार;
    सार्वजनिक मान आंतरिकनिर्भरता:कार्यआधार;
    सार्वजनिक मान आंतरिकबच्चे: सूची<कार्यआधार>;
    सार्वजनिक मान आंतरिकप्रतीक्षक: सूची<कार्यआधार>;
    सार्वजनिक मान आंतरिकचिह्न: निरस्तीकरणस्रोत;
    सार्वजनिक निर्माता() {
        आंतरिकबच्चे = नया सूची<कार्यआधार>();
        आंतरिकप्रतीक्षक = नया सूची<कार्यआधार>();
        आंतरिकचिह्न = नया निरस्तीकरणस्रोत();
    }
    सार्वजनिक फलन आगे() -> शून्य { फेंको नया अपवाद("अमान्य कार्यचरण।"); }
    सार्वजनिक फलन आंतरिकमुक्तकरो()->शून्य {}
    सार्वजनिक फलन समाप्तहै() -> तार्किक { लौटाओ आंतरिकस्थिति != ०; }
    सार्वजनिक फलन आंतरिकनिकालो(क:कार्यआधार)->शून्य {
        मान इ:पूर्णांक=०;जबतक(इ<आंतरिकबच्चे.आकार){यदि(आंतरिकबच्चे[इ]==क){आंतरिकबच्चे.हटाओ(इ);लौटाओ;}इ=इ+१;}
    }
    सार्वजनिक फलन आंतरिकदेखो()->शून्य {
        आंतरिकदेखा=सत्य;
        यदि(आंतरिकपर्यवेक्षक!=रिक्त){आंतरिकपर्यवेक्षक.आंतरिकनिकालो(यह);आंतरिकपर्यवेक्षक=रिक्त;}
    }
    सार्वजनिक फलन आंतरिकसफल() -> शून्य {
        यदि (आंतरिकसमापन || यह.समाप्तहै()) { फेंको नया अपवाद("कार्य पहले समाप्त हो चुका है।"); }
        आंतरिकसमापन = सत्य;
        यह.आंतरिकजोड़ो();
    }
    सार्वजनिक फलन आंतरिकअसफल(गलती: अपवाद) -> शून्य {
        यदि (यह.समाप्तहै()) { लौटाओ; }
        आंतरिकसमापन = सत्य;
        आंतरिकगलती = गलती;
        आंतरिकशरीरस्थिति = २;
        यदि (प्रकारहै<निरस्तअपवाद>(गलती) && परिवर्तित<निरस्तअपवाद>(गलती).आंतरिकपहचान) { आंतरिकशरीरस्थिति = ३; }
        आंतरिकचिह्न.निरस्तकरो();
        यह.आंतरिकजोड़ो();
    }
    सार्वजनिक फलन आंतरिकजोड़ो() -> शून्य {
        यदि (!आंतरिकसमापन || यह.समाप्तहै()) { लौटाओ; }
        मान बाकी: तार्किक = असत्य;
        प्रत्येक (आंतरिकबच्चे में बच्चा: कार्यआधार) {
            यदि (!बच्चा.समाप्तहै()) { बाकी = सत्य; }
            यदि (बच्चा.आंतरिकस्थिति >= २ && !बच्चा.आंतरिकदेखा && आंतरिकगलती == रिक्त) {
                आंतरिकचिह्न.निरस्तकरो();
            }
        }
        यदि (बाकी) { लौटाओ; }
        // Select only after draining: a registered earlier child may finish later.
        प्रत्येक (आंतरिकबच्चे में बच्चा: कार्यआधार) {
            यदि (बच्चा.आंतरिकस्थिति >= २ && !बच्चा.आंतरिकदेखा && आंतरिकगलती == रिक्त) {
                आंतरिकगलती = बच्चा.आंतरिकगलती;
                आंतरिकशरीरस्थिति = बच्चा.आंतरिकस्थिति;
            }
        }
        आंतरिकस्थिति = आंतरिकशरीरस्थिति;
        आंतरिकसीमा=रिक्त;
        आंतरिकनिर्भरता=रिक्त;
        यह.आंतरिकमुक्तकरो();
        कार्यतंत्र.समापनगिनो(यह);
        प्रत्येक(आंतरिकबच्चे में बच्चा:कार्यआधार){बच्चा.आंतरिकपर्यवेक्षक=रिक्त;}
        आंतरिकबच्चे.साफ़();
        प्रत्येक (आंतरिकप्रतीक्षक में अगला: कार्यआधार) { अगला.आंतरिकनिर्भरता=रिक्त; कार्यतंत्र.तैयार(अगला); }
        आंतरिकप्रतीक्षक.साफ़();
        यदि (आंतरिकमालिक != रिक्त) {
            स्थिर मालिक: कार्यआधार = आंतरिकमालिक;
            आंतरिकमालिक = रिक्त;
            यदि(आंतरिकस्थिति==१ || आंतरिकदेखा){मालिक.आंतरिकनिकालो(यह);}
            अन्यथा{आंतरिकपर्यवेक्षक=मालिक;}
            यदि (मालिक.आंतरिकसमापन) { कार्यतंत्र.तैयार(मालिक); }
        }
    }
    सार्वजनिक फलन आंतरिकप्रतीक्षा(अगला: कार्यआधार) -> शून्य {
        यदि (यह == अगला) { फेंको नया अपवाद("कार्य अपनी प्रतीक्षा नहीं कर सकता।"); }
        मान पूर्व:कार्यआधार=अगला.आंतरिकमालिक;
        जबतक(पूर्व!=रिक्त){यदि(पूर्व==यह){फेंको नया अपवाद("कार्य अपने मालिक की प्रतीक्षा नहीं कर सकता।");}पूर्व=पूर्व.आंतरिकमालिक;}
        पूर्व=यह;
        जबतक(पूर्व!=रिक्त){यदि(पूर्व==अगला){फेंको नया अपवाद("कार्य प्रतीक्षा में चक्र है।");}पूर्व=पूर्व.आंतरिकनिर्भरता;}
        यह.आंतरिकदेखो();
        यदि (यह.समाप्तहै()) { कार्यतंत्र.तैयार(अगला); }
        अन्यथा { अगला.आंतरिकनिर्भरता=यह; आंतरिकप्रतीक्षक.जोड़ो(अगला); }
    }
    सार्वजनिक फलन आंतरिकपरिणामजाँचो() -> शून्य {
        यह.आंतरिकदेखो();
        यदि (!यह.समाप्तहै()) { फेंको नया अपवाद("कार्य का परिणाम अभी उपलब्ध नहीं है।"); }
        यदि (आंतरिकगलती != रिक्त) { फेंको आंतरिकगलती; }
    }
}
सार्वजनिक वर्ग कार्यफल<त> विस्तार कार्यआधार {
    सार्वजनिक मान आंतरिकमूल्य: त;
    सार्वजनिक साझा फलन पूरा(मूल्य:त)->कार्यफल<त> {
        स्थिर क:कार्यफल<त> = नया कार्यफल<त>();क.आंतरिकमूल्य=मूल्य;क.आंतरिकसफल();लौटाओ क;
    }
    सार्वजनिक साझा फलन असफल(दोष:अपवाद)->कार्यफल<त> {
        यदि(दोष==रिक्त){फेंको नया अपवाद("असफल कार्य के लिए अपवाद चाहिए।");}
        स्थिर क:कार्यफल<त> = नया कार्यफल<त>();क.आंतरिकअसफल(दोष);लौटाओ क;
    }
    सार्वजनिक फलन आंतरिकमूल्यलो() -> त {
        यह.आंतरिकपरिणामजाँचो();
        लौटाओ आंतरिकमूल्य;
    }
    सार्वजनिक फलन साथप्रतीक्षा(चिह्न:निरस्तीकरणचिह्न)->कार्यफल<त> {
        स्थिर क:प्रतीक्षाकार्य<त> = नया प्रतीक्षाकार्य<त>(यह,चिह्न);कार्यतंत्र.आरम्भ(क);लौटाओ क;
    }
}
सार्वजनिक वर्ग प्रतीक्षाकार्य<त> विस्तार कार्यफल<त> {
    निजी मान मूल:कार्यफल<त>; निजी मान चिह्न:निरस्तीकरणचिह्न; निजी मान रखा:तार्किक=असत्य;
    सार्वजनिक निर्माता(कार्य:कार्यफल<त>,रोक:निरस्तीकरणचिह्न){मूल=कार्य;चिह्न=रोक;}
    सार्वजनिक अधिलेखन फलन आंतरिकमुक्तकरो()->शून्य {मूल=रिक्त;चिह्न=रिक्त;}
    सार्वजनिक अधिलेखन फलन आगे()->शून्य {
        यदि(मूल.समाप्तहै()){यह.आंतरिकमूल्य=मूल.आंतरिकमूल्यलो();मूल=रिक्त;चिह्न=रिक्त;यह.आंतरिकसफल();लौटाओ;}
        चिह्न.जाँचो();यह.आंतरिकचिह्न.चिह्नलो().जाँचो();
        यदि(!रखा){रखा=सत्य;कार्यतंत्र.समयरखो(यह);}
    }
}

सार्वजनिक वर्ग कार्यतंत्र {
    निजी साझा मान कतार: सूची<कार्यआधार>;
    निजी साझा मान वर्तमान: कार्यआधार;
    निजी साझा मान मालिक: कार्यआधार;
    निजी साझा मान आवरण:तार्किक=असत्य;
    निजी साझा मान समयकार्य:सूची<कार्यआधार>;
    निजी साझा मान चलरहा: तार्किक = असत्य;
    निजी साझा मान जीवित: पूर्णांक = ०;
    सार्वजनिक साझा फलन जीवितगिनती() -> पूर्णांक { लौटाओ जीवित; }
    सार्वजनिक साझा फलन मालिकरखो(मूल:कार्यआधार, सुरक्षित:तार्किक)->शून्य { मालिक=मूल; यदि(मालिक==रिक्त){मालिक=वर्तमान;} आवरण=सुरक्षित; }
    सार्वजनिक साझा फलन चिह्नलो()->निरस्तीकरणचिह्न { यदि(मालिक==रिक्त || आवरण){लौटाओ नया निरस्तीकरणचिह्न();}लौटाओ मालिक.आंतरिकचिह्न.चिह्नलो(); }
    सार्वजनिक साझा फलन विश्राम()->शून्य { कार्यघड़ी.विश्राम(); }
    सार्वजनिक साझा फलन समापनगिनो(क:कार्यआधार)->शून्य { यदि(क.आंतरिकगिना){क.आंतरिकगिना=असत्य;जीवित=जीवित-१;} }
    सार्वजनिक साझा फलन समयरखो(क:कार्यआधार)->शून्य { यदि(समयकार्य==रिक्त){समयकार्य=नया सूची<कार्यआधार>();}समयकार्य.जोड़ो(क); }
    सार्वजनिक साझा फलन समयजाँचो()->शून्य {
        यदि(समयकार्य==रिक्त){लौटाओ;} मान इ:पूर्णांक=०;
        जबतक(इ<समयकार्य.आकार){स्थिर क:कार्यआधार=समयकार्य[इ]; प्रयास{यदि(!क.समाप्तहै()){क.आगे();}}पकड़ो(ग:अपवाद){क.आंतरिकअसफल(ग);}
            यदि(क.समाप्तहै()){समयकार्य.हटाओ(इ);}अन्यथा{इ=इ+१;}}
    }
    सार्वजनिक साझा फलन तैयार(क: कार्यआधार) -> शून्य {
        यदि (!क.आंतरिकआरम्भ) { फेंको नया अपवाद("कार्य अभी आरम्भ नहीं हुआ है।"); }
        यदि (कतार == रिक्त) { कतार = नया सूची<कार्यआधार>(); }
        यदि (!क.आंतरिककतार && !क.समाप्तहै()) {
            क.आंतरिककतार = सत्य;
            कतार.जोड़ो(क);
        }
    }
    सार्वजनिक साझा फलन आरम्भ(क: कार्यआधार) -> शून्य {
        कार्यतंत्र.सीमाआरम्भ(क);
        कार्यतंत्र.तैयार(क);
    }
    सार्वजनिक साझा फलन सीमाआरम्भ(क:कार्यआधार)->शून्य {
        यदि (जीवित >= १०५६ || (जीवित >= १०२४ && !आवरण)) { फेंको नया अपवाद("कार्य क्षमता समाप्त।"); }
        यदि (क.आंतरिकआरम्भ || क.समाप्तहै()) {
            फेंको नया अपवाद("कार्य पहले आरम्भ हो चुका है।");
        }
        क.आंतरिकआरम्भ = सत्य;
        क.आंतरिकगिना = सत्य;
        यदि (मालिक != रिक्त) {
            क.आंतरिकमालिक = मालिक;
            यदि(!आवरण){क.आंतरिकचिह्न = नया निरस्तीकरणस्रोत(मालिक.आंतरिकचिह्न.चिह्नलो());}
            मालिक.आंतरिकबच्चे.जोड़ो(क);
        }
        जीवित = जीवित + १;
    }
    // Host calls a bounded turn; this method never pumps recursively or sleeps.
    सार्वजनिक साझा फलन चरण() -> तार्किक {
        यदि (चलरहा) { फेंको नया अपवाद("पुनरावर्ती कार्यप्रेषण उपलब्ध नहीं है।"); }
        कार्यतंत्र.समयजाँचो();
        यदि (कतार == रिक्त || कतार.आकार == ०) { लौटाओ असत्य; }
        स्थिर क: कार्यआधार = कतार[०];
        कतार.हटाओ(०);
        क.आंतरिककतार = असत्य;
        चलरहा = सत्य;
        वर्तमान = क;
        मालिक=क;आवरण=असत्य;
        प्रयास {
            यदि (!क.समाप्तहै()) {
                यदि (क.आंतरिकसमापन) { क.आंतरिकजोड़ो(); }
                अन्यथा { क.आगे(); }
            }
        } पकड़ो (गलती: अपवाद) { क.आंतरिकअसफल(गलती); }
        अंततः { वर्तमान = रिक्त; मालिक=रिक्त;आवरण=असत्य; चलरहा = असत्य; }
        यदि (क.समाप्तहै() && क.आंतरिकगिना) {
            क.आंतरिकगिना = असत्य;
            जीवित = जीवित - १;
        }
        लौटाओ सत्य;
    }
}

सार्वजनिक वर्ग कार्यसीमा विस्तार कार्यफल<कार्यशून्य> {}
// A queued callback creates a lexical group without exposing a completion source.
सार्वजनिक वर्ग समूहकार्य विस्तार कार्यफल<कार्यशून्य> {
    निजी मान काम:फलन()->कार्यफल<कार्यशून्य>;
    निजी मान परिणाम:कार्यफल<कार्यशून्य>;
    निजी मान चरण:पूर्णांक=०;
    सार्वजनिक निर्माता(फ:फलन()->कार्यफल<कार्यशून्य>){काम=फ;}
    सार्वजनिक अधिलेखन फलन आंतरिकमुक्तकरो()->शून्य {काम=रिक्त;परिणाम=रिक्त;}
    सार्वजनिक अधिलेखन फलन आगे()->शून्य {
        यदि(चरण==०){चरण=१;परिणाम=काम();परिणाम.आंतरिकप्रतीक्षा(यह);लौटाओ;}
        परिणाम.आंतरिकपरिणामजाँचो();यह.आंतरिकसफल();
    }
}
सार्वजनिक वर्ग कार्यसमूह {
    निजी निर्माता() {}
    सार्वजनिक साझा फलन चलाओ(काम:फलन()->कार्यफल<कार्यशून्य>)->कार्यफल<कार्यशून्य> {
        स्थिर क:समूहकार्य=नया समूहकार्य(काम);कार्यतंत्र.आरम्भ(क);लौटाओ क;
    }
}
सार्वजनिक अनुबंध असमकालिकबंदनीय { फलन बंदकरो()->कार्यफल<कार्यशून्य>; }
सार्वजनिक वर्ग विलंबकार्य विस्तार कार्यफल<कार्यशून्य> {
    निजी मान समय:पूर्णांक; निजी मान चिह्न:निरस्तीकरणचिह्न; निजी मान रखा:तार्किक=असत्य;
    सार्वजनिक अधिलेखन फलन आंतरिकमुक्तकरो()->शून्य {चिह्न=रिक्त;}
    सार्वजनिक निर्माता(मिलीसेकंड:पूर्णांक, रोक:निरस्तीकरणचिह्न){
        समय=-१;यदि(मिलीसेकंड>=० && मिलीसेकंड<=२१४७४८३६४७){समय=कार्यघड़ी.अब()+मिलीसेकंड;}चिह्न=रोक;
    }
    सार्वजनिक अधिलेखन फलन आगे()->शून्य {
        यदि(समय<०){फेंको नया अपवाद("अमान्य विलंब।");}
        चिह्न.जाँचो();यह.आंतरिकचिह्न.चिह्नलो().जाँचो();
        यदि(कार्यघड़ी.अब()>=समय){यह.आंतरिकसफल();लौटाओ;}
        यदि(!रखा){रखा=सत्य;कार्यतंत्र.समयरखो(यह);}
    }
}
सार्वजनिक वर्ग कार्य {
    सार्वजनिक साझा फलन पूरा()->कार्यफल<कार्यशून्य> {लौटाओ कार्यफल<कार्यशून्य>.पूरा(नया कार्यशून्य());}
    सार्वजनिक साझा फलन वर्तमानचिह्न()->निरस्तीकरणचिह्न { लौटाओ कार्यतंत्र.चिह्नलो(); }
    सार्वजनिक साझा फलन विलंब(मिलीसेकंड:पूर्णांक)->कार्यफल<कार्यशून्य> { लौटाओ कार्य.विलंब(मिलीसेकंड,कार्यतंत्र.चिह्नलो()); }
    सार्वजनिक साझा फलन विलंब(मिलीसेकंड:पूर्णांक,चिह्न:निरस्तीकरणचिह्न)->कार्यफल<कार्यशून्य> {
        स्थिर क:विलंबकार्य=नया विलंबकार्य(मिलीसेकंड,चिह्न);कार्यतंत्र.आरम्भ(क);लौटाओ क;
    }
    सार्वजनिक साझा फलन छोड़ो()->कार्यफल<कार्यशून्य> { लौटाओ कार्य.विलंब(०); }
}
