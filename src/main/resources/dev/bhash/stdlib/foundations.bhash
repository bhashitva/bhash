संकुल मानक;

सार्वजनिक अनुबंध बंदनीय { फलन बंदकरो() -> शून्य; }

सार्वजनिक वर्ग पाठस्वरूप {
    निजी निर्माता() {}

    सार्वजनिक साझा फलन बनाओ(साँचा: पाठ, मानक: सूची<सर्ववस्तु>) -> पाठ {
        यदि (मानक == रिक्त) { फेंको नया अपवाद("स्वरूपण के लिए मानों की सूची दें।"); }
        यदि (पाठ्य.लंबाई(साँचा) > ६५५३६) { फेंको नया अपवाद("स्वरूपण का साँचा बहुत लंबा है।"); }
        // Delimiters are ASCII, so scanning UTF-8 bytes preserves literal boundaries.
        स्थिर बाइटें: बाइटबफ़र = पाठ्य.यूटीएफ८(साँचा);
        स्थिर आकार: पूर्णांक = बाइटें.आकार;
        स्थिर भाग: सूची<पाठ> = नया सूची<पाठ>();
        स्थिर खोल: पूर्णांक = १२३;
        स्थिर बंद: पूर्णांक = १२५;
        मान कुल: पूर्णांक = ०;
        मान आरंभ: पूर्णांक = ०;
        मान स्थान: पूर्णांक = ०;
        जबतक (स्थान < आकार) {
            स्थिर चिह्न: पूर्णांक = परिवर्तित<पूर्णांक>(बाइटें[स्थान]);
            यदि (चिह्न != खोल && चिह्न != बंद) { स्थान = स्थान + १; जारी; }

            यदि (आरंभ < स्थान) {
                कुल = पाठस्वरूप.भागरखो(भाग, पाठ्य.यूटीएफ८पाठ(बाइटें.काटो(आरंभ, स्थान)), कुल);
            }
            यदि (स्थान + १ < आकार && बाइटें[स्थान + १] == चिह्न) {
                कुल = पाठस्वरूप.भागरखो(भाग, पाठ्य.यूटीएफ८पाठ(बाइटें.काटो(स्थान, स्थान + १)), कुल);
                स्थान = स्थान + २;
            } अन्यथा {
                यदि (चिह्न == बंद) { फेंको नया अपवाद("स्वरूपण के साँचे में अकेला } है।"); }
                मान अंत: पूर्णांक = स्थान + १;
                जबतक (अंत < आकार && अंत - स्थान <= ६५ && बाइटें[अंत] != खोल && बाइटें[अंत] != बंद) {
                    अंत = अंत + १;
                }
                यदि (अंत >= आकार || अंत - स्थान > ६५ || बाइटें[अंत] != बंद) {
                    फेंको नया अपवाद("स्वरूपण का स्थानचिह्न अधूरा या अमान्य है।");
                }
                स्थिर निर्देश: पाठ = पाठ्य.यूटीएफ८पाठ(बाइटें.काटो(स्थान + १, अंत));
                कुल = पाठस्वरूप.भागरखो(भाग, पाठस्वरूप.स्थानचिह्न(निर्देश, मानक), कुल);
                स्थान = अंत + १;
            }
            आरंभ = स्थान;
        }
        यदि (आरंभ < आकार) {
            पाठस्वरूप.भागरखो(भाग, पाठ्य.यूटीएफ८पाठ(बाइटें.काटो(आरंभ, आकार)), कुल);
        }
        लौटाओ पाठ्य.जोड़ो(भाग, "");
    }

    निजी साझा फलन भागरखो(भाग: सूची<पाठ>, अंश: पाठ, कुल: पूर्णांक) -> पूर्णांक {
        स्थिर नया_कुल: पूर्णांक = कुल + पाठ्य.लंबाई(अंश);
        यदि (नया_कुल > १०४८५७६) { फेंको नया अपवाद("स्वरूपित पाठ की सीमा पार हो गई।"); }
        भाग.जोड़ो(अंश);
        लौटाओ नया_कुल;
    }

    निजी साझा फलन स्थानचिह्न(निर्देश: पाठ, मानक: सूची<सर्ववस्तु>) -> पाठ {
        स्थिर खंड: सूची<पाठ> = पाठ्य.बाँटो(निर्देश, ":");
        स्थिर स्थिति: सूची<पाठ> = पाठ्य.बाँटो(खंड[०], ",");
        यदि (खंड.आकार > २ || स्थिति.आकार > २) { फेंको नया अपवाद("स्वरूपण का स्थानचिह्न अमान्य है।"); }
        स्थिर क्रम: पूर्णांक = पाठस्वरूप.संख्या(स्थिति[०], असत्य);
        यदि (क्रम >= मानक.आकार) { फेंको नया अपवाद("स्वरूपण का सूचकांक मानों की सूची से बाहर है।"); }

        मान चौड़ाई: पूर्णांक = ०;
        यदि (स्थिति.आकार == २) {
            चौड़ाई = पाठस्वरूप.संख्या(स्थिति[१], सत्य);
            यदि (चौड़ाई < -४०९६ || चौड़ाई > ४०९६) {
                फेंको नया अपवाद("स्वरूपण की चौड़ाई -४०९६ से ४०९६ तक होनी चाहिए।");
            }
        }

        मान स्थान: पूर्णांक = -१;
        यदि (खंड.आकार == २) {
            स्थिर रूप: पाठ = खंड[१];
            यदि (!पाठ्य.आरंभ(रूप, "F") && !पाठ्य.आरंभ(रूप, "f")) {
                फेंको नया अपवाद("संख्यात्मक स्वरूपण के लिए F और दशमलव स्थान दें।");
            }
            स्थान = पाठस्वरूप.संख्या(पाठ्य.अंश(रूप, १, पाठ्य.लंबाई(रूप)), असत्य);
            यदि (स्थान > १५) { फेंको नया अपवाद("स्वरूपण के दशमलव स्थान ० से १५ तक होने चाहिए।"); }
        }

        स्थिर पाठ्यांश: पाठ = पाठस्वरूप.मूल्यपाठ(मानक[क्रम], स्थान);
        स्थिर भराव: पूर्णांक = गणित.निरपेक्ष(चौड़ाई) - पाठ्य.लंबाई(पाठ्यांश);
        यदि (भराव <= ०) { लौटाओ पाठ्यांश; }
        स्थिर रिक्तस्थान: पाठ = पाठ्य.दोहराओ(" ", भराव);
        यदि (चौड़ाई < ०) { लौटाओ पाठ्यांश + रिक्तस्थान; }
        लौटाओ रिक्तस्थान + पाठ्यांश;
    }

    निजी साझा फलन संख्या(पाठ्यांश: पाठ, चिह्नित: तार्किक) -> पूर्णांक {
        यदि (!चिह्नित && (पाठ्य.आरंभ(पाठ्यांश, "-") || पाठ्य.आरंभ(पाठ्यांश, "+"))) {
            फेंको नया अपवाद("स्वरूपण में बिना चिह्न की संख्या अपेक्षित है।");
        }
        प्रयास { लौटाओ पूर्णांकपाठ(पाठ्यांश); }
        पकड़ो (दोष: अपवाद) { फेंको नया अपवाद("स्वरूपण के स्थानचिह्न में अमान्य संख्या है।"); }
    }

    निजी साझा फलन मूल्यपाठ(व: सर्ववस्तु, स्थान: पूर्णांक) -> पाठ {
        यदि (प्रकारहै<दशमलव>(व)) {
            स्थिर संख्या: दशमलव = परिवर्तित<दशमलव>(व);
            यदि (स्थान >= ०) { लौटाओ पाठ्य.संख्यापाठ(संख्या, स्थान); }
            लौटाओ परिवर्तित<पाठ>(संख्या);
        }
        यदि (प्रकारहै<पूर्णांक>(व)) { लौटाओ पाठस्वरूप.पूर्णांकस्वरूप(परिवर्तित<पूर्णांक>(व), स्थान); }
        यदि (प्रकारहै<लघुपूर्णांक>(व)) { लौटाओ पाठस्वरूप.पूर्णांकस्वरूप(परिवर्तित<पूर्णांक>(परिवर्तित<लघुपूर्णांक>(व)), स्थान); }
        यदि (प्रकारहै<बाइट>(व)) { लौटाओ पाठस्वरूप.पूर्णांकस्वरूप(परिवर्तित<पूर्णांक>(परिवर्तित<बाइट>(व)), स्थान); }
        यदि (स्थान >= ०) { फेंको नया अपवाद("दशमलव स्थान के लिए संख्यात्मक मान आवश्यक है।"); }
        यदि (व == रिक्त) { लौटाओ "रिक्त"; }
        यदि (प्रकारहै<पाठ>(व)) { लौटाओ परिवर्तित<पाठ>(व); }
        यदि (प्रकारहै<तार्किक>(व)) { लौटाओ परिवर्तित<पाठ>(परिवर्तित<तार्किक>(व)); }
        फेंको नया अपवाद("स्वरूपण के लिए पाठ, संख्या, तार्किक या रिक्त मान दें।");
    }

    निजी साझा फलन पूर्णांकस्वरूप(व: पूर्णांक, स्थान: पूर्णांक) -> पाठ {
        स्थिर अंक: पाठ = अंकपाठ(व);
        यदि (स्थान <= ०) { लौटाओ अंक; }
        लौटाओ अंक + "." + पाठ्य.दोहराओ("0", स्थान);
    }
}
सार्वजनिक अनुबंध तुलनाकार<त> { फलन तुलना(क: त, ख: त) -> पूर्णांक; }
सार्वजनिक अनुबंध चयनक<त> { फलन चुनो(मानक: त) -> तार्किक; }
सार्वजनिक अनुबंध रूपांतरक<क, ख> { फलन बदलो(मानक: क) -> ख; }
सार्वजनिक अनुबंध संचायक<क, ख> { फलन जोड़ो(संचय: ख, मानक: क) -> ख; }

सार्वजनिक वर्ग संग्रह<त> {
    सार्वजनिक साझा फलन प्रतिलिपि(मूल: सूची<त>) -> सूची<त> {
        स्थिर फल: सूची<त> = नया सूची<त>();
        प्रत्येक (मूल में व: त) { फल.जोड़ो(व); }
        लौटाओ फल;
    }
    सार्वजनिक साझा फलन उलटो(मूल: सूची<त>) -> सूची<त> {
        स्थिर फल: सूची<त> = नया सूची<त>(); मान ग: पूर्णांक = मूल.आकार;
        जबतक (ग > ०) { ग = ग - १; फल.जोड़ो(मूल[ग]); } लौटाओ फल;
    }
    सार्वजनिक साझा फलन छाँटो(मूल: सूची<त>, नियम: चयनक<त>) -> सूची<त> {
        स्थिर फल: सूची<त> = नया सूची<त>();
        प्रत्येक (मूल में व: त) { यदि (नियम.चुनो(व)) { फल.जोड़ो(व); } }
        लौटाओ फल;
    }
    सार्वजनिक साझा फलन कोई(मूल: सूची<त>, नियम: चयनक<त>) -> तार्किक {
        प्रत्येक (मूल में व: त) { यदि (नियम.चुनो(व)) { लौटाओ सत्य; } } लौटाओ असत्य;
    }
    सार्वजनिक साझा फलन सभी(मूल: सूची<त>, नियम: चयनक<त>) -> तार्किक {
        प्रत्येक (मूल में व: त) { यदि (!नियम.चुनो(व)) { लौटाओ असत्य; } } लौटाओ सत्य;
    }
    सार्वजनिक साझा फलन खोजो(मूल: सूची<त>, नियम: चयनक<त>) -> पूर्णांक {
        मान ग: पूर्णांक = ०;
        प्रत्येक (मूल में व: त) { यदि (नियम.चुनो(व)) { लौटाओ ग; } ग = ग + १; } लौटाओ -१;
    }
    सार्वजनिक साझा फलन गिनो(मूल: सूची<त>, नियम: चयनक<त>) -> पूर्णांक {
        मान फल: पूर्णांक = ०; प्रत्येक (मूल में व: त) { यदि (नियम.चुनो(व)) { फल = फल + १; } } लौटाओ फल;
    }
    सार्वजनिक साझा फलन द्विआधारीखोज(मूल: सूची<त>, मानक: त, नियम: तुलनाकार<त>) -> पूर्णांक {
        मान आर: पूर्णांक = ०; मान अंत: पूर्णांक = मूल.आकार;
        जबतक (आर < अंत) {
            स्थिर मध्य: पूर्णांक = आर + (अंत - आर) / २;
            यदि (नियम.तुलना(मूल[मध्य],मानक) < ०) { आर = मध्य + १; } अन्यथा { अंत = मध्य; }
        }
        यदि (आर < मूल.आकार && नियम.तुलना(मूल[आर],मानक) == ०) { लौटाओ आर; } लौटाओ -१;
    }
    // Bottom-up stable merge sort: O(n log n), new list, source unchanged.
    सार्वजनिक साझा फलन क्रमित(मूल: सूची<त>, नियम: तुलनाकार<त>) -> सूची<त> {
        मान फल: सूची<त> = संग्रह<त>.प्रतिलिपि(मूल); मान चौड़ाई: पूर्णांक = १;
        जबतक (चौड़ाई < मूल.आकार) {
            स्थिर अगला: सूची<त> = नया सूची<त>(); मान आर: पूर्णांक = ०;
            जबतक (आर < मूल.आकार) {
                स्थिर मध्य: पूर्णांक = गणित.न्यूनतम(आर + चौड़ाई, मूल.आकार);
                स्थिर अंत: पूर्णांक = गणित.न्यूनतम(मध्य + चौड़ाई, मूल.आकार);
                मान क: पूर्णांक = आर; मान ख: पूर्णांक = मध्य;
                जबतक (क < मध्य || ख < अंत) {
                    यदि (ख >= अंत || (क < मध्य && नियम.तुलना(फल[क], फल[ख]) <= ०)) {
                        अगला.जोड़ो(फल[क]); क = क + १;
                    } अन्यथा { अगला.जोड़ो(फल[ख]); ख = ख + १; }
                }
                आर = अंत;
            }
            फल = अगला; चौड़ाई = चौड़ाई * २;
        }
        लौटाओ फल;
    }
}
सार्वजनिक वर्ग रूपांतरण<क, ख> {
    सार्वजनिक साझा फलन बदलो(मूल: सूची<क>, नियम: रूपांतरक<क, ख>) -> सूची<ख> {
        स्थिर फल: सूची<ख> = नया सूची<ख>();
        प्रत्येक (मूल में व: क) { फल.जोड़ो(नियम.बदलो(व)); } लौटाओ फल;
    }
    सार्वजनिक साझा फलन संचित(मूल: सूची<क>, आरंभ: ख, नियम: संचायक<क, ख>) -> ख {
        मान फल: ख = आरंभ; प्रत्येक (मूल में व: क) { फल = नियम.जोड़ो(फल,व); } लौटाओ फल;
    }
}
सार्वजनिक वर्ग समूहन<क, ख> {
    सार्वजनिक साझा फलन समूहित(मूल: सूची<क>, नियम: रूपांतरक<क, ख>) -> मानचित्र<ख, सूची<क>> {
        स्थिर फल: मानचित्र<ख, सूची<क>> = नया मानचित्र<ख, सूची<क>>();
        प्रत्येक (मूल में व: क) {
            स्थिर कुंजी: ख = नियम.बदलो(व);
            यदि (!फल.है(कुंजी)) { फल[कुंजी] = नया सूची<क>(); } फल[कुंजी].जोड़ो(व);
        } लौटाओ फल;
    }
}
सार्वजनिक वर्ग पूर्णांकक्रम पालन तुलनाकार<पूर्णांक> {
    सार्वजनिक फलन तुलना(क: पूर्णांक, ख: पूर्णांक) -> पूर्णांक {
        यदि (क < ख) { लौटाओ -१; } यदि (क > ख) { लौटाओ १; } लौटाओ ०;
    }
}

सार्वजनिक वर्ग प्रवाह पालन बंदनीय {
    निजी मान पहचान: पूर्णांक = ०;
    निजी मान बंद: तार्किक = असत्य;
    निजी निर्माता(पहचान: पूर्णांक) { यह.पहचान = पहचान; }
    सार्वजनिक साझा फलन पठन(पथ: पाठ) -> प्रवाह { लौटाओ नया प्रवाह(तंत्र.पठनखोलो(पथ)); }
    सार्वजनिक साझा फलन लेखन(पथ: पाठ) -> प्रवाह { लौटाओ नया प्रवाह(तंत्र.लेखनखोलो(पथ)); }
    निजी फलन जाँचो() -> शून्य { यदि (बंद) { फेंको नया अपवाद("प्रवाह बंद है।"); } }
    सार्वजनिक फलन पढ़ो(गिनती: पूर्णांक) -> बाइटबफ़र { यह.जाँचो(); लौटाओ तंत्र.पढ़ो(पहचान, गिनती); }
    सार्वजनिक फलन बाइटलिखो(सामग्री: बाइटबफ़र) -> शून्य { यह.जाँचो(); तंत्र.बाइटलिखो(पहचान, सामग्री); }
    सार्वजनिक फलन पाठलिखो(पाठ्यांश: पाठ) -> शून्य { यह.बाइटलिखो(पाठ्य.यूटीएफ८(पाठ्यांश)); }
    सार्वजनिक फलन भेजो() -> शून्य { यह.जाँचो(); तंत्र.भेजो(पहचान); }
    सार्वजनिक फलन बंदकरो() -> शून्य {
        यदि (!बंद) { बंद = सत्य; तंत्र.बंदकरो(पहचान); }
    }
}

सार्वजनिक वर्ग पथ {
    सार्वजनिक साझा फलन सामान्य(मानक: पाठ) -> पाठ {
        यदि (पाठ्य.लंबाई(मानक) == ० || पाठ्य.है(मानक, "\u0000")) { फेंको नया अपवाद("अमान्य फ़ाइल पथ।"); }
        यदि (पाठ्य.आरंभ(मानक, "//") || पाठ्य.है(मानक, "\\")) { फेंको नया अपवाद("पोर्टेबल पथ में / का उपयोग करें; UNC पथ समर्थित नहीं है।"); }
        // Portable lexical paths use '/' on every platform; no filesystem access.
        स्थिर भाग: सूची<पाठ> = पाठ्य.बाँटो(मानक, "/"); स्थिर फल: सूची<पाठ> = नया सूची<पाठ>();
        प्रत्येक (भाग में अ: पाठ) { यदि (अ != "" && अ != ".") { फल.जोड़ो(अ); } }
        स्थिर जुड़ा: पाठ = पाठ्य.जोड़ो(फल, "/");
        यदि (पाठ्य.आरंभ(मानक, "/")) { लौटाओ "/" + जुड़ा; }
        यदि (पाठ्य.अंत(जुड़ा, ":") && पाठ्य.अंत(मानक, "/")) { लौटाओ जुड़ा + "/"; }
        यदि (जुड़ा == "") { लौटाओ "."; } लौटाओ जुड़ा;
    }
    सार्वजनिक साझा फलन जोड़ो(मूलपथ: पाठ, नाम: पाठ) -> पाठ {
        यदि (पाठ्य.आरंभ(नाम, "/") || पाठ्य.है(नाम, ":")) { फेंको नया अपवाद("सापेक्ष पथ अपेक्षित है।"); }
        स्थिर मूल: पाठ = पथ.सामान्य(मूलपथ);
        यदि (पाठ्य.अंत(मूल, "/")) { लौटाओ पथ.सामान्य(मूल + नाम); }
        लौटाओ पथ.सामान्य(मूल + "/" + नाम);
    }
    सार्वजनिक साझा फलन नाम(मानक: पाठ) -> पाठ {
        स्थिर भाग: सूची<पाठ> = पाठ्य.बाँटो(पथ.सामान्य(मानक), "/"); लौटाओ भाग[भाग.आकार - १];
    }
    सार्वजनिक साझा फलन जनक(मानक: पाठ) -> पाठ {
        स्थिर सामान्य: पाठ = पथ.सामान्य(मानक); स्थिर भाग: सूची<पाठ> = पाठ्य.बाँटो(सामान्य, "/");
        यदि (भाग.आकार == १) { लौटाओ "."; }
        भाग.हटाओ(भाग.आकार - १); स्थिर फल: पाठ = पाठ्य.जोड़ो(भाग, "/");
        यदि (फल == "") { लौटाओ "/"; } यदि (पाठ्य.अंत(फल, ":")) { लौटाओ फल + "/"; } लौटाओ फल;
    }
}
सार्वजनिक वर्ग निर्देशिका {
    सार्वजनिक साझा फलन है(पथ: पाठ) -> तार्किक { लौटाओ तंत्र.निर्देशिकाहै(पथ); }
    सार्वजनिक साझा फलन बनाओ(पथ: पाठ) -> शून्य { तंत्र.निर्देशिकाबनाओ(पथ); }
    सार्वजनिक साझा फलन नाम(पथ: पाठ) -> सूची<पाठ> { लौटाओ तंत्र.नाम(पथ); }
    सार्वजनिक साझा फलन हटाओ(पथ: पाठ) -> शून्य { तंत्र.निर्देशिकाहटाओ(पथ); }
    सार्वजनिक साझा फलन फ़ाइलहटाओ(पथ: पाठ) -> शून्य { तंत्र.फ़ाइलहटाओ(पथ); }
}

सार्वजनिक वर्ग विन्यास {
    निजी मान मानक: मानचित्र<पाठ, पाठ>;
    सार्वजनिक निर्माता() { यह.मानक = नया मानचित्र<पाठ, पाठ>(); }
    सार्वजनिक फलन रखो(नाम: पाठ, मानक: पाठ) -> शून्य { यह.मानक[नाम] = मानक; }
    सार्वजनिक फलन पढ़ो(नाम: पाठ, वैकल्पिक: पाठ) -> पाठ {
        यदि (मानक.है(नाम)) { लौटाओ मानक[नाम]; } लौटाओ वैकल्पिक;
    }
    सार्वजनिक साझा फलन परिवेश(नाम: पाठ, वैकल्पिक: पाठ) -> पाठ { लौटाओ तंत्र.परिवेश(नाम, वैकल्पिक); }
    सार्वजनिक साझा फलन तर्क() -> विन्यास { लौटाओ विन्यास.तर्कपढ़ो(तंत्र.तर्क()); }
    सार्वजनिक साझा फलन जेसनपढ़ो(पाठ्यांश: पाठ) -> विन्यास {
        स्थिर वस्तु: मानचित्र<पाठ, सर्ववस्तु> = परिवर्तित<मानचित्र<पाठ, सर्ववस्तु>>(जेसन.पढ़ो(पाठ्यांश));
        स्थिर फल: विन्यास = नया विन्यास();
        प्रत्येक (वस्तु में नाम: पाठ, व: सर्ववस्तु) { फल.रखो(नाम, परिवर्तित<पाठ>(व)); } लौटाओ फल;
    }
    सार्वजनिक साझा फलन तर्कपढ़ो(तर्क: सूची<पाठ>) -> विन्यास {
        स्थिर फल: विन्यास = नया विन्यास();
        प्रत्येक (तर्क में अ: पाठ) {
            स्थिर स्थान: पूर्णांक = पाठ्य.खोजो(अ, "=");
            यदि (!पाठ्य.आरंभ(अ,"--") || स्थान <= २) { फेंको नया अपवाद("तर्क --नाम=मान होना चाहिए।"); }
            फल.रखो(पाठ्य.अंश(अ,२,स्थान), पाठ्य.अंश(अ,स्थान+१,पाठ्य.लंबाई(अ)));
        } लौटाओ फल;
    }
}
सार्वजनिक वर्ग लेखा {
    निजी साझा मान सीमा: पूर्णांक = १;
    सार्वजनिक साझा फलन स्तर(मानक: पूर्णांक) -> शून्य {
        यदि (मानक < ० || मानक > ४) { फेंको नया अपवाद("लेखा स्तर ० से ४ होना चाहिए।"); } सीमा = मानक;
    }
    सार्वजनिक साझा फलन घटनालिखो(स्तर: पूर्णांक, संदेश: पाठ, क्षेत्र: मानचित्र<पाठ, सर्ववस्तु>) -> शून्य {
        यदि (स्तर < ० || स्तर > ३) { फेंको नया अपवाद("लेखा घटना स्तर ० से ३ होना चाहिए।"); }
        यदि (स्तर >= सीमा) {
            स्थिर घटना: मानचित्र<पाठ, सर्ववस्तु> = नया मानचित्र<पाठ, सर्ववस्तु>();
            घटना["level"] = स्तर; घटना["message"] = संदेश; घटना["fields"] = क्षेत्र;
            तंत्र.अभिलेखलिखो(जेसन.पाठबनाओ(घटना));
        }
    }
    सार्वजनिक साझा फलन सूचना(संदेश: पाठ) -> शून्य { लेखा.घटनालिखो(१, संदेश, नया मानचित्र<पाठ, सर्ववस्तु>()); }
}
सार्वजनिक वर्ग समुच्चय<त> {
    निजी मान सदस्य: मानचित्र<त, तार्किक>;

    सार्वजनिक निर्माता() { यह.सदस्य = नया मानचित्र<त, तार्किक>(); }

    सार्वजनिक फलन जोड़ो(तत्वमान: त) -> तार्किक {
        यदि (सदस्य.है(तत्वमान)) { लौटाओ असत्य; }
        सदस्य.रखो(तत्वमान, सत्य);
        लौटाओ सत्य;
    }
    सार्वजनिक फलन हटाओ(तत्वमान: त) -> तार्किक { लौटाओ सदस्य.हटाओ(तत्वमान); }
    सार्वजनिक फलन है(तत्वमान: त) -> तार्किक { लौटाओ सदस्य.है(तत्वमान); }
    सार्वजनिक फलन आकार() -> पूर्णांक { लौटाओ सदस्य.आकार; }
    सार्वजनिक फलन खाली() -> तार्किक { लौटाओ सदस्य.खाली(); }
    सार्वजनिक फलन साफ़() -> शून्य { सदस्य.साफ़(); }
    सार्वजनिक फलन तत्व() -> सूची<त> { लौटाओ सदस्य.कुंजियाँ(); }

    सार्वजनिक फलन संघ(दूसरा: समुच्चय<त>) -> समुच्चय<त> {
        स्थिर फल: समुच्चय<त> = नया समुच्चय<त>();
        प्रत्येक (सदस्य में अ: त) { फल.सदस्य.रखो(अ, सत्य); }
        प्रत्येक (दूसरा.सदस्य में अ: त) { फल.सदस्य.रखो(अ, सत्य); }
        लौटाओ फल;
    }
    सार्वजनिक फलन प्रतिच्छेद(दूसरा: समुच्चय<त>) -> समुच्चय<त> {
        स्थिर अन्य: मानचित्र<त, तार्किक> = दूसरा.सदस्य;
        स्थिर फल: समुच्चय<त> = नया समुच्चय<त>();
        प्रत्येक (सदस्य में अ: त) {
            यदि (अन्य.है(अ)) { फल.सदस्य.रखो(अ, सत्य); }
        }
        लौटाओ फल;
    }
    सार्वजनिक फलन अंतर(दूसरा: समुच्चय<त>) -> समुच्चय<त> {
        स्थिर अन्य: मानचित्र<त, तार्किक> = दूसरा.सदस्य;
        स्थिर फल: समुच्चय<त> = नया समुच्चय<त>();
        प्रत्येक (सदस्य में अ: त) {
            यदि (!अन्य.है(अ)) { फल.सदस्य.रखो(अ, सत्य); }
        }
        लौटाओ फल;
    }
}
सार्वजनिक वर्ग परीक्षण {
    सार्वजनिक साझा फलन सत्यहै(मानक: तार्किक, संदेश: पाठ) -> शून्य {
        यदि (!मानक) { फेंको नया अपवाद("परीक्षण विफल: " + संदेश); }
    }
    सार्वजनिक साझा फलन बराबर(अपेक्षित: पूर्णांक, मिला: पूर्णांक) -> शून्य { परीक्षण.सत्यहै(अपेक्षित == मिला,"पूर्णांक बराबर नहीं हैं।"); }
    सार्वजनिक साझा फलन बराबर(अपेक्षित: पाठ, मिला: पाठ) -> शून्य { परीक्षण.सत्यहै(अपेक्षित == मिला,"पाठ बराबर नहीं हैं।"); }
    सार्वजनिक साझा फलन बराबर(अपेक्षित: तार्किक, मिला: तार्किक) -> शून्य { परीक्षण.सत्यहै(अपेक्षित == मिला,"तार्किक मान बराबर नहीं हैं।"); }
}
