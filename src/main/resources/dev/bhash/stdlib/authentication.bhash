संकुल मानक;

// All policy is shared Bhash source. Only password KDF, CSPRNG, fixed-time
// comparison and a monotonic clock cross the platform boundary.
सार्वजनिक अनुबंध सत्रघड़ी { फलन अब() -> पूर्णांक; }
सार्वजनिक वर्ग वास्तविकसत्रघड़ी पालन सत्रघड़ी {
    सार्वजनिक फलन अब() -> पूर्णांक { लौटाओ सुरक्षाघड़ी.मिलीसेकंड(); }
}
सार्वजनिक वर्ग कुकी {
    सार्वजनिक साझा फलन शीर्षलो(अनुरोध: वेबअनुरोध, नाम: पाठ) -> सूची<पाठ> {
        स्थिर फल: सूची<पाठ> = नया सूची<पाठ>(); मान क: पूर्णांक = ०;
        यदि (अनुरोध.शीर्ष.आकार % २ != ०) { फेंको नया वेबत्रुटि(४००,"अमान्य HTTP शीर्ष।"); }
        जबतक (क < अनुरोध.शीर्ष.आकार) {
            यदि (पाठ्य.छोटाअक्षर(अनुरोध.शीर्ष[क]) == नाम) { फल.जोड़ो(अनुरोध.शीर्ष[क+१]); } क = क+२;
        } लौटाओ फल;
    }
    सार्वजनिक साझा फलन नामजाँचो(नाम: पाठ) -> शून्य {
        यदि (नाम == "" || पाठ्य.लंबाई(नाम)>१२८) { फेंको नया अपवाद("अमान्य कुकी।"); }
        स्थिर अक्षर: पाठ = "!#$%&'*+-.^_`|~0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
        मान क: पूर्णांक = ०; जबतक (क < पाठ्य.लंबाई(नाम)) { यदि (!पाठ्य.है(अक्षर,पाठ्य.अंश(नाम,क,क+१))) { फेंको नया अपवाद("अमान्य कुकी।"); } क = क+१; }
    }
    सार्वजनिक साझा फलन मानजाँचो(मानक: पाठ) -> शून्य {
        स्थिर ब: बाइटबफ़र = पाठ्य.यूटीएफ८(मानक);
        यदि (ब.आकार>४०९६) { फेंको नया अपवाद("अमान्य कुकी।"); }
        प्रत्येक (ब में व: बाइट) { स्थिर अ: पूर्णांक = परिवर्तित<पूर्णांक>(व);
            यदि (अ<३३ || अ>१२६ || अ==३४ || अ==४४ || अ==५९ || अ==९२) { फेंको नया अपवाद("अमान्य कुकी।"); }
        }
    }
    सार्वजनिक साझा फलन पढ़ो(अनुरोध: वेबअनुरोध, नाम: पाठ) -> पाठ {
        कुकी.नामजाँचो(नाम); मान मिला: तार्किक = असत्य; मान फल: पाठ = ""; मान आकार: पूर्णांक = ०; मान गिनती: पूर्णांक = ०;
        प्रत्येक (कुकी.शीर्षलो(अनुरोध,"cookie") में शीर्ष: पाठ) {
            आकार = आकार+पाठ्य.लंबाई(शीर्ष); यदि (आकार>८१९२) { फेंको नया वेबत्रुटि(४००,"कुकी सीमा पार हो गई।"); }
            प्रत्येक (पाठ्य.बाँटो(शीर्ष,";") में युग्म: पाठ) {
                गिनती = गिनती+१; यदि (गिनती>६४) { फेंको नया वेबत्रुटि(४००,"कुकी सीमा पार हो गई।"); }
                स्थिर प: पाठ = पाठ्य.छाँटो(युग्म); स्थिर अ: पूर्णांक = पाठ्य.खोजो(प,"=");
                यदि (अ<१) { फेंको नया वेबत्रुटि(४००,"अमान्य कुकी।"); }
                स्थिर न: पाठ = पाठ्य.अंश(प,०,अ); मान व: पाठ = पाठ्य.अंश(प,अ+१,पाठ्य.लंबाई(प));
                यदि (पाठ्य.लंबाई(व)>=२ && पाठ्य.आरंभ(व,"\"") && पाठ्य.अंत(व,"\"")) { व = पाठ्य.अंश(व,१,पाठ्य.लंबाई(व)-१); }
                प्रयास { कुकी.नामजाँचो(न); कुकी.मानजाँचो(व); } पकड़ो (ग: अपवाद) { फेंको नया वेबत्रुटि(४००,"अमान्य कुकी।"); }
                यदि (न == नाम) { यदि (मिला) { फेंको नया वेबत्रुटि(४००,"दोहराई गई सत्र कुकी।"); } मिला = सत्य; फल = व; }
            }
        } लौटाओ फल;
    }
    सार्वजनिक साझा फलन सुरक्षितजोड़ो(उत्तर: वेबउत्तर, नाम: पाठ, मानक: पाठ, आयु: पूर्णांक) -> शून्य {
        कुकी.नामजाँचो(नाम); कुकी.मानजाँचो(मानक);
        यदि (आयु < -१ || आयु>२६७८४००) { फेंको नया अपवाद("अमान्य कुकी आयु।"); }
        मान फल: पाठ = नाम+"="+मानक+"; Path=/; Secure; HttpOnly; SameSite=Lax";
        यदि (आयु>=०) { फल = फल+"; Max-Age="+वेब.अंक(आयु); } उत्तर.शीर्षजोड़ो("Set-Cookie",फल);
    }
}
सार्वजनिक वर्ग सत्र {
    निजी मान पहचानमान: पाठ; निजी मान उपयोगकर्तामान: पाठ; निजी मान सीएसआरएफमान: पाठ; निजी मान भूमिकाएँ: सूची<पाठ>;
    सार्वजनिक निर्माता(पहचान: पाठ, उपयोगकर्ता: पाठ, सीएसआरएफ: पाठ, भूमिकाएँ: सूची<पाठ>) {
        यदि (पाठ्य.लंबाई(उपयोगकर्ता)>२५६ || भूमिकाएँ.आकार>१६ || (उपयोगकर्ता=="" && भूमिकाएँ.आकार!=०)) { फेंको नया अपवाद("अमान्य सत्र पहचान या भूमिकाएँ।"); }
        पहचानमान = पहचान; उपयोगकर्तामान = उपयोगकर्ता; सीएसआरएफमान = सीएसआरएफ; यह.भूमिकाएँ = नया सूची<पाठ>();
        प्रत्येक (भूमिकाएँ में भूमिका: पाठ) { यदि (भूमिका=="" || पाठ्य.लंबाई(भूमिका)>६४) { फेंको नया अपवाद("अमान्य सत्र पहचान या भूमिकाएँ।"); } यह.भूमिकाएँ.जोड़ो(भूमिका); }
    }
    सार्वजनिक फलन पहचान() -> पाठ { लौटाओ पहचानमान; }
    सार्वजनिक फलन उपयोगकर्ता() -> पाठ { लौटाओ उपयोगकर्तामान; }
    सार्वजनिक फलन सीएसआरएफ() -> पाठ { लौटाओ सीएसआरएफमान; }
    सार्वजनिक फलन भूमिकाहै(भूमिका: पाठ) -> तार्किक { प्रत्येक (भूमिकाएँ में व: पाठ) { यदि (व==भूमिका) { लौटाओ सत्य; } } लौटाओ असत्य; }
}
सार्वजनिक वर्ग सत्रप्रविष्टि {
    सार्वजनिक मान सत्रमान: सत्र; सार्वजनिक मान जन्म: पूर्णांक; सार्वजनिक मान स्पर्श: पूर्णांक;
    सार्वजनिक निर्माता(मानक: सत्र, अब: पूर्णांक) { सत्रमान = मानक; जन्म = अब; स्पर्श = अब; }
}
सार्वजनिक वर्ग सत्रप्रबंधक पालन बंदनीय {
    निजी मान भंडार: मानचित्र<पाठ,सत्रप्रविष्टि>;
    निजी मान मूल: पाठ; निजी मान अधिकार: पाठ; निजी मान सुरक्षित: तार्किक = सत्य; निजी मान कुकीनाम: पाठ = "__Host-bhash-session";
    निजी मान क्षमता: पूर्णांक; निजी मान निष्क्रियसीमा: पूर्णांक; निजी मान पूर्णसीमा: पूर्णांक; निजी मान घड़ी: सत्रघड़ी;
    निजी मान पिछलासमय: पूर्णांक = -१; निजी मान बंद: तार्किक = असत्य;
    सार्वजनिक निर्माता(मूल: पाठ) {
        अधिकार = सत्रप्रबंधक.अधिकारलो(मूल,असत्य); यह.मूल = मूल; भंडार = नया मानचित्र<पाठ,सत्रप्रविष्टि>();
        क्षमता = १०२४; निष्क्रियसीमा = १८०००००; पूर्णसीमा = २८८०००००; घड़ी = नया वास्तविकसत्रघड़ी();
    }
    सार्वजनिक निर्माता(मूल: पाठ, क्षमता: पूर्णांक, निष्क्रियसीमा: पूर्णांक, पूर्णसीमा: पूर्णांक, घड़ी: सत्रघड़ी) {
        अधिकार = सत्रप्रबंधक.अधिकारलो(मूल,असत्य); यह.मूल = मूल; भंडार = नया मानचित्र<पाठ,सत्रप्रविष्टि>();
        यदि (क्षमता<१ || क्षमता>१०००० || निष्क्रियसीमा<१ || पूर्णसीमा<निष्क्रियसीमा || पूर्णसीमा>६०४८००००० || घड़ी==रिक्त) { फेंको नया अपवाद("अमान्य सत्र नीति।"); }
        यह.क्षमता = क्षमता; यह.निष्क्रियसीमा = निष्क्रियसीमा; यह.पूर्णसीमा = पूर्णसीमा; यह.घड़ी = घड़ी;
    }
    निजी साझा फलन अधिकारलो(मूल: पाठ, स्थानीय: तार्किक) -> पाठ {
        स्थिर प: सूची<पाठ> = जालनियम.पता(मूल);
        यदि (प[१]!=मूल || (!स्थानीय && प[४]!="https")) { फेंको नया अपवाद("सत्र के लिए शुद्ध HTTPS मूल दें।"); }
        यदि (स्थानीय && (प[४]!="http" || !(मूल=="http://127.0.0.1" || पाठ्य.आरंभ(मूल,"http://127.0.0.1:") || मूल=="http://localhost" || पाठ्य.आरंभ(मूल,"http://localhost:")))) { फेंको नया अपवाद("स्थानीय सत्र केवल loopback HTTP के लिए है।"); }
        लौटाओ पाठ्य.अंश(मूल,पाठ्य.लंबाई(प[४])+३,पाठ्य.लंबाई(मूल));
    }
    सार्वजनिक साझा फलन स्थानीय(मूल: पाठ) -> सत्रप्रबंधक {
        स्थिर फल: सत्रप्रबंधक = नया सत्रप्रबंधक("https://localhost"); फल.अधिकार = सत्रप्रबंधक.अधिकारलो(मूल,सत्य); फल.मूल = मूल; फल.सुरक्षित = असत्य; फल.कुकीनाम = "bhash-local-session"; लौटाओ फल;
    }
    निजी फलन अब() -> पूर्णांक {
        यदि (बंद) { फेंको नया अपवाद("सत्र प्रबंधक बंद है।"); }
        स्थिर अ: पूर्णांक = घड़ी.अब(); यदि (अ<० || अ<पिछलासमय) { फेंको नया अपवाद("सत्र घड़ी पीछे गई।"); } पिछलासमय = अ; लौटाओ अ;
    }
    निजी फलन जीवित(प: सत्रप्रविष्टि, अ: पूर्णांक) -> तार्किक { लौटाओ अ>=प.जन्म && अ>=प.स्पर्श && अ-प.जन्म<पूर्णसीमा && अ-प.स्पर्श<निष्क्रियसीमा; }
    सार्वजनिक फलन साफकरो() -> शून्य {
        स्थिर अ: पूर्णांक = यह.अब(); प्रत्येक (भंडार.कुंजियाँ() में न: पाठ) { यदि (!यह.जीवित(भंडार[न],अ)) { भंडार.हटाओ(न); } }
    }
    सार्वजनिक फलन आकार() -> पूर्णांक { यह.साफकरो(); लौटाओ भंडार.आकार; }
    सार्वजनिक फलन आरंभ(उपयोगकर्ता: पाठ, भूमिकाएँ: सूची<पाठ>) -> सत्र {
        यह.साफकरो(); यदि (भंडार.आकार>=क्षमता) { फेंको नया वेबत्रुटि(५०३,"सत्र भंडार भर गया।"); }
        मान पहचान: पाठ = सुरक्षा.टोकन(); मान चक्र: पूर्णांक = ०;
        जबतक (भंडार.है(पहचान)) { चक्र = चक्र+१; यदि (चक्र>=४) { फेंको नया अपवाद("सुरक्षा प्रदाता उपलब्ध नहीं है।"); } पहचान = सुरक्षा.टोकन(); }
        स्थिर फल: सत्र = नया सत्र(पहचान,उपयोगकर्ता,सुरक्षा.टोकन(),भूमिकाएँ); भंडार[पहचान] = नया सत्रप्रविष्टि(फल,यह.अब()); लौटाओ फल;
    }
    सार्वजनिक फलन मूलजाँचो(अनुरोध: वेबअनुरोध) -> शून्य {
        स्थिर होस्ट: सूची<पाठ> = कुकी.शीर्षलो(अनुरोध,"host");
        यदि (होस्ट.आकार!=१ || पाठ्य.छोटाअक्षर(होस्ट[०])!=अधिकार) { फेंको नया वेबत्रुटि(४०३,"अनुरोध मूल अस्वीकार है।"); }
        स्थिर मूलशीर्ष: सूची<पाठ> = कुकी.शीर्षलो(अनुरोध,"origin");
        यदि (मूलशीर्ष.आकार>१ || (मूलशीर्ष.आकार==१ && मूलशीर्ष[०]!=मूल)) { फेंको नया वेबत्रुटि(४०३,"अनुरोध मूल अस्वीकार है।"); }
        स्थिर स्थल: सूची<पाठ> = कुकी.शीर्षलो(अनुरोध,"sec-fetch-site");
        यदि (स्थल.आकार>१ || (स्थल.आकार==१ && स्थल[०]=="cross-site" && अनुरोध.विधि!="GET" && अनुरोध.विधि!="HEAD" && अनुरोध.विधि!="OPTIONS")) { फेंको नया वेबत्रुटि(४०३,"अनुरोध मूल अस्वीकार है।"); }
    }
    सार्वजनिक फलन पाओ(अनुरोध: वेबअनुरोध) -> सत्र {
        यह.मूलजाँचो(अनुरोध); स्थिर अ: पूर्णांक = यह.अब(); स्थिर न: पाठ = कुकी.पढ़ो(अनुरोध,कुकीनाम);
        यदि (पाठ्य.लंबाई(न)!=६४ || !भंडार.है(न)) { लौटाओ रिक्त; }
        स्थिर प: सत्रप्रविष्टि = भंडार[न]; यदि (!यह.जीवित(प,अ)) { भंडार.हटाओ(न); लौटाओ रिक्त; } प.स्पर्श = अ; लौटाओ प.सत्रमान;
    }
    सार्वजनिक फलन बदलो(पुराना: सत्र, उपयोगकर्ता: पाठ, भूमिकाएँ: सूची<पाठ>) -> सत्र {
        स्थिर अ: पूर्णांक = यह.अब();
        यदि (पुराना==रिक्त || !भंडार.है(पुराना.पहचान()) || भंडार[पुराना.पहचान()].सत्रमान!=पुराना || !यह.जीवित(भंडार[पुराना.पहचान()],अ)) { फेंको नया वेबत्रुटि(४०१,"सत्र उपलब्ध नहीं है।"); }
        भंडार.हटाओ(पुराना.पहचान()); लौटाओ यह.आरंभ(उपयोगकर्ता,भूमिकाएँ);
    }
    सार्वजनिक फलन हटाओ(मानक: सत्र) -> शून्य { यह.अब(); यदि (मानक!=रिक्त && भंडार.है(मानक.पहचान()) && भंडार[मानक.पहचान()].सत्रमान==मानक) { भंडार.हटाओ(मानक.पहचान()); } }
    सार्वजनिक फलन उपयोगकर्ताहटाओ(उपयोगकर्ता: पाठ) -> शून्य { यह.अब(); प्रत्येक (भंडार.कुंजियाँ() में न: पाठ) { यदि (भंडार[न].सत्रमान.उपयोगकर्ता()==उपयोगकर्ता) { भंडार.हटाओ(न); } } }
    सार्वजनिक फलन कुकीरखो(उत्तर: वेबउत्तर, मानक: सत्र) -> शून्य {
        स्थिर अ: पूर्णांक = यह.अब();
        यदि (मानक==रिक्त || !भंडार.है(मानक.पहचान()) || भंडार[मानक.पहचान()].सत्रमान!=मानक || !यह.जीवित(भंडार[मानक.पहचान()],अ)) { फेंको नया वेबत्रुटि(४०१,"सत्र उपलब्ध नहीं है।"); }
        यदि (सुरक्षित) { कुकी.सुरक्षितजोड़ो(उत्तर,कुकीनाम,मानक.पहचान(),-१); }
        अन्यथा { उत्तर.शीर्षजोड़ो("Set-Cookie",कुकीनाम+"="+मानक.पहचान()+"; Path=/; HttpOnly; SameSite=Lax"); }
        उत्तर.शीर्षरखो("Cache-Control","no-store");
    }
    सार्वजनिक फलन कुकीमिटाओ(उत्तर: वेबउत्तर) -> शून्य {
        यदि (सुरक्षित) { कुकी.सुरक्षितजोड़ो(उत्तर,कुकीनाम,"",०); }
        अन्यथा { उत्तर.शीर्षजोड़ो("Set-Cookie",कुकीनाम+"=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0"); }
        उत्तर.शीर्षरखो("Cache-Control","no-store");
    }
    सार्वजनिक फलन सीएसआरएफजाँचो(अनुरोध: वेबअनुरोध) -> शून्य {
        यह.मूलजाँचो(अनुरोध);
        यदि (अनुरोध.विधि=="GET" || अनुरोध.विधि=="HEAD" || अनुरोध.विधि=="OPTIONS") { लौटाओ; }
        स्थिर मूलशीर्ष: सूची<पाठ> = कुकी.शीर्षलो(अनुरोध,"origin"); स्थिर टोकन: सूची<पाठ> = कुकी.शीर्षलो(अनुरोध,"x-csrf-token");
        यदि (मूलशीर्ष.आकार!=१ || टोकन.आकार!=१ || पाठ्य.लंबाई(टोकन[०])!=६४) { फेंको नया वेबत्रुटि(४०३,"CSRF सुरक्षा जाँच असफल।"); }
        स्थिर मानक: सत्र = यह.पाओ(अनुरोध);
        यदि (मानक==रिक्त || !सुरक्षा.समान(मानक.सीएसआरएफ(),टोकन[०])) { फेंको नया वेबत्रुटि(४०३,"CSRF सुरक्षा जाँच असफल।"); }
    }
    सार्वजनिक फलन अधिकृत(अनुरोध: वेबअनुरोध, भूमिका: पाठ) -> सत्र {
        स्थिर मानक: सत्र = यह.पाओ(अनुरोध);
        यदि (मानक==रिक्त || मानक.उपयोगकर्ता()=="") { फेंको नया वेबत्रुटि(४०१,"प्रवेश आवश्यक है।"); }
        यदि (भूमिका!="" && !मानक.भूमिकाहै(भूमिका)) { फेंको नया वेबत्रुटि(४०३,"अनुमति नहीं है।"); }
        यह.सीएसआरएफजाँचो(अनुरोध); लौटाओ मानक;
    }
    सार्वजनिक फलन समाप्त(अनुरोध: वेबअनुरोध, उत्तर: वेबउत्तर) -> शून्य {
        यदि (अनुरोध.विधि=="GET" || अनुरोध.विधि=="HEAD" || अनुरोध.विधि=="OPTIONS") { फेंको नया वेबत्रुटि(४०५,"सत्र समाप्त करने के लिए असुरक्षित विधि चाहिए।"); }
        यह.सीएसआरएफजाँचो(अनुरोध); यह.हटाओ(यह.पाओ(अनुरोध)); यह.कुकीमिटाओ(उत्तर);
    }
    सार्वजनिक फलन बंदकरो() -> शून्य { बंद = सत्य; भंडार.साफ़(); }
}
सार्वजनिक वर्ग सुरक्षितवेब पालन वेबचालक {
    निजी मान सत्रमान: सत्रप्रबंधक; निजी मान चालक: वेबचालक;
    सार्वजनिक निर्माता(सत्रमान: सत्रप्रबंधक, चालक: वेबचालक) { यह.सत्रमान = सत्रमान; यह.चालक = चालक; }
    सार्वजनिक फलन संभालो(अनुरोध: वेबअनुरोध) -> वेबउत्तर {
        मान फल: वेबउत्तर = रिक्त;
        प्रयास { सत्रमान.सीएसआरएफजाँचो(अनुरोध); फल = चालक.संभालो(अनुरोध); }
        पकड़ो (दोष: वेबत्रुटि) { फल = वेब.त्रुटि(दोष.स्थिति); }
        फल.शीर्षरखो("Cache-Control","no-store"); फल.शीर्षरखो("X-Content-Type-Options","nosniff"); फल.शीर्षरखो("Referrer-Policy","same-origin"); लौटाओ फल;
    }
}
सार्वजनिक वर्ग अधिकृतचालक पालन वेबचालक {
    निजी मान सत्रमान: सत्रप्रबंधक; निजी मान भूमिका: पाठ; निजी मान चालक: वेबचालक;
    सार्वजनिक निर्माता(सत्रमान: सत्रप्रबंधक, भूमिका: पाठ, चालक: वेबचालक) { यह.सत्रमान = सत्रमान; यह.भूमिका = भूमिका; यह.चालक = चालक; }
    सार्वजनिक फलन संभालो(अनुरोध: वेबअनुरोध) -> वेबउत्तर { सत्रमान.अधिकृत(अनुरोध,भूमिका); लौटाओ चालक.संभालो(अनुरोध); }
}
सार्वजनिक वर्ग प्रवेशप्रविष्टि {
    सार्वजनिक मान जन्म: पूर्णांक; सार्वजनिक मान गिनती: पूर्णांक = ०;
    सार्वजनिक निर्माता(अ: पूर्णांक) { जन्म = अ; }
}
सार्वजनिक वर्ग प्रवेशरक्षक पालन बंदनीय {
    निजी मान मानक: मानचित्र<पाठ,प्रवेशप्रविष्टि>; निजी मान घड़ी: सत्रघड़ी;
    निजी मान सीमा: पूर्णांक; निजी मान अवधि: पूर्णांक; निजी मान क्षमता: पूर्णांक; निजी मान पिछला: पूर्णांक = -१; निजी मान बंद: तार्किक = असत्य;
    सार्वजनिक निर्माता() { सीमा = ५; अवधि = ३०००००; क्षमता = १०२४; घड़ी = नया वास्तविकसत्रघड़ी(); मानक = नया मानचित्र<पाठ,प्रवेशप्रविष्टि>(); }
    सार्वजनिक निर्माता(सीमा: पूर्णांक, अवधि: पूर्णांक, क्षमता: पूर्णांक, घड़ी: सत्रघड़ी) {
        मानक = नया मानचित्र<पाठ,प्रवेशप्रविष्टि>();
        यदि (सीमा<१ || सीमा>१०० || अवधि<१ || अवधि>३६००००० || क्षमता<१ || क्षमता>१०००० || घड़ी==रिक्त) { फेंको नया अपवाद("अमान्य प्रवेश सीमा।"); }
        यह.सीमा = सीमा; यह.अवधि = अवधि; यह.क्षमता = क्षमता; यह.घड़ी = घड़ी;
    }
    सार्वजनिक फलन प्रयासकरो(कुंजी: पाठ) -> शून्य {
        यदि (बंद) { फेंको नया अपवाद("प्रवेश रक्षक बंद है।"); } यदि (कुंजी=="" || पाठ्य.लंबाई(कुंजी)>२५६) { फेंको नया वेबत्रुटि(४००,"अमान्य प्रवेश कुंजी।"); }
        स्थिर अ: पूर्णांक = घड़ी.अब(); यदि (अ<० || अ<पिछला) { फेंको नया अपवाद("सत्र घड़ी पीछे गई।"); } पिछला = अ;
        प्रत्येक (मानक.कुंजियाँ() में न: पाठ) { यदि (अ-मानक[न].जन्म>=अवधि) { मानक.हटाओ(न); } }
        यदि (!मानक.है(कुंजी)) { यदि (मानक.आकार>=क्षमता) { फेंको नया वेबत्रुटि(४२९,"प्रवेश प्रयास सीमा पार हो गई।"); } मानक[कुंजी] = नया प्रवेशप्रविष्टि(अ); }
        यदि (मानक[कुंजी].गिनती>=सीमा) { फेंको नया वेबत्रुटि(४२९,"प्रवेश प्रयास सीमा पार हो गई।"); } मानक[कुंजी].गिनती = मानक[कुंजी].गिनती+१;
    }
    सार्वजनिक फलन बंदकरो() -> शून्य { बंद = सत्य; मानक.साफ़(); }
}
