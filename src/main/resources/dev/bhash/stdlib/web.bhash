संकुल मानक;

सार्वजनिक वर्ग वेबत्रुटि विस्तार अपवाद {
    सार्वजनिक मान स्थिति: पूर्णांक;
    सार्वजनिक निर्माता(स्थिति: पूर्णांक, संदेश: पाठ) : आधार(संदेश) { यह.स्थिति = स्थिति; }
}
सार्वजनिक अनुबंध वेबचालक {
    कार्य संभालो(अनुरोध: वेबअनुरोध) -> वेबउत्तर;
}
सार्वजनिक वर्ग वेबअनुरोध {
    सार्वजनिक मान विधि: पाठ;
    सार्वजनिक मान पथ: पाठ;
    सार्वजनिक मान लक्ष्य: पाठ;
    सार्वजनिक मान शीर्ष: सूची<पाठ>;
    सार्वजनिक मान सामग्री: बाइटबफ़र;
    सार्वजनिक मान पथमान: मानचित्र<पाठ,पाठ>;
    सार्वजनिक मान प्रश्न: सूची<पाठ>;
    सार्वजनिक निर्माता(विधि: पाठ, लक्ष्य: पाठ, शीर्ष: सूची<पाठ>, सामग्री: बाइटबफ़र) {
        यह.विधि = विधि; यह.लक्ष्य = लक्ष्य; यह.शीर्ष = शीर्ष; यह.सामग्री = सामग्री;
        पथमान = नया मानचित्र<पाठ,पाठ>(); प्रश्न = नया सूची<पाठ>();
        यदि (!पाठ्य.आरंभ(लक्ष्य,"/") || पाठ्य.है(लक्ष्य,"#") || पाठ्य.लंबाई(लक्ष्य)>४०९६) { फेंको नया वेबत्रुटि(४००,"अमान्य अनुरोध लक्ष्य।"); }
        स्थिर अ: पूर्णांक = पाठ्य.खोजो(लक्ष्य,"?");
        यदि (अ < ०) { पथ = लक्ष्य; } अन्यथा {
            पथ = पाठ्य.अंश(लक्ष्य,०,अ);
            प्रत्येक (युग्म: पाठ में पाठ्य.बाँटो(पाठ्य.अंश(लक्ष्य,अ+१,पाठ्य.लंबाई(लक्ष्य)),"&")) {
                यदि (युग्म != "") {
                    स्थिर स: पूर्णांक = पाठ्य.खोजो(युग्म,"=");
                    यदि (स < ०) { प्रश्न.जोड़ो(वेब.विकूटित(युग्म,सत्य)); प्रश्न.जोड़ो(""); }
                    अन्यथा { प्रश्न.जोड़ो(वेब.विकूटित(पाठ्य.अंश(युग्म,०,स),सत्य)); प्रश्न.जोड़ो(वेब.विकूटित(पाठ्य.अंश(युग्म,स+१,पाठ्य.लंबाई(युग्म)),सत्य)); }
                }
            }
        }
        // Validate every escaped path segment before routing; decode each segment once.
        प्रत्येक (खंड: पाठ में पाठ्य.बाँटो(पथ,"/")) { वेब.विकूटित(खंड,असत्य); }
    }
    सार्वजनिक कार्य शीर्षमान(नाम: पाठ) -> सूची<पाठ> { लौटाओ वेब.मानलो(शीर्ष,पाठ्य.छोटाअक्षर(नाम)); }
    सार्वजनिक कार्य प्रश्नमान(नाम: पाठ) -> सूची<पाठ> { लौटाओ वेब.मानलो(प्रश्न,नाम); }
    सार्वजनिक कार्य पाठ्यांश() -> पाठ {
        प्रयास { लौटाओ पाठ्य.यूटीएफ८पाठ(सामग्री); } पकड़ो (दोष: अपवाद) { फेंको नया वेबत्रुटि(४००,"सामग्री शुद्ध UTF-8 होनी चाहिए।"); }
    }
    सार्वजनिक कार्य जेसनलो() -> सर्ववस्तु {
        स्थिर प्रकार: सूची<पाठ> = यह.शीर्षमान("content-type");
        यदि (प्रकार.आकार != १ || पाठ्य.छोटाअक्षर(पाठ्य.छाँटो(पाठ्य.बाँटो(प्रकार[०],";")[०])) != "application/json") { फेंको नया वेबत्रुटि(४१५,"Content-Type application/json दें।"); }
        प्रयास { लौटाओ जेसन.पढ़ो(यह.पाठ्यांश()); } पकड़ो (दोष: अपवाद) { फेंको नया वेबत्रुटि(४००,"अमान्य JSON सामग्री।"); }
    }
}
सार्वजनिक वर्ग वेबउत्तर {
    सार्वजनिक मान स्थिति: पूर्णांक;
    सार्वजनिक मान शीर्ष: सूची<पाठ>;
    सार्वजनिक मान सामग्री: बाइटबफ़र;
    सार्वजनिक निर्माता(स्थिति: पूर्णांक, सामग्री: बाइटबफ़र) { यह.स्थिति = स्थिति; यह.सामग्री = सामग्री; शीर्ष = नया सूची<पाठ>(); }
    सार्वजनिक कार्य शीर्षजोड़ो(नाम: पाठ, मानक: पाठ) -> शून्य { जालनियम.शीर्षजाँचो(नाम,मानक); शीर्ष.जोड़ो(पाठ्य.छोटाअक्षर(नाम)); शीर्ष.जोड़ो(मानक); }
    सार्वजनिक कार्य शीर्षरखो(नाम: पाठ, मानक: पाठ) -> शून्य {
        जालनियम.शीर्षजाँचो(नाम,मानक); स्थिर न: पाठ = पाठ्य.छोटाअक्षर(नाम);
        मान क: पूर्णांक = ०; जबतक (क < शीर्ष.आकार) { यदि (शीर्ष[क] == न) { शीर्ष[क+१] = मानक; लौटाओ; } क = क+२; }
        शीर्ष.जोड़ो(न); शीर्ष.जोड़ो(मानक);
    }
}
सार्वजनिक वर्ग वेब {
    सार्वजनिक साझा कार्य मानलो(युग्म: सूची<पाठ>, नाम: पाठ) -> सूची<पाठ> {
        स्थिर फल: सूची<पाठ> = नया सूची<पाठ>(); मान क: पूर्णांक = ०;
        जबतक (क < युग्म.आकार) { यदि (युग्म[क] == नाम) { फल.जोड़ो(युग्म[क+१]); } क = क+२; } लौटाओ फल;
    }
    सार्वजनिक साझा कार्य अंक(मानक: पूर्णांक) -> पाठ {
        यदि (मानक < ०) { फेंको नया अपवाद("ऋणात्मक HTTP अंक।"); } यदि (मानक == ०) { लौटाओ "0"; }
        मान फल: पाठ = ""; मान अवशिष्ट: पूर्णांक = मानक; स्थिर अक्षर: पाठ = "0123456789";
        जबतक (अवशिष्ट > ०) { स्थिर अ: पूर्णांक = अवशिष्ट % १०; फल = पाठ्य.अंश(अक्षर,अ,अ+१)+फल; अवशिष्ट = अवशिष्ट/१०; } लौटाओ फल;
    }
    सार्वजनिक साझा कार्य संख्या(मानक: पाठ, अधिकतम: पूर्णांक) -> पूर्णांक {
        यदि (मानक == "") { फेंको नया वेबत्रुटि(४००,"अमान्य HTTP अंक।"); }
        मान फल: पूर्णांक = ०;
        मान क: पूर्णांक = ०;
        जबतक (क < पाठ्य.लंबाई(मानक)) {
            स्थिर अ: पूर्णांक = पाठ्य.खोजो("0123456789",पाठ्य.अंश(मानक,क,क+१));
            यदि (अ < ० || फल > (अधिकतम-अ)/१०) { फेंको नया वेबत्रुटि(४००,"अमान्य HTTP अंक।"); }
            फल = फल*१०+अ; यदि (फल > अधिकतम) { फेंको नया वेबत्रुटि(४००,"अमान्य HTTP अंक।"); } क = क+१;
        } लौटाओ फल;
    }
    सार्वजनिक साझा कार्य विकूटित(मानक: पाठ, जोड़: तार्किक) -> पाठ {
        स्थिर मूल: बाइटबफ़र = पाठ्य.यूटीएफ८(मानक); स्थिर फल: बाइटबफ़र = नया बाइटबफ़र(मूल.आकार);
        मान क: पूर्णांक = ०; मान ग: पूर्णांक = ०;
        जबतक (क < मूल.आकार) {
            मान ब: पूर्णांक = परिवर्तित<पूर्णांक>(मूल[क]);
            यदि (ब == ३७) {
                यदि (क+२ >= मूल.आकार) { फेंको नया वेबत्रुटि(४००,"अमान्य प्रतिशत कूट।"); }
                स्थिर अ: पूर्णांक = पाठ्य.खोजो("0123456789abcdef",पाठ्य.छोटाअक्षर(पाठ्य.यूटीएफ८पाठ(मूल.काटो(क+१,क+२))));
                स्थिर स: पूर्णांक = पाठ्य.खोजो("0123456789abcdef",पाठ्य.छोटाअक्षर(पाठ्य.यूटीएफ८पाठ(मूल.काटो(क+२,क+३))));
                यदि (अ < ० || स < ०) { फेंको नया वेबत्रुटि(४००,"अमान्य प्रतिशत कूट।"); } ब = अ*१६+स; क = क+२;
            } अन्यथा यदि (जोड़ && ब == ४३) { ब = ३२; }
            यदि (ब < ३२ || ब == १२७ || (!जोड़ && (ब == ४७ || ब == ९२))) { फेंको नया वेबत्रुटि(४००,"अमान्य URL खंड।"); }
            फल[ग] = परिवर्तित<बाइट>(ब); ग = ग+१; क = क+१;
        }
        प्रयास { लौटाओ पाठ्य.यूटीएफ८पाठ(फल.काटो(०,ग)); } पकड़ो (दोष: अपवाद) { फेंको नया वेबत्रुटि(४००,"URL शुद्ध UTF-8 होना चाहिए।"); }
    }
    सार्वजनिक साझा कार्य पाठउत्तर(स्थिति: पूर्णांक, मानक: पाठ) -> वेबउत्तर {
        स्थिर फल: वेबउत्तर = नया वेबउत्तर(स्थिति,पाठ्य.यूटीएफ८(मानक)); फल.शीर्षरखो("Content-Type","text/plain; charset=utf-8"); लौटाओ फल;
    }
    सार्वजनिक साझा कार्य एचटीएमएल(स्थिति: पूर्णांक, मानक: पाठ) -> वेबउत्तर {
        स्थिर फल: वेबउत्तर = वेब.पाठउत्तर(स्थिति,मानक); फल.शीर्षरखो("Content-Type","text/html; charset=utf-8"); लौटाओ फल;
    }
    सार्वजनिक साझा कार्य जेसन(स्थिति: पूर्णांक, मानक: सर्ववस्तु) -> वेबउत्तर {
        स्थिर फल: वेबउत्तर = वेब.पाठउत्तर(स्थिति,जेसन.पाठबनाओ(मानक)); फल.शीर्षरखो("Content-Type","application/json; charset=utf-8"); लौटाओ फल;
    }
    सार्वजनिक साझा कार्य त्रुटि(स्थिति: पूर्णांक) -> वेबउत्तर {
        स्थिर मानक: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>(); मानक["error"] = "अनुरोध पूरा नहीं हुआ।"; मानक["status"] = स्थिति; लौटाओ वेब.जेसन(स्थिति,मानक);
    }
}
सार्वजनिक वर्ग वेबमार्ग {
    सार्वजनिक मान विधि: पाठ; सार्वजनिक मान खंड: सूची<पाठ>; सार्वजनिक मान चालक: वेबचालक;
    सार्वजनिक निर्माता(विधि: पाठ, पथ: पाठ, चालक: वेबचालक) { यह.विधि = विधि; खंड = पाठ्य.बाँटो(पथ,"/"); यह.चालक = चालक; }
}
सार्वजनिक वर्ग वेबअनुप्रयोग पालन वेबचालक {
    निजी मान मार्ग: सूची<वेबमार्ग>;
    सार्वजनिक निर्माता() { मार्ग = नया सूची<वेबमार्ग>(); }
    सार्वजनिक कार्य जोड़ो(विधि: पाठ, पथ: पाठ, चालक: वेबचालक) -> शून्य {
        यदि (चालक == रिक्त || !पाठ्य.है("|GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|","|"+विधि+"|") || !पाठ्य.आरंभ(पथ,"/") || पाठ्य.है(पथ,"?") || मार्ग.आकार >= १२८) { फेंको नया अपवाद("अमान्य वेब मार्ग।"); }
        स्थिर नाम: मानचित्र<पाठ,तार्किक> = नया मानचित्र<पाठ,तार्किक>();
        प्रत्येक (खंड: पाठ में पाठ्य.बाँटो(पथ,"/")) {
            यदि (पाठ्य.आरंभ(खंड,":")) { यदि (पाठ्य.लंबाई(खंड) < २ || नाम.है(खंड)) { फेंको नया अपवाद("अमान्य मार्ग चर।"); } नाम[खंड] = सत्य; }
            अन्यथा { वेब.विकूटित(खंड,असत्य); }
        }
        मार्ग.जोड़ो(नया वेबमार्ग(विधि,पथ,चालक));
    }
    सार्वजनिक कार्य संभालो(अनुरोध: वेबअनुरोध) -> वेबउत्तर {
        स्थिर खंड: सूची<पाठ> = पाठ्य.बाँटो(अनुरोध.पथ,"/"); मान मिला: तार्किक = असत्य; स्थिर अनुमत: सूची<पाठ> = नया सूची<पाठ>();
        प्रत्येक (मार्ग: वेबमार्ग में यह.मार्ग) {
            यदि (खंड.आकार == मार्ग.खंड.आकार) {
                स्थिर चर: मानचित्र<पाठ,पाठ> = नया मानचित्र<पाठ,पाठ>(); मान क: पूर्णांक = ०; मान सही: तार्किक = सत्य;
                जबतक (क < खंड.आकार) {
                    स्थिर व: पाठ = वेब.विकूटित(खंड[क],असत्य); स्थिर म: पाठ = मार्ग.खंड[क];
                    यदि (पाठ्य.आरंभ(म,":")) { यदि (व == "") { सही = असत्य; } चर[पाठ्य.अंश(म,१,पाठ्य.लंबाई(म))] = व; }
                    अन्यथा यदि (वेब.विकूटित(म,असत्य) != व) { सही = असत्य; } क = क+१;
                }
                यदि (सही) { मिला = सत्य; अनुमत.जोड़ो(मार्ग.विधि); यदि (मार्ग.विधि == "GET") { अनुमत.जोड़ो("HEAD"); } यदि (अनुरोध.विधि == मार्ग.विधि || (अनुरोध.विधि == "HEAD" && मार्ग.विधि == "GET")) { अनुरोध.पथमान = चर; लौटाओ मार्ग.चालक.संभालो(अनुरोध); } }
            }
        }
        यदि (मिला) { स्थिर फल: वेबउत्तर = वेब.त्रुटि(४०५); फल.शीर्षरखो("Allow",पाठ्य.जोड़ो(अनुमत,", ")); लौटाओ फल; } लौटाओ वेब.त्रुटि(४०४);
    }
}
// Resource is allocated before an OS socket is opened; closing is idempotent.
सार्वजनिक वर्ग वेबसंबंध पालन बंदनीय {
    सार्वजनिक मान पहचान: पूर्णांक = ०;
    निजी मान खंड: बाइटबफ़र; निजी मान क्रम: पूर्णांक = ०;
    सार्वजनिक निर्माता() { खंड = नया बाइटबफ़र(०); }
    सार्वजनिक कार्य बंदकरो() -> शून्य { यदि (पहचान != ०) { स्थिर प: पूर्णांक = पहचान; पहचान = ०; सर्वरतंत्र.बंदकरो(प); } }
    सार्वजनिक कार्य बाइटलो() -> पूर्णांक {
        यदि (क्रम == खंड.आकार) { प्रयास { खंड = सर्वरतंत्र.बाइटपढ़ो(पहचान); }
            पकड़ो (दोष: अपवाद) { यदि (दोष.संदेश == "HTTP संबंध का समय समाप्त।") { फेंको नया वेबत्रुटि(४०८,"HTTP संबंध का समय समाप्त।"); } फेंको दोष; } क्रम = ०; यदि (खंड.आकार == ०) { फेंको नया वेबत्रुटि(४००,"अपूर्ण HTTP अनुरोध।"); } }
        स्थिर फल: पूर्णांक = परिवर्तित<पूर्णांक>(खंड[क्रम]); क्रम = क्रम+१; लौटाओ फल;
    }
    सार्वजनिक कार्य पंक्तिलो() -> पाठ {
        स्थिर ब: बाइटबफ़र = नया बाइटबफ़र(४०९६); मान क: पूर्णांक = ०;
        जबतक (सत्य) {
            स्थिर अ: पूर्णांक = यह.बाइटलो();
            यदि (अ == १३) { यदि (यह.बाइटलो() != १०) { फेंको नया वेबत्रुटि(४००,"HTTP में CRLF दें।"); } लौटाओ पाठ्य.यूटीएफ८पाठ(ब.काटो(०,क)); }
            यदि (क == ४०९६ || (अ < ३२ && अ != ९) || अ > १२६) { फेंको नया वेबत्रुटि(४००,"अमान्य HTTP पंक्ति।"); }
            ब[क] = परिवर्तित<बाइट>(अ); क = क+१;
        } लौटाओ "";
    }
    सार्वजनिक कार्य अनुरोधलो() -> वेबअनुरोध {
        स्थिर पंक्ति: सूची<पाठ> = पाठ्य.बाँटो(यह.पंक्तिलो()," ");
        यदि (पंक्ति.आकार != ३ || (पंक्ति[२] != "HTTP/1.1" && पंक्ति[२] != "HTTP/1.0")) { फेंको नया वेबत्रुटि(४००,"अमान्य HTTP अनुरोध पंक्ति।"); }
        यदि (!पाठ्य.है("|GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS|","|"+पंक्ति[०]+"|")) { फेंको नया वेबत्रुटि(५०१,"यह HTTP विधि उपलब्ध नहीं है।"); }
        स्थिर शीर्ष: सूची<पाठ> = नया सूची<पाठ>(); मान कुल: पूर्णांक = ०; मान आकार: पूर्णांक = ०; मान लंबाईहै: तार्किक = असत्य; मान मेजबान: पूर्णांक = ०;
        जबतक (सत्य) {
            स्थिर प: पाठ = यह.पंक्तिलो(); यदि (प == "") { विराम; } कुल = कुल+पाठ्य.लंबाई(प)+२;
            यदि (कुल > १६३८४ || शीर्ष.आकार >= १२८) { फेंको नया वेबत्रुटि(४३१,"बहुत अधिक HTTP शीर्ष।"); }
            स्थिर अ: पूर्णांक = पाठ्य.खोजो(प,":"); यदि (अ <= ०) { फेंको नया वेबत्रुटि(४००,"अमान्य HTTP शीर्ष।"); }
            स्थिर न: पाठ = पाठ्य.छोटाअक्षर(पाठ्य.अंश(प,०,अ)); स्थिर व: पाठ = पाठ्य.छाँटो(पाठ्य.अंश(प,अ+१,पाठ्य.लंबाई(प)));
            मान क: पूर्णांक = ०; जबतक (क < पाठ्य.लंबाई(न)) { यदि (!पाठ्य.है("!#$%&'*+-.^_`|~0123456789abcdefghijklmnopqrstuvwxyz",पाठ्य.अंश(न,क,क+१))) { फेंको नया वेबत्रुटि(४००,"अमान्य HTTP शीर्ष नाम।"); } क = क+१; }
            यदि (न == "content-length") {
                यदि (लंबाईहै) { फेंको नया वेबत्रुटि(४००,"दोहरा Content-Length।"); } लंबाईहै = सत्य;
                प्रयास { आकार = वेब.संख्या(व,१०४८५७६); } पकड़ो (दोष: वेबत्रुटि) { फेंको नया वेबत्रुटि(४१३,"सामग्री सीमा या लंबाई अमान्य।"); }
            }
            यदि (न == "transfer-encoding") { फेंको नया वेबत्रुटि(५०१,"खंडित सामग्री उपलब्ध नहीं है।"); }
            यदि (न == "expect") { फेंको नया वेबत्रुटि(४१७,"Expect उपलब्ध नहीं है।"); }
            यदि (न == "host") { मेजबान = मेजबान+१; यदि (व == "" || मेजबान > १) { फेंको नया वेबत्रुटि(४००,"अमान्य Host शीर्ष।"); } }
            शीर्ष.जोड़ो(न); शीर्ष.जोड़ो(व);
        }
        यदि (पंक्ति[२] == "HTTP/1.1" && मेजबान != १) { फेंको नया वेबत्रुटि(४००,"Host शीर्ष आवश्यक है।"); }
        स्थिर शरीर: बाइटबफ़र = नया बाइटबफ़र(आकार); मान क: पूर्णांक = ०;
        जबतक (क < आकार) { शरीर[क] = परिवर्तित<बाइट>(यह.बाइटलो()); क = क+१; }
        लौटाओ नया वेबअनुरोध(पंक्ति[०],पंक्ति[१],शीर्ष,शरीर);
    }
    सार्वजनिक कार्य उत्तरशीर्ष(उत्तर: वेबउत्तर) -> पाठ {
        यदि (उत्तर == रिक्त || उत्तर.स्थिति < २०० || उत्तर.स्थिति > ५९९ || उत्तर.सामग्री == रिक्त || उत्तर.सामग्री.आकार > १०४८५७६ || उत्तर.शीर्ष == रिक्त || उत्तर.शीर्ष.आकार % २ != ० || उत्तर.शीर्ष.आकार > १२८) { फेंको नया अपवाद("अमान्य वेब उत्तर।"); }
        मान शरीर: बाइटबफ़र = उत्तर.सामग्री;
        यदि (उत्तर.स्थिति == २०४ || उत्तर.स्थिति == ३०४) { शरीर = नया बाइटबफ़र(०); }
        मान लंबाई: पाठ = "Content-Length: "+वेब.अंक(शरीर.आकार)+"\r\n";
        यदि (उत्तर.स्थिति == २०४ || उत्तर.स्थिति == ३०४) { लंबाई = ""; }
        मान प: पाठ = "HTTP/1.1 "+वेब.अंक(उत्तर.स्थिति)+" Response\r\nConnection: close\r\n"+लंबाई+"X-Content-Type-Options: nosniff\r\n";
        मान क: पूर्णांक = ०; जबतक (क < उत्तर.शीर्ष.आकार) { जालनियम.शीर्षजाँचो(उत्तर.शीर्ष[क],उत्तर.शीर्ष[क+१]); प = प+उत्तर.शीर्ष[क]+": "+उत्तर.शीर्ष[क+१]+"\r\n"; क = क+२; }
        यदि (पाठ्य.लंबाई(प)>१६३८४) { फेंको नया अपवाद("वेब उत्तर के शीर्ष बहुत बड़े हैं।"); }
        लौटाओ प+"\r\n";
    }
    सार्वजनिक कार्य उत्तरदो(उत्तर: वेबउत्तर, केवलशीर्ष: तार्किक) -> शून्य {
        स्थिर प: पाठ = यह.उत्तरशीर्ष(उत्तर);
        सर्वरतंत्र.बाइटलिखो(पहचान,पाठ्य.यूटीएफ८(प));
        यदि (!केवलशीर्ष && उत्तर.स्थिति != २०४ && उत्तर.स्थिति != ३०४ && उत्तर.सामग्री.आकार > ०) { सर्वरतंत्र.बाइटलिखो(पहचान,उत्तर.सामग्री); }
    }
}
सार्वजनिक वर्ग एचटीटीपीसर्वर पालन बंदनीय {
    निजी मान सुनना: वेबसंबंध; निजी मान रुका: तार्किक = असत्य;
    सार्वजनिक निर्माता(पता: पाठ, पोर्ट: पूर्णांक) { सुनना = नया वेबसंबंध(); सुनना.पहचान = सर्वरतंत्र.खोलो(पता,पोर्ट); }
    सार्वजनिक कार्य पोर्ट() -> पूर्णांक { लौटाओ सर्वरतंत्र.पोर्ट(सुनना.पहचान); }
    सार्वजनिक कार्य रोको() -> शून्य { रुका = सत्य; }
    सार्वजनिक कार्य रुकाहै() -> तार्किक { यदि (सर्वरतंत्र.रोकचिह्न() != ०) { रुका = सत्य; } लौटाओ रुका; }
    सार्वजनिक कार्य बंदकरो() -> शून्य { रुका = सत्य; सुनना.बंदकरो(); }
    सार्वजनिक कार्य चलाओ(चालक: वेबचालक) -> शून्य {
        यदि (चालक == रिक्त) { फेंको नया अपवाद("वेब चालक रिक्त है।"); }
        जबतक (!यह.रुकाहै()) { यह.अगला(चालक); }
    }
    सार्वजनिक कार्य अगला(चालक: वेबचालक) -> तार्किक {
        यदि (यह.रुकाहै()) { लौटाओ असत्य; }
        यदि (चालक == रिक्त) { फेंको नया अपवाद("वेब चालक रिक्त है।"); }
            संसाधन (संबंध: वेबसंबंध = नया वेबसंबंध()) {
                संबंध.पहचान = सर्वरतंत्र.स्वीकारो(सुनना.पहचान);
                यदि (संबंध.पहचान != ०) {
                    मान शीर्षमात्र: तार्किक = असत्य;
                    मान उत्तर: वेबउत्तर = रिक्त;
                    प्रयास {
                        स्थिर अनुरोध: वेबअनुरोध = संबंध.अनुरोधलो(); शीर्षमात्र = अनुरोध.विधि == "HEAD";
                        उत्तर = चालक.संभालो(अनुरोध); संबंध.उत्तरशीर्ष(उत्तर);
                    } पकड़ो (दोष: वेबत्रुटि) { उत्तर = वेब.त्रुटि(दोष.स्थिति); }
                    पकड़ो (दोष: अपवाद) { लेखा.सूचना("वेब अनुरोध में आंतरिक त्रुटि।"); उत्तर = वेब.त्रुटि(५००); }
                    प्रयास { संबंध.उत्तरदो(उत्तर,शीर्षमात्र); }
                    पकड़ो (दोष: अपवाद) { लेखा.सूचना("वेब उत्तर भेजा नहीं जा सका।"); }
                    स्थिर घटना: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
                    यदि (उत्तर != रिक्त) { घटना["status"] = उत्तर.स्थिति; }
                    लेखा.घटनालिखो(१,"HTTP अनुरोध पूरा हुआ।",घटना);
                    लौटाओ सत्य;
                }
            }
        लौटाओ असत्य;
    }
}
