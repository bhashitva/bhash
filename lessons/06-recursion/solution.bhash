कार्य गुणनफल(संख्या: पूर्णांक) -> पूर्णांक {
    यदि (संख्या <= १) { लौटाओ १; }
    लौटाओ संख्या * गुणनफल(संख्या - १);
}
कार्य मुख्य() -> शून्य {
    स्थिर संख्या: पूर्णांक = पढ़ो();
    यदि (संख्या < ० || संख्या > २०) {
        लिखो("सीमा से बाहर");
        लौटाओ;
    }
    लिखो(गुणनफल(संख्या));
}
