कार्य मुख्य() -> शून्य {
    स्थिर वस्तुएँ: सूची<पाठ> = नया सूची<पाठ>{"पुस्तक","कलम","पुस्तक"};
    स्थिर गिनती: मानचित्र<पाठ, पूर्णांक> = नया मानचित्र<पाठ, पूर्णांक>();
    प्रत्येक (वस्तु: पाठ में वस्तुएँ) {
        गिनती[वस्तु] = गिनती.लो(वस्तु, ०) + १;
    }
    लिखो(गिनती.लो("पुस्तक", ०));
    लिखो(गिनती.लो("कलम", ०));
}
