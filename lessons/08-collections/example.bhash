कार्य मुख्य() -> शून्य {
    स्थिर नाम: सूची<पाठ> = नया सूची<पाठ>{"आशा","रवि"};
    नाम.जोड़ो("मीना");
    प्रत्येक (विद्यार्थी: पाठ में नाम) { लिखो(विद्यार्थी); }
    स्थिर अंक: मानचित्र<पाठ, पूर्णांक> = नया मानचित्र<पाठ, पूर्णांक>{"आशा":८};
    लिखो(अंक["आशा"]);
}
