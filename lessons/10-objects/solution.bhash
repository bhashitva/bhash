वर्ग खाता {
    निजी मान राशि: पूर्णांक;
    निर्माता(आरंभ: पूर्णांक) { यह.राशि = आरंभ; }
    सार्वजनिक कार्य जमा(जमा: पूर्णांक) -> शून्य { यह.राशि = यह.राशि + जमा; }
    सार्वजनिक कार्य बाकी() -> पूर्णांक { लौटाओ यह.राशि; }
}
कार्य मुख्य() -> शून्य {
    स्थिर पहला: खाता = नया खाता(१०);
    स्थिर दूसरा: खाता = नया खाता(२०);
    पहला.जमा(५);
    लिखो(पहला.बाकी());
    लिखो(दूसरा.बाकी());
}
