// विद्यार्थियों की संख्या शून्य या अधिक है। हर बस में कम से कम एक सीट है।
फलन बसों_की_संख्या(विद्यार्थी: पूर्णांक, सीटें: पूर्णांक) -> पूर्णांक {
    स्थिर भरी_बसें: पूर्णांक = विद्यार्थी / सीटें;
    यदि (विद्यार्थी % सीटें == ०) { लौटाओ भरी_बसें; }
    लौटाओ भरी_बसें + १;
}

फलन मुख्य() -> शून्य {
    स्थिर विद्यार्थी: पूर्णांक = पढ़ो();
    स्थिर सीटें: पूर्णांक = पढ़ो();
    लिखो(बसों_की_संख्या(विद्यार्थी, सीटें));
}
