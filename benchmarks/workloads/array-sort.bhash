कार्य काम(न: पूर्णांक) -> पूर्णांक {
    स्थिर अ: पूर्णांक[] = नया पूर्णांक[न]; मान इ: पूर्णांक = ०;
    जबतक (इ < न) { अ[इ] = न - इ; इ = इ + १; }
    इ = १;
    जबतक (इ < न) {
        स्थिर मूल्य: पूर्णांक = अ[इ]; मान ज: पूर्णांक = इ - १;
        जबतक (ज >= ० && अ[ज] > मूल्य) { अ[ज + १] = अ[ज]; ज = ज - १; }
        अ[ज + १] = मूल्य; इ = इ + १;
    }
    मान योग: पूर्णांक = ०; इ = ०;
    जबतक (इ < न) { यदि (अ[इ] != इ + १) { त्रुटि("क्रम"); } योग = योग + अ[इ]; इ = इ + १; }
    लौटाओ योग;
}
