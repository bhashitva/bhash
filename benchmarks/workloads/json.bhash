आयात मानक.जेसन उपनाम ज;
कार्य काम(न: पूर्णांक) -> पूर्णांक {
    मान इ: पूर्णांक = ०; मान योग: पूर्णांक = ०;
    जबतक (इ < न) {
        स्थिर म: मानचित्र<पाठ,सर्ववस्तु> = परिवर्तित<मानचित्र<पाठ,सर्ववस्तु>>(ज.पढ़ो("{\"नाम\":\"भारत😀\",\"अंक\":42,\"भीतर\":{\"सूची\":[1,true,null]}}"));
        स्थिर फिर: मानचित्र<पाठ,सर्ववस्तु> = परिवर्तित<मानचित्र<पाठ,सर्ववस्तु>>(ज.पढ़ो(ज.पाठबनाओ(म)));
        यदि (परिवर्तित<पाठ>(फिर["नाम"]) != "भारत😀") { त्रुटि("जेसन"); }
        योग = योग + परिवर्तित<पूर्णांक>(फिर["अंक"]); इ = इ + १;
    }
    लौटाओ योग;
}
