आयात मानक.फ़ाइल उपनाम फ;
आयात मानक.पाठ्य उपनाम प;
कार्य काम(न: पूर्णांक) -> पूर्णांक {
    स्थिर मूल: पाठ = प.दोहराओ("ASCII भारत😀\n", ४०९६);
    मान इ: पूर्णांक = ०; मान योग: पूर्णांक = ०;
    जबतक (इ < न) {
        फ.पाठलिखो("benchmark-data.txt", मूल);
        यदि (फ.पाठपढ़ो("benchmark-data.txt") != मूल) { त्रुटि("फ़ाइल"); }
        योग = योग + १; इ = इ + १;
    }
    लौटाओ योग;
}
