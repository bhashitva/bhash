कार्य काम(न: पूर्णांक) -> पूर्णांक {
    स्थिर स: सूची<पूर्णांक> = नया सूची<पूर्णांक>();
    स्थिर म: मानचित्र<पूर्णांक,पूर्णांक> = नया मानचित्र<पूर्णांक,पूर्णांक>();
    मान इ: पूर्णांक = ०; मान योग: पूर्णांक = ०;
    जबतक (इ < न) { स.जोड़ो(इ); म[इ] = इ * ३; इ = इ + १; }
    इ = ०; जबतक (इ < न) { योग = योग + स[इ] + म[इ]; इ = इ + १; }
    लौटाओ योग;
}
