आयात मानक.पाठ्य उपनाम प;
कार्य काम(न: पूर्णांक) -> पूर्णांक {
    मान इ: पूर्णांक = ०; मान योग: पूर्णांक = ०;
    जबतक (इ < न) {
        स्थिर पाठमान: पाठ = प.दोहराओ("ASCII,भारत,😀,", ८);
        स्थिर भाग: सूची<पाठ> = प.बाँटो(पाठमान, ",");
        यदि (प.जोड़ो(भाग, ",") != पाठमान) { त्रुटि("पाठ"); }
        योग = योग + भाग.आकार(); इ = इ + १;
    }
    लौटाओ योग;
}
